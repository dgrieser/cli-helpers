#!/bin/bash

APP_NAME="$(basename "${0}")"

FULL_REVIEW_PROMPT="Review the whole repository"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [full | base [BRANCH] | uncommitted | commit [SHA]]

Runs a Codex review of the current Git repository with codex exec review.

Without a target, the review is chosen from the repository state:
  - uncommitted changes (staged, unstaged, untracked): those changes
  - on the default branch (as detected by git-default): the whole repository
  - on any other branch: the changes against the default branch

In a terminal, the response is shown and a menu then offers to copy it, send
a follow-up prompt to the same Codex session, or run the review again.
Otherwise, or with --print, only the response goes to stdout.

Targets:
    full                Review the whole repository
    base [BRANCH]       Review changes against BRANCH (default: the default
                        branch; "default" also stands for it)
    uncommitted         Review staged, unstaged, and untracked changes
    commit [SHA]        Review commit SHA, any commit ref (default: HEAD)

Options:
    -p, --print         Print only the response, even in a terminal
    -h, --help          Display this help

    --bash-completion   Print completion candidates and exit

Environment:
    CODEX_REVIEW_PROFILE  Codex profile for the review (default: review)
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

# Local and remote branches, newest first, without symbolic refs like origin/HEAD.
list_branches() {
    git for-each-ref --sort=-committerdate \
        --format='%(if)%(symref)%(then)%(else)%(refname:short)%(end)' \
        refs/heads refs/remotes 2>/dev/null | grep -v '^$'
}

# Arguments: the word before the cursor, then the command line words after the
# command name, the last one being the word that is completed.
completion() {
    local prev="${1}"
    local word=""
    shift

    case "${prev}" in
        base)
            echo default
            list_branches
            return
            ;;
        commit)
            echo HEAD
            git for-each-ref --format='%(refname:short)' refs/heads refs/tags 2>/dev/null
            return
            ;;
    esac

    echo "-p --print -h --help --bash-completion"
    [ "${#}" -gt 0 ] && set -- "${@:1:$(( ${#} - 1 ))}"
    for word in "${@}"; do
        case "${word}" in
            full|base|uncommitted|commit) return ;;
        esac
    done
    echo "full base uncommitted commit"
}

# Shows what Codex does while it works: commands it runs and errors.
show_progress() {
    local width="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
    jq --unbuffered -r --argjson width "$(( width - 4 ))" '
        def short: gsub("\\s+"; " ") | if length > $width then .[0:$width - 1] + "…" else . end;
        if .type == "item.started" and .item.type == "command_execution" then
            "  $ " + (.item.command | sub("^/bin/(ba)?sh -lc "; "") | short)
        elif .type == "item.completed" and .item.type == "reasoning" and (.item.text // "") != "" then
            "  " + (.item.text | short)
        elif .type == "error" then
            "ERROR: " + .message
        elif .type == "turn.failed" then
            "ERROR: " + (.error.message // "turn failed")
        else empty end
    ' 2>/dev/null | if [ -t 2 ]; then
        sed -u "s/^/$(tput dim 2>/dev/null)/; s/\$/$(tput sgr0 2>/dev/null)/"
    else
        cat
    fi 1>&2
}

# Runs codex exec with the given arguments and standard input, records the
# session id and replaces ${answer_file} with the final response. On failure,
# the previous response stays.
run_codex() {
    local events_file="${work_dir}/events.jsonl"
    local new_answer_file="${work_dir}/answer.new.md"
    local status
    local id

    rm -f "${new_answer_file}"
    codex exec --profile "${profile}" "${@}" --json --output-last-message "${new_answer_file}" \
        | tee "${events_file}" | show_progress
    status="${PIPESTATUS[0]}"
    [ "${status}" -eq 0 ] || return "${status}"

    id="$(jq -r 'select(.type == "thread.started") | .thread_id' "${events_file}" | head -n 1)"
    [ -n "${id}" ] && session_id="${id}"
    [ -s "${new_answer_file}" ] || { error "Codex returned no response"; return 1; }
    mv -f "${new_answer_file}" "${answer_file}"
}

run_review() {
    run_codex review "${review_args[@]}" </dev/null
}

# The prompt goes through stdin, so text starting with "-" is no option.
run_followup() {
    [ -n "${session_id}" ] || { error "No Codex session to continue"; return 1; }
    printf '%s\n' "${1}" | run_codex resume "${session_id}" -
}

# Codex leaves out the final newline of the response.
print_answer() {
    cat "${answer_file}"
    [ -z "$(tail -c 1 "${answer_file}")" ] || echo
}

show_answer() {
    if [ -t 1 ] && command -v glow >/dev/null 2>&1; then
        glow --style "${GLOW_STYLE:-auto}" "${answer_file}"
    else
        print_answer
    fi
}

ask_next() {
    prompt-select --prompt "Next:" --no-abort-message \
        "copy=Copy response" \
        "followup=Send follow-up prompt" \
        "review=Run review again" \
        "quit=Quit" \
        </dev/tty
}

ask_followup() {
    prompt --prompt "Follow-up prompt (Ctrl-D sends):" --no-abort-message </dev/tty
}

interactive_loop() {
    local action
    local text

    while true; do
        echo 1>&2
        action="$(ask_next)" || return 0
        case "${action}" in
            copy)
                clip "${answer_file}" && echo "Copied to clipboard." 1>&2
                ;;
            followup)
                text="$(ask_followup)" || continue
                [ -n "${text//[[:space:]]/}" ] || continue
                if run_followup "${text}"; then
                    show_answer
                else
                    error "Follow-up failed"
                fi
                ;;
            review)
                if run_review; then
                    show_answer
                else
                    error "Review failed"
                fi
                ;;
            quit)
                return 0
                ;;
        esac
    done
}

# The default branch, as detected by git-default (which reports its own error).
default_branch() {
    command -v git-default >/dev/null 2>&1 || fail "git-default not found (from dev-helpers)"
    git-default || exit 1
}

# Uncommitted changes win; otherwise a branch is reviewed against the default
# branch, and the default branch itself gets a review of the whole repository.
detect_mode() {
    local branch

    if [ -n "$(git status --porcelain --untracked-files=normal 2>/dev/null)" ]; then
        echo uncommitted
        return
    fi
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
    if [ "${branch}" = "$(default_branch)" ]; then
        echo full
    else
        echo base
    fi
}

mode=""
target=""
print=0
profile="${CODEX_REVIEW_PROFILE:-review}"

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --bash-completion)
            shift
            completion "${@}"
            exit 0
            ;;
        -h|--help) usage ;;
        -p|--print) print=1 ;;
        full|base|uncommitted|commit)
            [ -z "${mode}" ] || fail "Choose one review target"
            mode="${1}"
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            [ "${mode}" = base ] || [ "${mode}" = commit ] || fail "Unexpected argument: ${1}"
            [ -z "${target}" ] || fail "Too many arguments"
            target="${1}"
            ;;
    esac
    shift
done

command -v codex >/dev/null 2>&1 || fail "codex not found"
command -v jq >/dev/null 2>&1 || fail "jq not found"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Not in a Git repository"

# Without a terminal on both ends, there is nobody to answer the menu.
if [ "${print}" -eq 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    print=1
fi
if [ "${print}" -eq 0 ]; then
    command -v prompt-select >/dev/null 2>&1 || fail "prompt-select not found"
    command -v prompt >/dev/null 2>&1 || fail "prompt not found"
    command -v clip >/dev/null 2>&1 || fail "clip not found"
fi

[ -n "${mode}" ] || mode="$(detect_mode)" || exit 1

case "${mode}" in
    full)
        review_args=("${FULL_REVIEW_PROMPT}")
        description="whole repository"
        ;;
    base)
        if [ -z "${target}" ] || [ "${target}" = default ]; then
            target="$(default_branch)" || exit 1
        fi
        git rev-parse --verify --quiet "${target}^{commit}" >/dev/null || fail "Unknown branch: ${target}"
        review_args=(--base "${target}")
        description="changes against ${target}"
        ;;
    uncommitted)
        review_args=(--uncommitted)
        description="uncommitted changes"
        ;;
    commit)
        sha="$(git rev-parse --verify --quiet "${target:-HEAD}^{commit}")" || fail "Unknown commit: ${target}"
        review_args=(--commit "${sha}")
        description="commit $(git rev-parse --short "${sha}")"
        ;;
esac

work_dir="$(mktemp -d)" || fail "Could not create temporary directory"
trap 'rm -rf "${work_dir}"' EXIT
answer_file="${work_dir}/answer.md"
session_id=""

echo "Reviewing ${description}" 1>&2
run_review || exit $?

if [ "${print}" -eq 1 ]; then
    print_answer
    exit 0
fi

show_answer
interactive_loop

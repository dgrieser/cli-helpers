#!/bin/bash

APP_NAME="$(basename "${0}")"

FULL_REVIEW_PROMPT="Review the whole repository"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [full | base [BRANCH] | uncommitted | commit [SHA]]

Runs a Codex review of the current Git repository with codex exec review.

Without a target, the review is chosen from the repository state:
  - uncommitted changes (staged, unstaged, untracked): those changes
  - on the default branch (as detected by git-default): the whole repository
  - on any other branch: the changes against the default branch

In a terminal, the response is shown and a menu then offers to copy it, send
a prompt to the same Codex session, or choose a new review.
Otherwise, or with --print, only the response goes to stdout.

Targets:
    full                Review the whole repository
    base [BRANCH]       Review changes against BRANCH (default: the default
                        branch; "default" also stands for it)
    uncommitted         Review staged, unstaged, and untracked changes
    commit [SHA]        Review commit SHA, any commit ref (default: HEAD)

Options:
    --deep              Use the review-deep profile (GPT-6.2 Astra, high reasoning)
    -p, --print         Print only the response, even in a terminal
    -h, --help          Display this help

    --bash-completion   Print completion candidates and exit

Environment:
    CODEX_REVIEW_PROFILE  Codex profile when --deep is omitted (default: review)
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

# Local and remote branches, newest first, without symbolic refs like origin/HEAD.
list_branches() {
    git for-each-ref --sort=-committerdate \
        --format='%(if)%(symref)%(then)%(else)%(refname:short)%(end)' \
        refs/heads refs/remotes 2>/dev/null | grep -v '^$'
}

# Arguments: the word before the cursor, then the command line words after the
# command name, the last one being the word that is completed.
completion() {
    local prev="${1}"
    local word=""
    shift

    case "${prev}" in
        base)
            echo default
            list_branches
            return
            ;;
        commit)
            echo HEAD
            git for-each-ref --format='%(refname:short)' refs/heads refs/tags 2>/dev/null
            return
            ;;
    esac

    echo "--deep -p --print -h --help --bash-completion"
    [ "${#}" -gt 0 ] && set -- "${@:1:$(( ${#} - 1 ))}"
    for word in "${@}"; do
        case "${word}" in
            full|base|uncommitted|commit) return ;;
        esac
    done
    echo "full base uncommitted commit"
}

# Shows what Codex does while it works: commands it runs and errors.
show_progress() {
    local width="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
    jq --unbuffered -r --argjson width "$(( width - 4 ))" '
        def short: gsub("\\s+"; " ") | if length > $width then .[0:$width - 1] + "…" else . end;
        if .type == "item.started" and .item.type == "command_execution" then
            "  $ " + (.item.command | sub("^/bin/(ba)?sh -lc "; "") | short)
        elif .type == "item.completed" and .item.type == "reasoning" and (.item.text // "") != "" then
            "  " + (.item.text | short)
        elif .type == "error" then
            "ERROR: " + .message
        elif .type == "turn.failed" then
            "ERROR: " + (.error.message // "turn failed")
        else empty end
    ' 2>/dev/null | if [ -t 2 ]; then
        sed -u "s/^/$(tput dim 2>/dev/null)/; s/\$/$(tput sgr0 2>/dev/null)/"
    else
        cat
    fi 1>&2
}

interrupt_review() {
    interrupt_status="${1}"
    if [ -n "${worker_pid}" ]; then
        kill -TERM -- "-${worker_pid}" 2>/dev/null
    fi
}

# Runs codex exec with the given arguments and standard input, records the
# session id and replaces ${answer_file} with the final response. On failure,
# the previous response stays.
run_codex() {
    local deep="${1}"
    shift
    local profile="${standard_profile}"
    local events_file="${work_dir}/events.jsonl"
    local new_answer_file="${work_dir}/answer.new.md"
    local status
    local id
    local worker_pid=""
    local interrupt_status=0

    if [ "${deep}" = on ]; then
        profile=review-deep
    fi
    rm -f "${new_answer_file}"
    # A foreground pipeline can delay SIGINT until Codex exits. Use an
    # interruptible wait and a separate process group for the whole pipeline.
    trap 'interrupt_review 130' INT
    trap 'interrupt_review 143' TERM
    set -m
    (
        set +m
        # Let the worker shell reap the pipeline after its commands terminate.
        trap ':' TERM
        codex exec --profile "${profile}" "${@}" --json --output-last-message "${new_answer_file}" 2>&3 3>&- \
            | tee "${events_file}" 2>&3 3>&- | show_progress 2>&3 3>&-
        exit "${PIPESTATUS[0]}"
    ) <&0 3>&2 2>/dev/null &
    worker_pid=$!
    set +m

    if [ "${interrupt_status}" -eq 0 ]; then
        wait "${worker_pid}"
        status=$?
    fi
    if [ "${interrupt_status}" -ne 0 ]; then
        trap '' INT TERM
        kill -TERM -- "-${worker_pid}" 2>/dev/null
        wait "${worker_pid}" 2>/dev/null
        if [ "${interrupt_status}" -eq 143 ]; then
            exit 143
        fi
        printf '\nCancelled.\n' >&2
        status=130
    fi
    trap - INT TERM
    [ "${status}" -eq 0 ] || return "${status}"

    id="$(jq -r 'select(.type == "thread.started") | .thread_id' "${events_file}" | head -n 1)"
    [ -n "${id}" ] && session_id="${id}"
    [ -s "${new_answer_file}" ] || { error "Codex returned no response"; return 1; }
    mv -f "${new_answer_file}" "${answer_file}"
}

run_review() {
    local deep="${1}" reviewing=Reviewing
    shift
    if [ "${deep}" = on ]; then
        reviewing="Deep reviewing"
    fi
    printf '%s %s (%s)\n' "${reviewing}" "${description}" "${selection}" >&2
    run_codex "${deep}" review "${@}" </dev/null
}

# The prompt goes through stdin, so text starting with "-" is no option.
run_followup() {
    [ -n "${session_id}" ] || { error "No Codex session to continue"; return 1; }
    if [ "${initial_deep}" = on ]; then
        printf 'Sending deep follow-up\n' >&2
    else
        printf 'Sending follow-up\n' >&2
    fi
    run_codex "${initial_deep}" resume "${session_id}" - <<< "${1}"
}

# Codex leaves out the final newline of the response.
print_answer() {
    cat "${answer_file}"
    [ -z "$(tail -c 1 "${answer_file}")" ] || echo
}

show_answer() {
    if [ -t 1 ] && command -v glow >/dev/null 2>&1; then
        glow --style "${GLOW_STYLE:-auto}" "${answer_file}"
    else
        print_answer
    fi
}

ask_repeat() {
    local other_deep=on entry key label
    local -a cycles=() choices=()

    if [ "${initial_deep}" = on ]; then
        other_deep=off
    fi
    for entry in "${@}"; do
        key="${entry%%=*}"
        label="${entry#*=}"
        cycles+=(--cycle "${key}:${initial_deep}|${key}:${other_deep}")
        choices+=("${key}:off=${label}" "${key}:on=Deep ${label,}")
    done
    prompt-select --prompt "Repeat (Tab toggles deep):" --no-abort-message \
        "${cycles[@]}" "${choices[@]}" </dev/tty
}

ask_next() {
    local label=Prompt
    if [ "${initial_deep}" = on ]; then
        label="Deep prompt"
    fi
    prompt-select --prompt "Next:" --no-abort-message \
        "copy=Copy response" \
        "followup=${label}" \
        "review=Repeat" \
        "quit=Quit" </dev/tty
}

ask_followup() {
    local label="Follow-up prompt"
    if [ "${initial_deep}" = on ]; then
        label="Deep follow-up prompt"
    fi
    prompt --prompt "${label} (Ctrl-D sends):" --no-abort-message </dev/tty
}

review_again() {
    local initial_mode="${mode}" initial_description="${description}"
    local -a initial_args=("${review_args[@]}")
    local mode="" target="" selection="" description="" action entry deep
    local -a entries=() review_args=()

    if detect_mode && resolve_review; then
        entries+=("auto=Review ${description} (${selection})")
    else
        mode=""
    fi
    entries+=("same=Review with same settings (${initial_description})")
    for entry in "full=Review whole repository" \
                 "base=Review changes against a branch" \
                 "uncommitted=Review uncommitted changes" \
                 "commit=Review a commit"; do
        if [ "${entry%%=*}" != "${mode}" ] && [ "${entry%%=*}" != "${initial_mode}" ]; then
            entries+=("${entry}")
        fi
    done

    action="$(ask_repeat "${entries[@]}")" || return 0
    deep="${action##*:}"
    action="${action%%:*}"
    case "${action}" in
        auto) ;;
        same)
            description="${initial_description}"
            selection="same settings"
            review_args=("${initial_args[@]}")
            ;;
        full|base|uncommitted|commit)
            mode="${action}"
            target=""
            case "${mode}" in
                base)
                    target="$(prompt --single-line --prompt "Base branch:" --default default --no-abort-message </dev/tty)" || return 0
                    ;;
                commit)
                    target="$(prompt --single-line --prompt "Commit ref:" --default HEAD --no-abort-message </dev/tty)" || return 0
                    ;;
            esac
            selection="--${mode}${target:+ ${target}}"
            resolve_review || return 0
            ;;
        *) return 0 ;;
    esac

    run_review "${deep}" "${review_args[@]}"
    case $? in
        0) show_answer ;;
        130) ;;
        *) error "Review failed" ;;
    esac
}

interactive_loop() {
    local action
    local text

    while true; do
        echo 1>&2
        action="$(ask_next)" || return 0
        case "${action}" in
            copy)
                clip "${answer_file}" && echo "Copied to clipboard." 1>&2
                ;;
            followup)
                text="$(ask_followup)" || continue
                [ -n "${text//[[:space:]]/}" ] || continue
                run_followup "${text}"
                case $? in
                    0) show_answer ;;
                    130) ;;
                    *) error "Follow-up failed" ;;
                esac
                ;;
            review)
                review_again
                ;;
            quit)
                return 0
                ;;
        esac
    done
}

# The default branch, as detected by git-default (which reports its own error).
default_branch() {
    command -v git-default >/dev/null 2>&1 || { error "git-default not found (from dev-helpers)"; return 1; }
    git-default
}

# Uncommitted changes win; otherwise a branch is reviewed against the default
# branch, and the default branch itself gets a review of the whole repository.
detect_mode() {
    local branch
    local default

    if [ -n "$(git status --porcelain --untracked-files=normal 2>/dev/null)" ]; then
        mode=uncommitted
        selection="auto-detected, working tree has uncommitted changes"
        return
    fi
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"
    default="$(default_branch)" || return 1
    if [ "${branch}" = "${default}" ]; then
        mode=full
        selection="auto-detected, HEAD on default branch ${default}"
    else
        mode=base
        target="${default}"
        selection="auto-detected, HEAD off default branch ${default}"
    fi
}

resolve_review() {
    local sha

    case "${mode}" in
        full)
            review_args=("${FULL_REVIEW_PROMPT}")
            description="whole repository"
            ;;
        base)
            if [ -z "${target}" ] || [ "${target}" = default ]; then
                target="$(default_branch)" || return 1
            fi
            if ! git rev-parse --verify --quiet "${target}^{commit}" >/dev/null; then
                error "Unknown branch: ${target}"
                return 1
            fi
            review_args=(--base "${target}")
            description="changes against ${target}"
            ;;
        uncommitted)
            review_args=(--uncommitted)
            description="uncommitted changes"
            ;;
        commit)
            if ! sha="$(git rev-parse --verify --quiet "${target:-HEAD}^{commit}")"; then
                error "Unknown commit: ${target}"
                return 1
            fi
            review_args=(--commit "${sha}")
            description="commit $(git rev-parse --short "${sha}")"
            ;;
    esac
}

mode=""
target=""
print=0
standard_profile="${CODEX_REVIEW_PROFILE:-review}"
initial_deep=off
if [ "${standard_profile}" = review-deep ]; then
    standard_profile=review
    initial_deep=on
fi

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --bash-completion)
            shift
            completion "${@}"
            exit 0
            ;;
        -h|--help) usage ;;
        --deep) initial_deep=on ;;
        -p|--print) print=1 ;;
        full|base|uncommitted|commit)
            [ -z "${mode}" ] || fail "Choose one review target"
            mode="${1}"
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            [ "${mode}" = base ] || [ "${mode}" = commit ] || fail "Unexpected argument: ${1}"
            [ -z "${target}" ] || fail "Too many arguments"
            target="${1}"
            ;;
    esac
    shift
done

command -v codex >/dev/null 2>&1 || fail "codex not found"
command -v jq >/dev/null 2>&1 || fail "jq not found"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Not in a Git repository"

# Without a terminal on both ends, there is nobody to answer the menu.
if [ "${print}" -eq 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    print=1
fi
if [ "${print}" -eq 0 ]; then
    command -v prompt-select >/dev/null 2>&1 || fail "prompt-select not found"
    command -v prompt >/dev/null 2>&1 || fail "prompt not found"
    command -v clip >/dev/null 2>&1 || fail "clip not found"
fi

if [ -n "${mode}" ]; then
    selection="--${mode}${target:+ ${target}}"
else
    detect_mode || exit 1
fi

resolve_review || exit 1

work_dir="$(mktemp -d)" || fail "Could not create temporary directory"
trap 'rm -rf "${work_dir}"' EXIT
answer_file="${work_dir}/answer.md"
session_id=""

run_review "${initial_deep}" "${review_args[@]}" || exit $?

if [ "${print}" -eq 1 ]; then
    print_answer
    exit 0
fi

show_answer
interactive_loop

# Local settings use literal key=value lines. Never source a settings file.
local_config_value() {
    local file="${1}" key="${2}"
    [ -r "${file}" ] || return 0
    awk -v key="${key}" '
        index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }
    ' "${file}"
}


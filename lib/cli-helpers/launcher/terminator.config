[global_config]
  borderless = True
  tab_position = hidden
  hide_from_taskbar = True
  always_on_top = True
  inactive_color_offset = 0.8068181818181818
  enabled_plugins = LaunchpadBugURLHandler, LaunchpadCodeURLHandler, APTURLHandler, TerminalShot, MavenPluginURLHandler, ActivityWatch, InactivityWatch, FocusAlpha
  invert_search = True
  link_single_click = True
[keybindings]
  new_tab = <Primary>t
  go_up = <Shift><Alt>Up
  go_down = <Shift><Alt>Down
  go_left = <Shift><Alt>Left
  go_right = <Shift><Alt>Right
  split_horiz = <Primary><Alt>Down
  split_vert = <Primary><Alt>Right
  close_term = <Primary><Alt>d
  page_up_half = <Shift>Page_Up
  page_down_half = <Shift>Page_Down
  reset_clear = <Primary>l
  hide_window = ""
  new_window = <Primary>n
[profiles]
  [[default]]
    icon_bell = False
    background_color = "#32383f"
    background_darkness = 0.41
    cursor_fg_color = "#ffffff"
    cursor_bg_color = "#000000"
    font = Agave Nerd Font Mono 13
    foreground_color = "#d7dde5"
    scrollbar_position = hidden
    scrollback_infinite = True
    palette = "#000000:#cd0000:#00cd00:#cdcd00:#0000ee:#cd00cd:#00cdcd:#e5e5e5:#7f7f7f:#ff0000:#00ff00:#ffff00:#5c5cff:#ff00ff:#00ffff:#ffffff"
    use_system_font = False
    copy_on_selection = True
    title_hide_sizetext = True
    title_transmit_fg_color = "#d7dde5"
    title_transmit_bg_color = "#32383f"
    title_inactive_fg_color = "#9099a5"
    title_inactive_bg_color = "#32383f"
    title_use_system_font = False
    title_font = Sans 17
  [[launcher]]
    icon_bell = False
    background_color = "#f6f5f4"
    background_darkness = 0.95
    background_type = transparent
    cursor_fg_color = "#ffffff"
    cursor_bg_color = "#000000"
    font = Cousine for Powerline 14
    foreground_color = "#000000"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_infinite = True
    palette = "#000000:#cd0000:#00cd00:#cdcd00:#0000ee:#cd00cd:#00cdcd:#e5e5e5:#7f7f7f:#ff0000:#00ff00:#ffff00:#5c5cff:#ff00ff:#00ffff:#ffffff"
    copy_on_selection = True
[layouts]
  [[default]]
    [[[child0]]]
      type = Window
      parent = ""
      order = 0
      maximised = False
      fullscreen = False
      last_active_term = ef7fc29b-2db4-4b72-b238-1e8e0cda40c7
      last_active_window = False
    [[[terminal1]]]
      type = Terminal
      parent = child0
      order = 0
      title = ⌨
      profile = default
      uuid = ef7fc29b-2db4-4b72-b238-1e8e0cda40c7
[plugins]
  [[FocusAlpha]]
    unfocused_alpha = 0.85

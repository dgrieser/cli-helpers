# launcher-terminal: the settings of the launcher's own Ptyxis process
# (GSETTINGS_BACKEND=keyfile), written fresh on every start, so changes made in its
# preferences do not stick. The look comes from launcher/theme, whose values fill
# the @-placeholders.
[org/gnome/Ptyxis]
profile-uuids=['c6190f9e42f345c298e61b3c2c2400a4']
default-profile-uuid='c6190f9e42f345c298e61b3c2c2400a4'
use-system-font=false
font-name='@font@'
scrollbar-policy='never'
interface-style='dark'
audible-bell=false
visual-bell=false
toast-on-copy-clipboard=false
prompt-on-close=false
restore-session=false
restore-window-size=false
# the size of the window in cells, from the theme's width and aspect ratio, as
# nothing resizes it afterwards
default-columns=@columns@
default-rows=@rows@
# the window is found by its title, so programs in it must not change it
ignore-osc-title=true

[org/gnome/Ptyxis/Profiles/c6190f9e42f345c298e61b3c2c2400a4]
label='Launcher'
palette='launcher'
opacity=@opacity@
limit-scrollback=false
exit-action='close'

#!/bin/bash

set -euo pipefail

BUS_NAME="de.david.grieser.CliHelpers.WindowBridge"
OBJECT_PATH="/de/david/grieser/CliHelpers/WindowBridge"
INTERFACE="de.david.grieser.CliHelpers.WindowBridge"
EXTENSION_UUID="cli-helpers-window-bridge@dgrieser.de"
EXTENSION_DIR="${CLI_HELPERS_EXTENSION_DIR:-/usr/local/share/gnome-shell/extensions/${EXTENSION_UUID}}"

usage() {
    echo "usage: $(basename "${0}") <list|active|focus|pointer-monitor|active-monitor|set-above|set-geometry> [argument ...]" 1>&2
    exit 1
}

fail_bridge() {
    cat 1>&2 <<EOF
ERROR: GNOME Wayland window control requires the ${EXTENSION_UUID} GNOME Shell extension.
Install the extension from ${EXTENSION_DIR}, then enable it with:
  gnome-extensions enable ${EXTENSION_UUID}
EOF
    exit 1
}

call_bridge() {
    gdbus call --session \
        --dest "${BUS_NAME}" \
        --object-path "${OBJECT_PATH}" \
        --method "${INTERFACE}.${1}" \
        "${@:2}" 2>/dev/null || fail_bridge
}

unquote_gvariant_string() {
    python3 -c '
import ast
import sys

value = ast.literal_eval(sys.stdin.read())
if isinstance(value, tuple) and len(value) == 1 and isinstance(value[0], str):
    print(value[0])
else:
    sys.exit("ERROR: unexpected GVariant string response")
'
}

call_bridge_string() {
    local output
    output="$(call_bridge "${@}")" || exit 1
    unquote_gvariant_string <<<"${output}"
}

[ "$#" -ge 1 ] || usage

case "${1}" in
    list)
        call_bridge_string ListWindows
        ;;
    active)
        call_bridge_string GetActiveWindow
        ;;
    focus)
        [ "$#" -eq 2 ] || usage
        call_bridge FocusWindow "${2}" >/dev/null
        ;;
    pointer-monitor)
        call_bridge_string GetPointerMonitor
        ;;
    active-monitor)
        call_bridge_string GetActiveWindowMonitor
        ;;
    set-above)
        [ "$#" -eq 2 ] || usage
        call_bridge SetWindowAbove "${2}" >/dev/null
        ;;
    set-geometry)
        [ "$#" -eq 6 ] || usage
        call_bridge SetWindowGeometry "${2}" "${3}" "${4}" "${5}" "${6}" >/dev/null
        ;;
    *)
        usage
        ;;
esac

[Unit]
Description=mittwald Outlook bridge (M365 calendar -> ICS feed, mail -> IMAP)
Documentation=https://github.com/mittwald/mittwald-outlook-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Reads MWOB_* variables (at least MWOB_FEED_TOKEN). %h is your home dir.
EnvironmentFile=%h/.config/mittwald-outlook-bridge/env
# No path: systemd looks in /usr/local/bin (tarball install) before /usr/bin
# (deb/rpm), so the same unit fits both.
ExecStart=mittwald-outlook-bridge serve
Restart=on-failure
RestartSec=10
# Periodically restarting is harmless and keeps the refresh token rolling.

[Install]
WantedBy=default.target

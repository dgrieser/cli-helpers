#!/bin/bash

interface="${1}"
action="${2}"
[ -r /etc/cli-helpers/networkmanager.conf ] || exit 0
. /etc/cli-helpers/networkmanager-functions

profile_pattern="$(dispatcher_value wifi_profile_pattern)"
if [ "${action}" = "up" ] && [[ "${interface}" = wlp* ]] &&
    [[ -n "${profile_pattern}" && "${CONNECTION_ID}" = ${profile_pattern} ]]; then
    /usr/local/bin/set-slack-profile
fi

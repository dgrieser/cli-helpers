#!/bin/bash
# NetworkManager has no setting for the wpa_supplicant bgscan parameters: it
# hardcodes "simple:30:-65:300" for every 802.1X/EAP profile. At desks where the
# corporate BSSes all sit below -65 dBm that makes wpa_supplicant scan every 30 s
# and roam back and forth between two equally weak APs. This re-applies calmer
# parameters on each activation, since NM recreates the network block every time.

interface="${1}"
action="${2}"

BGSCAN='simple:60:-75:600'   # short_interval:signal_threshold:long_interval
# Alternative, scans only the channels this ESS has been seen on:
# BGSCAN='learn:60:-75:600:/var/lib/wpa_supplicant/bgscan-learn-mittwald'

if [ "${action}" = "up" ] && [[ "${interface}" = wlp* ]] && [[ "${CONNECTION_ID}" = Mittwald* ]]; then
    id="$(wpa_cli -i "${interface}" list_networks 2>/dev/null \
          | awk -F'\t' '$4 ~ /CURRENT/ { print $1; exit }')"
    [ -z "${id}" ] && id=0
    wpa_cli -i "${interface}" set_network "${id}" bgscan "\"${BGSCAN}\"" >/dev/null 2>&1 \
        && logger -t wifi-bgscan "set bgscan ${BGSCAN} on ${interface} network ${id}" \
        || logger -t wifi-bgscan "failed to set bgscan on ${interface} network ${id}"
fi

#!/bin/bash

function usage() {
    echo "usage: $(basename "${0}") [--command <command>] [--key-command <command>] [--key-descriptions <key>:<description>,...] [--watch <seconds>] [--columns <comma separated columns>] [--filter-columns <comma separated columns>] [--delimiter <delimiter>] [<query ...>] -- [fzf args]" 1>&2
    exit 1
}

color_settings='bg+:'"${COLOR_SELECTION_BACKGROUND:-238}"',header:'"${COLOR_TABLE_HEADER:-238}"':italic'
color_style="${COLOR_MODE}"

C_HELP=$'\033[90m'      # grey descriptions (matches reminder's help text)
C_KEY=$'\033[38;5;250m' # lighter grey keys
C_RESET=$'\033[0m'

cmd=""
key_cmd=""
declare -A key_desc
args=""
query=""
delimiter='  +'
watch_seconds=0
reverse=1
print_query=0
fzf_bindings='shift-left:change-preview-window(wrap),shift-right:change-preview-window(nowrap)'

while [ $# -gt 0 ]; do
    case "${1}" in
        --columns)
            shift
            [ -z "${1}" ] && usage
            [ -n "${args}" ] && args="${args} "
            args="${args}--with-nth=${1}"
            ;;
        --filter-columns)
            shift
            [ -z "${1}" ] && usage
            [ -n "${args}" ] && args="${args} "
            args="${args}--nth=${1}"
            ;;
        --command)
            shift
            [ -z "${1}" ] && usage
            cmd="${1}"
            print_query=1
            ;;
        --key-command)
            shift
            [ -z "${1}" ] && usage
            key_cmd="${1}"
            print_query=1
            ;;
        --key-descriptions)
            shift
            [ -z "${1}" ] && usage
            IFS=',' read -ra desc_pairs <<< "${1}"
            for desc_pair in "${desc_pairs[@]}"; do
                [[ "${desc_pair}" != *:* ]] && usage
                key_desc["${desc_pair%%:*}"]="${desc_pair#*:}"
            done
            ;;
        --watch)
            shift
            [[ ! "${1}" =~ ^[0-9]+$ ]] && usage
            watch_seconds="${1}"
            ;;
        --delimiter)
            shift
            [ -z "${1}" ] && usage
            delimiter="${1}"
            ;;
        --help)
            usage
            ;;
        --)
            shift
            break
            ;;
        *)
            if [[ "${1}" == -* ]]; then
                break
            else
                [ -n "${query}" ] && query="${query} "
                query="${query}${1}"
            fi
            ;;
    esac
    shift
done

if [ ${print_query} -eq 1 ]; then
    [ -n "${args}" ] && args="${args} "
    args="${args}--print-query"
fi

[ ${watch_seconds} -gt 0 ] && [ -z "${cmd}" ] && echo "ERROR: --watch requires --command" 1>&2 && usage

if [ ${reverse} -eq 1 ]; then
    [ -n "${args}" ] && args="${args} "    
    args="${args}--layout=default"
fi

[ -n "${args}" ] && args="${args} "
args="${args}--bind=${fzf_bindings}"

split_key_spec() {
    # split a bind/expect spec on commas outside parentheses
    echo "${1}" | awk '{
        depth = 0; buf = ""
        for (i = 1; i <= length($0); i++) {
            c = substr($0, i, 1)
            if (c == "(") depth++
            else if (c == ")") depth--
            if (c == "," && depth == 0) { if (buf != "") print buf; buf = "" } else buf = buf c
        }
        if (buf != "") print buf
    }'
}

format_key_entry() {
    local entry="${1}"
    local key="${entry%%:*}"
    if [ -n "${key_desc[${key}]+x}" ]; then
        echo "${C_KEY}${key}${C_HELP} ${key_desc[${key}]}"
    elif [[ "${entry}" != *:* ]]; then
        echo "${C_KEY}${entry}"
    else
        local action="${entry#*:}"
        case "${action}" in
            execute\(*|execute-silent\(*|become\(*)
                local body="${action#*\(}"
                body="${body%)}"
                echo "${C_KEY}${key}${C_HELP} ${body%% *}"
                ;;
            *)
                echo "${C_KEY}${key}${C_HELP} $(echo "${action}" | sed 's/([^)]*)//g')"
                ;;
        esac
    fi
}

collect_keys() {
    local entry
    while read -r entry; do
        format_key_entry "${entry}"
    done < <(split_key_spec "${1}")
}

mapped_keys=""
has_preview=0
prev=""
for arg in "$@"; do
    spec=""
    case "${arg}" in
        --preview|--preview=*)
            # preview-wrap bindings only matter with a preview window
            mapped_keys="${C_KEY}shift-←/→${C_HELP} preview-wrap"$'\n'"${mapped_keys}"
            has_preview=1
            ;;
        --bind=*)
            spec="${arg#--bind=}"
            ;;
        --expect=*)
            spec="${arg#--expect=}"
            ;;
        *)
            case "${prev}" in
                --bind|--expect)
                    spec="${arg}"
                    ;;
            esac
            ;;
    esac
    [ -n "${spec}" ] && mapped_keys="${mapped_keys}"$'\n'"$(collect_keys "${spec}")"
    prev="${arg}"
done
# wrap the key list to the terminal width (footer lines never soft-wrap);
# widths are measured on the entry with its ANSI colors stripped, and fzf
# indents the footer by 2 columns
term_cols="$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)"
[ -z "${term_cols}" ] && term_cols="$(tput cols 2>/dev/null)"
[ -z "${term_cols}" ] && term_cols="${COLUMNS:-80}"
max_line_width=$((term_cols - 4))
# with a preview window the footer only spans the list half of the screen
[ "${has_preview}" -eq 1 ] && max_line_width=$((term_cols / 2 - 4))
keys_header=""
line_width=0
declare -A seen_keys
while IFS= read -r entry; do
    [ -z "${entry}" ] && continue
    [ -n "${seen_keys[${entry}]+x}" ] && continue
    seen_keys["${entry}"]=1
    plain="$(echo "${entry}" | sed $'s/\033\\[[0-9;]*m//g')"
    if [ -z "${keys_header}" ]; then
        keys_header="${entry}"
        line_width=${#plain}
    elif [ $((line_width + 3 + ${#plain})) -le ${max_line_width} ]; then
        keys_header="${keys_header} · ${entry}"
        line_width=$((line_width + 3 + ${#plain}))
    else
        keys_header="${keys_header}"$'\n'"${entry}"
        line_width=${#plain}
    fi
done <<< "${mapped_keys}"
footer_args=()
[ -n "${keys_header}" ] && footer_args=(--footer "${keys_header}${C_RESET}")

update_fzf() {
    local cmd="${1}"
    local port="${2}"
    local seconds="${3}"
    sleep 2
    while true; do
        reload_fzf "${cmd}" "${port}" || break
        sleep "${seconds}"
    done
}

reload_fzf() {
    local cmd="${1}"
    local port="${2}"
    curl -XPOST 127.0.0.1:${port} -d "reload(${cmd})" &> /dev/null
    return ${?}
}

while true; do
    if [ -n "${cmd}" ]; then
        if [ ${watch_seconds} -gt 0 ]; then
            port=$((39000+RANDOM%1000))
            while lsof -nP -i:${port} &> /dev/null; do
                port=$((port+1))
            done
            [ -n "${args}" ] && args="${args} "
            args="${args}--listen=127.0.0.1:${port}"
            update_fzf "${cmd}" "${port}" "${watch_seconds}" &
        fi
        cmd_result="$(${cmd})"
        header="$(echo "${cmd_result}" | head -n 1)"
        result="$(echo "${cmd_result}" | fzf --delimiter "${delimiter}" --ansi --header-lines 1 "${footer_args[@]}" --tabstop 2 --info inline-right --color "${color_style}" --color="${color_settings}" --query="${query}" ${args} "$@")"
        if [ ${print_query} -eq 1 ]; then
            query="$(echo "${result}" | head -n 1)"
            result="$(echo "${result}" | sed '1d')"
        fi
    else
        result="$(fzf --delimiter "${delimiter}" --ansi --header-lines 1 "${footer_args[@]}" --tabstop 2 --info inline-right --color "${color_style}" --color="${color_settings}" --query="${query}" ${args} "$@")"
    fi

    if [ -n "${key_cmd}" ]; then
        # TODO actually store last command exec and pipe back into fzf
        # TODO OR at least add saved header as argument, maybe split key, result and header as individual arguments
        ${key_cmd} "${result}"
        exit_code=$?
        case "${exit_code}" in
            1)
                exit 0
                ;;
           255)
                exit 1
                ;;
        esac
    else
        echo "${result}"
        exit 0
    fi
done

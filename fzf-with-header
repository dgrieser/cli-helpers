#!/bin/bash

function usage() {
    echo "usage: $(basename "${0}") [--command <command>] [--key-command <command>] [--key-descriptions <key>:<description>,...] [--reload-keys <key>,...] [--exec-reload-keys <key>,...] [--silent-keys <key>,...] [--exec-keys <key>,...] [--footer-prefix <command>] [--watch <seconds>] [--watch-delay <seconds>] [--watch-while <command>] [--watch-interval-command <command>] [--columns <comma separated columns>] [--filter-columns <comma separated columns>] [--delimiter <delimiter>] [<query ...>] -- [fzf args]" 1>&2
    exit 1
}

color_settings='bg+:'"${COLOR_SELECTION_BACKGROUND:-238}"',header:'"${COLOR_TABLE_HEADER:-238}"':italic'
color_style="${COLOR_MODE}"

C_HELP=$'\033[90m'      # grey descriptions (matches reminder's help text)
C_KEY=$'\033[38;5;250m' # lighter grey keys
C_RESET=$'\033[0m'

cmd=""
key_cmd=""
# keys handled inside the running fzf instead of ending it: silently or with the
# terminal handed over, each of them with or without a reload of the list
reload_keys=""
exec_reload_keys=""
silent_keys=""
exec_keys=""
msg_file=""
# a command whose output leads the footer, in front of the watch indicator: for
# a caller that has a state of its own to name there
footer_prefix_cmd=""
declare -A key_desc
key_desc_order=()
args=""
query=""
delimiter='  +'
watch_seconds=0
watch_delay=2
watch_while_cmd=""
# a command naming the seconds between two reloads, asked again while watching:
# for a caller whose view changes into one that is worth watching less often
watch_interval_cmd=""
watcher_pid=""
watch_reset_file=""
refresh_key="ctrl-r"
reverse=1
print_query=0
preview_toggle_key="ctrl-p"
preview_width_key="ctrl-g"
# the widths ctrl-g offers on top of the one the caller asked for, which the
# cycle ends on again
preview_widths="70 85 40"
fzf_bindings='shift-left:change-preview-window(wrap),shift-right:change-preview-window(nowrap)'

while [ $# -gt 0 ]; do
    case "${1}" in
        --columns)
            shift
            [ -z "${1}" ] && usage
            [ -n "${args}" ] && args="${args} "
            args="${args}--with-nth=${1}"
            ;;
        --filter-columns)
            shift
            [ -z "${1}" ] && usage
            [ -n "${args}" ] && args="${args} "
            args="${args}--nth=${1}"
            ;;
        --command)
            shift
            [ -z "${1}" ] && usage
            cmd="${1}"
            print_query=1
            ;;
        --key-command)
            shift
            [ -z "${1}" ] && usage
            key_cmd="${1}"
            print_query=1
            ;;
        --key-descriptions)
            shift
            [ -z "${1}" ] && usage
            IFS=',' read -ra desc_pairs <<< "${1}"
            for desc_pair in "${desc_pairs[@]}"; do
                [[ "${desc_pair}" != *:* ]] && usage
                key_desc["${desc_pair%%:*}"]="${desc_pair#*:}"
                key_desc_order+=("${desc_pair%%:*}")
            done
            ;;
        --reload-keys)
            shift
            [ -z "${1}" ] && usage
            reload_keys="${1}"
            ;;
        --exec-reload-keys)
            shift
            [ -z "${1}" ] && usage
            exec_reload_keys="${1}"
            ;;
        --silent-keys)
            shift
            [ -z "${1}" ] && usage
            silent_keys="${1}"
            ;;
        --exec-keys)
            shift
            [ -z "${1}" ] && usage
            exec_keys="${1}"
            ;;
        --footer-prefix)
            shift
            [ -z "${1}" ] && usage
            footer_prefix_cmd="${1}"
            ;;
        --watch)
            shift
            [[ ! "${1}" =~ ^[0-9]+$ ]] && usage
            watch_seconds="${1}"
            ;;
        --watch-delay)
            shift
            [[ ! "${1}" =~ ^[0-9]+$ ]] && usage
            watch_delay="${1}"
            ;;
        --watch-while)
            shift
            [ -z "${1}" ] && usage
            watch_while_cmd="${1}"
            ;;
        --watch-interval-command)
            shift
            [ -z "${1}" ] && usage
            watch_interval_cmd="${1}"
            ;;
        --delimiter)
            shift
            [ -z "${1}" ] && usage
            delimiter="${1}"
            ;;
        --help)
            usage
            ;;
        --)
            shift
            break
            ;;
        *)
            if [[ "${1}" == -* ]]; then
                break
            else
                [ -n "${query}" ] && query="${query} "
                query="${query}${1}"
            fi
            ;;
    esac
    shift
done

if [ ${print_query} -eq 1 ]; then
    [ -n "${args}" ] && args="${args} "
    args="${args}--print-query"
fi

[ ${watch_seconds} -gt 0 ] && [ -z "${cmd}" ] && echo "ERROR: --watch requires --command" 1>&2 && usage
[ -n "${watch_while_cmd}" ] && [ ${watch_seconds} -eq 0 ] && echo "ERROR: --watch-while requires --watch" 1>&2 && usage
[ -n "${watch_interval_cmd}" ] && [ ${watch_seconds} -eq 0 ] && echo "ERROR: --watch-interval-command requires --watch" 1>&2 && usage
inline_keys="${reload_keys}${exec_reload_keys}${silent_keys}${exec_keys}"
[ -n "${inline_keys}" ] && [ -z "${key_cmd}" ] && echo "ERROR: keys handled inside fzf require --key-command" 1>&2 && usage
[ -n "${reload_keys}${exec_reload_keys}" ] && [ -z "${cmd}" ] && echo "ERROR: reloading keys require --command" 1>&2 && usage

# a manual refresh signals the watcher through this file to restart its timer
[ ${watch_seconds} -gt 0 ] && watch_reset_file="${TMPDIR:-/tmp}/fzf-with-header-refresh.$$"
# the same file put into the environment of everything started from inside fzf:
# a key command that ended whatever --watch-while waits for can touch it to put
# the watching back on its interval, instead of the user having to press ctrl-r
[ -n "${watch_reset_file}" ] && export FZF_WITH_HEADER_WATCH_RESET="${watch_reset_file}"

# a silent key runs its command inside fzf, so whatever it writes to stderr is
# collected here instead of the screen and shown as a message above the header
[ -n "${inline_keys}" ] && msg_file="${TMPDIR:-/tmp}/fzf-with-header-message.$$"

if [ ${reverse} -eq 1 ]; then
    [ -n "${args}" ] && args="${args} "    
    args="${args}--layout=default"
fi

[ -n "${args}" ] && args="${args} "
args="${args}--bind=${fzf_bindings}"

split_key_spec() {
    # split a bind/expect spec on commas outside parentheses
    echo "${1}" | awk '{
        depth = 0; buf = ""
        for (i = 1; i <= length($0); i++) {
            c = substr($0, i, 1)
            if (c == "(") depth++
            else if (c == ")") depth--
            if (c == "," && depth == 0) { if (buf != "") print buf; buf = "" } else buf = buf c
        }
        if (buf != "") print buf
    }'
}

format_key_entry() {
    local entry="${1}"
    local key="${entry%%:*}"
    if [ -n "${key_desc[${key}]+x}" ]; then
        printf '%s\t%s\n' "${key}" "${key_desc[${key}]}"
    elif [[ "${entry}" != *:* ]]; then
        printf '%s\t\n' "${entry}"
    else
        local action="${entry#*:}"
        case "${action}" in
            execute\(*|execute-silent\(*|become\(*)
                local body="${action#*\(}"
                body="${body%)}"
                printf '%s\t%s\n' "${key}" "${body%% *}"
                ;;
            *)
                printf '%s\t%s\n' "${key}" "$(echo "${action}" | sed 's/([^)]*)//g')"
                ;;
        esac
    fi
}

collect_keys() {
    local entry
    while read -r entry; do
        format_key_entry "${entry}"
    done < <(split_key_spec "${1}")
}

# extract position and size from a --preview-window spec (other tokens ignored)
preview_pos="right"
preview_size="50"
preview_size_pct=1
parse_preview_window() {
    local toks tok
    IFS=',:' read -ra toks <<< "${1}"
    for tok in "${toks[@]}"; do
        case "${tok}" in
            up|down|left|right)
                preview_pos="${tok}"
                ;;
            [0-9]*%)
                preview_size="${tok%\%}"
                preview_size_pct=1
                ;;
            [0-9]*)
                preview_size="${tok}"
                preview_size_pct=0
                ;;
        esac
    done
}

# with --height the footer has to fit into that window instead of the terminal
height_spec=""
parse_height() {
    local spec="${1#\~}"
    [[ "${spec}" =~ ^[0-9]+%?$ ]] && height_spec="${spec}"
}

# The list is loaded by fzf itself (see the start binding further down), so the
# caller's own start actions have to join that one binding instead of replacing
# it: they are taken out of their --bind arguments here and put back together
# with the reload below. Everything else is passed on untouched.
caller_args=("$@")
passthrough_args=()
caller_start_actions=""
arg_index=0
while [ ${arg_index} -lt ${#caller_args[@]} ]; do
    bind_arg="${caller_args[arg_index]}"
    bind_spec=""
    bind_style=""
    case "${bind_arg}" in
        --bind=*)
            bind_spec="${bind_arg#--bind=}"
            bind_style="inline"
            ;;
        --bind)
            bind_spec="${caller_args[arg_index + 1]}"
            bind_style="pair"
            ;;
    esac
    if [ -n "${bind_spec}" ]; then
        kept_spec=""
        while read -r bind_entry; do
            [ -z "${bind_entry}" ] && continue
            if [[ "${bind_entry}" == start:* ]]; then
                caller_start_actions="${caller_start_actions:+${caller_start_actions}+}${bind_entry#start:}"
            else
                kept_spec="${kept_spec:+${kept_spec},}${bind_entry}"
            fi
        done < <(split_key_spec "${bind_spec}")
        if [ -n "${kept_spec}" ]; then
            if [ "${bind_style}" == "inline" ]; then
                passthrough_args+=("--bind=${kept_spec}")
            else
                passthrough_args+=(--bind "${kept_spec}")
            fi
        fi
        [ "${bind_style}" == "pair" ] && arg_index=$(( arg_index + 1 ))
    else
        passthrough_args+=("${bind_arg}")
    fi
    arg_index=$(( arg_index + 1 ))
done
set -- "${passthrough_args[@]}"

mapped_keys=""
used_keys=""
has_preview=0
prev=""
for arg in "$@"; do
    spec=""
    case "${arg}" in
        --preview|--preview=*)
            has_preview=1
            ;;
        --preview-window=*)
            parse_preview_window "${arg#--preview-window=}"
            ;;
        --height=*)
            parse_height "${arg#--height=}"
            ;;
        --bind=*)
            spec="${arg#--bind=}"
            ;;
        --expect=*)
            spec="${arg#--expect=}"
            ;;
        *)
            case "${prev}" in
                --bind|--expect)
                    spec="${arg}"
                    ;;
                --preview-window)
                    parse_preview_window "${arg}"
                    ;;
                --height)
                    parse_height "${arg}"
                    ;;
            esac
            ;;
    esac
    if [ -n "${spec}" ]; then
        mapped_keys="${mapped_keys}"$'\n'"$(collect_keys "${spec}")"
        used_keys="${used_keys}"$'\n'"$(split_key_spec "${spec}" | sed 's/:.*//')"
    fi
    prev="${arg}"
done

# explicit --key-descriptions: show exactly those keys, in the given order
if [ "${#key_desc_order[@]}" -gt 0 ]; then
    mapped_keys=""
    for desc_key in "${key_desc_order[@]}"; do
        mapped_keys="${mapped_keys}${desc_key}"$'\t'"${key_desc[${desc_key}]}"$'\n'
    done
fi

# keys handled inside the running fzf instead of letting it exit on them and
# starting it again below. The bindings are built further down, once the width a
# message may use is known.
inline_specs=()
collect_inline_keys() {
    local keys="${1}"
    local mode="${2}"
    local do_reload="${3}"
    local key

    [ -z "${keys}" ] && return 0
    while read -r key; do
        [ -z "${key}" ] && continue
        if printf '%s\n' "${used_keys}" | grep -qxF -- "${key}"; then
            echo "ERROR: key '${key}' is handled inside fzf and bound as well (--bind/--expect)" 1>&2
            exit 1
        fi
        used_keys="${used_keys}"$'\n'"${key}"
        inline_specs+=("${key}"$'\t'"${mode}"$'\t'"${do_reload}")
        # a caller without --key-descriptions still gets the key into the footer
        [ "${#key_desc_order[@]}" -eq 0 ] && mapped_keys="${mapped_keys}"$'\n'"${key}"$'\t'
    done < <(split_key_spec "${keys}")
}

collect_inline_keys "${reload_keys}" silent 1
collect_inline_keys "${exec_reload_keys}" exec 1
collect_inline_keys "${silent_keys}" silent 0
collect_inline_keys "${exec_keys}" exec 0

# the preview-wrap bindings are always added, so they belong in the footer
# whenever there is a preview window - including the --key-descriptions case,
# which rebuilds the list from the caller's keys alone. The preview is toggled
# on top of that, unless the caller uses that key for something else
preview_toggle_bind_args=()
preview_width_bind_args=()
if [ "${has_preview}" -eq 1 ]; then
    # the width is cycled by one binding: fzf walks through the specs of a
    # change-preview-window separated by "|", and the empty one at the end is the
    # window the caller asked for, with whatever else it had in it
    if ! printf '%s\n' "${used_keys}" | grep -qxF -- "${preview_width_key}"; then
        width_spec=""
        for preview_width in ${preview_widths}; do
            [ "${preview_size_pct}" -eq 1 ] && [ "${preview_width}" == "${preview_size}" ] && continue
            width_spec="${width_spec}${width_spec:+|}${preview_pos},${preview_width}%"
        done
        if [ -n "${width_spec}" ]; then
            preview_width_bind_args=(--bind "${preview_width_key}:change-preview-window(${width_spec}|)")
            used_keys="${used_keys}"$'\n'"${preview_width_key}"
            mapped_keys="${preview_width_key}"$'\t'"width"$'\n'"${mapped_keys}"
        fi
    fi
    if ! printf '%s\n' "${used_keys}" | grep -qxF -- "${preview_toggle_key}"; then
        preview_toggle_bind_args=(--bind "${preview_toggle_key}:toggle-preview")
        used_keys="${used_keys}"$'\n'"${preview_toggle_key}"
        mapped_keys="${preview_toggle_key}"$'\t'"preview"$'\n'"${mapped_keys}"
    fi
    mapped_keys="shift ←/→"$'\t'"wrap"$'\n'"${mapped_keys}"
fi

# any --command view can be reloaded on demand; leave the key alone if the
# caller already uses it for something else
refresh_bind_args=()
if [ -n "${cmd}" ] && [ -z "${key_desc[${refresh_key}]+x}" ] &&
   ! printf '%s\n' "${used_keys}" | grep -qxF -- "${refresh_key}"; then
    refresh_action="reload(${cmd})"
    # the manual reload already happened, the watcher only restarts its timer
    [ -n "${watch_reset_file}" ] && refresh_action="${refresh_action}+execute-silent(touch '${watch_reset_file}')"
    refresh_bind_args=(--bind "${refresh_key}:${refresh_action}")
    mapped_keys="${mapped_keys}"$'\n'"${refresh_key}"$'\t'"↻"
fi

# merge keys sharing a description: "alt-+ stage" + "insert stage" -> "alt-+/insert stage"
mapped_keys="$(echo "${mapped_keys}" | awk 'BEGIN { FS = OFS = "\t" }
    $1 == "" { next }
    seen[$0]++ { next }
    $2 != "" && ($2 in slot) { keys[slot[$2]] = keys[slot[$2]] "/" $1; next }
    { n++; keys[n] = $1; descs[n] = $2; if ($2 != "") slot[$2] = n }
    END { for (i = 1; i <= n; i++) print keys[i], descs[i] }')"
# wrap the key list to the terminal width (footer lines never soft-wrap);
# widths are measured on the entry with its ANSI colors stripped, and fzf
# indents the footer by 2 columns
term_cols="$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)"
[ -z "${term_cols}" ] && term_cols="$(tput cols 2>/dev/null)"
[ -z "${term_cols}" ] && term_cols="${COLUMNS:-80}"
max_line_width=$((term_cols - 4))
# a left/right preview window shrinks the footer to the list pane; up/down
# previews leave the full width
if [ "${has_preview}" -eq 1 ]; then
    case "${preview_pos}" in
        left|right)
            if [ "${preview_size_pct}" -eq 1 ]; then
                list_cols=$(( term_cols * (100 - preview_size) / 100 ))
            else
                list_cols=$(( term_cols - preview_size ))
            fi
            max_line_width=$(( list_cols - 4 ))
            ;;
    esac
fi
[ "${max_line_width}" -lt 10 ] && max_line_width=10

# the bindings for the keys handled inside fzf: run the key command with the same
# payload an --expect exit would have produced (the key on the first line, the
# selected line on the second), then reload the list if the key changed anything.
#
# A silent key keeps the screen, so its stderr is collected and shown above the
# header until the next key wipes it; an exec key gets the terminal handed over
# and shows whatever it wants itself. fzf's stdout is the command substitution
# around it, so a silent key command must not write there.
#
# fzf keeps the cursor on its index across a reload and fires the load event
# again, so the cursor is put back on the first entry unless the caller positions
# it on load itself.
inline_bind_args=()
cursor_action="+first"
printf '%s\n' "${used_keys}" | grep -qxF -- "load" && cursor_action=""
show_message="transform-header:m=\$(tail -n 3 '${msg_file}' 2>/dev/null); [ -n \"\${m}\" ] && printf '%s\n' \"\${m}\" | fold -s -w ${max_line_width} | awk '{printf \"\033[31m%s\033[0m\n\", \$0}'"
for spec in "${inline_specs[@]}"; do
    IFS=$'\t' read -r inline_key inline_mode inline_reload <<< "${spec}"
    payload="\"\$(printf '%s\n%s' '${inline_key}' {})\""
    if [ "${inline_mode}" == "exec" ]; then
        # the terminal is handed over, so stdout goes to it as well: fzf would
        # pass on its own, which is the command substitution around it, and a
        # command that pages only when it talks to a terminal would not page
        # (the message of a previous key is gone once the screen was handed over)
        action="execute(${key_cmd} ${payload} >/dev/tty; : > '${msg_file}')"
    else
        action="execute-silent(${key_cmd} ${payload} >/dev/null 2>'${msg_file}')"
    fi
    if [ "${inline_reload}" -eq 1 ]; then
        action="${action}+reload-sync(${cmd})${cursor_action}"
        # the list is up to date now, so the watcher restarts its interval
        [ -n "${watch_reset_file}" ] && action="${action}+execute-silent(touch '${watch_reset_file}')"
    fi
    action="${action}+${show_message}"
    inline_bind_args+=(--bind "${inline_key}:${action}")
done

# with --watch the key list is led by a "↻ <n>s" indicator naming the reload
# interval; reserve its widest form so the wrapping stays put when it changes
footer_ind_sep=""
watch_indicator=0
ind_width=0
if [ ${watch_seconds} -gt 0 ]; then
    watch_indicator=1
    ind_text="${watch_seconds}s"
    [ ${watch_delay} -gt ${watch_seconds} ] && ind_text="${watch_delay}s"
    # an interval command may name a wider one right away; a later change simply
    # rewraps the footer
    if [ -n "${watch_interval_cmd}" ]; then
        watch_interval_start="$(${watch_interval_cmd} 2>/dev/null)"
        [[ "${watch_interval_start}" =~ ^[0-9]+$ ]] &&
            [ ${#watch_interval_start} -gt $(( ${#ind_text} - 1 )) ] && ind_text="${watch_interval_start}s"
    fi
    ind_width=$(( 2 + ${#ind_text} ))
    # "↻ off" is shown once watching stopped
    [ ${ind_width} -lt 5 ] && ind_width=5
fi

# a footer prefix leads the indicator, so both take their room out of the first
# footer line; the width is measured on what the command prints right now, with
# its colors stripped, and a later prefix of another width simply wraps as it
# comes out
prefix_width=0
if [ -n "${footer_prefix_cmd}" ]; then
    footer_prefix_text="$(${footer_prefix_cmd} 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')"
    [ -n "${footer_prefix_text}" ] && prefix_width=$(( ${#footer_prefix_text} + 3 ))
fi
# what leads the keys of the footer: the prefix, the indicator, or both
lead_width=$(( ind_width + prefix_width ))

# how many footer lines the terminal can spare
term_lines="$(stty size </dev/tty 2>/dev/null | cut -d' ' -f1)"
[ -z "${term_lines}" ] && term_lines="$(tput lines 2>/dev/null)"
[ -z "${term_lines}" ] && term_lines="${LINES:-24}"
window_lines="${term_lines}"
if [ -n "${height_spec}" ]; then
    if [ "${height_spec}" != "${height_spec%\%}" ]; then
        window_lines=$(( term_lines * ${height_spec%\%} / 100 ))
        # a percentage never shrinks the window below fzf's --min-height
        [ "${window_lines}" -lt 10 ] && window_lines=10
    else
        window_lines="${height_spec}"
    fi
    [ "${window_lines}" -gt "${term_lines}" ] && window_lines="${term_lines}"
fi
# fzf spends three lines on the header, its separator and the prompt, and one
# more on the border above the footer
avail_lines=$(( window_lines - 4 ))
# an up/down preview eats list lines as well; a left/right one does not
if [ "${has_preview}" -eq 1 ]; then
    case "${preview_pos}" in
        up|down)
            if [ "${preview_size_pct}" -eq 1 ]; then
                avail_lines=$(( avail_lines - window_lines * preview_size / 100 ))
            else
                # plus the two lines of the preview border
                avail_lines=$(( avail_lines - preview_size - 2 ))
            fi
            ;;
    esac
fi
# whatever the footer would like, the list keeps at least this many rows
min_list_lines=3
max_footer_lines=$(( avail_lines - min_list_lines ))

entry_texts=()
entry_widths=()
while IFS=$'\t' read -r entry_key entry_desc; do
    [ -z "${entry_key}" ] && continue
    if [ -n "${entry_desc}" ]; then
        entry_texts+=("${C_KEY}${entry_key}${C_HELP} ${entry_desc}")
        entry_widths+=($(( ${#entry_key} + 1 + ${#entry_desc} )))
    else
        entry_texts+=("${C_KEY}${entry_key}")
        entry_widths+=("${#entry_key}")
    fi
done <<< "${mapped_keys}"

# every footer line is a line the list does not get, so on a short terminal the
# keys are packed into fewer lines and the ones that no longer fit are dropped
# behind a "…"
pack_keys_header() {
    local max_lines="${1}"
    local i lines=1 line_width=${lead_width} entry_width limit
    keys_header=""
    footer_ind_sep=""
    for (( i = 0; i < ${#entry_texts[@]}; i++ )); do
        entry_width="${entry_widths[i]}"
        # the last line still has to fit the "…" marker
        limit=${max_line_width}
        [ ${lines} -ge ${max_lines} ] && limit=$(( max_line_width - 2 ))
        if [ -z "${keys_header}" ] && [ ${lead_width} -eq 0 ]; then
            keys_header="${entry_texts[i]}"
            line_width=${entry_width}
        elif [ $((line_width + 3 + entry_width)) -le ${limit} ]; then
            if [ -z "${keys_header}" ]; then
                # the prefix or the indicator holds the first slot of the line
                footer_ind_sep=" · "
                keys_header="${entry_texts[i]}"
            else
                keys_header="${keys_header} · ${entry_texts[i]}"
            fi
            line_width=$((line_width + 3 + entry_width))
        elif [ ${lines} -lt ${max_lines} ]; then
            if [ -z "${keys_header}" ]; then
                footer_ind_sep=$'\n'
                keys_header="${entry_texts[i]}"
            else
                keys_header="${keys_header}"$'\n'"${entry_texts[i]}"
            fi
            line_width=${entry_width}
            lines=$((lines + 1))
        else
            [ -z "${keys_header}" ] && [ ${lead_width} -gt 0 ] && footer_ind_sep=" "
            keys_header="${keys_header}${C_HELP}…"
            break
        fi
    done
}

footer_enabled=1
if [ ${max_footer_lines} -lt 1 ]; then
    # not even one line to spare: the list needs every row it can get
    footer_enabled=0
    keys_header=""
else
    pack_keys_header ${max_footer_lines}
fi

# everything of the footer but the prefix, which is asked for separately because
# it is the one part that changes without the footer being rebuilt here
build_footer_rest() {
    local indicator="${1}"
    local lead=""

    if [ ${watch_indicator} -eq 1 ] && [ -n "${indicator}" ]; then
        # the prefix took the first slot, so the indicator follows it
        [ -n "${footer_prefix_cmd}" ] && lead="${C_HELP} · "
        lead="${lead}${C_HELP}↻ ${indicator}"
    fi
    if [ -z "${lead}" ] && [ -z "${footer_prefix_cmd}" ]; then
        printf '%s' "${keys_header}${C_RESET}"
    else
        # the separator carries the color of the descriptions, so a prefix that
        # ends its own colors does not leave it in whatever comes next
        printf '%s' "${lead}${C_HELP}${footer_ind_sep}${keys_header}${C_RESET}"
    fi
}

build_footer() {
    local indicator="${1}"

    [ -n "${footer_prefix_cmd}" ] && printf '%s' "$(${footer_prefix_cmd} 2>/dev/null)"
    build_footer_rest "${indicator}"
}

# until the first reload the wait is the delay, afterwards the interval
if [ ${watch_delay} -gt 0 ]; then
    initial_indicator="${watch_delay}s"
else
    initial_indicator="${watch_seconds}s"
fi

# fzf is started with nothing to show and fetches the list on its start event, so
# the picker is on the screen while the command is still running instead of after
# it. Whatever the caller wanted to do on start follows the reload.
start_bind_args=()
if [ -n "${cmd}" ]; then
    start_action="reload(${cmd})"
    [ -n "${caller_start_actions}" ] && start_action="${start_action}+${caller_start_actions}"
    start_bind_args=(--bind "start:${start_action}")
elif [ -n "${caller_start_actions}" ]; then
    start_bind_args=(--bind "start:${caller_start_actions}")
fi

footer_args=()
if [ ${footer_enabled} -eq 1 ] && { [ -n "${keys_header}" ] || [ ${watch_indicator} -eq 1 ] || [ -n "${footer_prefix_cmd}" ]; }; then
    [ ${watch_indicator} -eq 0 ] && initial_indicator=""
    footer_args=(--footer "$(build_footer "${initial_indicator}")")
fi

# A prefix names something the caller changes while the picker runs, so waiting
# for the next watch interval to show it would be too late. Every reload fires
# the load event, and every key that changes the prefix reloads, so the footer is
# put together again there: the prefix is asked for anew and the rest is read
# back from a file the watcher keeps up to date - it is the only part that
# changes without a reload.
footer_refresh_bind_args=()
footer_rest_file=""
if [ -n "${footer_prefix_cmd}" ] && [ ${footer_enabled} -eq 1 ] && [ -n "${cmd}" ] &&
   ! printf '%s\n' "${used_keys}" | grep -qxF -- "load"; then
    footer_rest_file="${TMPDIR:-/tmp}/fzf-with-header-footer.$$"
    build_footer_rest "${initial_indicator}" > "${footer_rest_file}"
    footer_refresh_bind_args=(--bind "load:transform-footer(printf '%s%s' \"\$(${footer_prefix_cmd})\" \"\$(cat '${footer_rest_file}')\")")
fi

update_fzf() {
    local cmd="${1}"
    local port="${2}"
    local seconds="${3}"
    local remaining="${watch_delay}"
    local first=1
    local idle=0
    rm -f "${watch_reset_file}"
    # fzf is started after this watcher, so give it a moment to open its port
    [ ${remaining} -eq 0 ] && sleep 1
    while true; do
        # reloading stopped, but a manual refresh may bring the watched state
        # back: wait for one and put the watching back on its interval - the
        # condition is checked at the end of that interval, by which time the
        # reload of the refresh has updated whatever it looks at
        if [ ${idle} -eq 1 ]; then
            while [ ! -e "${watch_reset_file}" ]; do
                sleep 1
            done
            rm -f "${watch_reset_file}"
            idle=0
            remaining="${seconds}"
            post_footer "${port}" "${seconds}s"
            continue
        fi
        # counted down in steps instead of one sleep, so a manual refresh can
        # restart the wait; the indicator only names the interval, so no redraw
        while [ ${remaining} -gt 0 ]; do
            sleep 1
            remaining=$(( remaining - 1 ))
            # a manual refresh reloaded already, so only the timer restarts
            if [ -e "${watch_reset_file}" ]; then
                rm -f "${watch_reset_file}"
                remaining="${seconds}"
            fi
            # an interval named while the wait is running counts from here, so a
            # view that just became a slow one is not reloaded once more first
            if [ -n "${watch_interval_cmd}" ]; then
                new_seconds="$(${watch_interval_cmd} 2>/dev/null)"
                if [[ "${new_seconds}" =~ ^[0-9]+$ ]] && [ "${new_seconds}" -gt 0 ] &&
                   [ "${new_seconds}" -ne "${seconds}" ]; then
                    seconds="${new_seconds}"
                    remaining="${seconds}"
                    post_footer "${port}" "${seconds}s"
                fi
            fi
        done
        # the first reload always happens; the condition only decides whether
        # to keep going, so a state the command reports after that reload counts
        if [ ${first} -eq 0 ] && [ -n "${watch_while_cmd}" ] && ! ${watch_while_cmd} >/dev/null 2>&1; then
            post_footer "${port}" "off"
            idle=1
            continue
        fi
        reload_fzf "${cmd}" "${port}" || break
        # the delay only applies before the first reload; a footer prefix is
        # posted after every reload instead, because only the command behind it
        # knows whether it still says the same
        if [ ${first} -eq 1 ] && [ "${initial_indicator}" != "${seconds}s" ]; then
            post_footer "${port}" "${seconds}s"
        elif [ -n "${footer_prefix_cmd}" ]; then
            post_footer "${port}" "${seconds}s"
        fi
        first=0
        remaining="${seconds}"
    done
}

post_footer() {
    local port="${1}"
    local indicator="${2}"
    # no footer was shown in the first place
    [ ${footer_enabled} -eq 0 ] && return 0
    # the load event puts the footer together again from this file, so it has to
    # know the indicator the watcher is showing right now
    [ -n "${footer_rest_file}" ] && build_footer_rest "${indicator}" > "${footer_rest_file}"
    # --data-binary keeps the newlines of a wrapped footer intact
    curl -XPOST 127.0.0.1:${port} --data-binary "change-footer($(build_footer "${indicator}"))" &> /dev/null
    return 0
}

reload_fzf() {
    local cmd="${1}"
    local port="${2}"
    curl -XPOST 127.0.0.1:${port} -d "reload(${cmd})" &> /dev/null
    return ${?}
}

stop_watcher() {
    [ -n "${watch_reset_file}" ] && rm -f "${watch_reset_file}"
    [ -z "${watcher_pid}" ] && return 0
    kill "${watcher_pid}" &> /dev/null
    watcher_pid=""
}

cleanup() {
    stop_watcher
    [ -n "${msg_file}" ] && rm -f "${msg_file}"
    [ -n "${footer_rest_file}" ] && rm -f "${footer_rest_file}"
    return 0
}

trap cleanup EXIT

while true; do
    # a message left over from the previous round must not reappear
    [ -n "${msg_file}" ] && : > "${msg_file}"
    if [ -n "${cmd}" ]; then
        # a fresh listen port per round, so restarts after a key command do not
        # reuse the port of an fzf that is already gone
        listen_arg=""
        if [ ${watch_seconds} -gt 0 ]; then
            port=$((39000+RANDOM%1000))
            while lsof -nP -i:${port} &> /dev/null; do
                port=$((port+1))
            done
            listen_arg="--listen=127.0.0.1:${port}"
            update_fzf "${cmd}" "${port}" "${watch_seconds}" &
            watcher_pid=$!
        fi
        result="$(fzf --delimiter "${delimiter}" --ansi --header-lines 1 "${footer_args[@]}" "${start_bind_args[@]}" "${footer_refresh_bind_args[@]}" "${preview_toggle_bind_args[@]}" "${preview_width_bind_args[@]}" "${refresh_bind_args[@]}" "${inline_bind_args[@]}" --tabstop 2 --info inline-right --color "${color_style}" --color="${color_settings}" --query="${query}" ${args} ${listen_arg} "$@" < /dev/null)"
        stop_watcher
        if [ ${print_query} -eq 1 ]; then
            query="$(echo "${result}" | head -n 1)"
            result="$(echo "${result}" | sed '1d')"
        fi
    else
        result="$(fzf --delimiter "${delimiter}" --ansi --header-lines 1 "${footer_args[@]}" "${start_bind_args[@]}" "${preview_toggle_bind_args[@]}" "${preview_width_bind_args[@]}" "${inline_bind_args[@]}" --tabstop 2 --info inline-right --color "${color_style}" --color="${color_settings}" --query="${query}" ${args} "$@")"
    fi

    if [ -n "${key_cmd}" ]; then
        # TODO actually store last command exec and pipe back into fzf
        # TODO OR at least add saved header as argument, maybe split key, result and header as individual arguments
        # the query is what the list was narrowed down to when the key was
        # pressed, so a key command that wants to show what was on the screen
        # can filter by it the same way
        FZF_WITH_HEADER_QUERY="${query}" ${key_cmd} "${result}"
        exit_code=$?
        case "${exit_code}" in
            1)
                exit 0
                ;;
           255)
                exit 1
                ;;
        esac
    else
        echo "${result}"
        exit 0
    fi
done

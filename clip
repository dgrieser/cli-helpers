#!/bin/bash
APP_NAME="$(basename "${0}")"
SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"
if [ -f "${SCRIPT_DIR}/lib/cli-helpers/lib-clipboard" ]; then
    . "${SCRIPT_DIR}/lib/cli-helpers/lib-clipboard"
elif [ -f "${SCRIPT_DIR}/lib-clipboard" ]; then
    . "${SCRIPT_DIR}/lib-clipboard"
else
    . "${CLI_HELPERS_LIBDIR:-/usr/local/lib/cli-helpers}/lib-clipboard"
fi

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [--print] [-c|--clipboard|-p|--primary] [-n|--no-newline] [-s|--secret] [-t|--timeout SECONDS] [-H|--history-only] [<file, or stdin>]

Copies text from a file or stdin into the clipboard and records it in the
history of clip-history. A secret is never recorded, and it is taken out of the
clipboard again after a timeout (clip-secret is clip --secret).

Options:
  --print                  Also print the copied text
  -c, --clipboard          Copy to the clipboard only (default: clipboard and primary)
  -p, --primary            Copy to the primary selection only
  -n, --no-newline         Strip all newline and carriage return characters
  -H, --history-only       Only record the text in the history, leave the
                           clipboard as it is
  -s, --secret             Do not record the text, clear it after the timeout
                           (what the clipboard held before comes back)
  -t, --timeout SECONDS    Timeout of a secret, 0 keeps it (default: ${CLIP_SECRET_TIMEOUT:-30},
                           CLIP_SECRET_TIMEOUT); implies --secret
  -h, --help               Show this help message and exit

Environment:
  CLIP_HISTORY=0           Do not record anything
  CLIP_SECRET_RESTORE=0    Only clear a secret, do not restore what was before
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

PRINT=0
FILE=""
CLIPBOARD="both"
SKIP_NEWLINE=0
SECRET=0
HISTORY_ONLY=0
[ "${APP_NAME}" = "clip-secret" ] && SECRET=1
TIMEOUT="${CLIP_SECRET_TIMEOUT:-30}"

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        --print)
            PRINT=1
            ;;
        -c|--clipboard)
            CLIPBOARD="clipboard"
            ;;
        -p|--primary)
            CLIPBOARD="primary"
            ;;
        -n|--no-newline)
            SKIP_NEWLINE=1
            ;;
        -H|--history-only)
            HISTORY_ONLY=1
            ;;
        -s|--secret)
            SECRET=1
            ;;
        -t|--timeout)
            shift
            [ -z "${1}" ] && usage
            TIMEOUT="${1}"
            SECRET=1
            ;;
        *)
            if [ -z "${FILE}" ]; then
                FILE="${1}"
            else
                error "Unexpected argument '${1}'"
                usage
            fi
            ;;
    esac
    shift
done

[[ "${TIMEOUT}" =~ ^[0-9]+$ ]] || fail "Timeout '${TIMEOUT}' is no number of seconds"
if [ "${HISTORY_ONLY}" -eq 1 ]; then
    [ "${SECRET}" -eq 1 ] && fail "--history-only cannot record a secret"
    [ "${CLIPBOARD}" != "both" ] && fail "--history-only does not copy into a selection"
    [ "${CLIP_HISTORY:-1}" = "0" ] && warning "CLIP_HISTORY=0, so nothing is recorded"
fi
[ "${FILE}" = "-" ] && FILE=""
[ -n "${FILE}" ] && [ ! -f "${FILE}" ] && fail "File '${FILE}' does not exist"

STAGE_FILE=""
trap '[ -n "${STAGE_FILE}" ] && rm -f "${STAGE_FILE}"' EXIT

# the text to copy in a file of its own, in tmpfs: a secret never lands on disk
stage_file() {
    local dir

    dir="$(cli_helpers_clip_runtime_dir)" || return 1
    STAGE_FILE="$(mktemp "${dir}/stage.XXXXXX")" || return 1
}

# clears the secret marked as ID after the timeout, in a session of its own, so
# it still runs once the terminal it was copied in is closed
schedule_clear() {
    local id="${1}"
    local clip_clear="${SCRIPT_DIR}/clip-clear"

    [ -x "${clip_clear}" ] || clip_clear="clip-clear"
    setsid -f "${clip_clear}" --secret "${id}" --after "${TIMEOUT}" < /dev/null &>/dev/null
}

# prints a file (tmpfs) with the text the clipboard holds now, for clip-clear to
# put back once the secret expires; when that is a secret too, still waiting to
# expire, the text it replaced instead, so that an expired secret never comes
# back; prints nothing when there is nothing to keep
read_previous() {
    local dir
    local file
    local previous_id
    local earlier_file

    dir="$(cli_helpers_clip_runtime_dir)" || return 0
    file="$(mktemp "${dir}/previous.XXXXXX")" || return 0
    cli_helpers_clipboard_read clipboard > "${file}"
    if previous_id="$(cli_helpers_clip_secret_find "$(cli_helpers_clip_hash "${file}")")"; then
        earlier_file="$(cli_helpers_clip_secret_previous "${previous_id}")"
        if [ -s "${earlier_file}" ]; then
            cp -f "${earlier_file}" "${file}"
        else
            : > "${file}"
        fi
    fi
    if [ -s "${file}" ]; then
        echo "${file}"
    else
        rm -f "${file}"
    fi
}

# keeps the text of PREVIOUS_FILE as what the clipboard held before the secret ID
keep_previous() {
    local id="${1}"
    local previous_file="${2}"
    local target

    if target="$(cli_helpers_clip_secret_previous "${id}")" &&
        (umask 077 && mkdir -p "${target%/*}") && mv -f "${previous_file}" "${target}"; then
        return 0
    fi
    rm -f "${previous_file}"
    return 1
}

copy_file() {
    local input_file="${1}"
    local hash
    local id=""
    local previous_file=""

    if [ "${HISTORY_ONLY}" -eq 1 ]; then
        cli_helpers_clip_history_add "${input_file}" || return 1
        [ "${PRINT}" -eq 1 ] && cat "${input_file}"
        return 0
    fi
    if [ "${SECRET}" -eq 1 ]; then
        hash="$(cli_helpers_clip_hash "${input_file}")" || return 1
        # read before the secret is marked, so it is never mistaken for an
        # earlier copy of the same secret
        if [ "${TIMEOUT}" -gt 0 ] && [ "${CLIPBOARD}" != "primary" ]; then
            previous_file="$(read_previous)"
        fi
        # marked before it reaches the clipboard, so that nothing records it
        id="$(cli_helpers_clip_secret_mark "${hash}")" || {
            [ -n "${previous_file}" ] && rm -f "${previous_file}"
            fail "Cannot mark the secret"
        }
        [ -n "${previous_file}" ] && keep_previous "${id}" "${previous_file}"
        cli_helpers_clip_history_remove "${hash}"
    fi
    if ! cli_helpers_clipboard_write "${CLIPBOARD}" "${input_file}"; then
        [ -n "${id}" ] && cli_helpers_clip_secret_unmark "${id}"
        return 1
    fi
    if [ "${SECRET}" -eq 0 ]; then
        cli_helpers_clip_history_add "${input_file}"
    elif [ "${TIMEOUT}" -gt 0 ]; then
        schedule_clear "${id}"
    fi

    [ "${PRINT}" -eq 1 ] && cat "${input_file}"
    return 0
}

# the input as it is, or without its line breaks
read_input() {
    if [ "${SKIP_NEWLINE}" -eq 1 ]; then
        tr -d '\r\n'
    else
        cat -
    fi
}

# read from file
if [ -n "${FILE}" ]; then
    if [ "${SKIP_NEWLINE}" -eq 1 ]; then
        stage_file || fail "Cannot stage the text to copy"
        read_input < "${FILE}" > "${STAGE_FILE}"
        FILE="${STAGE_FILE}"
    fi
    copy_file "${FILE}" || exit 1
    exit 0
fi

# read from stdin if available
if [ -p /dev/stdin ]; then
    stage_file || fail "Cannot stage the text to copy"
    read_input > "${STAGE_FILE}"
    copy_file "${STAGE_FILE}"
    exit "${?}"
fi

usage

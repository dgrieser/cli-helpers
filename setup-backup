#!/bin/bash
# Backs up on the old machine every file setup.sh asks for on the new one: the
# keyring files, the reminders, the shell histories, the Keys folder of the
# documents folder with the SSH keys the SSH config names and the private
# scripts of ~/bin (gen, which dials the VPN, and .power with .in and .out).
# Before the keyring files are copied it offers to store the current SSH config in the keyring, so setup.sh
# restores that one and not an older copy.

APP_NAME="$(basename "${0}")"
# the prompts and keyring-cli next to it, so it also runs from the repo before
# cli-helpers is installed
BIN_DIR="$(cd "$(dirname "${0}")" && pwd)"

KEYRING_DIR="${HOME}/.local/share/keyrings"
REMINDER_DIR="${HOME}/.cache/reminder"
# the history files of bash_aliases.d's install-home
HISTORY_FILES=(.bash_super_history .kube_history)
SSH_CONFIG="${HOME}/.ssh/config"
HOME_BIN="${HOME}/bin"
# the private scripts of ~/bin that are not in this public repo: setup.sh dials
# the VPN with gen before the glab login, and .power runs ssh with the password
# that .in reads and .out closes
HOME_BIN_FILES=(gen .power .in .out)

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [-h] [FOLDER]

Back up every file setup.sh asks for on a new machine into a new folder
setup-backup-<host>-<date> in FOLDER (asked for when not given):

  keyrings/     the keyring files of ${KEYRING_DIR}, with the SSH keys,
                the SSH config and the network connections stored in them
                (setup.sh: "Keyring file or folder")
  reminder/     the reminders of ${REMINDER_DIR}
                (setup.sh: "Reminder folder or archive")
  history/      ${HISTORY_FILES[*]}
                (setup.sh, dotfiles: "Path of a backup of ~/...")
  Keys/         the Keys folder of the documents folder, plus the SSH keys
                ~/.ssh/config names that are in neither it nor the keyring
                (setup.sh, dotfiles: copy them to Documents/Keys)
  bin/          ${HOME_BIN_FILES[*]} of ${HOME_BIN}
                (setup.sh: "Backup of ~/bin")

The backup holds private keys and the keyring files: keep it somewhere safe.

Options:
  -h, --help    Show this help message and exit
EOF
    exit 1
}

info() {
    echo 1>&2
    echo -e "\033[1m${1}\033[0m" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    echo "ERROR: ${1}" 1>&2
    exit 1
}

failed=()

# a prompt aborted with Ctrl-C (exit 130) aborts the whole backup
ask() {
    "${BIN_DIR}/prompt-yes-no" "${1}"
    local status="${?}"
    [ "${status}" -eq 130 ] && { echo 1>&2; fail "Aborted"; }
    return "${status}"
}

# the SSH config in the keyring is what setup.sh restores, so an outdated one is
# offered to be replaced before the keyring files are copied
store_ssh_config() {
    local stored
    [ -f "${SSH_CONFIG}" ] || return 0
    command -v secret-tool > /dev/null 2>&1 || return 0
    stored="$(secret-tool lookup type ssh-config name config 2>/dev/null)"
    [ "${stored}" = "$(cat "${SSH_CONFIG}")" ] && return 0
    if [ -z "${stored}" ]; then
        info "The SSH config is not stored in the keyring"
    else
        info "The SSH config in the keyring differs from ${SSH_CONFIG}"
    fi
    ask "Store ${SSH_CONFIG} in the keyring (keyring-cli ssh-config-store)?" || return 0
    "${BIN_DIR}/keyring-cli" ssh-config-store --overwrite "${SSH_CONFIG}" || failed+=("keyring-cli ssh-config-store")
}

backup_keyrings() {
    local target="${1}/keyrings" files=()
    mapfile -t files < <(find "${KEYRING_DIR}" -maxdepth 1 -type f -name '*.keyring' 2>/dev/null | sort)
    if [ "${#files[@]}" -eq 0 ]; then
        warning "No keyring files in ${KEYRING_DIR}"
        failed+=("keyrings")
        return 0
    fi
    if ! { mkdir -p "${target}" && cp -p "${files[@]}" "${target}/"; }; then
        failed+=("keyrings")
        return 0
    fi
    echo "keyrings: ${#files[@]} files" 1>&2
}

backup_reminders() {
    local target="${1}/reminder"
    if ! compgen -G "${REMINDER_DIR}/*.md*" > /dev/null; then
        echo "reminder: none" 1>&2
        return 0
    fi
    # -a keeps the modification times, which order the reminders without an order
    cp -a "${REMINDER_DIR}" "${target}" || { failed+=("reminder"); return 0; }
    echo "reminder: $(find "${target}" -maxdepth 1 -type f -name '*.md' | wc -l) open," \
        "$(find "${target}" -maxdepth 1 -type f -name '*.md_*' | wc -l) done" 1>&2
}

backup_histories() {
    local target="${1}/history" name
    for name in "${HISTORY_FILES[@]}"; do
        [ -f "${HOME}/${name}" ] || continue
        mkdir -p "${target}" && cp -p "${HOME}/${name}" "${target}/${name}" \
            && echo "history: ${name}" 1>&2 || failed+=("history ${name}")
    done
}

# the Keys folder of the documents folder, whole: the dotfiles link the SSH keys
# of the SSH config from there, and it holds other keys and tokens too; then
# the keys of the SSH config that are in neither it nor the keyring, as
# setup.sh restores only the stored ones
backup_keys() {
    local target="${1}/Keys" keys_dir name key count
    local -A stored=()
    keys_dir="$(xdg-user-dir DOCUMENTS 2>/dev/null || echo "${HOME}/Documents")/Keys"
    if [ -d "${keys_dir}" ]; then
        # editor swap files are no keys
        if ! { mkdir -p "${target}" \
            && find "${keys_dir}" -mindepth 1 -maxdepth 1 ! -name '.*.sw?' \
                -exec cp -a -t "${target}" {} +; }; then
            failed+=("Keys ${keys_dir}")
        fi
        count="$(find "${target}" -type f | wc -l)"
        echo "Keys: ${count} files of ${keys_dir}" 1>&2
    fi

    [ -f "${SSH_CONFIG}" ] || return 0
    while read -r name _; do
        stored["${name}"]=1
    done < <("${BIN_DIR}/keyring-cli" ssh-list 2>/dev/null | tail -n +2)
    while read -r name; do
        [ -n "${stored[${name}]:-}" ] && continue
        [ -e "${target}/${name}" ] && continue
        key="${HOME}/.ssh/${name}"
        if [ ! -f "${key}" ]; then
            warning "The SSH config names ~/.ssh/${name}, which does not exist"
            continue
        fi
        if ! { mkdir -p "${target}" && cp -pL "${key}" "${target}/${name}"; }; then
            failed+=("Keys ${name}")
            continue
        fi
        [ -f "${key}.pub" ] && cp -pL "${key}.pub" "${target}/${name}.pub"
        echo "Keys: ${name} of ~/.ssh, in neither ${keys_dir} nor the keyring" 1>&2
    done < <(awk 'tolower($1) == "identityfile" && $2 ~ /^~\/\.ssh\/[^\/]+$/ {print substr($2, 8)}' "${SSH_CONFIG}" | sort -u)
}

backup_bin() {
    local target="${1}/bin" name
    local -a files=()
    for name in "${HOME_BIN_FILES[@]}"; do
        if [ -f "${HOME_BIN}/${name}" ]; then
            files+=("${HOME_BIN}/${name}")
        else
            warning "No ${HOME_BIN}/${name}"
        fi
    done
    [ "${#files[@]}" -eq 0 ] && return 0
    # -L: a link is backed up as the file it points to
    if ! { mkdir -p "${target}" && cp -pL "${files[@]}" "${target}/"; }; then
        failed+=("bin")
        return 0
    fi
    echo "bin: ${#files[@]} files of ${HOME_BIN}" 1>&2
}

folder=""
while [ $# -gt 0 ]; do
    case "${1}" in
        -h|--help) usage ;;
        -*)        echo "ERROR: Unknown option ${1}" 1>&2; usage ;;
        *)         [ -n "${folder}" ] && usage; folder="${1}" ;;
    esac
    shift
done

if [ -z "${folder}" ]; then
    [ -t 0 ] || fail "No FOLDER given and no terminal to ask for one"
    folder="$("${BIN_DIR}/prompt-folder" "Folder to store the backup in:")"
    [ -z "${folder}" ] && fail "No folder given"
fi
folder="${folder/#\~/${HOME}}"
[ -d "${folder}" ] || fail "No such folder: ${folder}"

[ -t 0 ] && store_ssh_config

backup="${folder%/}/setup-backup-$(hostname -s)-$(date +%Y%m%d-%H%M%S)"
umask 077
mkdir "${backup}" || fail "Cannot create ${backup}"
info "Backing up to ${backup}"
backup_keyrings "${backup}"
backup_reminders "${backup}"
backup_histories "${backup}"
backup_keys "${backup}"
backup_bin "${backup}"

if [ "${#failed[@]}" -gt 0 ]; then
    info "Done, but these failed:"
    printf '  %s\n' "${failed[@]}" 1>&2
    exit 1
fi
info "Done, it holds private keys and the keyring files: keep it somewhere safe"
echo "${backup}"

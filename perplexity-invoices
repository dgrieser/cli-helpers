import urllib.parse
import urllib.request

APP_NAME = os.path.basename(sys.argv[0])
BASE_URL = "https://www.perplexity.ai"
INVOICES_PATH = "/rest/stripe/customer-invoices"
API_QUERY = {"version": "2.18", "source": "default"}
# the login: one __Secure-pplx.session.<account id> per account, the older
# next-auth cookie only on some logins
SESSION_PREFIX = "__Secure-pplx.session."
SESSION_COOKIE = "__Secure-next-auth.session-token"
LAST_ACCOUNT_COOKIE = "__Host-pplx-last-active-account"
DEFAULT_USER_DATA_DIR = os.path.expanduser("~/.config/google-chrome")
DEFAULT_PROFILE = "Default"
DEFAULT_LOGIN_TIMEOUT = 300
LOGIN_POLL_SECONDS = 3

TOOL = "perplexity-invoices"
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
EMAIL_CONFIG = os.path.join(CONFIG_HOME, TOOL, "email.json")
SENT_STATE = os.path.join(STATE_HOME, TOOL, "sent.json")
# the settings of bahn-probonio-bot are offered as defaults of a first setup
OTHER_EMAIL_CONFIGS = [os.path.join(CONFIG_HOME, "bahn-probonio-bot", "email.json")]
KEYRING_SERVICE = TOOL
PASSWORD_KEY = "smtp-password"
SECURITY_MODES = ["starttls", "tls", "opportunistic", "none"]
DEFAULT_PREFIX = f"[{TOOL}]"
DEFAULT_FROM_NAME = TOOL
SMTP_TIMEOUT = 60
ADDRESS_RE = re.compile(r'^[^\s@<>()",;:]+@[^\s@<>()",;:]+\.[^\s@<>()",;:]+$')
# common providers, the same presets as bahn-probonio-bot
PRESETS = [
    ("Gmail", "smtp.gmail.com", 587, "starttls",
     "Needs an app password (Google account > Security > App passwords)."),
    ("Outlook.com / Hotmail", "smtp-mail.outlook.com", 587, "starttls", ""),
    ("Microsoft 365", "smtp.office365.com", 587, "starttls", "SMTP AUTH must be enabled for the mailbox."),
    ("iCloud", "smtp.mail.me.com", 587, "starttls", "Needs an app-specific password."),
    ("GMX", "mail.gmx.net", 587, "starttls", "Enable POP3/IMAP/SMTP access in the GMX settings."),
    ("WEB.DE", "smtp.web.de", 587, "starttls", "Enable POP3/IMAP/SMTP access in the WEB.DE settings."),
    ("T-Online", "securesmtp.t-online.de", 465, "tls", "Uses the separate e-mail password."),
    ("mailbox.org", "smtp.mailbox.org", 465, "tls", ""),
    ("Posteo", "posteo.de", 587, "starttls", ""),

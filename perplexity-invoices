#!/usr/bin/env python3
"""List and download the invoices (Rechnungen) of a perplexity.ai subscription.

The invoices come from the same API the settings page of perplexity.ai uses
(/rest/stripe/customer-invoices), the PDFs from Stripe. The login is the one of
Google Chrome: its cookies of perplexity.ai are read from the profile and
decrypted with the key Chrome keeps in the keyring (Chrome Safe Storage).
Cloudflare only lets requests through with Chrome's cf_clearance cookie and
the user agent of the same Chrome, so both are sent along.
"""
import argparse
import datetime
import glob
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

APP_NAME = os.path.basename(sys.argv[0])
BASE_URL = "https://www.perplexity.ai"
INVOICES_PATH = "/rest/stripe/customer-invoices"
API_QUERY = {"version": "2.18", "source": "default"}
# the login: one __Secure-pplx.session.<account id> per account, the older
# next-auth cookie only on some logins
SESSION_PREFIX = "__Secure-pplx.session."
SESSION_COOKIE = "__Secure-next-auth.session-token"
LAST_ACCOUNT_COOKIE = "__Host-pplx-last-active-account"
DEFAULT_USER_DATA_DIR = os.path.expanduser("~/.config/google-chrome")
DEFAULT_PROFILE = "Default"
DEFAULT_LOGIN_TIMEOUT = 300
LOGIN_POLL_SECONDS = 3


def log(message):
    print(message, file=sys.stderr)


def warning(message):
    log(f"WARNING: {message}")


def fail(message):
    log(f"ERROR: {message}")
    sys.exit(1)


def downloads_dir():
    """The user's Downloads folder (XDG), ~/Downloads without xdg-user-dir."""
    try:
        result = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True,
                                check=False)
        path = result.stdout.strip()
    except FileNotFoundError:
        path = ""
    return path or os.path.expanduser("~/Downloads")


def chrome_key(user_data_dir):
    """Key of the v11 cookies: PBKDF2 of the password Chrome stores in the keyring."""
    from cryptography.hazmat.primitives import hashes
    from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC

    application = "chromium" if "chromium" in os.path.basename(user_data_dir.rstrip("/")) else "chrome"
    try:
        result = subprocess.run(["secret-tool", "lookup", "application", application],
                                capture_output=True, check=False)
    except FileNotFoundError:
        fail("secret-tool not found (package libsecret-tools)")
    password = result.stdout.strip()
    if not password:
        fail(f"No key of Chrome in the keyring (secret-tool lookup application {application})")
    kdf = PBKDF2HMAC(algorithm=hashes.SHA1(), length=16, salt=b"saltysalt", iterations=1)
    return kdf.derive(password)


def decrypt(value, key, strip_hash):
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

    prefix = value[:3]
    if prefix not in (b"v10", b"v11"):
        return value.decode("utf-8", "replace")
    if prefix == b"v10":
        # v10 cookies use a fixed password, when Chrome runs without a keyring
        from cryptography.hazmat.primitives import hashes
        from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
        key = PBKDF2HMAC(algorithm=hashes.SHA1(), length=16, salt=b"saltysalt",
                         iterations=1).derive(b"peanuts")
    decryptor = Cipher(algorithms.AES(key), modes.CBC(b" " * 16)).decryptor()
    plain = decryptor.update(value[3:]) + decryptor.finalize()
    plain = plain[:-plain[-1]]
    # since database version 24 the value starts with the SHA-256 of the host
    if strip_hash:
        plain = plain[32:]
    return plain.decode("utf-8")


def read_cookies(user_data_dir, profile, key=None):
    """Cookies of perplexity.ai of the Chrome profile as {name: value}."""
    db = os.path.join(user_data_dir, profile, "Cookies")
    if not os.path.isfile(db):
        fail(f"No cookie database of Chrome: {db}")
    # copy it, together with its journal, so a running Chrome is not disturbed
    with tempfile.TemporaryDirectory(prefix=f"{APP_NAME}-") as tmp:
        for path in glob.glob(glob.escape(db) + "*"):
            if path in (db, db + "-journal", db + "-wal"):
                shutil.copy2(path, tmp)
        connection = sqlite3.connect(os.path.join(tmp, "Cookies"))
        try:
            version = connection.execute("SELECT value FROM meta WHERE key = 'version'").fetchone()
            rows = connection.execute(
                "SELECT name, value, encrypted_value, host_key FROM cookies "
                "WHERE host_key IN ('.perplexity.ai', 'www.perplexity.ai', '.www.perplexity.ai') "
                "ORDER BY length(host_key)").fetchall()
        finally:
            connection.close()
    strip_hash = version is not None and int(version[0]) >= 24
    cookies = {}
    for name, value, encrypted, _host in rows:
        if not value and encrypted:
            if key is None:
                key = chrome_key(user_data_dir)
            try:
                value = decrypt(encrypted, key, strip_hash)
            except (ValueError, UnicodeDecodeError):
                warning(f"Cannot decrypt the cookie {name}, skipped")
                continue
        cookies[name] = value
    return cookies, key


def session(cookies):
    """(account id or None, session token or None) of the login in the cookies."""
    accounts = [name[len(SESSION_PREFIX):] for name in cookies if name.startswith(SESSION_PREFIX)]
    if accounts:
        account = cookies.get(LAST_ACCOUNT_COOKIE)
        if account not in accounts:
            account = accounts[0]
        return account, cookies[SESSION_PREFIX + account]
    return None, cookies.get(SESSION_COOKIE)


def user_agent(user_data_dir):
    """The user agent of the Chrome the cf_clearance cookie was issued to."""
    major = "0"
    try:
        with open(os.path.join(user_data_dir, "Last Version"), encoding="utf-8") as file:
            major = file.read().strip().split(".")[0]
    except OSError:
        warning("No 'Last Version' in the Chrome folder, Cloudflare may refuse the requests")
    return (f"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
            f"Chrome/{major}.0.0.0 Safari/537.36")


class Client:
    def __init__(self, user_data_dir, profile):
        cookies, _key = read_cookies(user_data_dir, profile)
        self.account, token = session(cookies)
        if not token:
            fail(f"Not logged in to perplexity.ai in the Chrome profile '{profile}', run: {APP_NAME} login")
        self.cookie = "; ".join(f"{name}={value}" for name, value in cookies.items())
        self.user_agent = user_agent(user_data_dir)

    def get_json(self, path, query):
        url = f"{BASE_URL}{path}?{urllib.parse.urlencode({**query, **API_QUERY})}"
        request = urllib.request.Request(url, headers={
            "Accept": "application/json",
            "Cookie": self.cookie,
            "User-Agent": self.user_agent,
            "Referer": f"{BASE_URL}/",
            # the API picks the account of the session cookie by this header
            **({"x-pplx-account": self.account} if self.account else {}),
        })
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            body = error.read(2000).decode("utf-8", "replace")
            if error.code == 403 and "Just a moment" in body:
                fail("Cloudflare refused the request: open https://www.perplexity.ai in Chrome "
                     "once to renew its check, then try again")
            if error.code in (401, 403):
                fail(f"perplexity.ai refused the login (HTTP {error.code}), run: {APP_NAME} login")
            fail(f"HTTP {error.code} from {path}: {body[:200]}")
        except urllib.error.URLError as error:
            fail(f"Cannot reach perplexity.ai: {error.reason}")

    def invoices(self, since=None):
        """All invoices, newest first; stops paging at the first one older than since."""
        result = []
        starting_after = None
        while True:
            query = {"starting_after": starting_after} if starting_after else {}
            page = self.get_json(INVOICES_PATH, query)
            invoices = page.get("invoices") or []
            for invoice in invoices:
                if since is not None and invoice["created_ts"] < since:
                    return result
                result.append(invoice)
            if not page.get("has_more") or not invoices:
                return result
            starting_after = invoices[-1]["invoice_id"]


def invoice_date(invoice):
    return datetime.datetime.fromtimestamp(invoice["created_ts"]).strftime("%Y-%m-%d")


def invoice_amount(invoice):
    return f"{invoice['amount_cents'] / 100:.2f} {invoice['currency'].upper()}"


def invoice_filename(invoice):
    return f"perplexity-{invoice_date(invoice)}-{invoice['invoice_id']}.pdf"


def parse_since(value):
    try:
        return int(datetime.datetime.strptime(value, "%Y-%m-%d").timestamp())
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a date YYYY-MM-DD: {value}")


def command_list(args):
    invoices = Client(args.user_data_dir, args.profile).invoices(args.since)
    if args.json:
        print(json.dumps(invoices, indent=2))
        return
    for invoice in invoices:
        print("\t".join([invoice_date(invoice), invoice["invoice_id"], invoice_amount(invoice),
                         invoice["status"]]))


def download(url, target):
    request = urllib.request.Request(url, headers={"User-Agent": f"{APP_NAME}"})
    partial = target + ".part"
    try:
        with urllib.request.urlopen(request, timeout=60) as response, open(partial, "wb") as file:
            shutil.copyfileobj(response, file)
    except (urllib.error.URLError, OSError) as error:
        if os.path.exists(partial):
            os.remove(partial)
        raise RuntimeError(str(getattr(error, "reason", error)))
    with open(partial, "rb") as file:
        if file.read(5) != b"%PDF-":
            os.remove(partial)
            raise RuntimeError("the response is not a PDF")
    os.replace(partial, target)


def command_download(args):
    invoices = Client(args.user_data_dir, args.profile).invoices(args.since)
    if args.output is None:
        args.output = downloads_dir()
    os.makedirs(args.output, exist_ok=True)
    failed = 0
    for invoice in invoices:
        url = invoice.get("invoice_pdf")
        if not url:
            warning(f"No PDF for the invoice {invoice['invoice_id']} ({invoice['status']}), skipped")
            continue
        target = os.path.join(args.output, invoice_filename(invoice))
        if os.path.exists(target) and not args.force:
            log(f"Exists: {target}")
            continue
        try:
            download(url, target)
        except RuntimeError as error:
            log(f"ERROR: Download of {invoice['invoice_id']} failed: {error}")
            failed += 1
            continue
        print(target)
    if failed:
        sys.exit(1)


def command_login(args):
    cookies, key = read_cookies(args.user_data_dir, args.profile)
    _account, old_session = session(cookies)
    if old_session and not args.force:
        log("Already logged in to perplexity.ai in Chrome (--force opens the login anyway)")
        return
    profile_arg = f"--profile-directory={args.profile}"
    browser = "chromium" if "chromium" in os.path.basename(args.user_data_dir.rstrip("/")) else "google-chrome"
    try:
        subprocess.Popen([browser, profile_arg, f"{BASE_URL}/"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except FileNotFoundError:
        fail(f"{browser} not found")
    log(f"Log in to perplexity.ai in Chrome, waiting up to {args.timeout}s for the login ...")
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        time.sleep(LOGIN_POLL_SECONDS)
        cookies, key = read_cookies(args.user_data_dir, args.profile, key)
        _account, token = session(cookies)
        if token and token != old_session:
            log("Logged in")
            return
    fail("No login within the timeout (Chrome writes its cookies to disk with a delay, try again)")


def main():
    parser = argparse.ArgumentParser(
        prog=APP_NAME,
        description="List and download the invoices (Rechnungen) of a perplexity.ai subscription, "
                    "with the login of Google Chrome.",
        epilog=f"examples:\n  {APP_NAME} login\n  {APP_NAME} list\n"
               f"  {APP_NAME} download -o ~/Documents/Rechnungen --since 2026-01-01",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--profile", default=DEFAULT_PROFILE,
                        help=f"Chrome profile folder (default {DEFAULT_PROFILE})")
    parser.add_argument("--user-data-dir", default=DEFAULT_USER_DATA_DIR,
                        help=f"Chrome user data folder (default {DEFAULT_USER_DATA_DIR})")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND")

    list_parser = commands.add_parser("list", help="list the invoices, newest first (default)")
    list_parser.add_argument("--since", type=parse_since, metavar="YYYY-MM-DD",
                             help="only invoices from this date on")
    list_parser.add_argument("--json", action="store_true", help="print the invoices as JSON")
    list_parser.set_defaults(func=command_list)

    download_parser = commands.add_parser(
        "download", help="download the invoices as PDF, perplexity-<date>-<invoice id>.pdf")
    download_parser.add_argument("-o", "--output", default=None,
                                 help="folder for the PDFs (default: the Downloads folder)")
    download_parser.add_argument("--since", type=parse_since, metavar="YYYY-MM-DD",
                                 help="only invoices from this date on")
    download_parser.add_argument("-f", "--force", action="store_true",
                                 help="download again PDFs that are already there")
    download_parser.set_defaults(func=command_download)

    login_parser = commands.add_parser(
        "login", help="open perplexity.ai in Chrome and wait until you logged in")
    login_parser.add_argument("-t", "--timeout", type=int, default=DEFAULT_LOGIN_TIMEOUT,
                              help=f"seconds to wait for the login (default {DEFAULT_LOGIN_TIMEOUT})")
    login_parser.add_argument("-f", "--force", action="store_true",
                              help="open the login even when already logged in")
    login_parser.set_defaults(func=command_login)

    args = parser.parse_args()
    if args.command is None:
        args = parser.parse_args(sys.argv[1:] + ["list"])
    try:
        args.func(args)
    except KeyboardInterrupt:
        log("Abort.")
        sys.exit(1)
    except ImportError:
        fail("Python module cryptography not found (package python3-cryptography)")


if __name__ == "__main__":
    main()

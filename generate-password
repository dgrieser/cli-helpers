#!/bin/bash

APP_NAME="$(basename "${0}")"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS]

Generate a random password.

Options:
  -h, --help            Print this help message.
  -l, --length LENGTH   The length of the password to generate, default: 12
  -L, --lower COUNT     Require COUNT lowercase letters, default: auto
  -U, --upper COUNT     Require COUNT uppercase letters, default: auto
  -d, --digits COUNT    Require COUNT digits, default: auto
  -s, --special COUNT   Require COUNT special characters, default: auto
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

check_command() {
    local cmd="${1}"; shift
    command -v "${cmd}" >/dev/null 2>&1 || fail "${cmd} is not installed"
}

validate_count() {
    local name="${1}"
    local value="${2}"

    [ -z "${value}" ] && error "${name} must not be empty" && usage
    [[ ! "${value}" =~ ^[0-9]+$ ]] && fail "${name} must be a number"
}

random_chars() {
    local chars="${1}"
    local count="${2}"
    local chars_length="${#chars}"
    local threshold=$((256 - (256 % chars_length)))
    local result=""
    local hex byte index i

    while [ "${#result}" -lt "${count}" ]; do
        hex="$(openssl rand -hex "${count}")"
        for ((i = 0; i < ${#hex} && ${#result} < count; i += 2)); do
            byte=$((16#${hex:i:2}))
            [ "${byte}" -ge "${threshold}" ] && continue
            index=$((byte % chars_length))
            result+="${chars:index:1}"
        done
    done

    printf '%s' "${result}"
}

extract_chars() {
    local pool="${1}"
    local chars="${2}"
    local count="${3}"
    local result=""
    local char i

    for ((i = 0; i < ${#pool} && ${#result} < count; i++)); do
        char="${pool:i:1}"
        [[ "${chars}" == *"${char}"* ]] && result+="${char}"
    done

    [ "${#result}" -eq "${count}" ] || return 1
    printf '%s' "${result}"
}

shuffle_chars() {
    local input="${1}"
    local output=""
    local index

    while [ "${#input}" -gt 0 ]; do
        index="$(random_number "${#input}")"
        output+="${input:index:1}"
        input="${input:0:index}${input:index+1}"
    done

    printf '%s' "${output}"
}

random_number() {
    local max="${1}"
    local threshold=$((256 - (256 % max)))
    local hex byte

    while true; do
        hex="$(openssl rand -hex 1)"
        byte=$((16#${hex}))
        [ "${byte}" -lt "${threshold}" ] && printf '%s' "$((byte % max))" && return
    done
}

length=12
lower_count=""
upper_count=""
digit_count=""
special_count=""
custom_counts=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h | --help)
            usage
            ;;
        -l|--length)
            shift
            [ -z "${1}" ] && error "length must not be empty" && usage
            [[ ! "${1}" =~ ^[0-9]+$ ]] && fail "length must be a number"
            [[ "${1}" -le 0 ]] && fail "length must be greater than 0"
            length="${1}"
            ;;
        -L|--lower)
            shift
            validate_count "lower count" "${1}"
            lower_count="${1}"
            custom_counts=1
            ;;
        -U|--upper)
            shift
            validate_count "upper count" "${1}"
            upper_count="${1}"
            custom_counts=1
            ;;
        -d|--digits)
            shift
            validate_count "digit count" "${1}"
            digit_count="${1}"
            custom_counts=1
            ;;
        -s|--special)
            shift
            validate_count "special count" "${1}"
            special_count="${1}"
            custom_counts=1
            ;;
        *)
            usage
            ;;
    esac
    shift
done

check_command openssl

lower_chars="abcdefghijklmnopqrstuvwxyz"
upper_chars="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
digit_chars="0123456789"
special_chars='!@#$%^&*()-_=+[]{};:,.<>/?'
all_chars="${lower_chars}${upper_chars}${digit_chars}${special_chars}"

if [ "${custom_counts}" -eq 0 ]; then
    base_count=$((length / 4))
    remainder=$((length % 4))
    lower_count="${base_count}"
    upper_count="${base_count}"
    digit_count="${base_count}"
    special_count="${base_count}"
    [ "${remainder}" -ge 1 ] && lower_count=$((lower_count + 1))
    [ "${remainder}" -ge 2 ] && upper_count=$((upper_count + 1))
    [ "${remainder}" -ge 3 ] && digit_count=$((digit_count + 1))
else
    lower_count="${lower_count:-0}"
    upper_count="${upper_count:-0}"
    digit_count="${digit_count:-0}"
    special_count="${special_count:-0}"
fi

required_count=$((lower_count + upper_count + digit_count + special_count))
[ "${required_count}" -gt "${length}" ] && fail "character counts must not exceed length"

pool_length=$((length * 10))
password=""

for attempt in {1..20}; do
    pool="$(random_chars "${all_chars}" "${pool_length}")"
    lower_password="$(extract_chars "${pool}" "${lower_chars}" "${lower_count}")" || continue
    upper_password="$(extract_chars "${pool}" "${upper_chars}" "${upper_count}")" || continue
    digit_password="$(extract_chars "${pool}" "${digit_chars}" "${digit_count}")" || continue
    special_password="$(extract_chars "${pool}" "${special_chars}" "${special_count}")" || continue
    remaining_password="$(extract_chars "${pool}" "${all_chars}" "$((length - required_count))")" || continue
    password="${lower_password}${upper_password}${digit_password}${special_password}${remaining_password}"
    break
done

[ -z "${password}" ] && fail "could not extract requested character mix"

shuffle_chars "${password}"
echo 1>&2
exit 0

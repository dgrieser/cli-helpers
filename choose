#!/bin/bash

# Thin wrapper around "prompt --select", kept for callers that pass their items
# as one newline separated string.

usage() {
    echo "usage: $(basename ${0}) [-p|--prompt <prompt>] [-n|--newlines] <list of choices>" 1>&2
    exit 1
}

NL=$'\n'
prompt="Choose from list"
items=""
newlines=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        -p|--prompt)
            shift
            [ -z "${1}" ] && usage
            prompt="${1}"
            ;;
        -n|--newlines)
            newlines=1
            ;;
        *)
            if [ -z "${items}" ]; then
                items="${1}"
            else
                items="${items}${NL}${1}"
            fi
            ;;
    esac
    shift
done

[ -z "${items}" ] && usage

[ "${newlines}" -eq 1 ] && echo 1>&2
choice="$(printf '%s\n' "${items}" | prompt-select --delimiter '' --prompt "${prompt}")"
status=${?}
[ "${status}" -ne 0 ] && exit "${status}"
[ "${newlines}" -eq 1 ] && echo 1>&2
echo "${choice}"

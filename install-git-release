#!/bin/bash

APP_NAME="$(basename "${0}")"


function usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] PROJECT

    PROJECT
        Name or URL of the project to install

    Options:
        -h, --help          Display this help and exit

        -p, --pattern       Pattern of the artifact to install. {arch} stands
                            for each name of the architecture (amd64, x86_64,
                            x64, ...), one pattern per name.
                            Default: Linux builds for the architecture

        -a, --arch          Architecture to install for (amd64, arm64, armhf,
                            armel, i386 or a uname -m name like armv7l)
                            Default: the userland's, from dpkg or uname -m

        -x, --exclude       Pattern of artifacts to exclude. Neither gh nor
                            glab can exclude, so this is applied after the
                            download and to the files inside an archive.
                            May be given multiple times.

        -r, --release       Release tag to install
                            Default: latest release

        -b, --binary        Pattern of the binary to install

        -n, --name          Name to install the final binary as
                            Default: original binary name

        -i, --install-path  Path to install the binary
                            Default: /usr/local/bin

        --bundle            Install archive as bundled app

        --bundle-path       Path to install bundled app contents
                            Default: /usr/local/share

        -c, --post-install  Command to run after a successful install, with
                            the working directory set to the unpacked archive
                            contents (the downloaded file's directory for a
                            plain binary). May be given multiple times.
                            Env: INSTALL_PATH, BINARY_NAME, BINARY_PATH,
                            ARTIFACT, UNPACK_DIR

        -y, --yes           Answer yes to all prompts

        -d, --dry-run       Perform a trial run with no changes made

        --bash-completion   Print completion candidates and exit

    Exit status 4: the release has no build for the architecture.
EOF
    exit 1
}

function completion() {
    local previous="${1}"
    local project=""
    local argument=""
    local skip_next=0

    if [ "${previous}" != "-r" ] && [ "${previous}" != "--release" ]; then
        echo "-h --help -p --pattern -a --arch -x --exclude -r --release -b --binary -n --name -i --install-path --bundle --bundle-path -c --post-install -y --yes -d --dry-run"
        return
    fi
    shift

    # Find the positional project argument. Completion is intentionally limited
    # to an explicit repository so it never starts an interactive git-search.
    for argument in "${@}"; do
        if [ "${skip_next}" -eq 1 ]; then
            skip_next=0
            continue
        fi
        case "${argument}" in
            -p|--pattern|-a|--arch|-x|--exclude|-r|--release|-i|--install-path|--bundle-path|-b|--binary|-n|--name|-c|--post-install)
                skip_next=1
                ;;
            -*)
                ;;
            *)
                project="${argument}"
                ;;
        esac
    done

    [ -z "${project}" ] && return

    case "${project}" in
        https://gitlab.com/*|http://gitlab.com/*|gitlab.com/*)
            project="${project#http://}"
            project="${project#https://}"
            project="${project#gitlab.com/}"
            project="${project%.git}"
            glab release list --repo "${project}" --per-page 100 | awk 'NR > 1 { print $1 }'
            ;;
        https://github.com/*|http://github.com/*|github.com/*|*/*)
            project="${project#http://}"
            project="${project#https://}"
            project="${project#github.com/}"
            project="${project%.git}"
            gh release list --repo "${project}" --limit 100 --json tagName --jq '.[].tagName'
            ;;
    esac
}

function error() {
    echo "ERROR: ${1}" 1>&2
}

function fail() {
    error "${1}"
    cleanup
    exit 1
}

# fail_no_build MESSAGE: the release is not built for the architecture, which
# is exit status 4, so a caller can skip it
function fail_no_build() {
    error "${1}"
    cleanup
    exit 4
}

function abort() {
    echo "Abort." 1>&2
    cleanup
    exit 1
}

function success() {
    echo "Done" 1>&2
    cleanup
    exit 0
}

# api_curl PROJECT ARGS...: curl for the REST API of the project's host; public
# projects need no login, a token from the environment is used if set
# (GH_TOKEN/GITHUB_TOKEN, GITLAB_TOKEN)
function api_curl() {
    local project="${1}"; shift
    local curl_args=( "-fsSL" )
    local token="${GITLAB_TOKEN}"
    if [[ "${project}" == "https://github.com/"* ]]; then
        token="${GH_TOKEN:-${GITHUB_TOKEN}}"
        [ -n "${token}" ] && curl_args+=( "-H" "Authorization: Bearer ${token}" )
    else
        [ -n "${token}" ] && curl_args+=( "-H" "PRIVATE-TOKEN: ${token}" )
    fi
    curl "${curl_args[@]}" "${@}"
}

# release_assets PROJECT: the name and download URL of each asset of the
# release, tab-separated, from the REST API
function release_assets() {
    local project="${1}"
    local api_url
    local release_json
    local assets

    command -v curl &> /dev/null || { error "curl is required to download without gh or glab"; return 1; }
    command -v jq &> /dev/null || { error "jq is required to download without gh or glab"; return 1; }

    if [[ "${project}" == "https://github.com/"* ]]; then
        local repo="${project#https://github.com/}"
        repo="${repo%/}"
        repo="${repo%.git}"
        api_url="https://api.github.com/repos/${repo}/releases/latest"
        [ -n "${RELEASE}" ] && api_url="https://api.github.com/repos/${repo}/releases/tags/${RELEASE}"
        release_json="$(api_curl "${project}" "${api_url}")" || { error "Failed to get the release from ${api_url}"; return 1; }
        assets="$(echo "${release_json}" | jq -r '.assets[] | [.name, .browser_download_url] | @tsv')"
    else
        local host
        local path
        host="$(echo "${project}" | cut -d/ -f1-3)"
        path="${project#"${host}"/}"
        path="${path%/}"
        path="${path%.git}"
        api_url="${host}/api/v4/projects/$(jq -rn --arg path "${path}" '$path | @uri')/releases/permalink/latest"
        [ -n "${RELEASE}" ] && api_url="${host}/api/v4/projects/$(jq -rn --arg path "${path}" '$path | @uri')/releases/$(jq -rn --arg tag "${RELEASE}" '$tag | @uri')"
        release_json="$(api_curl "${project}" "${api_url}")" || { error "Failed to get the release from ${api_url}"; return 1; }
        assets="$(echo "${release_json}" | jq -r '.assets.links[] | [.name, (.direct_asset_url // .url)] | @tsv')"
    fi
    echo "${assets}"
}

# downloads the release assets matching the patterns through the REST API, for
# when gh or glab is missing or fails
function download_with_api() {
    local project="${1}"
    local assets
    local name
    local url
    local pattern
    local downloaded=0

    assets="$(release_assets "${project}")" || return 1

    while IFS=$'\t' read -r name url; do
        [ -z "${name}" ] && continue
        for pattern in "${PATTERNS[@]}"; do
            # shellcheck disable=SC2053
            [[ "${name}" == ${pattern} ]] || continue
            echo "Downloading ${name}..." 1>&2
            api_curl "${project}" -o "${tmpfolder}/${name}" "${url}" || { error "Failed to download ${url}"; return 1; }
            downloaded=1
            break
        done
    done <<< "${assets}"
    if [ "${downloaded}" -eq 0 ]; then
        built_for_other_arch "$(cut -f1 <<< "${assets}")" && fail_no_build "The release of ${project} has no build for ${ARCH}"
        error "No release asset of ${project} matches ${PATTERNS[*]}"
        return 1
    fi
}

function manual_download() {
    echo 1>&2
    download_url="$(prompt-input "Please provide download URL:")"
    [ -z "${download_url}" ] && abort
    (cd "${tmpfolder}" && curl -L -O "${download_url}")
    return $?
}

function cleanup() {
    [ -n "${TMP_DIR}" ] && rm -rf "${TMP_DIR}"
    [ -d "${tmpfolder}" ] && rm -rf "${tmpfolder}"
}

function contains_version() {
    local version_output="${1}"
    # check if anything looks like a version
    echo -e "${version_output}" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+' && echo -e "${version_output}" && return 0
    return 1
}

function binary_version() {
    local binary_path="${1}"
    local timeout_cmd=()
    command -v timeout >/dev/null 2>&1 && timeout_cmd=(timeout 5)

    # Prefer a pty via unbuffer, some tools only print a version when attached to
    # a terminal. Stdin is /dev/null so an interactive prompt cannot block.
    if command -v unbuffer >/dev/null 2>&1; then
        contains_version "$(unbuffer "${timeout_cmd[@]}" "${binary_path}" --version </dev/null 2>&1)" && return 0
        contains_version "$(unbuffer "${timeout_cmd[@]}" "${binary_path}" version </dev/null 2>&1)" && return 0
    fi

    # Retry without a pty. Tools that query terminal capabilities (OSC/DSR escape
    # sequences) stall on the fake pty until the timeout kills them and lose their
    # output, but print the version fine on a plain pipe.
    contains_version "$("${timeout_cmd[@]}" "${binary_path}" --version </dev/null 2>&1)" && return 0
    contains_version "$("${timeout_cmd[@]}" "${binary_path}" version </dev/null 2>&1)" && return 0

    echo "<unknown>"
    return 1
}

function print_version_table() {
	local name="${1}"; shift
	local current="${1}"; shift
	local update="${1}"; shift
	if [ "${current}" == "${update}" ]; then
		echo "${name} is up to date" 1>&2
	else
		echo -e "NAME\tCURRENT\tUPDATE\n${name}\t${current}\t${update}" | column -t -s $'\t'
	fi
}

function list_files() {
    local file_list="${1}"
    if [ -z "${file_list}" ]; then
        echo " └─ (empty)"
    else
        echo " │"
        # shellcheck disable=SC2001
        echo "${file_list}" | sed 's/^/ └─ /'
    fi
}

function find_readme() {
    local files="${1}"
    echo "${files}" | grep -i 'readme' | awk '{ print length(), $0 }' | sort -n | cut -d' ' -f2- | head -n 1
}

function matches_exclude() {
    local file="${1}"
    local basename_file
    local pattern
    [ ${#EXCLUDES[@]} -eq 0 ] && return 1
    basename_file="$(basename "${file}")"
    for pattern in "${EXCLUDES[@]}"; do
        # shellcheck disable=SC2053
        [[ "${file}" == ${pattern} ]] && return 0
        # shellcheck disable=SC2053
        [[ "${basename_file}" == ${pattern} ]] && return 0
    done
    return 1
}

function filter_excluded_patterns() {
    local list="${1}"
    local filtered=""
    local file
    [ ${#EXCLUDES[@]} -eq 0 ] && echo "${list}" && return 0
    while IFS= read -r file; do
        [ -z "${file}" ] && continue
        matches_exclude "${file}" && continue
        if [ -z "${filtered}" ]; then
            filtered="${file}"
        else
            filtered="${filtered}"$'\n'"${file}"
        fi
    done <<< "${list}"
    echo "${filtered}"
}

function filter_excluded_artifacts() {
    local artifacts="${1}"
    local filtered=""
    local excluded_name
    local artifact
    while IFS= read -r artifact; do
        [ -z "${artifact}" ] && continue
        excluded_name="$(basename "${artifact}")"
        case "${excluded_name}" in
            README|README.md|README-??_??.md|RELEASE|RELEASE.md|CONTRIBUTING|CONTRIBUTING.md|LICENSE|LICENSE.md|SECURITY|SECURITY.md|CHANGELOG|CHANGELOG.md)
                continue
                ;;
        esac
        matches_exclude "${artifact}" && continue
        if [ -z "${filtered}" ]; then
            filtered="${artifact}"
        else
            filtered="${filtered}"$'\n'"${artifact}"
        fi
    done <<< "${artifacts}"
    echo "${filtered}"
}

function print_archive_file() {
    local artifact="${1}"
    local archive_type="${2}"
    local file="${3}"
    case "${archive_type}" in
        zip)
            unzip -cq "${artifact}" "${file}"
            ;;
        tar)
            tar -xOf "${artifact}" "${file}"
            ;;
        *)
            fail "Unsupported archive type: ${archive_type} for '${artifact}'"
            ;;
    esac
}

function reduce_artifacts() {
    local list="${1}"
    local reduced="${list}"
    local deb_list=""
    local tar_list=""
    local zip_list=""
    local noext_list=""

    deb_list="$(echo "${reduced}" | grep -E '\.deb$' || true)"
    if [ -n "${deb_list}" ]; then
        echo "${deb_list}"
        return 0
    fi

    tar_list="$(echo "${reduced}" | grep -E '\.(tar\.gz|tar\.xz|tar\.bz2|tar|tgz)$' || true)"
    if [ -n "${tar_list}" ]; then
        echo "${tar_list}"
        return 0
    fi

    zip_list="$(echo "${reduced}" | grep -E '\.zip$' || true)"
    if [ -n "${zip_list}" ]; then
        echo "${zip_list}"
        return 0
    fi

    noext_list="$(echo "${reduced}" | awk -F/ '{ b=$NF; if (b !~ /\./) print $0 }')"
    if [ -n "${noext_list}" ]; then
        echo "${noext_list}"
        return 0
    fi

    echo "${reduced}"
    return 0
}

function prefer_without() {
    local marker="${1}"; shift
    local list="${1}"; shift
    local reduced
    reduced="$(echo "${list}" | grep -vi "${marker}" || true)"
    [ -n "${reduced}" ] && echo "${reduced}" && return 0
    echo "${list}"
    return 0
}

function prefer_with() {
    local marker="${1}"; shift
    local list="${1}"; shift
    local reduced
    reduced="$(echo "${list}" | grep -i "${marker}" || true)"
    [ -n "${reduced}" ] && echo "${reduced}" && return 0
    echo "${list}"
    return 0
}

function prefer_gnu_over_musl() {
    local list="${1}"; shift
    # Not every project spells the glibc build "gnu" (opencode ships
    # *-linux-x64.tar.gz next to *-linux-x64-musl.tar.gz), so drop the musl
    # variant whenever a non-musl sibling exists.
    prefer_without "musl" "${list}"
    return $?
}

function prefer_supported_cpu_variant() {
    local list="${1}"; shift
    # "baseline" builds (bun, opencode, ...) are the fallback for CPUs without
    # modern SIMD. Take them only when this CPU lacks AVX2, or when the CPU
    # cannot be inspected at all, since they run everywhere.
    if grep -qm1 '\bavx2\b' /proc/cpuinfo 2>/dev/null; then
        prefer_without "baseline" "${list}"
    else
        prefer_with "baseline" "${list}"
    fi
    return $?
}

# prefer_linux LIST: drops the builds for other operating systems, when a
# release names its Linux builds by architecture only (x86_64.tar.gz next to
# macos-x86_64.tar.gz) unless nothing else is left
function prefer_linux() {
    local list="${1}"; shift
    local reduced
    local item
    reduced="$(while IFS= read -r item; do
        basename "${item}" | tr '[:upper:]' '[:lower:]' \
            | grep -qP '(?<![a-z0-9])(darwin|macos|mac|osx|apple|windows|win32|win64|freebsd|openbsd|netbsd|android|illumos|solaris)(?![a-z0-9])|\.(exe|msi|dmg|pkg)$' \
            || echo "${item}"
    done <<< "${list}")"
    [ -n "${reduced}" ] && echo "${reduced}" && return 0
    echo "${list}"
}

# The architectures by their Debian name (what dpkg --print-architecture says),
# then the names release artifacts give them, the preferred first, and after a
# "|" the names of older instruction sets it runs too, taken only when nothing
# is built for it. A name maps to the first architecture that prefers it, for
# --arch and uname -m.
ARCH_TABLE=(
    "amd64 amd64 x86_64 x86-64 x64"
    "arm64 arm64 aarch64 armv8"
    "armhf armhf armv7l armv7 armv7hf armv8l arm32 | armv6l armv6 armv6hf arm"
    "armel armel armv6l armv6 armv6hf armv5tel armv5te armv5 arm"
    "i386 i386 i686 i586 i486 386 ia32 x86"
    "ppc64el ppc64el ppc64le"
    "ppc64 ppc64"
    "s390x s390x"
    "riscv64 riscv64"
    "mips64el mips64el mips64le"
    "mipsel mipsel mipsle"
    "mips mips"
    "loong64 loong64 loongarch64"
)

# arch_names ARCH [preferred|fallback|all]: the names of ARCH from the table
function arch_names() {
    local arch="${1}"
    local part="${2:-all}"
    local row
    local names
    local -a words
    for row in "${ARCH_TABLE[@]}"; do
        [ "${row%% *}" = "${arch}" ] || continue
        names="${row#* }"
        case "${part}" in
            preferred) names="${names%%|*}" ;;
            fallback) [[ "${names}" == *"|"* ]] && names="${names#*|}" || names="" ;;
            all) names="${names/|/}" ;;
        esac
        read -ra words <<< "${names}"
        echo "${words[*]}"
        return 0
    done
    # not in the table: only its own name
    [ "${part}" = "fallback" ] || echo "${arch}"
}

# normalize_arch NAME: the Debian name of a dpkg, uname -m or artifact name
function normalize_arch() {
    local name="${1,,}"
    local row
    for row in "${ARCH_TABLE[@]}"; do
        if [[ " $(arch_names "${row%% *}" preferred) " == *" ${name} "* ]]; then
            echo "${row%% *}"
            return 0
        fi
    done
    echo "${name}"
}

# detect_arch: the architecture of the userland, which is what has to run the
# binaries. dpkg knows it; uname -m only names the kernel, and a Raspberry Pi OS
# with a 32-bit (armhf) userland boots a 64-bit (aarch64) kernel on a Pi 3/4/5.
function detect_arch() {
    local arch
    arch="$(dpkg --print-architecture 2>/dev/null || true)"
    if [ -z "${arch}" ]; then
        arch="$(normalize_arch "$(uname -m 2>/dev/null)")"
        if [ "$(getconf LONG_BIT 2>/dev/null)" = "32" ]; then
            case "${arch}" in
                arm64) arch="armhf" ;;
                amd64) arch="i386" ;;
            esac
        fi
    fi
    echo "${arch}"
}

# arch_aliases [ARCH]: how release artifacts name the architecture (default:
# ARCH), the preferred names first, then the fallback ones
function arch_aliases() {
    local -a words
    read -ra words <<< "$(arch_preferred_aliases "${@}") $(arch_fallback_aliases "${@}")"
    echo "${words[*]}"
}

# arch_preferred_aliases [ARCH]: the names of builds for the architecture itself.
# A 32-bit ARM userland on an ARMv6 CPU (Pi 1/Zero) cannot run ARMv7 builds, so
# there the ARMv6 ones are its own.
function arch_preferred_aliases() {
    local arch="${1:-${ARCH}}"
    if [ "${arch}" = "armhf" ] && [ "${arch}" = "${ARCH}" ] && [[ "$(uname -m 2>/dev/null)" == armv6* ]]; then
        echo "armhf $(arch_names armhf fallback | sed -E 's/(^| )arm( |$)/ /')"
        return 0
    fi
    arch_names "${arch}" preferred
}

# arch_fallback_aliases [ARCH]: the names of older instruction sets the
# architecture runs too
function arch_fallback_aliases() {
    local arch="${1:-${ARCH}}"
    if [ "${arch}" = "armhf" ] && [ "${arch}" = "${ARCH}" ] && [[ "$(uname -m 2>/dev/null)" == armv6* ]]; then
        echo "arm"
        return 0
    fi
    arch_names "${arch}" fallback
}

# all_arch_aliases: every name an artifact may carry, to spot builds for other
# architectures
function all_arch_aliases() {
    local row
    for row in "${ARCH_TABLE[@]}"; do
        arch_names "${row%% *}"
    done | tr ' ' '\n' | sort -u | paste -sd' '
}

# arch_regex ALIASES...: a PCRE that matches any of the aliases as a whole word
# of a file name, so "arm" matches arm-unknown-linux-gnueabihf but not arm64,
# and "x86" not x86_64
function arch_regex() {
    local aliases
    # the longest first, so x86_64 is tried before x86
    aliases="$(echo "${*}" | tr ' ' '\n' | grep -v '^$' | awk '{ print length(), $0 }' | sort -rn | cut -d' ' -f2- \
        | sed 's/[.]/\\./g' | paste -sd'|')"
    echo "(?<![a-z0-9])(${aliases})(?![a-z0-9]|[-_]64)"
}

# matches_arch FILE ALIASES...: whether the file name carries one of the aliases
function matches_arch() {
    local file="${1}"; shift
    basename "${file}" | tr '[:upper:]' '[:lower:]' | grep -qP "$(arch_regex "${@}")"
}

# reduce_unsupported_artifacts LIST: drops AppImages and artifacts built only
# for other architectures; artifacts naming no architecture stay
function reduce_unsupported_artifacts() {
    local list="${1}"
    local reduced=""
    local item
    local native
    local all
    native="$(arch_aliases)"
    all="$(all_arch_aliases)"
    while IFS= read -r item; do
        [ -z "${item}" ] && continue
        [[ "${item}" =~ AppImage$ ]] && continue
        # shellcheck disable=SC2086
        if matches_arch "${item}" ${all} && ! matches_arch "${item}" ${native}; then
            continue
        fi
        if [ -z "${reduced}" ]; then
            reduced="${item}"
        else
            reduced="${reduced}"$'\n'"${item}"
        fi
    done <<< "${list}"
    echo "${reduced}"
}

# filter_native_arch LIST: the artifacts built for this architecture, else the
# ones for an older instruction set it runs too; empty when none names one
function filter_native_arch() {
    local list="${1}"
    local filtered
    local aliases
    local item
    for aliases in "$(arch_preferred_aliases)" "$(arch_fallback_aliases)"; do
        [ -z "${aliases}" ] && continue
        # shellcheck disable=SC2086
        filtered="$(while IFS= read -r item; do
            [ -n "${item}" ] && matches_arch "${item}" ${aliases} && echo "${item}"
        done <<< "${list}")"
        [ -n "${filtered}" ] && echo "${filtered}" && return 0
    done
    return 0
}

# arch_patterns ARCH PATTERNS...: the patterns for an architecture: {arch}
# replaced with each of its names, one pattern per name; without patterns its
# Linux builds, where the Debian name needs no "linux" next to it, as in the
# name of a package (foo_1.0_amd64.deb)
function arch_patterns() {
    local arch="${1}"; shift
    local pattern
    local alias
    if [ $# -eq 0 ]; then
        [ "${arch}" = "amd64" ] && echo "*linux*64*"
        echo "*${arch}*"
        for alias in $(arch_aliases "${arch}"); do
            echo "*linux*${alias}*"
            echo "*${alias}*linux*"
        done
        return 0
    fi
    for pattern in "${@}"; do
        if [[ "${pattern}" == *"{arch}"* ]]; then
            for alias in $(arch_aliases "${arch}"); do
                echo "${pattern//\{arch\}/${alias}}"
            done
        else
            echo "${pattern}"
        fi
    done
}

# built_for_other_arch NAMES: whether one of the asset names is what the
# patterns pick on another architecture, so the release has no build for this
# one rather than a pattern that is wrong
function built_for_other_arch() {
    local names="${1}"
    local row
    local arch
    local pattern
    local name
    # only patterns that depend on the architecture tell
    if [ ${#PATTERN_TEMPLATES[@]} -gt 0 ] && [[ "${PATTERN_TEMPLATES[*]}" != *"{arch}"* ]]; then
        return 1
    fi
    for row in "${ARCH_TABLE[@]}"; do
        arch="${row%% *}"
        [ "${arch}" = "${ARCH}" ] && continue
        while IFS= read -r pattern; do
            while IFS= read -r name; do
                [ -z "${name}" ] && continue
                # shellcheck disable=SC2053
                [[ "${name}" == ${pattern} ]] || continue
                # shellcheck disable=SC2046
                matches_arch "${name}" $(arch_aliases "${arch}") && return 0
            done <<< "${names}"
        done < <(arch_patterns "${arch}" "${PATTERN_TEMPLATES[@]}")
    done
    return 1
}

function archive_ls() {
    local artifact="${1}"
    local archive_type="${2}"
    case "${archive_type}" in
        zip)
            zipinfo -1 "${artifact}"
            ;;
        tar)
            tar -tf "${artifact}"
            ;;
        *)
            fail "Unsupported archive type: ${archive_type} for '${artifact}'"
            ;;
    esac
}

function archive_files_for_install() {
    local artifact="${1}"
    local archive_type="${2}"
    local files
    files="$(archive_ls "${artifact}" "${archive_type}")"
    filter_excluded_artifacts "${files}"
}

function is_safe_archive_path() {
    local file="${1}"
    [ -z "${file}" ] && return 1
    [[ "${file}" == /* ]] && return 1
    [[ "${file}" == *"/../"* ]] && return 1
    [[ "${file}" == "../"* ]] && return 1
    [[ "${file}" == *"/.." ]] && return 1
    [ "${file}" == ".." ] && return 1
    return 0
}

function validate_archive_paths() {
    local files="${1}"
    local file
    while IFS= read -r file; do
        [ -z "${file}" ] && continue
        if ! is_safe_archive_path "${file}"; then
            error "Unsafe archive path: '${file}'"
            return 1
        fi
    done <<< "${files}"
    return 0
}

function common_top_level_dir() {
    local files="${1}"
    local first=""
    local top=""
    local file
    while IFS= read -r file; do
        [ -z "${file}" ] && continue
        [[ "${file}" != */* ]] && return 0
        top="${file%%/*}"
        [ -z "${top}" ] && return 0
        if [ -z "${first}" ]; then
            first="${top}"
        elif [ "${first}" != "${top}" ]; then
            return 0
        fi
    done <<< "${files}"
    echo "${first}"
}

function strip_archive_prefix() {
    local file="${1}"
    local prefix="${2}"
    if [ -n "${prefix}" ] && [[ "${file}" == "${prefix}/"* ]]; then
        echo "${file#"${prefix}"/}"
    else
        echo "${file}"
    fi
}

function matching_binary_files() {
    local files="${1}"
    local pattern="${2}"
    local matching_files=""
    local file
    local basename_file
    while IFS= read -r file; do
        [ -z "${file}" ] && continue
        basename_file="$(basename "${file}")"
        # shellcheck disable=SC2053
        if [ -z "${pattern}" ] || [[ "${file}" == ${pattern} ]] || [[ "${basename_file}" == ${pattern} ]]; then
            if [ -z "${matching_files}" ]; then
                matching_files="${file}"
            else
                matching_files="${matching_files}"$'\n'"${file}"
            fi
        fi
    done <<< "${files}"
    echo "${matching_files}"
}

function choose_binary_from_files() {
    local files="${1}"
    local artifact="${2}"
    local binary_path=""
    local count

    if [ -n "${BINARY_PATTERN}" ]; then
        files="$(matching_binary_files "${files}" "${BINARY_PATTERN}")"
    fi

    count=$(echo "${files}" | wc -l)
    if [ "${count}" -eq 1 ] && [ -n "${files}" ]; then
        binary_path="${files}"
    elif [ "${count}" -gt 1 ]; then
        [ ${YES} -eq 1 ] && echo 1>&2 && echo "${files}" 1>&2 && error "Found ${count} files in '${artifact}' archive" && return 1
        binary_path="$(printf '%s\n' "${files}" | prompt-select -p "Binary to install:" --delimiter '')"
    else
        echo "No files found in '${artifact}'" 1>&2
        return 1
    fi
    echo "${binary_path}"
    return 0
}

function retrieve_binary_from_archive() {
    local artifact="${1}"
    local archive_type="${2}"
    echo "Unpacking archive '${artifact}'..." 1>&2
    files="$(archive_ls "${artifact}" "${archive_type}")"
    output="$(list_files "${files}")"
    echo "${output}" 1>&2
    count=$(echo "${files}" | wc -l)
    readme_file="$(find_readme "${files}")"
    if [ -n "${readme_file}" ]; then
        if prompt_readme "${readme_file}"; then
            echo 1>&2
            echo "Content of '${readme_file}':" 1>&2
            readme_content="$(print_archive_file "${artifact}" "${archive_type}" "${readme_file}")"
			if command -v glow &>/dev/null; then
	            glow <(echo "${readme_content}") 1>&2
			else
				echo "${readme_content}" 1>&2
				echo 1>&2
			fi
        fi
    fi
    files="$(filter_excluded_artifacts "${files}")"
    choose_binary_from_files "${files}" "${artifact}"
}

function prompt_readme() {
    local readme="${1}"
    [ ${YES} -eq 1 ] && return 1
    [ ${DRY_RUN} -eq 1 ] && return 1
    echo 1>&2
    prompt-no-yes "Show readme '${readme}'?" && return 0
    return 1
}

function prompt_install() {
    local binary="${1}"
    local target_path="${2}"
    [ ${YES} -eq 1 ] && return 0
    [ ${DRY_RUN} -eq 1 ] && return 0
    prompt-yes-no "Install binary '${binary}' to '${target_path}/${binary}'" || abort
    return 0
}

function prompt_bundle_install() {
    local package="${1}"
    local bundle_path="${2}"
    [ ${YES} -eq 1 ] && return 0
    [ ${DRY_RUN} -eq 1 ] && return 0
    prompt-yes-no "Install archive as bundled app under '${bundle_path}/${package}'" || return 1
    return 0
}

function sudo_for_path() {
    local path="${1}"
    local parent
    if [ -e "${path}" ]; then
        [ -w "${path}" ] || echo "sudo"
        return 0
    fi
    parent="$(dirname "${path}")"
    [ -w "${parent}" ] || echo "sudo"
}

function extract_binary_from_archive() {
    local artifact="${1}"; shift
    local archive_type="${1}"; shift
    local binary_path="${1}"; shift
    local binary="${1}"; shift
    local target_path="${1}"; shift
    local archive_binary
    archive_binary="$(basename "${binary_path}")"
    local tmpdir
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "${tmpdir}"' RETURN

    extract_binary_to_dir "${artifact}" "${archive_type}" "${binary_path}" "${tmpdir}"

    SUDO=""
    [ ! -w "${target_path}" ] && SUDO="sudo"
    LC_ALL=C ${SUDO} mv -vf "${tmpdir}/${archive_binary}" "${target_path}/${binary}"
}

function extract_binary_to_dir() {
    local artifact="${1}"; shift
    local archive_type="${1}"; shift
    local binary_path="${1}"; shift
    local target_dir="${1}"; shift
    case "${archive_type}" in
        zip)
            # -j strips directories so the file lands directly in ${target_dir}
            unzip -o -j "${artifact}" "${binary_path}" -d "${target_dir}" 1>&2
            ;;
        tar)
            # count path components to strip so the file lands in ${target_dir}
            local component_count
            component_count=$(echo "${binary_path}" | tr -cd '/' | wc -c)
            tar -xvf "${artifact}" -C "${target_dir}" --strip-components="${component_count}" "${binary_path}" 1>&2
            ;;
        *)
            fail "Unsupported archive type: ${archive_type} for '${artifact}'"
            ;;
    esac
}

function extract_archive_to_dir() {
    local artifact="${1}"
    local archive_type="${2}"
    local target_dir="${3}"
    case "${archive_type}" in
        zip)
            unzip -q -o "${artifact}" -d "${target_dir}" 1>&2
            ;;
        tar)
            tar -xf "${artifact}" -C "${target_dir}" 1>&2
            ;;
        *)
            fail "Unsupported archive type: ${archive_type} for '${artifact}'"
            ;;
    esac
}

function stage_bundle_archive() {
    local artifact="${1}"
    local archive_type="${2}"
    local files="${3}"
    local stage_dir="${4}"
    local prefix="${5}"
    local extract_dir
    extract_dir="$(mktemp -d)"

    validate_archive_paths "${files}" || return 1
    extract_archive_to_dir "${artifact}" "${archive_type}" "${extract_dir}" || { rm -rf "${extract_dir}"; return 1; }

    if [ -n "${prefix}" ]; then
        mv "${extract_dir}/${prefix}/"* "${stage_dir}/" 2>/dev/null || true
        mv "${extract_dir}/${prefix}/".[!.]* "${stage_dir}/" 2>/dev/null || true
        mv "${extract_dir}/${prefix}/"..?* "${stage_dir}/" 2>/dev/null || true
    else
        mv "${extract_dir}/"* "${stage_dir}/" 2>/dev/null || true
        mv "${extract_dir}/".[!.]* "${stage_dir}/" 2>/dev/null || true
        mv "${extract_dir}/"..?* "${stage_dir}/" 2>/dev/null || true
    fi
    rm -rf "${extract_dir}"
}

function install_bundle_from_archive() {
    local artifact="${1}"
    local archive_type="${2}"
    local install_path="${3}"
    local bundle_path="${4}"
    local files
    local binary_path
    local binary
    local package
    local prefix
    local staged_binary_path
    local stage_parent
    local stage_dir
    local target_bundle_dir
    local link_path
    local tmp_link

    files="$(archive_files_for_install "${artifact}" "${archive_type}")"
    validate_archive_paths "${files}" || return 1
    binary_path="$(choose_binary_from_files "${files}" "${artifact}")" || return 1
    binary="$(basename "${binary_path}")"
    package="${BINARY_NAME:-${binary}}"
    prefix="$(common_top_level_dir "${files}")"
    staged_binary_path="$(strip_archive_prefix "${binary_path}" "${prefix}")"

    if ! prompt_bundle_install "${package}" "${bundle_path}"; then
        return 2
    fi

    if [ "${DRY_RUN}" -eq 1 ]; then
        stage_parent="$(mktemp -d)"
        stage_dir="${stage_parent}/${package}"
        mkdir -p "${stage_dir}"
        stage_bundle_archive "${artifact}" "${archive_type}" "${files}" "${stage_dir}" "${prefix}" || { rm -rf "${stage_parent}"; return 1; }
        if [ ! -x "${stage_dir}/${staged_binary_path}" ]; then
            error "Selected binary is not executable after extraction: '${staged_binary_path}'"
            rm -rf "${stage_parent}"
            return 1
        fi
        local new_version
        local current_version
        new_version="$(binary_version "${stage_dir}/${staged_binary_path}" | head -n 1)"
        if [ -x "${install_path}/${package}" ]; then
            current_version="$(binary_version "${install_path}/${package}" | head -n 1)"
        else
            current_version="(not installed)"
        fi
        print_version_table "${package}" "${current_version}" "${new_version}"
        echo "Bundle path: ${bundle_path}/${package}" 1>&2
        echo "Binary link: ${install_path}/${package} -> ${bundle_path}/${package}/${staged_binary_path}" 1>&2
        rm -rf "${stage_parent}"
        return 0
    fi

    prompt_install "${package}" "${install_path}"
    stage_parent="$(mktemp -d)"
    stage_dir="${stage_parent}/${package}"
    mkdir -p "${stage_dir}"
    stage_bundle_archive "${artifact}" "${archive_type}" "${files}" "${stage_dir}" "${prefix}" || { rm -rf "${stage_parent}"; return 1; }
    if [ ! -x "${stage_dir}/${staged_binary_path}" ]; then
        error "Selected binary is not executable after extraction: '${staged_binary_path}'"
        rm -rf "${stage_parent}"
        return 1
    fi

    SUDO="$(sudo_for_path "${bundle_path}")"
    target_bundle_dir="${bundle_path}/${package}"
    ${SUDO} mkdir -p "${bundle_path}" || return 1
    ${SUDO} rm -rf "${target_bundle_dir}.tmp" || return 1
    LC_ALL=C ${SUDO} mv -vf "${stage_dir}" "${target_bundle_dir}.tmp" || return 1
    rm -rf "${stage_parent}"
    ${SUDO} rm -rf "${target_bundle_dir}" || return 1
    LC_ALL=C ${SUDO} mv -vf "${target_bundle_dir}.tmp" "${target_bundle_dir}" || return 1

    SUDO="$(sudo_for_path "${install_path}")"
    ${SUDO} mkdir -p "${install_path}" || return 1
    link_path="${install_path}/${package}"
    tmp_link="${link_path}.tmp"
    ${SUDO} rm -f "${tmp_link}" || return 1
    ${SUDO} ln -s "${target_bundle_dir}/${staged_binary_path}" "${tmp_link}" || return 1
    LC_ALL=C ${SUDO} mv -vf "${tmp_link}" "${link_path}" || return 1

    BINARY="${package}"
    return 0
}

function install_from_archive() {
    local artifact="${1}"
    local archive_type="${2}"
    local target_path="${3}"
    local bundle_result
    if [ ${BUNDLE} -eq 1 ]; then
        install_bundle_from_archive "${artifact}" "${archive_type}" "${target_path}" "${BUNDLE_PATH}"
        return $?
    fi
    local files
    local count
    files="$(archive_files_for_install "${artifact}" "${archive_type}")"
    # honour -b|--binary: if it narrows to a single file, skip the bundle heuristic
    if [ -n "${BINARY_PATTERN}" ]; then
        files="$(matching_binary_files "${files}" "${BINARY_PATTERN}")"
    fi
    count=$(echo "${files}" | wc -l)
    if [ "${count}" -gt 1 ]; then
        install_bundle_from_archive "${artifact}" "${archive_type}" "${target_path}" "${BUNDLE_PATH}"
        bundle_result=$?
        [ ${bundle_result} -ne 2 ] && return ${bundle_result}
    fi
    if ! binary_path="$(retrieve_binary_from_archive "${artifact}" "${archive_type}")"; then
        return 1
    fi
    if [ -n "${binary_path}" ]; then
        local archive_binary
        archive_binary="$(basename "${binary_path}")"
        # setting global variable
        BINARY="${BINARY_NAME:-${archive_binary}}"
        if [ "${DRY_RUN}" -eq 1 ]; then
            local tmpdir
            tmpdir="$(mktemp -d)"
            trap 'rm -rf "${tmpdir}"' RETURN
            extract_binary_to_dir "${artifact}" "${archive_type}" "${binary_path}" "${tmpdir}" || return 1
            local new_version
            local current_version
            new_version="$(binary_version "${tmpdir}/${archive_binary}" | head -n 1)"
            if [ -x "${INSTALL_PATH}/${BINARY}" ]; then
                current_version="$(binary_version "${INSTALL_PATH}/${BINARY}" | head -n 1)"
            else
                current_version="(not installed)"
            fi
            print_version_table "${BINARY}" "${current_version}" "${new_version}"
        else
            prompt_install "${BINARY}" "${target_path}"
            extract_binary_from_archive "${artifact}" "${archive_type}" "${binary_path}" "${BINARY}" "${target_path}"
        fi
        return $?
    fi
}

function install_binary() {
    local binary_path="${1}"
    local target_path="${2}"
    local binary
    local install_name
    binary="$(basename "${binary_path}")"
    install_name="${BINARY_NAME:-${binary}}"

    if [ -n "${BINARY_PATTERN}" ]; then
        # shellcheck disable=SC2053
        if [[ "${binary}" != ${BINARY_PATTERN} ]]; then
            error "Binary '${binary}' doesn't match pattern '${BINARY_PATTERN}'"
            return 1
        fi
    fi

    echo "Detected binary '${binary_path}'..." 1>&2
    if [ "${DRY_RUN}" -eq 1 ]; then
        local new_version
        local current_version
        new_version="$(binary_version "${binary_path}" | head -n 1)"
        if [ -x "${target_path}/${install_name}" ]; then
            current_version="$(binary_version "${target_path}/${install_name}" | head -n 1)"
        else
            current_version="(not installed)"
        fi
        print_version_table "${install_name}" "${current_version}" "${new_version}"
    else
        prompt_install "${install_name}" "${target_path}"
        SUDO=""
        [ ! -w "${target_path}" ] && SUDO="sudo"
        ${SUDO} cp -v "${binary_path}" "${target_path}/${install_name}" || return 1
        ${SUDO} chmod +x "${target_path}/${install_name}" || return 1
        # setting global variable
        BINARY="${install_name}"
    fi
    return 0
}

function install_deb() {
    local artifact="${1}"
    local package_name=""
    if [ "${DRY_RUN}" -eq 1 ]; then
        package_name="$(dpkg-deb -f "${artifact}" Package)"
        new_version="$(dpkg-deb -f "${artifact}" Version)"
		current_version="$(LC_ALL=C apt list "${package_name}" --installed 2>/dev/null | tail -1 | head -1 | awk '{print $2}')"
		print_version_table "${package_name}" "${current_version}" "${new_version}"
        return 0
    else
        echo "Installing '${artifact}' using apt..." 1>&2
        sudo apt install "${artifact}" 1>&2 || return 1
    fi
    return 0
}

function run_post_install() {
    local artifact="${1}"
    local artifact_kind="${2}"
    [ ${#POST_INSTALL_CMDS[@]} -eq 0 ] && return 0

    local work_dir=""
    local unpack_dir=""
    case "${artifact_kind}" in
        tar|zip)
            unpack_dir="$(mktemp -d)"
            if ! extract_archive_to_dir "${artifact}" "${artifact_kind}" "${unpack_dir}"; then
                error "Failed to unpack archive for post-install command"
                rm -rf "${unpack_dir}"
                return 1
            fi
            work_dir="${unpack_dir}"
            ;;
        deb)
            unpack_dir="$(mktemp -d)"
            if ! dpkg-deb -x "${artifact}" "${unpack_dir}" 2>/dev/null; then
                error "Failed to unpack deb for post-install command"
                rm -rf "${unpack_dir}"
                return 1
            fi
            work_dir="${unpack_dir}"
            ;;
        *)
            # plain binary: nothing to unpack, use the downloaded file's directory
            work_dir="$(dirname "${artifact}")"
            ;;
    esac

    local binary_path=""
    [ -n "${BINARY}" ] && binary_path="${INSTALL_PATH}/${BINARY}"

    local rc=0
    local cmd
    for cmd in "${POST_INSTALL_CMDS[@]}"; do
        if [ "${DRY_RUN}" -eq 1 ]; then
            echo 1>&2
            echo "[dry-run] would run post-install command in '${work_dir}':" 1>&2
            echo "  ${cmd}" 1>&2
            continue
        fi
        echo 1>&2
        echo "Running post-install command in '${work_dir}':" 1>&2
        echo "  ${cmd}" 1>&2
        if ! (
            cd "${work_dir}" || exit 1
            INSTALL_PATH="${INSTALL_PATH}" \
            BINARY_NAME="${BINARY}" \
            BINARY_PATH="${binary_path}" \
            ARTIFACT="${artifact}" \
            UNPACK_DIR="${work_dir}" \
            bash -c "${cmd}" 1>&2
        ); then
            error "Post-install command failed: ${cmd}"
            rc=1
            break
        fi
    done

    [ -n "${unpack_dir}" ] && rm -rf "${unpack_dir}"
    return ${rc}
}

if [ $# -lt 1 ]; then
    usage
fi

YES=0
DRY_RUN=0
PATTERNS=()
EXCLUDES=()
RELEASE=""
INSTALL_PATH="/usr/local/bin"
BUNDLE=0
BUNDLE_PATH="/usr/local/share"
BINARY_PATTERN=""
BINARY_NAME=""
POST_INSTALL_CMDS=()
ARTIFACT_KIND=""
TMP_DIR=""
ARCH=""

while [ $# -gt 0 ]; do
    case "${1}" in
        --bash-completion)
            shift
            completion "${@}"
            exit 0
            ;;
        -h|--help)
            usage
            ;;
        -d|--dry-run)
            DRY_RUN=1
            ;;
        -p|--pattern)
            shift
            [ -z "${1}" ] && usage
            PATTERNS+=("${1}")
            ;;
        -x|--exclude)
            shift
            [ -z "${1}" ] && usage
            EXCLUDES+=("${1}")
            ;;
        -r|--release)
            shift
            [ -z "${1}" ] && usage
            RELEASE="${1}"
            ;;
        -i|--install-path)
            shift
            [ -z "${1}" ] && usage
            INSTALL_PATH="${1}"
            ;;
        --bundle)
            BUNDLE=1
            ;;
        --bundle-path)
            shift
            [ -z "${1}" ] && usage
            BUNDLE_PATH="${1}"
            ;;
        -b|--binary)
            shift
            [ -z "${1}" ] && usage
            BINARY_PATTERN="${1}"
            ;;
        -n|--name)
            shift
            [ -z "${1}" ] && usage
            BINARY_NAME="${1}"
            ;;
        -c|--post-install)
            shift
            [ -z "${1}" ] && usage
            POST_INSTALL_CMDS+=("${1}")
            ;;
        -a|--arch)
            shift
            [ -z "${1}" ] && usage
            ARCH="$(normalize_arch "${1}")"
            ;;
        -y|--yes)
            YES=1
            ;;
        *)
            if [ -z "${project}" ]; then
                project="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

[ -z "${project}" ] && usage
[ -z "${ARCH}" ] && ARCH="$(detect_arch)"
[ -z "${ARCH}" ] && fail "Failed to detect the architecture, pass it with --arch"
# the patterns as given, {arch} still in them
PATTERN_TEMPLATES=( "${PATTERNS[@]}" )
mapfile -t PATTERNS < <(arch_patterns "${ARCH}" "${PATTERN_TEMPLATES[@]}")

if [ "${DRY_RUN}" -eq 1 ]; then
    echo "Running in dry-run mode..." 1>&2
    TMP_DIR="$(mktemp -d)"
fi
target_path="${INSTALL_PATH}"
[ "${DRY_RUN}" -eq 1 ] && target_path="${TMP_DIR}"

GITLAB=0
GITHUB=0

if [[ "${APP_NAME}" == *gitlab* ]]; then
    GITLAB=1
elif [[ "${APP_NAME}" == *github* ]]; then
    GITHUB=1
fi

tmpfolder=$(mktemp -d)
trap cleanup EXIT


release_description=""
[ -n "${RELEASE}" ] && release_description=" (release '${RELEASE}')"
exclude_description=""
[ ${#EXCLUDES[@]} -gt 0 ] && exclude_description=", excluding ${EXCLUDES[*]}"
echo "Retrieving ${ARCH} artifact from '${project}'${release_description} with patterns ${PATTERNS[*]}${exclude_description}..." 1>&2

if [[ ! "${project}" =~ ^(https?)://.* ]]; then
    echo 1>&2
    echo "Looking for repository: ${project}" 1>&2
    git_search_args=()
    git_search_args+=("${project}")
    [ ${GITLAB} -eq 1 ] && git_search_args+=("--gitlab")
    [ ${GITHUB} -eq 1 ] && git_search_args+=("--github")
    repo="$(git-search "${git_search_args[@]}")"
    if [ -z "${repo}" ]; then
        fail "No such repository: ${project}"
    fi
    count=$(echo "${repo}" | wc -l)
    if [ "${count}" -gt 1 ]; then
        [ ${YES} -eq 1 ] && fail "Found multiple repositories: ${repo}"
        echo 1>&2
        repo="$(printf '%s\n' "${repo}" | prompt-select -p "Found multiple repositories:" --delimiter '')"
    fi
    if [ -n "${repo}" ]; then
        project="${repo}"
        echo "${project}" 1>&2
        echo 1>&2
    fi
fi

if [[ "${project}" == "https://github.com"* ]]; then
    gh_args=( "-R" "${project}" "release" "download" "-D" "${tmpfolder}" )
    [ -n "${RELEASE}" ] && gh_args+=( "${RELEASE}" )
    for pattern in "${PATTERNS[@]}"; do
        gh_args+=( "-p" "${pattern}" )
    done
    if ! command -v gh &> /dev/null; then
        echo "gh not found, using the GitHub API..." 1>&2
        download_with_api "${project}" || manual_download
    elif ! gh "${gh_args[@]}" 1>&2; then
        echo "gh failed, trying the GitHub API..." 1>&2
        download_with_api "${project}" || { error "Failed to retrieve artifact from '${project}'"; manual_download; }
    fi
else
    if [[ "${project}" == "https://"* ]]; then
        if [ -n "${GITLAB_HOST}" ] && [[ "${project}" != "${GITLAB_HOST}"* ]]; then
            GITLAB_HOST="$(echo "${project}" | cut -d/ -f1-3)"
            unset GITLAB_TOKEN
        fi
    fi

    glab_args=( "-R" "${project}" "release" "download" "-D" "${tmpfolder}" )
    [ -n "${RELEASE}" ] && glab_args+=( "${RELEASE}" )
    for pattern in "${PATTERNS[@]}"; do
        glab_args+=( "-n" "${pattern}" )
    done
    if ! command -v glab &> /dev/null; then
        echo "glab not found, using the GitLab API..." 1>&2
        download_with_api "${project}" || manual_download
    elif ! glab "${glab_args[@]}" 1>&2; then
        echo "glab failed, trying the GitLab API..." 1>&2
        download_with_api "${project}" || { error "Failed to retrieve artifact from '${project}'"; manual_download; }
    fi
fi

artifact=""
for pattern in "${PATTERNS[@]}"; do
    [ -n "${artifact}" ] && artifact+=$'\n'
    # shellcheck disable=SC2086
    artifact="${artifact}$(ls -1 "${tmpfolder}/"${pattern} 2> /dev/null)"
done
if [ ${#EXCLUDES[@]} -gt 0 ]; then
    artifact="$(filter_excluded_patterns "${artifact}")"
    [ -z "${artifact}" ] && error "All downloaded artifacts excluded by ${EXCLUDES[*]}"
fi
if [ -z "${artifact}" ]; then
    # gh and glab say only that nothing matched
    assets="$(release_assets "${project}" 2> /dev/null)" \
        && built_for_other_arch "$(cut -f1 <<< "${assets}")" \
        && fail_no_build "The release of ${project} has no build for ${ARCH}"
    error "Artifact not found"
    manual_download
fi

# sort reverse and make unique
artifact="$(echo "${artifact}" | sort -ur)"

# remove unsupported artifacts early, a lone one built for another architecture too
if [ -n "${artifact}" ]; then
    artifact_list="$(reduce_unsupported_artifacts "${artifact}")"
    [ -z "${artifact_list}" ] && fail_no_build "No artifact for ${ARCH} among: $(echo "${artifact}" | xargs -rd '\n' -n1 basename | paste -sd' ')"
    artifact="${artifact_list}"
fi

if [ "$(echo "${artifact}" | wc -l)" -gt 1 ]; then
    # os first: the arch filter alone would happily settle on a darwin build
    artifact_list="$(prefer_linux "${artifact_list}")"
    best=""
    echo 1>&2
    echo "Found multiple artifacts matching ${PATTERNS[*]}:" 1>&2
    while IFS= read -r item; do
        basename "${item}" 1>&2
    done <<< "${artifact_list}"


    # try filtering by architecture, original list stays intact
    filtered="$(filter_native_arch "${artifact_list}")"
    count=0
    [ -n "${filtered}" ] && count=$(echo "${filtered}" | wc -l)

    if [ "${count}" -eq 1 ]; then
        # reduced to one, use it
        best="${filtered}"
    elif [ "${count}" -gt 1 ]; then
        # continue with filtered list
        echo 1>&2
        echo "Filtered artifacts:" 1>&2
        while IFS= read -r item; do
            basename "${item}" 1>&2
        done <<< "${filtered}"
        artifact_list="${filtered}"
    fi

    if [ -z "${best}" ]; then
        reduced_list="$(reduce_artifacts "${artifact_list}")"
        reduced_list="$(prefer_gnu_over_musl "${reduced_list}")"
        reduced_list="$(prefer_supported_cpu_variant "${reduced_list}")"
        if [ "$(echo "${reduced_list}" | wc -l)" -eq 1 ]; then
            best="${reduced_list}"
        else
            artifact_list="${reduced_list}"
        fi
    fi

    if [ -z "${best}" ]; then
        [ ${YES} -eq 1 ] && fail "Multiple artifacts found"
        echo 1>&2
        best="$(printf '%s\n' "${artifact_list}" | prompt-select -p "Please select the artifact to install:" --delimiter '')"
    fi
    echo "Chose '$(basename "${best}")' as best candidate" 1>&2
    artifact="${best}"
fi

BINARY=""
artifact_tmp_path="/tmp/$(basename "${artifact}" | tr '.' '_')"
manual_install=0

echo 1>&2; echo "Installing from '${artifact}'..." 1>&2
if [[ "${artifact}" == *.deb ]]; then
    ARTIFACT_KIND="deb"
    install_deb "${artifact}" || manual_install=1
elif tar -tf "${artifact}" &> /dev/null; then
    ARTIFACT_KIND="tar"
    install_from_archive "${artifact}" "tar" "${target_path}" || manual_install=1
elif zipinfo -1 "${artifact}" &> /dev/null; then
    ARTIFACT_KIND="zip"
    install_from_archive "${artifact}" "zip" "${target_path}" || manual_install=1
elif file "${artifact}" | grep -q "ELF"; then
    ARTIFACT_KIND="binary"
    install_binary "${artifact}" "${target_path}" || manual_install=1
else
    error "Unknown artifact type: '${artifact}'"
    manual_install=1
fi

if [ ${manual_install} -eq 1 ]; then
    LC_ALL=C mv -vf "${artifact}" "${artifact_tmp_path}"
    echo 1>&2
    echo "Please install manually from:" 1>&2
    echo 1>&2
    echo "${artifact_tmp_path}" 1>&2
    ls -al "${artifact_tmp_path}" 1>&2
    abort 
fi

if [ "${DRY_RUN}" -eq 0 ] && [ -n "${BINARY}" ]; then
    echo 1>&2
    echo "Printing version of '${target_path}/${BINARY}':" 1>&2
    binary_version "${target_path}/${BINARY}" 1>&2
fi

run_post_install "${artifact}" "${ARTIFACT_KIND}" || abort

success

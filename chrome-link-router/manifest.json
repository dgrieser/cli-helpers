{
  "manifest_version": 3,
  "name": "Link router (cli-helpers)",
  "version": "1.0",
  "description": "Opens the links of some sites in their apps instead of a tab, e.g. Teams meeting links in the Teams app. The routes are in rules.json.",
  "key": "",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {"id": "routes", "enabled": true, "path": "rules.json"}
    ]
  }
}

#!/bin/bash

APP_NAME="$(basename "${0}")"

claude_session_folder="${HOME}/.claude/projects"
codex_session_folder="${HOME}/.codex/sessions"
codex_state_db="${HOME}/.codex/state_5.sqlite"
codex_session_prefix="rollout-"
# Claude writes a file per running process here, naming the session it has open
# and what that session is doing.
claude_peer_folder="${HOME}/.claude/sessions"
session_ext="jsonl"
directory_max_length=35
initial_batch_size=20
fzf_text_max_length=30
# without the prompt column the title gets the width the prompt would have used
fzf_title_max_length=50
print_title_max_length=50
print_prompt_max_length=60
fork_prompt_max_bytes=100000
# jq's gsub walks a string again per match, so collapsing the whitespace of a
# message of a few megabytes takes minutes. Only the beginning of a prompt is
# ever shown or searched, so the text is cut down before a pattern touches it.
prompt_scan_max_chars=8192
cache_folder="${XDG_CACHE_HOME:-${HOME}/.cache}/agent-session"
cache_max_lines=5000
# Where codex has no name for a session it keeps its first message as the title,
# which runs to megabytes. Fifty columns of it are ever shown, so the rest is
# left in the database instead of being read into every listing.
title_max_bytes=500
# a separator the texts of a session cannot carry and that bash does not treat
# as whitespace, so an empty field of a cached entry stays a field
cache_separator=$'\037'
# The open picker lists again on its own: every few seconds from what it listed
# last, reading only the sessions whose files changed since, and from scratch
# once a minute, for whatever that leaves out - a file that is gone, a title a
# session was given elsewhere.
refresh_seconds=5
refresh_full_seconds=60
all_agents="claude codex"
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_folder="$(dirname "${script_path}")"

# Match the table palette used by the git pickers in dev-helpers.
C_AGENT_CLAUDE=$'\033[38;5;141m'
C_AGENT_CODEX=$'\033[38;5;40m'
C_AGENT_OTHER=$'\033[38;5;208m'
C_AGE_SHORT=$'\033[38;5;40;3m'
C_AGE_LONG=$'\033[38;5;245m'
C_DIRECTORY=$'\033[38;5;33m'
C_TITLE=$'\033[38;5;250m'
C_PROMPT=$'\033[38;5;110m'
C_MUTED=$'\033[90m'
C_RESET=$'\033[0m'
# the marker of a session that is open in a running agent: what it is doing
# decides its symbol and its color, and a session nobody has open gets none
C_LIVE_WORKING=$'\033[38;5;45m'
# the one marker that wants to be seen from across the room, so it blinks; the
# symbol alone carries it, the rest of the row stays still
C_LIVE_WAITING=$'\033[38;5;208;5m'
C_LIVE_OPEN=$'\033[38;5;40m'
declare -A live_symbols=(
    [working]=$'\u25b6'
    # the keyboard with the variation selector that asks for its text shape
    [waiting]=$'\u2328\ufe0e'
    [open]=$'\u2714'
)
# The glyphs are drawn at different widths, so each is nudged right by as many
# spaces as it takes for them to stand over each other. The spaces go between
# copies of the color of the marker and not next to each other, because
# k-format reads a run of two spaces as the end of a cell.
declare -A live_paddings=(
    [working]=1
    [waiting]=0
    [open]=1
)
# A cell of its own is what keeps the markers under each other, and the column
# formatter drops a cell that holds nothing at all. A session nobody has open
# and the heading of the column therefore hold a color and no character: that is
# a cell to the formatter and nothing to the eye.
live_empty_cell="${C_RESET}"
declare -A live_colors=(
    [working]="${C_LIVE_WORKING}"
    [waiting]="${C_LIVE_WAITING}"
    [open]="${C_LIVE_OPEN}"
)
declare -A agent_colors=(
    [claude]="${C_AGENT_CLAUDE}"
    [codex]="${C_AGENT_CODEX}"
)

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [SESSION]

Browses sessions of the claude and codex CLIs, user and agent messages

SESSION   the ID of the session to print; omit to browse sessions

Options:
    -h, --help          Show this message
    -a, --agent AGENT   Only use sessions of AGENT (claude or codex; default: both)
    -l, --last          Print the latest session
    -n, --limit LIMIT   Limit sessions by count instead of age
    -d, --days DAYS     Only list sessions active within DAYS (default: 60)
    -c, --current-directory
                        Only list sessions from the current directory; the
                        picker always starts with all of them
    -A, --all-directories
                        List sessions from all directories (the default)
    -o, --open          Only list the sessions open in a running agent; the
                        picker always starts with them
    -p, --print         Print the session table instead of opening the picker
    -P, --prompt-column Show the first prompt as a column of its own; without it
                        the prompt stays searchable in the picker
    -g, --grep GREP     Filter listed sessions by a regex match in their messages
    -i, --igrep GREP    Filter listed sessions by a case-insensitive regex match
    -r, --raw           Raw output
    --resume SESSION    Resume the session with SESSION in its directory
    --fork SESSION      Fork the session with SESSION, asking for the folder
                        and the agent
    --bash-completion   Print completion candidates and exit
    --verbose           Verbose output

Called as claude-session or codex-session the matching agent is preselected.

A session that is open in a running agent carries a marker next to its agent:
    ▶   working on something right now
    ⌨︎   waiting for you: a question, a permission, a plan to confirm
    ✔   open, with nothing to do
Codex does not write down what it waits for; a session counts as waiting when
its last call asks to run a command outside the sandbox or asks you a question
and nothing runs for it yet. The state is searchable in the picker,
as '@working, '@waiting or '@open - the leading quote is fzf's exact match,
without which its letters are found spread over the rest of the row.

The open picker refreshes itself every ${refresh_seconds} seconds: the sessions whose files
were written since - new ones, resumed ones, working ones - are read again, and
every row gets its age and its marker anew. Once every ${refresh_full_seconds} seconds the
list is made from scratch instead.

The title, the first prompt and the directory of a session are cached in
    ${cache_folder}
keyed by the session file and read again as soon as that file changes. Removing
the folder costs the next listing its speed and nothing else.

Interactive keys:
    /                   Search messages case-insensitively
    enter               Use the session: asks what is to happen with it
    tab                 Toggle the open sessions only (the start) and all of them
    ctrl-space          Show the folders of the listed sessions to pick the scope
                        from, <all> first; the cursor starts on the folder the
                        picker was started in, or on <all> while a folder is
                        picked; enter picks, esc and ctrl-space go back
    ctrl-s              Take that folder from the selected session
    ctrl-a              Walk the agent filter: both, claude only, codex only
    ctrl-f              Focus the terminal a running session is open in
    ctrl-r              Refresh sessions
    esc                 Clear an active search, exit without one
    ctrl-c              Exit

Asked for the selected session, esc stepping back one question and out of
the first one into the picker again:
    Resume              Resume the session in its original directory
    Focus terminal      In place of Resume for a running session: bring the
                        terminal it runs in to the front, the picker stays open
    Fork                Continue it, asking for the folder and the agent
    Copy                Copy raw Markdown to the clipboard
    Print               Print it, asking for rendered Markdown or raw

Copy and Print each share their row with a last message variant, tab
(shift-tab backwards) walking over the two of them.
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

verbose() {
    local message

    [ "${verbose}" -eq 0 ] && return
    message="${1//$'\n'/$'\n+ '}"
    printf '+ %s\n' "${message}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

muted() {
    printf '%s%s%s\n' "${C_MUTED}" "${1}" "${C_RESET}" 1>&2
}

truncate_middle() {
    local value="${1}"
    local max_length="${2}"
    local marker="..."
    local start_length
    local end_length

    [ "${#value}" -le "${max_length}" ] && echo "${value}" && return

    start_length=$(( (max_length - ${#marker}) / 2 ))
    end_length=$(( max_length - ${#marker} - start_length ))
    echo "${value:0:${start_length}}${marker}${value: -${end_length}}"
}

shorten_path() {
    local path="${1}"
    local max_length="${2}"
    local parts
    local part_count
    local prefix
    local collapse_start
    local collapse_end
    local shortened
    local index

    [ "${#path}" -le "${max_length}" ] && echo "${path}" && return

    IFS='/' read -r -a parts <<< "${path}"
    part_count="${#parts[@]}"

    if [[ "${path}" == /* ]]; then
        [ "${part_count}" -le 3 ] && truncate_middle "${path}" "${max_length}" && return
        prefix="/${parts[1]}"
        collapse_start=2
    else
        [ "${part_count}" -le 3 ] && truncate_middle "${path}" "${max_length}" && return
        prefix="${parts[0]}/${parts[1]}"
        collapse_start=2
    fi

    for (( collapse_end=collapse_start; collapse_end<part_count-1; collapse_end++ )); do
        shortened="${prefix}/..."
        for (( index=collapse_end+1; index<part_count; index++ )); do
            shortened+="/${parts[index]}"
        done
        [ "${#shortened}" -le "${max_length}" ] && echo "${shortened}" && return
    done

    truncate_middle "${shortened}" "${max_length}"
}

# Leaves the shortened text in shortened_text. A listing shortens two texts per
# row and a subshell per row is what that would cost otherwise.
shortened_text=""

set_shortened_text() {
    local text="${1}"
    local max_length="${2}"

    if [ "${#text}" -le "${max_length}" ]; then
        shortened_text="${text}"
    else
        shortened_text="${text:0:$((max_length - 3))}..."
    fi
}

shorten_text() {
    set_shortened_text "${1}" "${2}"
    echo "${shortened_text}"
}

display_path() {
    local path="${1}"
    local home_display="~"

    [ "${path}" = "${HOME}" ] && path="${home_display}"
    [[ "${path}" == "${HOME}/"* ]] && path="${home_display}/${path#"${HOME}/"}"
    printf '%s' "${path}"
}

format_cwd() {
    local cwd="${1}"

    shorten_path "$(display_path "${cwd}")" "${directory_max_length}"
}

# Common jq snippets. Both agents end up with a list of {role, text} objects,
# so listing and printing share the same shape.
# shellcheck disable=SC2016 # jq programs, no shell expansion wanted
jq_claude_messages='
    def text_content:
        if type == "string" then .
        elif type == "array" then [.[]? | select(.type == "text") | .text] | join("\n")
        else "" end;
    def role_label:
        if .type == "assistant" then "Assistant"
        elif .type == "user" then "User"
        else empty end;
    def messages:
        [
            .[]
            | select((.type == "assistant" or .type == "user") and ((.isMeta // false) | not))
            | select(.message.content? != null)
            | {role: role_label, text: (.message.content | text_content)}
            | select(.role != null)
            | .text |= (gsub("^[[:space:]]+|[[:space:]]+$"; ""))
            | select(.role == "Assistant" or (.text | test("^<command-name>|^<local-command-|^<tool_result>"; "n") | not))
            | select(.text | length > 0)
        ];
'

# shellcheck disable=SC2016 # jq programs, no shell expansion wanted
jq_codex_messages='
    def messages:
        (
            [
                .[]
                | select(.type == "event_msg")
                | .payload
                | select(.type == "user_message" or .type == "agent_message")
                | {role: (if .type == "user_message" then "User" else "Assistant" end), text: (.message // "")}
            ]
        ) as $events
        | (
            if ($events | length) > 0 then
                $events
            else
                [
                    .[]
                    | (.payload // .)
                    | select(.type == "message" and (.role == "user" or .role == "assistant"))
                    | {role: (if .role == "user" then "User" else "Assistant" end),
                       text: ([.content[]? | (.text // "")] | join("\n"))}
                ]
            end
        )
        | map(.text |= (gsub("^[[:space:]]+|[[:space:]]+$"; "")))
        | map(select(.role == "Assistant" or (.text | test("^<environment_context>|^<user_instructions>|^<user_shell>"; "n") | not)))
        | map(select(.text | length > 0));
'

jq_messages() {
    local agent="${1}"

    case "${agent}" in
        claude)
            echo "${jq_claude_messages}"
            ;;
        codex)
            echo "${jq_codex_messages}"
            ;;
    esac
}

session_folder() {
    local agent="${1}"

    case "${agent}" in
        claude)
            echo "${claude_session_folder}"
            ;;
        codex)
            echo "${codex_session_folder}"
            ;;
    esac
}

# Claude keeps the sessions of a working directory in one folder, named after
# that directory with everything that is not a letter or a digit turned into a
# dash. The name does not give a directory back, but it rules every other
# project out without a single session file being opened.
claude_project_folder() {
    local cwd="${1}"

    printf '%s/%s' "${claude_session_folder}" "${cwd//[![:alnum:]]/-}"
}

# The name above is claude's to choose, so it is only trusted where it can be
# seen to hold: a folder of this directory that is there says so by being there,
# and where there is none, one session of another folder is asked. A claude that
# named its folders differently one day would make the listing read the files
# again, not drop every session of the directory.
claude_current_folder=""
claude_folder_checked=0

claude_folder_rule_holds() {
    local folder
    local filepath

    for folder in "${claude_session_folder}"/*/; do
        [ -d "${folder}" ] || continue
        for filepath in "${folder}"*.jsonl; do
            [ -f "${filepath}" ] || continue
            [ "$(claude_project_folder "$(session_cwd_from_file claude "${filepath}")")" \
                = "${folder%/}" ]
            return
        done
    done
    return 1
}

ensure_claude_current_folder() {
    [ "${claude_folder_checked}" -eq 1 ] && return 0
    claude_folder_checked=1
    claude_current_folder="$(claude_project_folder "${current_directory}")"
    [ -d "${claude_current_folder}" ] && return 0
    claude_folder_rule_holds || claude_current_folder=""
}

# realpath is a process of its own and the sessions of a listing share a handful
# of working directories, so each of them is resolved once.
declare -A resolved_directories=()
resolved_directory=""

resolve_directory() {
    local path="${1}"

    if [ -z "${resolved_directories[${path}]+set}" ]; then
        resolved_directories["${path}"]="$(realpath -m -- "${path}")"
    fi
    resolved_directory="${resolved_directories[${path}]}"
}

# Codex keeps a row per session in its state database, the working directory and
# the title among its columns. One query answers for all of them at once, where
# reading the files would be one jq per session.
declare -A codex_cwd_by_path=()
declare -A codex_title_by_path=()
codex_state_loaded=0

load_codex_state() {
    local path
    local cwd
    local title

    [ "${codex_state_loaded}" -eq 1 ] && return 0
    codex_state_loaded=1
    command -v sqlite3 >/dev/null 2>&1 || return 0
    [ -r "${codex_state_db}" ] || return 0
    while IFS=$'\t' read -r path cwd title; do
        [ -n "${path}" ] || continue
        codex_cwd_by_path["${path}"]="${cwd}"
        codex_title_by_path["${path}"]="${title}"
    done < <(sqlite3 -readonly -separator $'\t' "${codex_state_db}" "
        SELECT rollout_path,
               replace(replace(replace(cwd, char(10), ' '), char(13), ' '), char(9), ' '),
               substr(replace(replace(replace(COALESCE(NULLIF(name, ''), title), char(10), ' '), char(13), ' '), char(9), ' '), 1, ${title_max_bytes})
        FROM threads;" 2>/dev/null)
    warm_resolved_directories
}

# The first prompt of a codex session is a column of its state database as well,
# and it is the message the user actually typed - the session file starts with
# what the harness wrapped around it, a review task or the instructions of the
# repository, which is not what the session was about. Only the rows a listing
# shows need one and the cache answers for most of them, so they are asked for
# together instead of being loaded for every session there is.
declare -A codex_prompt_by_path=()

preload_codex_prompts() {
    local entry
    local agent
    local mtime
    local size
    local filepath
    local cached
    local cached_mtime
    local cached_size
    local missing=()
    local quoted
    local list=""
    local path
    local prompt

    command -v sqlite3 >/dev/null 2>&1 || return 0
    [ -r "${codex_state_db}" ] || return 0
    for entry in "${session_entries[@]}"; do
        IFS=$'\t' read -r agent mtime _ size filepath <<< "${entry}"
        [ "${agent}" = "codex" ] || continue
        cached="${metadata_cache[${filepath}]-}"
        if [ -n "${cached}" ]; then
            IFS="${cache_separator}" read -r cached_mtime cached_size _ <<< "${cached}"
            [ "${cached_mtime}" = "${mtime}" ] && [ "${cached_size}" = "${size}" ] && continue
        fi
        missing+=("${filepath}")
    done
    [ "${#missing[@]}" -gt 0 ] || return 0

    for path in "${missing[@]}"; do
        quoted="${path//\'/\'\'}"
        list+="${list:+,}'${quoted}'"
    done
    # awk stands in for the patterns the prompt of a session file is put
    # through: the tags of a wrapped prompt dropped and its whitespace
    # collapsed, done once for the whole answer instead of once per row.
    while IFS=$'\t' read -r path prompt; do
        [ -n "${path}" ] || continue
        codex_prompt_by_path["${path}"]="${prompt}"
    done < <(sqlite3 -readonly -separator $'\t' "${codex_state_db}" "
        SELECT rollout_path,
               substr(replace(replace(replace(first_user_message, char(10), ' '), char(13), ' '), char(9), ' '), 1, ${prompt_scan_max_chars})
        FROM threads
        WHERE rollout_path IN (${list});" 2>/dev/null \
        | awk -F'\t' 'BEGIN { OFS = "\t" } {
            gsub(/<[^>]*>/, "", $2)
            gsub(/ +/, " ", $2)
            sub(/^ /, "", $2)
            sub(/ $/, "", $2)
            print
        }')
}

# Every working directory a codex session names is resolved in one call, so that
# the listing below does not start a realpath per directory it walks past.
warm_resolved_directories() {
    local -A seen=()
    local -a paths=()
    local path
    local resolved
    local index=0

    for path in "${codex_cwd_by_path[@]}"; do
        [ -n "${path}" ] || continue
        [ -n "${seen[${path}]+set}" ] && continue
        seen["${path}"]=1
        paths+=("${path}")
    done
    [ "${#paths[@]}" -gt 0 ] || return 0
    while IFS= read -r resolved; do
        resolved_directories["${paths[index]}"]="${resolved}"
        index=$((index + 1))
    done < <(printf '%s\0' "${paths[@]}" | xargs -0 -r realpath -m -- 2>/dev/null)
}

# What a listing shows of a session - its working directory, its title and its
# first prompt - is what reading the session file costs, and none of it changes
# while the file does not. It is kept in a file of its own, keyed by the path of
# the session and checked against its modification time and its size. That file
# is a log: a new entry is appended and the last one of a path wins, and it is
# rewritten once it has grown past what the sessions need.
declare -A metadata_cache=()
metadata_cache_file=""
metadata_cache_lines=0
metadata_cache_additions=()
session_meta_cwd=""
session_meta_title=""
session_meta_prompt=""

load_metadata_cache() {
    local line
    local filepath

    metadata_cache_file="${cache_folder}/metadata.tsv"
    [ -r "${metadata_cache_file}" ] || return 0
    while IFS= read -r line; do
        filepath="${line%%"${cache_separator}"*}"
        [ -n "${filepath}" ] && [ "${filepath}" != "${line}" ] || continue
        metadata_cache["${filepath}"]="${line#*"${cache_separator}"}"
        metadata_cache_lines=$((metadata_cache_lines + 1))
    done < "${metadata_cache_file}"
}

remember_session_metadata() {
    local filepath="${1}"
    local mtime="${2}"
    local size="${3}"
    local entry

    entry="${mtime}${cache_separator}${size}"
    entry+="${cache_separator}${session_meta_cwd//[$'\t\r\n\037']/ }"
    entry+="${cache_separator}${session_meta_title//[$'\t\r\n\037']/ }"
    entry+="${cache_separator}${session_meta_prompt//[$'\t\r\n\037']/ }"
    metadata_cache["${filepath}"]="${entry}"
    metadata_cache_additions+=("${filepath}${cache_separator}${entry}")
}

flush_metadata_cache() {
    local filepath
    local temp_file

    [ -n "${metadata_cache_file}" ] || return 0
    [ "${#metadata_cache_additions[@]}" -gt 0 ] || return 0
    mkdir -p -- "${cache_folder}" 2>/dev/null || return 0
    if [ $(( metadata_cache_lines + ${#metadata_cache_additions[@]} )) -le "${cache_max_lines}" ]; then
        printf '%s\n' "${metadata_cache_additions[@]}" >> "${metadata_cache_file}"
        metadata_cache_additions=()
        return 0
    fi
    # The log has outgrown the sessions it describes, so it is written again
    # from what is left of it: one entry per session, none for a file that is
    # gone.
    temp_file="$(mktemp "${metadata_cache_file}.XXXXXX")" || return 0
    for filepath in "${!metadata_cache[@]}"; do
        [ -f "${filepath}" ] || continue
        printf '%s%s%s\n' "${filepath}" "${cache_separator}" "${metadata_cache[${filepath}]}"
    done > "${temp_file}"
    mv -f -- "${temp_file}" "${metadata_cache_file}" 2>/dev/null || rm -f -- "${temp_file}"
    metadata_cache_additions=()
}

# Which sessions are open in a running agent, and what they are doing.
# Claude publishes a file per process naming the session it has open and its
# state, so it answers both. Codex publishes nothing, but the process that has a
# session open holds its file open, and the last turn event written to that file
# says whether it is still working on something, the last call whether it waits
# for you. None of this is cached: it is what the sessions are doing right now,
# and it changes while the picker is up.
declare -A live_state_by_id=()
declare -A live_detail_by_id=()
# the agent process that has the session open, for finding its terminal
declare -A live_pid_by_id=()
# the session file, where the agent names it: codex holds it open
declare -A live_file_by_id=()
live_sessions_loaded=0

load_live_sessions() {
    [ "${live_sessions_loaded}" -eq 1 ] && return 0
    live_sessions_loaded=1
    load_claude_live_sessions
    load_codex_live_sessions
}

# A file of the folder outlives the session that wrote it and a process id is
# handed out again, so the start time of the process has to agree with the one
# the file was written with.
process_is_alive() {
    local pid="${1}"
    local started="${2}"
    local stat_line
    local fields=()

    [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
    [ -n "${started}" ] || return 1
    [ -r "/proc/${pid}/stat" ] || return 1
    stat_line="$(< "/proc/${pid}/stat")"
    # the name of the process is in brackets and can hold anything, the numbers
    # after it cannot, so the last bracket is where the fields start
    read -r -a fields <<< "${stat_line##*') '}"
    [ "${fields[19]}" = "${started}" ]
}

load_claude_live_sessions() {
    local files=()
    local file
    local id
    local pid
    local started
    local status
    local waiting

    [ -d "${claude_peer_folder}" ] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    for file in "${claude_peer_folder}"/*.json; do
        [ -f "${file}" ] && files+=("${file}")
    done
    [ "${#files[@]}" -gt 0 ] || return 0

    while IFS=$'\t' read -r id pid started status waiting; do
        [ -n "${id}" ] && [ "${id}" != "-" ] || continue
        process_is_alive "${pid}" "${started}" || continue
        live_pid_by_id["${id}"]="${pid}"
        case "${status}" in
            busy | shell)
                live_state_by_id["${id}"]="working"
                ;;
            waiting)
                live_state_by_id["${id}"]="waiting"
                ;;
            *)
                live_state_by_id["${id}"]="open"
                ;;
        esac
        [ "${waiting}" != "-" ] && live_detail_by_id["${id}"]="${waiting}"
    done < <(jq -rc '[(.sessionId // "-"), (.pid // "-"), (.procStart // "-"),
                      (.status // "-"), (.waitingFor // "-")] | @tsv' "${files[@]}" 2>/dev/null)
}

load_codex_live_sessions() {
    local pids=()
    local pid
    local target

    command -v pgrep >/dev/null 2>&1 || return 0
    mapfile -t pids < <(pgrep -x codex 2>/dev/null)
    [ "${#pids[@]}" -gt 0 ] || return 0
    for pid in "${pids[@]}"; do
        while IFS= read -r target; do
            case "${target}" in
                "${codex_session_folder}"/*."${session_ext}")
                    read_session_id codex "${target}"
                    live_pid_by_id["${session_id_value}"]="${pid}"
                    live_file_by_id["${session_id_value}"]="${target}"
                    read_codex_live_state "${pid}" "${target}"
                    ;;
            esac
        done < <(readlink -- "/proc/${pid}/fd/"* 2>/dev/null)
    done
}

# Codex writes the start and the end of a turn into the session file, so the
# last of the two says whether it is still working on one. What it waits for
# inside a turn it does not write down, but the call that makes it wait is
# there: a command that asks to run outside the sandbox, or a question to the
# user, with no output after it yet. Such a call is written before it is
# approved or answered; once it runs, its command is a process below codex, so
# a call without one is still at the prompt. The code mode host is a child of
# codex for as long as it runs and says nothing about a command.
jq_codex_pending_prompt='
    [inputs | .payload // {}] as $items
    | ([$items | to_entries[]
        | select(.value.type == "custom_tool_call" or .value.type == "function_call")]
        | last) as $call
    | select($call != null)
    | select([$items[$call.key + 1:][]
              | select(.call_id == $call.value.call_id
                       and ((.type // "") | endswith("_output")))]
             | length == 0)
    | $call.value
    | if .name == "request_user_input" then "question"
      elif ((.input // .arguments // "") | contains("require_escalated")) then "approval"
      else empty end
'

codex_has_command_process() {
    local pid="${1}"
    local child

    while IFS= read -r child; do
        [ "$(< "/proc/${child}/comm")" != "codex-code-mode" ] && return 0
    done < <(pgrep -P "${pid}" 2>/dev/null)
    return 1
}

# Leaves the state of the session in live_state_by_id and what it waits for in
# live_detail_by_id, under session_id_value.
read_codex_live_state() {
    local pid="${1}"
    local filepath="${2}"
    local last
    local pending

    # read from the end, so a session of megabytes costs the length of its
    # last turn and not the length of its history
    last="$(tac -- "${filepath}" 2>/dev/null | grep -m 1 -oE '"task_started"|"task_complete"')"
    if [ "${last}" != '"task_started"' ]; then
        live_state_by_id["${session_id_value}"]="open"
        return 0
    fi
    live_state_by_id["${session_id_value}"]="working"
    # the call that waits is among the last lines; what follows it is the
    # bookkeeping of the turn, not output
    pending="$(tail -n 50 -- "${filepath}" 2>/dev/null \
        | jq -rn "${jq_codex_pending_prompt}" 2>/dev/null)"
    [ -n "${pending}" ] || return 0
    codex_has_command_process "${pid}" && return 0
    live_state_by_id["${session_id_value}"]="waiting"
    live_detail_by_id["${session_id_value}"]="${pending}"
}

# The marker cell of a row, left in live_marker, and the words that make its
# state searchable in the picker, left in live_words. The state word carries an
# @, so that a query for it finds the sessions that are in that state and not
# the ones that happen to say "working" in their title.
live_marker=""
live_words=""

read_live_marker() {
    local agent="${1}"
    local filepath="${2}"
    local state
    local color
    local pad

    live_marker="${live_empty_cell}"
    live_words=""
    read_session_id "${agent}" "${filepath}"
    state="${live_state_by_id[${session_id_value}]-}"
    [ -n "${state}" ] || return 0
    color="${live_colors[${state}]}"
    live_marker="${color}"
    for (( pad = live_paddings[${state}]; pad > 0; pad-- )); do
        live_marker+=" ${color}"
    done
    live_marker+="${live_symbols[${state}]}${C_RESET}"
    live_words="@${state}${live_detail_by_id[${session_id_value}]:+ ${live_detail_by_id[${session_id_value}]}}"
}

# Leaves what a listing shows of a session in session_meta_cwd,
# session_meta_title and session_meta_prompt: from the cache where the file has
# not changed since the entry was written, from the file itself otherwise.
read_session_metadata() {
    local agent="${1}"
    local filepath="${2}"
    local mtime="${3}"
    local size="${4}"
    local entry
    local cached_mtime
    local cached_size

    entry="${metadata_cache[${filepath}]-}"
    if [ -n "${entry}" ]; then
        IFS="${cache_separator}" read -r cached_mtime cached_size \
            session_meta_cwd session_meta_title session_meta_prompt <<< "${entry}"
        if [ "${cached_mtime}" = "${mtime}" ] && [ "${cached_size}" = "${size}" ]; then
            return 0
        fi
    fi

    read_session_cwd "${agent}" "${filepath}"
    session_meta_cwd="${session_directory_value}"
    session_meta_prompt="$(session_prompt "${agent}" "${filepath}")"
    session_meta_title="$(session_title "${agent}" "${filepath}" "${session_meta_prompt}")"
    remember_session_metadata "${filepath}" "${mtime}" "${size}"
}

# Emits "<mtime epoch>\t<agent>\t<mtime datetime>\t<size>\t<filepath>" per
# session file. The modification time is the last activity of the session, and
# together with the size it says whether a cached entry still describes it.
agent_session_files() {
    local agent="${1}"
    local folder
    local find_format
    local find_args

    folder="$(session_folder "${agent}")"
    [ -d "${folder}" ] || return 0

    find_format='%T@\t'"${agent}"'\t%TY-%Tm-%TdT%TH:%TM:%TS\t%s\t%p\n'
    case "${agent}" in
        claude)
            find_args=( "${folder}" '-mindepth' '2' '-maxdepth' '2' '-name' "*.${session_ext}" )
            ;;
        codex)
            find_args=( "${folder}" '-name' "${codex_session_prefix}*.${session_ext}" )
            ;;
    esac

    find "${find_args[@]}" -printf "${find_format}"
}

session_files() {
    local agent

    for agent in ${agents}; do
        agent_session_files "${agent}"
    done | LC_ALL=C sort -n
}

# Leaves the id of the session in session_id_value; a listing asks for one per
# row, which is a subshell per row when it is echoed instead.
session_id_value=""

read_session_id() {
    local agent="${1}"
    local filepath="${2}"
    local filename

    filename="${filepath##*/}"
    filename="${filename%."${session_ext}"}"
    session_id_value="${filename}"

    case "${agent}" in
        codex)
            if [[ "${filename}" =~ ^${codex_session_prefix}[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-(.+)$ ]]; then
                session_id_value="${BASH_REMATCH[1]}"
            else
                session_id_value="${filename#"${codex_session_prefix}"}"
            fi
            ;;
    esac
}

session_id_of() {
    read_session_id "${1}" "${2}"
    printf '%s' "${session_id_value}"
}

session_cwd_from_file() {
    local agent="${1}"
    local filepath="${2}"
    local filter

    case "${agent}" in
        claude)
            filter='first(inputs | select(.cwd? != null) | .cwd) // ""'
            ;;
        codex)
            filter='first(inputs | select(.type == "session_meta") | .payload.cwd) // ""'
            ;;
    esac
    jq -rn "${filter}" "${filepath}"
}

# Leaves the working directory of the session in session_directory_value, taken
# from the state database of codex where that knows it, so that the file is only
# opened where nothing else answers. It is a variable and not an echo, because
# one process per session is what this is here to avoid.
session_directory_value=""

read_session_cwd() {
    local agent="${1}"
    local filepath="${2}"

    if [ "${agent}" = "codex" ] && [ -n "${codex_cwd_by_path[${filepath}]+set}" ]; then
        session_directory_value="${codex_cwd_by_path[${filepath}]}"
        return 0
    fi
    session_directory_value="$(session_cwd_from_file "${agent}" "${filepath}")"
}

session_cwd() {
    [ "${1}" = "codex" ] && load_codex_state
    read_session_cwd "${1}" "${2}"
    printf '%s' "${session_directory_value}"
}

session_is_in_directory() {
    local agent="${1}"
    local filepath="${2}"
    local directory="${3}"

    # The folder a claude session lies in already says which directory it can
    # belong to, and says so without opening anything; the name being lossy, the
    # session itself still has the last word.
    [ "${agent}" = "claude" ] && ensure_claude_current_folder
    if [ "${agent}" = "claude" ] && [ -n "${claude_current_folder}" ] \
        && [ "${directory}" = "${current_directory}" ] \
        && [[ "${filepath}" != "${claude_current_folder}/"* ]]; then
        return 1
    fi
    read_session_cwd "${agent}" "${filepath}"
    [ -n "${session_directory_value}" ] || return 1
    [ "${session_directory_value}" = "${directory}" ] && return 0
    resolve_directory "${session_directory_value}"
    [ "${resolved_directory}" = "${directory}" ]
}

# Finds the one session an ID or a part of one refers to, leaving its agent and
# its file in session_match_agent and session_match_filepath. Sessions outside
# the current directory are only looked at where all_directories is 1.
find_session() {
    local wanted="${1}"
    local all_directories="${2}"
    local agent
    local filepath
    local matches=()

    session_match_agent=""
    session_match_filepath=""
    load_codex_state
    while IFS=$'\t' read -r _ agent _ _ filepath; do
        [ -n "${filepath}" ] || continue
        if [ "${all_directories}" -eq 0 ] \
            && ! session_is_in_directory "${agent}" "${filepath}" "${current_directory}"; then
            continue
        fi
        case "$(session_id_of "${agent}" "${filepath}")" in
            *"${wanted}"*)
                matches+=("${agent}"$'\t'"${filepath}")
                ;;
        esac
    done < <(session_files)
    [ "${#matches[@]}" -eq 0 ] && fail "No such session: ${wanted}"
    [ "${#matches[@]}" -gt 1 ] && fail "Multiple matches for session: ${wanted}"
    IFS=$'\t' read -r session_match_agent session_match_filepath <<< "${matches[0]}"
    verbose "${session_match_agent} ${session_match_filepath}"
}

# One line per message, whitespace collapsed, so that patterns spanning line
# breaks of a message still match. Streamed instead of slurped, so that a
# reader stopping at the first match does not pay for the whole session, and the
# collapsing is left to tr, which walks a message once where jq's gsub needs
# minutes for one of a few megabytes. The messages are handed over separated by
# SOH, which tr turns into the line breaks between them afterwards.
# shellcheck disable=SC2016 # jq programs, no shell expansion wanted
jq_claude_message_texts='
    def text_content:
        if type == "string" then .
        elif type == "array" then [.[]? | select(.type == "text") | .text] | join(" ")
        else "" end;
    inputs
    | select((.type == "assistant" or .type == "user") and ((.isMeta // false) | not))
    | select(.message.content? != null)
    | (.message.content | text_content)
    | select(length > 0)
    | (., "\u0001")
'

# shellcheck disable=SC2016 # jq programs, no shell expansion wanted
jq_codex_message_texts='
    inputs
    | if .type == "event_msg" then
          .payload
          | select(.type == "user_message" or .type == "agent_message")
          | (.message // "")
      else
          (.payload // .)
          | select(.type == "message" and (.role == "user" or .role == "assistant"))
          | ([.content[]? | (.text // "")] | join(" "))
      end
    | select(length > 0)
    | (., "\u0001")
'

session_messages() {
    local agent="${1}"
    local filepath="${2}"
    local filter

    case "${agent}" in
        claude)
            filter="${jq_claude_message_texts}"
            ;;
        codex)
            filter="${jq_codex_message_texts}"
            ;;
    esac
    jq -jn "${filter}" "${filepath}" 2>/dev/null \
        | tr -s '[:space:]' ' ' \
        | tr '\001' '\n'
}

# What is made of the first prompt once it has been found, and the reason the
# text is cut down before it: every pattern here is a gsub, and jq walks the
# whole string again for each match it makes.
# shellcheck disable=SC2016 # jq program, no shell expansion wanted
jq_prompt_tail='
    | (capture("<command-message>(?<message>.*?)</command-message>"; "n").message? // .)
    | gsub("<[^>]+>"; "")
    | gsub("^[[:space:]]+|[[:space:]]+$"; "")
    | gsub("[[:space:]]+"; " ")
'

# The first prompt of the session. Only the message it needs is read, the stream
# stopping there instead of building every message of the session first.
session_prompt() {
    local agent="${1}"
    local filepath="${2}"
    local prompt

    case "${agent}" in
        claude)
            jq -rn '
                def text_content:
                    if type == "string" then .
                    elif type == "array" then [.[]? | select(.type == "text") | .text] | join("\n")
                    else "" end;
                first(
                    inputs
                    | select(.type == "user" and ((.isMeta // false) | not))
                    | select(.message.content? != null)
                    | (.message.content | text_content)
                    | .[0:'"${prompt_scan_max_chars}"']
                    | gsub("^[[:space:]]+|[[:space:]]+$"; "")
                    | select(length > 0)
                    | select(test("^<command-name>|^<local-command-|^<tool_result>"; "n") | not)
                ) // ""
                '"${jq_prompt_tail}" "${filepath}" 2>/dev/null
            ;;
        codex)
            # What the user typed, where the state database has it. The session
            # file only says what the harness sent first, which for a review or
            # a session with repository instructions is not the prompt.
            prompt="${codex_prompt_by_path[${filepath}]-}"
            if [ -n "${prompt}" ]; then
                printf '%s' "${prompt}"
                return 0
            fi
            prompt="$(jq -rn '
                first(
                    inputs
                    | select(.type == "event_msg")
                    | .payload
                    | select(.type == "user_message")
                    | (.message // "")
                    | .[0:'"${prompt_scan_max_chars}"']
                    | gsub("^[[:space:]]+|[[:space:]]+$"; "")
                    | select(length > 0)
                    | select(test("^<environment_context>|^<user_instructions>|^<user_shell>"; "n") | not)
                ) // ""
                '"${jq_prompt_tail}" "${filepath}" 2>/dev/null)"
            # Sessions of an older codex recorded their messages in a shape only
            # the whole file tells apart from this one, so that shape is asked
            # where the streamed one found nothing.
            if [ -z "${prompt}" ]; then
                prompt="$(jq -rs "${jq_codex_messages}"'
                    messages
                    | map(select(.role == "User"))
                    | .[0].text // ""
                    | .[0:'"${prompt_scan_max_chars}"']
                    '"${jq_prompt_tail}" "${filepath}" 2>/dev/null)"
            fi
            printf '%s' "${prompt}"
            ;;
    esac
}

# The generated title of the session; the first prompt stands in for sessions
# without one. A caller that has the prompt already hands it over, so it is not
# read from the session file a second time.
session_title() {
    local agent="${1}"
    local filepath="${2}"
    local fallback="${3-}"
    local session_id
    local title=""

    case "${agent}" in
        claude)
            # grep picks the few lines that can carry a title out of a file of
            # any size and jq only reads those; a line of a message quoting the
            # marker drops out there.
            title="$(grep -F '"type":"ai-title"' "${filepath}" 2>/dev/null \
                | jq -rR 'fromjson? | select(.type == "ai-title") | .aiTitle // empty' 2>/dev/null \
                | tail -1)"
            ;;
        codex)
            if [ -n "${codex_title_by_path[${filepath}]+set}" ]; then
                title="${codex_title_by_path[${filepath}]}"
            else
                session_id="$(session_id_of "${agent}" "${filepath}")"
                if command -v sqlite3 >/dev/null 2>&1 \
                    && [ -r "${codex_state_db}" ] \
                    && [[ "${session_id}" =~ ^[[:alnum:]-]+$ ]]; then
                    title="$(sqlite3 -readonly "${codex_state_db}" \
                        "SELECT substr(COALESCE(NULLIF(name, ''), title), 1, ${title_max_bytes}) FROM threads WHERE id = '${session_id}' LIMIT 1;" \
                        2>/dev/null)"
                fi
            fi
            ;;
    esac

    if [ -z "${title}" ]; then
        [ -n "${fallback}" ] || fallback="$(session_prompt "${agent}" "${filepath}")"
        title="${fallback}"
    fi
    printf '%s' "${title}" | tr '\t\r\n' '   ' | tr -s ' '
}

agent_color() {
    printf '%s' "${agent_colors[${1}]-${C_AGENT_OTHER}}"
}

# All ages of a listing come from a single toage call - one call per session
# would start a Python interpreter per row - and against one reference point, so
# the column stays consistent while it is built. The precision shrinks as a
# session gets older: seconds only below a minute, minutes below two hours,
# hours below two days. The colors of the column are handed over as well, so a
# recent session comes back highlighted and an old one faded.
format_ages() {
    local now="${1}"
    shift

    [ "${#}" -gt 0 ] || return 0
    toage --units wdhms --min 1s \
          --drop-seconds 1m --drop-minutes 2h --drop-hours 2d \
          --color "1h=${C_AGE_SHORT}" --color "${C_AGE_LONG}" \
          --now "${now}" -- "${@}"
}

# the scope and the search of the picker can be changed while it is open, so they
# live in a file instead of in the arguments of the command that lists the
# sessions - that command is fixed once the picker runs, its output is not
fzf_state_file=""
fzf_answer_file=""

write_fzf_state() {
    {
        printf 'agents=%q\n' "${agents}"
        printf 'current_directory_only=%q\n' "${current_directory_only}"
        printf 'current_directory=%q\n' "${current_directory}"
        printf 'grep_pattern=%q\n' "${grep_pattern}"
        printf 'igrep_pattern=%q\n' "${igrep_pattern}"
        printf 'open_only=%q\n' "${open_only}"
        printf 'fzf_view=%q\n' "${fzf_view}"
        printf 'launch_directory=%q\n' "${launch_directory}"
    } > "${fzf_state_file}"
}

read_fzf_state() {
    [ -f "${fzf_state_file}" ] || return 0
    # shellcheck source=/dev/null
    . "${fzf_state_file}"
}

# the prompt of the picker names what it currently shows, so the agent filter,
# the scope and the search stay visible after they were changed. Each of them
# carries the color of the column it names - the agent the color of its own
# agent - and only both agents go unnamed, that being what the scope word "all"
# would read as twice. The arrow that follows them is left alone, so it keeps the
# prompt color of the picker.
print_fzf_prompt() {
    local scope="all"

    [ "${open_only}" -eq 1 ] && printf '%sopen%s ' "${C_LIVE_OPEN}" "${C_RESET}"
    [ "${agents}" != "${all_agents}" ] \
        && printf '%s%s%s ' "$(agent_color "${agents}")" "${agents}" "${C_RESET}"
    [ "${current_directory_only}" -eq 1 ] && scope="$(basename -- "${current_directory}")"
    [ "${fzf_view}" = "folders" ] && scope="folders"
    printf '%s%s%s' "${C_DIRECTORY}" "${scope}" "${C_RESET}"
    [ -n "${igrep_pattern}" ] && printf '%s ~ %s%s' "${C_TITLE}" "${igrep_pattern}" "${C_RESET}"
    printf ' > '
}

# The preview is shown or hidden along with the view, which gives the list
# another width: the footer of fzf-with-header is packed again for it by the
# action that picker exports for this.
print_fzf_preview() {
    printf '%s-preview' "${1}"
    [ -n "${FZF_WITH_HEADER_FOOTER_ACTION}" ] && printf '+%s' "${FZF_WITH_HEADER_FOOTER_ACTION}"
}

# esc clears an active search and leaves the picker without one. The clearing
# happens here, so the actions handed back only have to bring the list and the
# prompt in line with the state that was just written.
print_fzf_escape() {
    # the folders are left without choosing one, back to the sessions as they were
    if [ "${fzf_view}" = "folders" ]; then
        fzf_view="sessions"
        write_fzf_state
        printf '%s+%s' "$(print_fzf_preview show)" "${fzf_escape_actions}"
        return
    fi
    if [ -z "${grep_pattern}" ] && [ -z "${igrep_pattern}" ]; then
        printf 'abort'
        return
    fi
    grep_pattern=""
    igrep_pattern=""
    write_fzf_state
    printf '%s' "${fzf_escape_actions}"
}

# the agent filter walks both agents -> claude -> codex and around again, so one
# key reaches every listing without a direction to remember
cycle_fzf_agents() {
    case "${agents}" in
        claude)
            agents="codex"
            ;;
        codex)
            agents="${all_agents}"
            ;;
        *)
            agents="claude"
            ;;
    esac
}

# The folder scope is narrowed to the folder of the selected session, on ctrl-s
# next to the folders of ctrl-space. This is why the directory it filters by
# lives in the state file as well: it does not have to stay the one the picker was started in. A session
# whose directory is not recorded anywhere leaves the scope as it is.
scope_fzf_session() {
    local agent="${1}"
    local filepath="${2}"
    local directory

    case "${agent}" in
        claude | codex) ;;
        *) return 0 ;;
    esac
    directory="$(session_cwd "${agent}" "${filepath}")"
    [ -n "${directory}" ] || return 0
    resolve_directory "${directory}"
    current_directory="${resolved_directory}"
    current_directory_only=1
    write_fzf_state
}

# ctrl-space switches between the sessions and the folders they were recorded
# in; the preview belongs to the sessions, so it goes away with them.
print_fzf_toggle_view() {
    if [ "${fzf_view}" = "folders" ]; then
        fzf_view="sessions"
        write_fzf_state
        printf '%s+%s' "$(print_fzf_preview show)" "${fzf_view_actions}"
    else
        fzf_view="folders"
        write_fzf_state
        printf '%s+%s' "$(print_fzf_preview hide)" "${fzf_view_actions}"
    fi
}

# enter answers the question of the view: a folder becomes the scope of the
# sessions, which are shown again; a session is asked what is to happen with it.
print_fzf_enter() {
    local agent="${1}"
    local filepath="${2}"
    local script_command
    local answers

    if [ "${fzf_view}" = "folders" ]; then
        [ -n "${filepath}" ] || return 0
        if [ "${filepath}" = "${folders_all}" ]; then
            current_directory_only=0
        else
            resolve_directory "${filepath}"
            current_directory="${resolved_directory}"
            current_directory_only=1
        fi
        fzf_view="sessions"
        write_fzf_state
        printf '%s+%s' "$(print_fzf_preview show)" "${fzf_view_actions}"
        return
    fi
    # the placeholders are left for fzf to fill in when it runs the actions
    printf -v script_command '%q' "${script_path}"
    printf -v answers '%q' "${fzf_answer_file}"
    printf 'execute(%s --fzf-answers %s --fzf-action ask {2} {3})' "${script_command}" "${answers}"
    printf '+transform:%s --fzf-answers %s --fzf-action become {2} {3}' "${script_command}" "${answers}"
}

fzf_list_command() {
    local scope="${1:-all}"
    local command
    local argument
    local quoted
    local arguments=(--fzf-list)

    [ "${scope}" = "initial" ] && arguments+=(--fzf-batch "${initial_batch_size}")
    [ "${scope}" = "refresh" ] && arguments+=(--fzf-refresh)

    if [ -n "${limit}" ]; then
        arguments+=(--limit "${limit}")
    else
        arguments+=(--days "${days}")
    fi

    [ "${prompt_column}" -eq 1 ] && arguments+=(--prompt-column)
    if [ -n "${fzf_state_file}" ]; then
        arguments+=(--fzf-state "${fzf_state_file}")
    else
        [ "${agents}" != "${all_agents}" ] && arguments+=(--agent "${agents}")
        [ "${current_directory_only}" -eq 1 ] && arguments+=(--current-directory)
        [ -n "${grep_pattern}" ] && arguments+=(--grep "${grep_pattern}")
        [ -n "${igrep_pattern}" ] && arguments+=(--igrep "${igrep_pattern}")
    fi

    printf -v command '%q' "${script_path}"
    for argument in "${arguments[@]}"; do
        printf -v quoted '%q' "${argument}"
        command+=" ${quoted}"
    done
    printf '%s' "${command}"
}

# a command that acts on the state of the open picker: it changes the state file
# or reports from it, and the picker reloads afterwards
fzf_state_command() {
    local command
    local argument
    local quoted

    printf -v command '%q' "${script_path}"
    printf -v quoted '%q' "${fzf_state_file}"
    command+=" --fzf-state ${quoted}"
    for argument in "${@}"; do
        printf -v quoted '%q' "${argument}"
        command+=" ${quoted}"
    done
    printf '%s' "${command}"
}

print_session_file() {
    local agent="${1}"
    local filepath="${2}"
    local jq_filter
    local session_content

    jq_filter="$(jq_messages "${agent}")"'
        messages
        | map("### \(.role)\n\n\(.text)")
        | join("\n\n---\n\n")
    '
    verbose "Extracting session messages from ${filepath}..."
    verbose "jq -rs '${jq_filter}' ${filepath}"
    session_content="$(jq -rs "${jq_filter}" "${filepath}")"
    [ "${raw}" -eq 0 ] && echo "${session_content}" | glow || echo "${session_content}"
}

# The conversation as Markdown; with the last flag set only its last message,
# which is what the "last message" answers of the picker ask for.
raw_session_file() {
    local agent="${1}"
    local filepath="${2}"
    local last="${3:-0}"
    local selection="messages"
    local jq_filter

    [ "${last}" -eq 1 ] && selection="messages | [last // empty]"
    jq_filter="$(jq_messages "${agent}")"'
        '"${selection}"'
        | map("### \(.role)\n\n\(.text)")
        | join("\n\n---\n\n")
    '
    jq -rs "${jq_filter}" "${filepath}"
}

# Continue the session itself, with the given directory as the working root. Both
# CLIs look a session up in the project of that directory, so this only works for
# the directory the session was recorded in - except for codex, which takes the
# working root as an argument.
resume_session() {
    local agent="${1}"
    local filepath="${2}"
    local cwd="${3}"
    local session_id
    local resume_command

    session_id="$(session_id_of "${agent}" "${filepath}")"
    cd -- "${cwd}" || fail "Cannot enter session directory: ${cwd}"
    case "${agent}" in
        claude)
            printf -v resume_command 'cd -- %q && claude --resume %q </dev/tty >/dev/tty 2>&1' "${cwd}" "${session_id}"
            muted "${resume_command}"
            exec claude --resume "${session_id}" </dev/tty >/dev/tty 2>&1
            ;;
        codex)
            printf -v resume_command 'cd -- %q && codex resume -C %q %q </dev/tty >/dev/tty 2>&1' "${cwd}" "${cwd}" "${session_id}"
            muted "${resume_command}"
            exec codex resume -C "${cwd}" "${session_id}" </dev/tty >/dev/tty 2>&1
            ;;
    esac
}

# Continue the conversation in a fresh session of the target agent, with the
# rendered conversation handed over as its first prompt. That is how a fork into
# another agent works, and how a claude session of another folder is continued
# in this one, where the agent cannot be told where to look for it. Neither CLI
# takes a conversation as a file, so a transcript too large for a command line
# stays in its file and the agent is told to read it.
continue_with_context() {
    local agent="${1}"
    local target_agent="${2}"
    local filepath="${3}"
    local cwd="${4}"
    local context_file
    local context_size
    local fork_prompt
    local fork_prompt_display
    local fork_command
    local cleanup_command

    cd -- "${cwd}" || fail "Cannot enter directory: ${cwd}"
    context_file="$(create_fork_context "${agent}" "${filepath}")"
    printf -v cleanup_command 'rm -f -- %q' "${context_file}"
    # The trap deliberately captures the exact generated filename now.
    # shellcheck disable=SC2064
    trap "${cleanup_command}" EXIT

    context_size="$(wc -c < "${context_file}")"
    if [ "${context_size}" -le "${fork_prompt_max_bytes}" ]; then
        fork_prompt="$(< "${context_file}")"
        # This is the muted command display; expansion happens when copied and run.
        # shellcheck disable=SC2016
        printf -v fork_prompt_display '"$(< %q)"' "${context_file}"
    else
        printf -v fork_prompt 'User wants to continue a previous %s session. Read the complete context from %s. Do nothing else for now. Wait for the next user prompt.' "${agent}" "${context_file}"
        printf -v fork_prompt_display '%q' "${fork_prompt}"
    fi

    case "${target_agent}" in
        claude)
            printf -v fork_command 'cd -- %q && claude %s </dev/tty >/dev/tty 2>&1' "${cwd}" "${fork_prompt_display}"
            muted "${fork_command}"
            claude "${fork_prompt}" </dev/tty >/dev/tty 2>&1
            ;;
        codex)
            printf -v fork_command 'cd -- %q && codex -C %q %s </dev/tty >/dev/tty 2>&1' "${cwd}" "${cwd}" "${fork_prompt_display}"
            muted "${fork_command}"
            codex -C "${cwd}" "${fork_prompt}" </dev/tty >/dev/tty 2>&1
            ;;
    esac
}

create_fork_context() {
    local agent="${1}"
    local filepath="${2}"
    local context_file

    context_file="$(mktemp --suffix=.md "${TMPDIR:-/tmp}/agent-session-fork.XXXXXX")" \
        || fail "Failed to create temporary fork context"
    if ! {
        printf 'User wants to continue a previous %s session. This is the complete context:\n\n---\n\n' "${agent}"
        raw_session_file "${agent}" "${filepath}"
        printf '\n\n---\n\nDo nothing for now. Wait for the next user prompt.\n'
    } > "${context_file}"; then
        rm -f -- "${context_file}"
        fail "Failed to create fork context"
    fi
    printf '%s' "${context_file}"
}

# Copying and printing come in a whole-conversation and a last-message variant
# each, and the two of them share one row of the question: tab walks over the
# variants, so the question stays four lines long.
# A session that is open in a running agent is resumed already, so going to it
# takes the place of resuming it: its terminal is brought to the front instead.
ask_session_action() {
    local running="${1}"
    local choices=()

    if [ "${running}" -eq 1 ]; then
        choices+=("focus=Focus terminal")
    else
        choices+=("resume=Resume")
    fi
    choices+=(
        "fork=Fork"
        "clipboard=Copy"
        "clipboard-last=Copy last message"
        "print=Print"
        "print-last=Print last message"
    )
    prompt-select --prompt "Continue session:" --no-abort-message \
        --cycle "clipboard|clipboard-last" \
        --cycle "print|print-last" \
        "${choices[@]}" \
        </dev/tty
}

# The agent process of a running session, or nothing.
session_live_pid() {
    local agent="${1}"
    local filepath="${2}"

    load_live_sessions
    read_session_id "${agent}" "${filepath}"
    printf '%s' "${live_pid_by_id[${session_id_value}]-}"
}

# Brings the terminal window the session runs in to the front. Which terminal
# that is, is left to window-focus-by-process: it walks up from the agent
# process to whatever owns a window, and the title the agents give their
# terminal - the one of the session - decides between the windows of a
# terminal that has several.
focus_session() {
    local agent="${1}"
    local filepath="${2}"
    local pid
    local title
    local focus_by_process="${script_folder}/window-focus-by-process"
    local cwd
    local texts=()

    pid="$(session_live_pid "${agent}" "${filepath}")"
    [ -n "${pid}" ] || fail "Session is not running"
    [ -x "${focus_by_process}" ] || focus_by_process="$(command -v window-focus-by-process)"
    [ -n "${focus_by_process}" ] || fail "window-focus-by-process not found"
    # the title the agent gives its terminal first, then the directory a shell
    # names in it - which is all a window shows of a session that is not in
    # its active tab
    title="$(session_title "${agent}" "${filepath}")"
    [ -n "${title}" ] && texts+=(--title "${title}")
    cwd="$(session_cwd "${agent}" "${filepath}")"
    if [ -n "${cwd}" ]; then
        texts+=(--title "$(display_path "${cwd}")")
        [ "${cwd}" != "$(display_path "${cwd}")" ] && texts+=(--title "${cwd}")
    fi
    "${focus_by_process}" "${texts[@]}" "${pid}" >/dev/null
}

# The fork picks its working root before its agent, so the folder of the picker
# and the folder of the session are one key each and any other one is typed with
# completion. Both are listed even where they are the same folder, so the keys of
# the question stay where they are from session to session.
ask_fork_directory() {
    local session_directory="${1}"
    local entries=()
    local choice

    entries+=("here=$(display_path "${current_directory}") (current)")
    [ -n "${session_directory}" ] \
        && entries+=("session=$(display_path "${session_directory}") (session)")
    entries+=("other=...")

    choice="$(prompt-select --prompt "Fork in:" --no-abort-message \
        "${entries[@]}" </dev/tty)" || return 1
    case "${choice}" in
        here)
            printf '%s' "${current_directory}"
            ;;
        session)
            printf '%s' "${session_directory}"
            ;;
        other)
            choice="$(prompt-folder --prompt "Folder:" --no-abort-message </dev/tty)" || return 1
            [ -n "${choice}" ] || return 1
            printf '%s' "$(realpath -m -- "${choice}")"
            ;;
    esac
}

ask_fork_agent() {
    local agent="${1}"
    local choice

    choice="$(prompt-complete --prompt "Fork with:" --default "${agent}" \
        --no-abort-message claude codex </dev/tty)" || return 1
    case "${choice}" in
        claude | codex)
            printf '%s' "${choice}"
            ;;
        *)
            fail "Unknown fork agent: ${choice}"
            ;;
    esac
}

# The questions of a fork asked outside the picker, esc stepping back one
# question and out of the first one without forking anything.
ask_fork() {
    local agent="${1}"
    local filepath="${2}"
    local step="directory"
    local directory=""
    local target_agent=""
    local session_directory

    command -v prompt-select >/dev/null 2>&1 || fail "prompt-select not found"
    command -v prompt-complete >/dev/null 2>&1 || fail "prompt-complete not found"
    command -v prompt-folder >/dev/null 2>&1 || fail "prompt-folder not found"
    session_directory="$(session_cwd "${agent}" "${filepath}")"

    while true; do
        case "${step}" in
            directory)
                directory="$(ask_fork_directory "${session_directory}")" || return 0
                step="agent"
                ;;
            agent)
                if target_agent="$(ask_fork_agent "${agent}")"; then
                    break
                fi
                step="directory"
                ;;
        esac
    done

    fork_session "${agent}" "${filepath}" "${target_agent}" "${directory}"
}

ask_print_format() {
    prompt-select --prompt "Print:" --no-abort-message \
        "markdown=Markdown" \
        "raw=Raw" \
        </dev/tty
}

# What is to happen with the selected session is asked while the picker is still
# open, in as many steps as the answer needs, and the answers are left in a file
# for the action that runs once the picker is gone. Esc steps back to the
# question before it; out of the first one it answers nothing, which is what
# leaves the picker as it was.
session_ask() {
    local agent="${1}"
    local filepath="${2}"
    local step="action"
    local action=""
    local directory=""
    local target_agent=""
    local format=""
    local session_directory
    local running

    command -v prompt-select >/dev/null 2>&1 || fail "prompt-select not found"
    command -v prompt-complete >/dev/null 2>&1 || fail "prompt-complete not found"
    command -v prompt-folder >/dev/null 2>&1 || fail "prompt-folder not found"
    : > "${fzf_answer_file}" || fail "Cannot write the answers of the picker"
    session_directory="$(session_cwd "${agent}" "${filepath}")"
    running=0
    [ -n "$(session_live_pid "${agent}" "${filepath}")" ] && running=1

    while true; do
        case "${step}" in
            action)
                action="$(ask_session_action "${running}")" || return 0
                case "${action}" in
                    resume | clipboard | clipboard-last)
                        break
                        ;;
                    focus)
                        # nothing to become: the picker stays where it is, for
                        # coming back to
                        if ! (focus_session "${agent}" "${filepath}"); then
                            read -r -s -n 1 -p "Press any key to go back" </dev/tty
                        fi
                        return 0
                        ;;
                    fork)
                        step="directory"
                        ;;
                    print | print-last)
                        step="format"
                        ;;
                    *)
                        fail "Unknown session action: ${action}"
                        ;;
                esac
                ;;
            directory)
                if directory="$(ask_fork_directory "${session_directory}")"; then
                    step="agent"
                else
                    step="action"
                fi
                ;;
            agent)
                if target_agent="$(ask_fork_agent "${agent}")"; then
                    break
                else
                    step="directory"
                fi
                ;;
            format)
                if format="$(ask_print_format)"; then
                    break
                else
                    step="action"
                fi
                ;;
        esac
    done

    {
        printf 'answered_action=%q\n' "${action}"
        printf 'answered_format=%q\n' "${format}"
        printf 'answered_directory=%q\n' "${directory}"
        printf 'answered_agent=%q\n' "${target_agent}"
    } > "${fzf_answer_file}"
}

# an unanswered question leaves the file empty, so there is nothing to become
print_fzf_become() {
    local agent="${1}"
    local filepath="${2}"

    [ -s "${fzf_answer_file}" ] || return 0
    printf 'become(%s --fzf-answers %q --fzf-action run %q %q)' \
        "${script_path}" "${fzf_answer_file}" "${agent}" "${filepath}"
}

session_run() {
    local agent="${1}"
    local filepath="${2}"
    local answered_action=""
    local answered_format=""
    local answered_directory=""
    local answered_agent=""

    [ -s "${fzf_answer_file}" ] || return 0
    # shellcheck source=/dev/null
    . "${fzf_answer_file}"
    case "${answered_action}" in
        resume | clipboard | clipboard-last)
            fzf_action "${answered_action}" "${agent}" "${filepath}"
            ;;
        print)
            fzf_action "${answered_format}" "${agent}" "${filepath}"
            ;;
        print-last)
            fzf_action "${answered_format}-last" "${agent}" "${filepath}"
            ;;
        fork)
            fork_session "${agent}" "${filepath}" "${answered_agent}" "${answered_directory}"
            ;;
        *)
            fail "Unknown session action: ${answered_action}"
            ;;
    esac
}

# Continue the session in the chosen folder, taking the shortest route the CLIs
# allow: codex takes the working root as an argument and forks natively wherever
# it is started, claude looks a session up in the project of the working
# directory and forks natively only in the folder the session was recorded in.
# Everything else - the other agent, or a claude session of another folder -
# starts fresh with the conversation handed over as context.
fork_session() {
    local agent="${1}"
    local filepath="${2}"
    local target_agent="${3}"
    local directory="${4}"
    local cwd
    local session_id
    local fork_command

    command -v "${target_agent}" >/dev/null 2>&1 || fail "${target_agent} not found"
    [ -d "${directory}" ] || fail "Directory not found: ${directory}"

    cwd="$(session_cwd "${agent}" "${filepath}")"
    cd -- "${directory}" || fail "Cannot enter directory: ${directory}"

    if [ "${target_agent}" = "${agent}" ]; then
        session_id="$(session_id_of "${agent}" "${filepath}")"
        case "${agent}" in
            claude)
                if [ "${cwd}" = "${directory}" ]; then
                    printf -v fork_command 'cd -- %q && claude --resume %q --fork-session </dev/tty >/dev/tty 2>&1' "${directory}" "${session_id}"
                    muted "${fork_command}"
                    exec claude --resume "${session_id}" --fork-session </dev/tty >/dev/tty 2>&1
                fi
                ;;
            codex)
                printf -v fork_command 'cd -- %q && codex fork -C %q %q </dev/tty >/dev/tty 2>&1' "${directory}" "${directory}" "${session_id}"
                muted "${fork_command}"
                exec codex fork -C "${directory}" "${session_id}" </dev/tty >/dev/tty 2>&1
                ;;
        esac
    fi

    continue_with_context "${agent}" "${target_agent}" "${filepath}" "${directory}"
}

fzf_action() {
    local action="${1}"
    local agent="${2}"
    local filepath="${3}"
    local last_message=0
    local content
    local cwd
    local session_id
    local preview_width

    # the last-message variants of copying and printing are the same actions on
    # the last message instead of the whole conversation
    case "${action}" in
        *-last)
            last_message=1
            action="${action%-last}"
            ;;
    esac

    case "${agent}" in
        claude | codex)
            ;;
        *)
            fail "Unknown agent: ${agent}"
            ;;
    esac
    [ -f "${filepath}" ] || fail "Session file not found: ${filepath}"

    case "${action}" in
        ask)
            [ -n "${fzf_answer_file}" ] || fail "The picker questions require --fzf-answers"
            session_ask "${agent}" "${filepath}"
            ;;
        become)
            [ -n "${fzf_answer_file}" ] || fail "The picker questions require --fzf-answers"
            print_fzf_become "${agent}" "${filepath}"
            ;;
        run)
            [ -n "${fzf_answer_file}" ] || fail "The picker questions require --fzf-answers"
            session_run "${agent}" "${filepath}"
            ;;
        preview)
            preview_width="${FZF_PREVIEW_COLUMNS:-80}"
            raw_session_file "${agent}" "${filepath}" \
                | COLORTERM=truecolor CLICOLOR_FORCE=1 \
                    glow --style "${GLOW_STYLE:-dark}" --width "${preview_width}" 2>/dev/null
            ;;
        markdown)
            raw_session_file "${agent}" "${filepath}" "${last_message}" | glow
            ;;
        raw)
            raw_session_file "${agent}" "${filepath}" "${last_message}"
            ;;
        clipboard)
            content="$(raw_session_file "${agent}" "${filepath}" "${last_message}")"
            [ -n "${content}" ] || fail "Session has no messages"
            if printf '%s\n' "${content}" | clip; then
                if [ "${last_message}" -eq 1 ]; then
                    muted "Copied the last message to clipboard"
                else
                    muted "Copied to clipboard"
                fi
            else
                fail "Failed to copy session to clipboard"
            fi
            ;;
        focus)
            focus_session "${agent}" "${filepath}"
            ;;
        resume)
            cwd="$(session_cwd "${agent}" "${filepath}")"
            [ -n "${cwd}" ] || fail "Session has no working directory"
            [ -d "${cwd}" ] || fail "Session directory not found: ${cwd}"
            resume_session "${agent}" "${filepath}" "${cwd}"
            ;;
        *)
            fail "Unknown interactive action: ${action}"
            ;;
    esac
}

# A row of the listing without what changes while its file does not: the age
# and the marker. Kept as one record per session, fields separated by
# cache_separator, which is what the snapshot of an open picker is made of:
#   agent, mtime, datetime, size, file, title, prompt, directory, full title,
#   full prompt, full directory
# The title and the prompt are shortened to their column already.
session_row=""
declare -A formatted_cwds=()

row_title_max_length() {
    if [ "${print}" -eq 1 ]; then
        printf '%s' "${print_title_max_length}"
    elif [ "${prompt_column}" -eq 1 ]; then
        printf '%s' "${fzf_text_max_length}"
    else
        printf '%s' "${fzf_title_max_length}"
    fi
}

read_session_row() {
    local agent="${1}"
    local mtime="${2}"
    local datetime="${3}"
    local size="${4}"
    local filepath="${5}"
    local title_max_length="${6}"
    local cwd
    local title
    local prompt
    local title_cell
    local prompt_cell=""

    read_session_metadata "${agent}" "${filepath}" "${mtime}" "${size}"
    # the sessions of a listing share their directories, so each of them is
    # shortened once instead of once per row
    if [ -z "${formatted_cwds[${session_meta_cwd}]+set}" ]; then
        formatted_cwds["${session_meta_cwd}"]="$(format_cwd "${session_meta_cwd}")"
    fi
    cwd="${formatted_cwds[${session_meta_cwd}]}"
    prompt="${session_meta_prompt}"
    title="${session_meta_title}"
    [ -n "${title}" ] || title="-"
    [ -n "${prompt}" ] || prompt="-"
    [ -n "${cwd}" ] || cwd="-"
    set_shortened_text "${title}" "${title_max_length}"
    title_cell="${shortened_text}"
    # the prompt is kept as a hidden field of the picker either way, so
    # without its column it stays searchable but takes no width
    if [ "${prompt_column}" -eq 1 ]; then
        if [ "${print}" -eq 1 ]; then
            set_shortened_text "${prompt}" "${print_prompt_max_length}"
        else
            set_shortened_text "${prompt}" "${fzf_text_max_length}"
        fi
        prompt_cell="${shortened_text}"
    fi
    session_row="${agent}${cache_separator}${mtime}${cache_separator}${datetime}"
    session_row+="${cache_separator}${size}${cache_separator}${filepath}"
    session_row+="${cache_separator}${title_cell}${cache_separator}${prompt_cell}"
    session_row+="${cache_separator}${cwd}${cache_separator}${title}${cache_separator}${prompt}"
    session_row+="${cache_separator}${session_meta_cwd}"
    session_row="${session_row//[$'\t\r\n']/ }"
}

# The rows of session_entries, newest first, left in session_rows.
session_rows=()

collect_session_rows() {
    local entry
    local agent
    local mtime
    local datetime
    local size
    local filepath
    local title_max_length

    title_max_length="$(row_title_max_length)"
    preload_codex_prompts
    session_rows=()
    for entry in "${session_entries[@]}"; do
        IFS=$'\t' read -r agent mtime datetime size filepath <<< "${entry}"
        read_session_row "${agent}" "${mtime}" "${datetime}" "${size}" "${filepath}" "${title_max_length}"
        session_rows+=("${session_row}")
    done
    flush_metadata_cache
}

# Prints session_rows as the table, or as the rows of the picker: the ages and
# the markers of the sessions are what is worked out here, the rest the rows
# carry already. A picker row whose file is fzf_track_filepath has its position
# left in fzf_track_file, as the action that puts the cursor back on it.
fzf_track_filepath=""
fzf_track_file=""

# The columns of session_rows, as arrays of one element per row: one awk
# splitting all of them into files costs less than a read per row, which is
# what a refresh would otherwise spend its time on.
row_agents=()
row_mtimes=()
row_files=()
row_titles=()
row_prompts=()
row_cwds=()
row_full_titles=()
row_full_prompts=()

split_session_rows() {
    local folder

    row_agents=() row_mtimes=() row_files=() row_titles=() row_prompts=()
    row_cwds=() row_full_titles=() row_full_prompts=()
    [ "${#session_rows[@]}" -gt 0 ] || return 0
    folder="$(mktemp -d "${TMPDIR:-/tmp}/${APP_NAME}.rows.XXXXXX")" || fail "Cannot split the rows"
    printf '%s\n' "${session_rows[@]}" | awk -v separator="${cache_separator}" -v folder="${folder}" '
        {
            count = split($0, fields, separator)
            for (field = 1; field <= 10; field++) print (field <= count ? fields[field] : "") > (folder "/" field)
        }'
    mapfile -t row_agents < "${folder}/1"
    mapfile -t row_mtimes < "${folder}/2"
    mapfile -t row_files < "${folder}/5"
    mapfile -t row_titles < "${folder}/6"
    mapfile -t row_prompts < "${folder}/7"
    mapfile -t row_cwds < "${folder}/8"
    mapfile -t row_full_titles < "${folder}/9"
    mapfile -t row_full_prompts < "${folder}/10"
    rm -rf -- "${folder}"
}

print_session_rows() {
    local table
    local agent
    local agent_color_code
    local ages=()
    local row_index
    local filepath
    local prompt_cell
    local now
    local picker_rows
    local full_states=()
    local formatted_rows=()
    local table_file

    now="$(date +%s)"
    table="AGENT  ${live_empty_cell}  AGE  TITLE"
    [ "${prompt_column}" -eq 1 ] && table+="  PROMPT"
    table+="  DIRECTORY"$'\n'
    command -v toage >/dev/null 2>&1 || fail "toage not found"
    split_session_rows
    mapfile -t ages < <(format_ages "${now}" "${row_mtimes[@]}")
    load_live_sessions
    # Rows were collected newest first. fzf's default layout places the first
    # row next to its prompt, keeping the latest session selected.
    for (( row_index = 0; row_index < ${#session_rows[@]}; row_index++ )); do
        agent="${row_agents[row_index]}"
        agent_color_code="${agent_colors[${agent}]-${C_AGENT_OTHER}}"
        read_live_marker "${agent}" "${row_files[row_index]}"
        full_states+=("${live_words}")
        prompt_cell=""
        [ "${prompt_column}" -eq 1 ] && prompt_cell="  ${C_PROMPT}${row_prompts[row_index]}${C_RESET}"
        table+="${agent_color_code}${agent}${C_RESET}  ${live_marker}  ${ages[row_index]:-}  ${C_TITLE}${row_titles[row_index]}${C_RESET}${prompt_cell}  ${C_DIRECTORY}${row_cwds[row_index]}${C_RESET}"$'\n'
    done

    # through a file, which mapfile reads a block at a time and a pipe not
    table_file="$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.table.XXXXXX")" || fail "Cannot format the rows"
    printf '%s' "${table}" | k-format > "${table_file}"
    mapfile -t formatted_rows < "${table_file}"
    rm -f -- "${table_file}"

    if [ "${print}" -eq 1 ]; then
        printf '%s\n' "${formatted_rows[@]}"
        return 0
    fi

    picker_rows="${formatted_rows[0]}"$'\tAGENT\tFILE\tFULL_TITLE\tFULL_PROMPT\tSTATE\n'
    for (( row_index = 0; row_index < ${#session_rows[@]}; row_index++ )); do
        filepath="${row_files[row_index]}"
        picker_rows+="${formatted_rows[row_index+1]}"$'\t'"${row_agents[row_index]}"$'\t'"${filepath}"$'\t'"${row_full_titles[row_index]}"$'\t'"${row_full_prompts[row_index]}"$'\t'"${full_states[row_index]}"$'\n'
        if [ -n "${fzf_track_file}" ] && [ "${filepath}" = "${fzf_track_filepath}" ]; then
            printf 'pos(%s)' "$((row_index + 1))" > "${fzf_track_file}"
        fi
    done

    printf '%s' "${picker_rows}"
}

# The session files of the sessions that are open in a running agent, in the
# shape of session_files: the files are named by the agents themselves, so no
# folder is searched.
live_session_files() {
    local id
    local file
    local agent
    local files=()
    local -A files_by_agent=()

    load_live_sessions
    for id in "${!live_state_by_id[@]}"; do
        file="${live_file_by_id[${id}]-}"
        if [ -n "${file}" ]; then
            agent="codex"
        else
            agent="claude"
            for file in "${claude_session_folder}"/*/"${id}.${session_ext}"; do
                [ -f "${file}" ] && break
            done
        fi
        [ -f "${file}" ] || continue
        [[ " ${agents} " == *" ${agent} "* ]] || continue
        files_by_agent["${agent}"]+="${file}"$'\n'
    done
    for agent in "${!files_by_agent[@]}"; do
        mapfile -t files < <(printf '%s' "${files_by_agent[${agent}]}")
        find "${files[@]}" -maxdepth 0 -printf '%T@\t'"${agent}"'\t%TY-%Tm-%TdT%TH:%TM:%TS\t%s\t%p\n'
    done | LC_ALL=C sort -n
}

# The folders view: the folders the listed sessions were recorded in, each once
# and in order, led by the one that stands for all of them. It is kept next to
# the state file, as it is only worth making again once the state changed. The
# cursor starts on the other way the scope can go: on the folder the picker was
# started in while every folder is listed, on all of them while one is.
folders_all="<all>"

print_folder_rows() {
    local folders_file="${1}"
    local folder
    local position=1
    local wanted="${fzf_track_filepath}"
    local wanted_found=0
    local rows

    if [ -z "${wanted}" ]; then
        wanted="${folders_all}"
        [ "${scoped_directory_only}" -eq 0 ] && wanted="${launch_directory}"
    fi
    rows="FOLDER"$'\tAGENT\tFILE\tFULL_TITLE\tFULL_PROMPT\tSTATE\n'
    rows+="${C_DIRECTORY}${folders_all}${C_RESET}"$'\tfolder\t'"${folders_all}"$'\t\t\t\n'
    while IFS= read -r folder; do
        [ -n "${folder}" ] || continue
        position=$((position + 1))
        rows+="${C_DIRECTORY}$(display_path "${folder}")${C_RESET}"$'\tfolder\t'"${folder}"$'\t\t\t\n'
        if [ -n "${fzf_track_file}" ] && [ "${folder}" = "${wanted}" ]; then
            printf 'pos(%s)' "${position}" > "${fzf_track_file}"
            wanted_found=1
        fi
    done < "${folders_file}"
    # a folder without sessions in the list is no row to go to either
    [ -n "${fzf_track_file}" ] && [ "${wanted_found}" -eq 0 ] \
        && printf 'pos(1)' > "${fzf_track_file}"
    printf '%s' "${rows}"
}

write_folders() {
    local folders_file="${1}"
    local temp_file

    temp_file="$(mktemp "${folders_file}.XXXXXX")" || return 1
    [ "${#session_rows[@]}" -gt 0 ] && printf '%s\n' "${session_rows[@]}" \
        | cut -d "${cache_separator}" -f 11 \
        | awk 'NF && !seen[$0]++' \
        | while IFS= read -r folder; do printf '%s\t%s\n' "$(display_path "${folder}")" "${folder}"; done \
        | LC_ALL=C sort -f -t $'\t' -k1,1 | cut -f 2 > "${temp_file}"
    mv -f -- "${temp_file}" "${folders_file}"
}

# The snapshot of an open picker: what it listed last, as rows, led by a line
# naming what the rows were listed for. A refresh lists from it as long as that
# line still says the same and the snapshot is younger than refresh_full_seconds.
# Next to it lies a marker, touched before the session files were looked at, so
# that every file written since is newer than the marker and no file written
# while the rows were put together is missed.
snapshot_file=""
snapshot_marker=""

snapshot_signature() {
    printf '%q ' "${agents}" "${current_directory_only}" "${current_directory}" \
        "${grep_pattern}" "${igrep_pattern}" "${days}" "${limit}" "${prompt_column}" \
        "${open_only}"
}

# touched before the files are looked at; takes the place of the marker once the
# snapshot of that look is written
start_snapshot() {
    [ -n "${snapshot_file}" ] || return 0
    touch -- "${snapshot_marker}.next" 2>/dev/null
}

write_snapshot() {
    local built="${1}"
    local temp_file

    [ -n "${snapshot_file}" ] || return 0
    temp_file="$(mktemp "${snapshot_file}.XXXXXX")" || return 0
    {
        printf '%s\n' "$(snapshot_signature)"
        printf '%s\n' "${built}"
        [ "${#session_rows[@]}" -gt 0 ] && printf '%s\n' "${session_rows[@]}"
    } > "${temp_file}"
    mv -f -- "${temp_file}" "${snapshot_file}" 2>/dev/null || rm -f -- "${temp_file}"
    mv -f -- "${snapshot_marker}.next" "${snapshot_marker}" 2>/dev/null
}

# Reads the snapshot into session_rows where it still describes what is to be
# listed, and says whether it did.
snapshot_built=""

read_snapshot() {
    local signature
    local now

    [ -n "${snapshot_file}" ] && [ -r "${snapshot_file}" ] && [ -e "${snapshot_marker}" ] || return 1
    {
        IFS= read -r signature
        IFS= read -r snapshot_built
        mapfile -t session_rows
    } < "${snapshot_file}"
    [ "${signature}" = "$(snapshot_signature)" ] || return 1
    [[ "${snapshot_built}" =~ ^[0-9]+$ ]] || return 1
    now="$(date +%s)"
    [ $(( now - snapshot_built )) -lt "${refresh_full_seconds}" ]
}

# Whether a session belongs in the listing: its directory, where the listing is
# held to one, and the search, where there is one. The pre-filter over the raw
# file is taken from prefilter_hits where a listing grepped all of them at once.
session_is_listed() {
    local agent="${1}"
    local filepath="${2}"

    if [ "${current_directory_only}" -eq 1 ] \
        && ! session_is_in_directory "${agent}" "${filepath}" "${current_directory}"; then
        return 1
    fi
    [ -n "${filter_pattern}" ] || return 0
    if [ "${prefilter_done}" -eq 1 ]; then
        [ -n "${prefilter_hits[${filepath}]+set}" ] || return 1
    else
        grep "${verify_args[@]}" -- "${prefilter_pattern}" "${filepath}" 2>/dev/null || return 1
    fi
    session_messages "${agent}" "${filepath}" \
        | grep "${verify_args[@]}" -- "${filter_pattern}"
}

# The fast refresh: the rows of the snapshot, with the sessions whose files were
# written since - new ones, resumed ones, the ones that are working - read again
# and put where their time puts them. Nothing else is opened: the age and the
# marker of every row are worked out anew anyway, and a session that is merely
# open changes nothing but its marker.
refresh_session_rows() {
    local row
    local agent
    local mtime
    local datetime
    local size
    local filepath
    local folder
    local title_max_length
    local changed_file="${snapshot_marker}.changed"
    local merged_file="${snapshot_marker}.merged"
    local changed=()
    local new_rows=()

    start_snapshot
    for agent in ${agents}; do
        folder="$(session_folder "${agent}")"
        [ -d "${folder}" ] || continue
        case "${agent}" in
            claude)
                find "${folder}" -mindepth 2 -maxdepth 2 -name "*.${session_ext}" \
                    -newer "${snapshot_marker}" -printf "${agent}"'\t%T@\t%TY-%Tm-%TdT%TH:%TM:%TS\t%s\t%p\n'
                ;;
            codex)
                find "${folder}" -name "${codex_session_prefix}*.${session_ext}" \
                    -newer "${snapshot_marker}" -printf "${agent}"'\t%T@\t%TY-%Tm-%TdT%TH:%TM:%TS\t%s\t%p\n'
                ;;
        esac
    done > "${changed_file}"
    mapfile -t changed < "${changed_file}"

    # The metadata cache is left alone: the files read here are the ones being
    # written to, and an entry for each of their sizes would be outdated by the
    # next refresh already.
    if [ "${#changed[@]}" -gt 0 ]; then
        title_max_length="$(row_title_max_length)"
        session_entries=("${changed[@]}")
        preload_codex_prompts
        for row in "${changed[@]}"; do
            IFS=$'\t' read -r agent mtime datetime size filepath <<< "${row}"
            [ -n "${filepath}" ] || continue
            session_is_listed "${agent}" "${filepath}" || continue
            read_session_row "${agent}" "${mtime}" "${datetime}" "${size}" "${filepath}" "${title_max_length}"
            new_rows+=("${session_row}")
        done
    fi

    # The rows of the files that were written are dropped from the snapshot and
    # the new ones put in, newest first again, so a session that was written
    # moves up to where its time puts it; the age of the listing is held to as
    # well, and its limit.
    # mapfile reads a pipe a byte at a time and a file a block at a time, so the
    # rows go through a file of their own
    {
        [ "${#session_rows[@]}" -gt 0 ] && printf '%s\n' "${session_rows[@]}"
        [ "${#new_rows[@]}" -gt 0 ] && printf '%s\n' "${new_rows[@]}"
    } | awk -v separator="${cache_separator}" -v cutoff="${cutoff_epoch}" \
            -v kept="${#session_rows[@]}" -v changed_file="${changed_file}" '
        FILENAME == changed_file {
            split($0, fields, "\t")
            if (fields[5] != "") written[fields[5]] = 1
            next
        }
        {
            split($0, fields, separator)
            if (FNR <= kept && (fields[5] in written)) next
            if (cutoff > 0 && fields[2] + 0 < cutoff) next
            print
        }' "${changed_file}" - \
      | LC_ALL=C sort -s -t "${cache_separator}" -k2,2gr \
      | if [ -n "${limit}" ]; then head -n "${limit}"; else cat; fi > "${merged_file}"
    mapfile -t session_rows < "${merged_file}"
    rm -f -- "${changed_file}" "${merged_file}"
    write_snapshot "${snapshot_built}"
}

browse_sessions() {
    local fzf_with_header="${script_folder}/fzf-with-header"
    local script_command
    local preview_command
    local initial_list_command
    local list_command
    local refresh_command
    local track_command
    local search_command
    local escape_command
    local focus_command
    local toggle_open_command
    local toggle_view_command
    local enter_command
    local scope_session_command
    local state_file_argument
    local cycle_agent_command
    local prompt_command
    local reload_actions
    local key_descriptions
    local answer_file_argument
    local fzf_query_arguments=()

    [ -x "${fzf_with_header}" ] || fzf_with_header="$(command -v fzf-with-header)"
    [ -n "${fzf_with_header}" ] || fail "fzf-with-header not found"
    command -v glow >/dev/null 2>&1 || fail "glow not found"
    command -v clip >/dev/null 2>&1 || fail "clip not found"

    fzf_state_file="$(mktemp "${TMPDIR:-/tmp}/$(basename -- "${script_path}").state.XXXXXX")" \
        || fail "Cannot create the state file of the picker"
    # the questions of a selected session are asked while the picker is still
    # open, so their answers are left here for the action that follows them
    fzf_answer_file="$(mktemp "${TMPDIR:-/tmp}/$(basename -- "${script_path}").answers.XXXXXX")" \
        || fail "Cannot create the answers file of the picker"
    # the snapshot of the listing and what its refreshes leave lie next to the
    # state file, named after it
    trap 'rm -f "${fzf_state_file}" "${fzf_state_file}".* "${fzf_answer_file}"' EXIT
    # the open sessions are few and run anywhere, so the picker starts with all
    # of them wherever they were started; ctrl-space narrows the folder down
    open_only=1
    current_directory_only=0
    write_fzf_state

    printf -v script_command '%q' "${script_path}"
    initial_list_command="$(fzf_list_command initial)"
    list_command="$(fzf_list_command all)"
    # A refresh is told the session under the cursor, so that it can put the
    # cursor back on it once the rows moved: the new list is in, the result
    # event takes the position the refresh found, and only while nothing is
    # searched for - a query orders the rows by itself.
    refresh_command="$(fzf_list_command refresh) --fzf-track {3}"
    printf -v track_command '%q' "${fzf_state_file}.track"
    track_command="[ -z {q} ] && cat -- ${track_command} 2>/dev/null; rm -f -- ${track_command}"
    search_command="$(fzf_state_command --fzf-search)"
    toggle_open_command="$(fzf_state_command --fzf-toggle-open)"
    # the placeholders of the picker are filled in by fzf itself, so this one is
    # spelled out instead of quoted along with the arguments around it
    printf -v state_file_argument '%q' "${fzf_state_file}"
    scope_session_command="${script_command} --fzf-state ${state_file_argument}"
    scope_session_command+=" --fzf-scope-session {2} {3}"
    cycle_agent_command="$(fzf_state_command --fzf-cycle-agent)"
    prompt_command="$(fzf_state_command --fzf-prompt)"
    preview_command="${script_command} --fzf-action preview {2} {3}"
    printf -v answer_file_argument '%q' "${fzf_answer_file}"
    focus_command="${script_command} --fzf-action focus {2} {3}"
    [ -n "${fzf_query}" ] && fzf_query_arguments+=(--query "${fzf_query}")

    # a changed scope or search shows the first batch again and loads the rest in
    # the background, the way the picker started: the load binding does that, so
    # it is bound again before the reload it reacts to
    reload_actions="rebind(load)+reload-sync(${initial_list_command})"
    reload_actions+="+transform-prompt(${prompt_command})"

    # esc decides between clearing the search and leaving, so it hands the
    # actions of a cleared search over and gets back the one that applies. Its
    # binding spells the command out after a colon instead of in parentheses,
    # because the actions handed over carry parentheses of their own and fzf
    # ends a parenthesized argument on the first one that closes.
    escape_command="$(fzf_state_command --fzf-escape "${reload_actions}")"
    # enter and ctrl-space depend on the view, so they are decided the same way;
    # enter is told the row, which fzf fills in
    toggle_view_command="$(fzf_state_command --fzf-toggle-view "${reload_actions}")"
    enter_command="${script_command} --fzf-state ${state_file_argument} --fzf-answers ${answer_file_argument}"
    enter_command+=" --fzf-enter $(printf '%q' "${reload_actions}") {2} {3}"

    key_descriptions="/:search,enter:use,tab:open or all,ctrl-space:folders"
    key_descriptions+=",ctrl-s:session folder,ctrl-f:focus"
    key_descriptions+=",ctrl-a:agent,ctrl-r:refresh,esc:clear search or exit,ctrl-c:exit"

    "${fzf_with_header}" \
        --command "${initial_list_command}" \
        --columns 1 \
        --filter-columns 1,4,5,6 \
        --delimiter $'\t' \
        --key-descriptions "${key_descriptions}" \
        --watch "${refresh_seconds}" \
        --watch-command "${refresh_command}" \
        -- \
        --no-multi \
        "${fzf_query_arguments[@]}" \
        --prompt "$(print_fzf_prompt)" \
        --preview "${preview_command}" \
        --preview-window 'right,60%,wrap,follow' \
        --bind "load:reload-sync(${list_command})+unbind(load)+refresh-preview" \
        --bind "result:transform:${track_command}" \
        --bind "/:execute(${search_command} >/dev/tty)+${reload_actions}" \
        --bind "tab:execute-silent(${toggle_open_command})+${reload_actions}" \
        --bind "ctrl-space:transform:${toggle_view_command}" \
        --bind "ctrl-s:execute-silent(${scope_session_command})+${reload_actions}" \
        --bind "ctrl-a:execute-silent(${cycle_agent_command})+${reload_actions}" \
        --bind "ctrl-r:reload(${list_command})+refresh-preview" \
        --bind "esc:transform:${escape_command}" \
        --bind "ctrl-c:abort" \
        --bind "ctrl-f:execute-silent(${focus_command})" \
        --bind "enter:transform:${enter_command}"
}

completion() {
    local previous="${1}"
    local agent
    local filepath
    local argument
    local agent_argument=0
    local ids_only=0

    case "${previous}" in
        -a|--agent)
            echo "${all_agents}"
            return
            ;;
        -n|--limit|-d|--days|-g|--grep|-i|--igrep)
            return
            ;;
        --resume|--fork)
            ids_only=1
            ;;
    esac
    shift

    # An agent already given on the command line limits the session IDs.
    for argument in "${@}"; do
        if [ "${agent_argument}" -eq 1 ]; then
            case "${argument}" in
                claude | codex)
                    agents="${argument}"
                    ;;
            esac
            agent_argument=0
            continue
        fi
        case "${argument}" in
            -a|--agent)
                agent_argument=1
                ;;
        esac
    done

    [ "${ids_only}" -eq 0 ] \
        && echo "-h --help -a --agent -l --last -n --limit -d --days -A --all-directories -c --current-directory -o --open -p --print -P --prompt-column -g --grep -i --igrep -r --raw --resume --fork --verbose"
    for agent in ${agents}; do
        while IFS=$'\t' read -r _ _ _ _ filepath; do
            [ -n "${filepath}" ] || continue
            session_id_of "${agent}" "${filepath}"
        done < <(agent_session_files "${agent}")
    done
}

agents="${all_agents}"
case "${APP_NAME}" in
    claude-session)
        agents="claude"
        ;;
    codex-session)
        agents="codex"
        ;;
esac

session_id=""
resume_id=""
fork_id=""
session_match_agent=""
session_match_filepath=""
fzf_action_name=""
fzf_action_agent=""
fzf_action_filepath=""
fzf_list=0
fzf_batch=""
fzf_refresh=0
fzf_toggle_open=0
fzf_toggle_view=0
fzf_view_actions=""
fzf_enter=0
fzf_enter_agent=""
fzf_enter_filepath=""
fzf_search=0
fzf_scope_session=0
fzf_scope_agent=""
fzf_scope_filepath=""
fzf_cycle_agent=0
fzf_print_prompt=0
fzf_print_escape=0
fzf_escape_actions=""
fzf_query=""
grep_pattern=""
igrep_pattern=""
last=0
limit=""
limit_explicit=0
days=60
days_explicit=0
# sessions of every folder are listed; -c narrows a listing down to this one
current_directory_only=0
current_directory="$(pwd -P)"
# the folder the picker was started in, which the folders view offers first
# while every folder is listed
launch_directory="${current_directory}"
# the picker starts with the sessions that are open in a running agent, a
# listing of everything else starts with all of them
open_only=0
fzf_view="sessions"
print=0
prompt_column=0
raw=0
verbose=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h | --help)
            usage
            ;;
        --bash-completion)
            shift
            completion "${@}"
            exit 0
            ;;
        --fzf-action)
            shift
            [ "${#}" -ge 3 ] || fail "Missing arguments for --fzf-action"
            fzf_action_name="${1}"
            fzf_action_agent="${2}"
            fzf_action_filepath="${3}"
            shift 2
            ;;
        --fzf-list)
            fzf_list=1
            ;;
        --fzf-batch)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-batch"
            [[ "${1}" =~ ^[0-9]+$ ]] || fail "Invalid fzf batch size: ${1}"
            [ "${1}" -gt 0 ] || fail "Invalid fzf batch size: ${1}"
            fzf_list=1
            fzf_batch="${1}"
            ;;
        --fzf-refresh)
            fzf_list=1
            fzf_refresh=1
            ;;
        --fzf-track)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-track"
            fzf_track_filepath="${1}"
            ;;
        --fzf-search)
            fzf_search=1
            ;;
        --fzf-toggle-open)
            fzf_toggle_open=1
            ;;
        --fzf-toggle-view)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-toggle-view"
            fzf_toggle_view=1
            fzf_view_actions="${1}"
            ;;
        --fzf-enter)
            shift
            [ "${#}" -ge 3 ] || fail "Missing arguments for --fzf-enter"
            fzf_enter=1
            fzf_view_actions="${1}"
            fzf_enter_agent="${2}"
            fzf_enter_filepath="${3}"
            shift 2
            ;;
        --fzf-scope-session)
            shift
            [ "${#}" -ge 2 ] || fail "Missing arguments for --fzf-scope-session"
            fzf_scope_session=1
            fzf_scope_agent="${1}"
            fzf_scope_filepath="${2}"
            shift
            ;;
        --fzf-cycle-agent)
            fzf_cycle_agent=1
            ;;
        --fzf-prompt)
            fzf_print_prompt=1
            ;;
        --fzf-escape)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-escape"
            fzf_print_escape=1
            fzf_escape_actions="${1}"
            ;;
        --fzf-state)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-state"
            fzf_state_file="${1}"
            ;;
        --fzf-answers)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-answers"
            fzf_answer_file="${1}"
            ;;
        --fzf-query)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fzf-query"
            fzf_query="${1}"
            ;;
        -a | --agent)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --agent"
            case "${1}" in
                claude | codex)
                    agents="${1}"
                    ;;
                *)
                    fail "Unknown agent: ${1}"
                    ;;
            esac
            ;;
        -r | --raw)
            raw=1
            ;;
        -l | --last)
            last=1
            ;;
        --resume)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --resume"
            resume_id="${1}"
            [ -n "${resume_id}" ] || fail "Missing argument for --resume"
            ;;
        --fork)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --fork"
            fork_id="${1}"
            [ -n "${fork_id}" ] || fail "Missing argument for --fork"
            ;;
        -n | --limit)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --limit"
            limit="${1}"
            [[ "${limit}" =~ ^[0-9]+$ ]] || fail "Invalid limit: ${limit}"
            [ "${limit}" -gt 0 ] || fail "Invalid limit: ${limit}"
            limit_explicit=1
            ;;
        -d | --days)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --days"
            days="${1}"
            [[ "${days}" =~ ^[0-9]+$ ]] || fail "Invalid days: ${days}"
            [ "${days}" -gt 0 ] || fail "Invalid days: ${days}"
            days_explicit=1
            ;;
        -A | --all-directories)
            current_directory_only=0
            ;;
        -c | --current-directory)
            current_directory_only=1
            ;;
        -o | --open)
            open_only=1
            ;;
        -p | --print)
            print=1
            ;;
        -P | --prompt-column)
            prompt_column=1
            ;;
        -g | --grep)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --grep"
            grep_pattern="${1}"
            [ -n "${grep_pattern}" ] || fail "Missing argument for --grep"
            ;;
        -i | --igrep)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --igrep"
            igrep_pattern="${1}"
            [ -n "${igrep_pattern}" ] || fail "Missing argument for --igrep"
            ;;
        --verbose)
            verbose=1
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            if [ -z "${session_id}" ]; then
                session_id="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

if [ -n "${fzf_action_name}" ]; then
    [ "${#}" -eq 0 ] || fail "Unexpected argument after --fzf-action"
    fzf_action "${fzf_action_name}" "${fzf_action_agent}" "${fzf_action_filepath}"
    exit 0
fi

# the scope and the search of the open picker come from its state file, not from
# the arguments the list command was built with
if [ -n "${fzf_state_file}" ]; then
    read_fzf_state

    if [ "${fzf_print_prompt}" -eq 1 ]; then
        print_fzf_prompt
        exit 0
    fi
    if [ "${fzf_print_escape}" -eq 1 ]; then
        print_fzf_escape
        exit 0
    fi
    if [ "${fzf_toggle_open}" -eq 1 ]; then
        open_only=$((1 - open_only))
        write_fzf_state
        exit 0
    fi
    if [ "${fzf_toggle_view}" -eq 1 ]; then
        print_fzf_toggle_view
        exit 0
    fi
    if [ "${fzf_enter}" -eq 1 ]; then
        print_fzf_enter "${fzf_enter_agent}" "${fzf_enter_filepath}"
        exit 0
    fi
    if [ "${fzf_scope_session}" -eq 1 ]; then
        scope_fzf_session "${fzf_scope_agent}" "${fzf_scope_filepath}"
        exit 0
    fi
    if [ "${fzf_cycle_agent}" -eq 1 ]; then
        cycle_fzf_agents
        write_fzf_state
        exit 0
    fi
    if [ "${fzf_search}" -eq 1 ]; then
        command -v prompt >/dev/null 2>&1 || fail "prompt not found"
        # an aborted prompt keeps the search that is already there
        search_term="$(prompt --complete --prompt "Search sessions:" \
            --prefill "${igrep_pattern}")" || search_term="${igrep_pattern}"
        grep_pattern=""
        igrep_pattern="${search_term}"
        write_fzf_state
        exit 0
    fi
elif [ "${fzf_print_prompt}" -eq 1 ] || [ "${fzf_print_escape}" -eq 1 ] \
    || [ "${fzf_scope_session}" -eq 1 ] \
    || [ "${fzf_cycle_agent}" -eq 1 ] || [ "${fzf_search}" -eq 1 ] \
    || [ "${fzf_toggle_open}" -eq 1 ] || [ "${fzf_toggle_view}" -eq 1 ] \
    || [ "${fzf_enter}" -eq 1 ]; then
    fail "The picker actions require --fzf-state"
fi

if [ "${limit_explicit}" -eq 1 ] && [ "${days_explicit}" -eq 1 ]; then
    fail "--limit and --days cannot be used together"
fi

[ "${limit_explicit}" -eq 1 ] && days=""

# Both go straight to what the picker asks for once a session is selected, so
# they take the place of the session argument and of everything that lists.
direct_option=""
direct_session_id=""
if [ -n "${resume_id}" ] && [ -n "${fork_id}" ]; then
    fail "--resume and --fork cannot be used together"
elif [ -n "${resume_id}" ]; then
    direct_option="--resume"
    direct_session_id="${resume_id}"
elif [ -n "${fork_id}" ]; then
    direct_option="--fork"
    direct_session_id="${fork_id}"
fi

if [ -n "${direct_option}" ]; then
    [ -n "${session_id}" ] && fail "${direct_option} cannot be used with SESSION"
    [ "${last}" -eq 1 ] && fail "${direct_option} cannot be used with --last"
    [ -n "${grep_pattern}" ] && fail "${direct_option} cannot be used with --grep"
    [ -n "${igrep_pattern}" ] && fail "${direct_option} cannot be used with --igrep"
    [ "${print}" -eq 1 ] && fail "${direct_option} cannot be used with --print"
fi

if [ "${last}" -eq 1 ] && [ -n "${session_id}" ]; then
    fail "--last cannot be used with SESSION"
fi

if [ -n "${grep_pattern}" ] && [ -n "${session_id}" ]; then
    fail "--grep cannot be used with SESSION"
fi

if [ -n "${igrep_pattern}" ] && [ -n "${session_id}" ]; then
    fail "--igrep cannot be used with SESSION"
fi

if [ -n "${grep_pattern}" ] && [ "${last}" -eq 1 ]; then
    fail "--grep cannot be used with --last"
fi

if [ -n "${igrep_pattern}" ] && [ "${last}" -eq 1 ]; then
    fail "--igrep cannot be used with --last"
fi

if [ -n "${grep_pattern}" ] && [ -n "${igrep_pattern}" ]; then
    fail "--grep and --igrep cannot be used together"
fi

if [ -n "${grep_pattern}" ]; then
    grep -q -- "${grep_pattern}" /dev/null 2>/dev/null
    grep_status="${?}"
    [ "${grep_status}" -eq 1 ] || [ "${grep_status}" -eq 0 ] || fail "Invalid --grep pattern: ${grep_pattern}"
fi

if [ -n "${igrep_pattern}" ]; then
    grep -qi -- "${igrep_pattern}" /dev/null 2>/dev/null
    grep_status="${?}"
    [ "${grep_status}" -eq 1 ] || [ "${grep_status}" -eq 0 ] || fail "Invalid --igrep pattern: ${igrep_pattern}"
fi

folders_found=0
for agent in ${agents}; do
    [ -d "$(session_folder "${agent}")" ] && folders_found=1
done
[ "${folders_found}" -eq 1 ] || fail "No session folder found for: ${agents}"

filter_pattern=""
prefilter_done=0
prefilter_pattern=""
prefilter_args=()
verify_args=()
if [ -n "${grep_pattern}" ]; then
    filter_pattern="${grep_pattern}"
    prefilter_args=( '-l' )
    verify_args=( '-q' )
elif [ -n "${igrep_pattern}" ]; then
    filter_pattern="${igrep_pattern}"
    prefilter_args=( '-l' '-i' )
    verify_args=( '-q' '-i' )
fi

# Line breaks of a message are stored escaped, so spaces of the pattern have to
# match them during the pre-filter as well. Over-matching is harmless, the
# decoded messages are matched with the pattern itself afterwards. Bracket
# expressions are left alone, replacing a space in them would change their
# meaning.
prefilter_pattern="${filter_pattern}"
case "${filter_pattern}" in
    *'['*)
        ;;
    *' '*)
        prefilter_pattern="${filter_pattern// /.*}"
        ;;
esac

if [ -n "${direct_option}" ]; then
    # the session is named, so it is looked for wherever it was recorded and
    # both actions enter its folder themselves
    verbose "Finding session with session_id=${direct_session_id} in: ${agents}..."
    find_session "${direct_session_id}" 1
    case "${direct_option}" in
        --resume)
            fzf_action resume "${session_match_agent}" "${session_match_filepath}"
            ;;
        --fork)
            ask_fork "${session_match_agent}" "${session_match_filepath}"
            ;;
    esac
elif [ "${last}" -eq 1 ]; then
    verbose "Finding latest session of: ${agents}..."
    load_codex_state
    if [ "${current_directory_only}" -eq 0 ]; then
        IFS=$'\t' read -r _ agent _ _ filepath < <(session_files | tail -n 1)
    else
        mapfile -t latest_session_lines < <(session_files)
        filepath=""
        for (( index=${#latest_session_lines[@]} - 1; index >= 0; index-- )); do
            IFS=$'\t' read -r _ agent _ _ candidate_filepath <<< "${latest_session_lines[index]}"
            if session_is_in_directory "${agent}" "${candidate_filepath}" "${current_directory}"; then
                filepath="${candidate_filepath}"
                break
            fi
        done
    fi
    verbose "${agent} ${filepath}"
    [ -z "${filepath}" ] && fail "No sessions found"
    print_session_file "${agent}" "${filepath}"
elif [ -n "${session_id}" ]; then
    verbose "Finding session with session_id=${session_id} in: ${agents}..."
    find_session "${session_id}" "$(( 1 - current_directory_only ))"
    print_session_file "${session_match_agent}" "${session_match_filepath}"
else
    verbose "Listing sessions of: ${agents}..."
    if [ "${fzf_list}" -eq 0 ] && [ "${print}" -eq 0 ]; then
        browse_sessions
        exit 0
    fi

    cutoff_epoch=0
    if [ -n "${days}" ]; then
        cutoff_epoch=$(( $(date +%s) - days * 86400 ))
    fi
    list_limit="${limit}"
    if [ -n "${fzf_batch}" ] \
        && { [ -z "${list_limit}" ] || [ "${fzf_batch}" -lt "${list_limit}" ]; }; then
        list_limit="${fzf_batch}"
    fi
    # The folders view lists the folders of the sessions of every folder, and
    # comes from the folders it listed last for as long as the state is the one
    # they were listed for.
    scoped_directory_only="${current_directory_only}"
    scoped_directory="${current_directory}"
    folders_file=""
    if [ "${fzf_view}" = "folders" ] && [ -n "${fzf_state_file}" ]; then
        folders_file="${fzf_state_file}.folders"
        fzf_track_file="${fzf_state_file}.track"
        if [ "${folders_file}" -nt "${fzf_state_file}" ]; then
            print_folder_rows "${folders_file}"
            exit 0
        fi
        current_directory_only=0
        list_limit="${limit}"
    fi
    # The open picker keeps a snapshot of the full listing for its refreshes to
    # start from; the first batch of it is no listing of its own, and the open
    # sessions are few enough to be listed anew every time, which is also what
    # finds a session that was opened without being written to.
    if [ -n "${fzf_state_file}" ] && [ -z "${fzf_batch}" ] && [ -z "${folders_file}" ]; then
        [ -n "${fzf_track_filepath}" ] && fzf_track_file="${fzf_state_file}.track"
        if [ "${open_only}" -eq 0 ]; then
            snapshot_file="${fzf_state_file}.snapshot"
            snapshot_marker="${fzf_state_file}.marker"
        fi
    fi
    if [ "${fzf_refresh}" -eq 1 ] && read_snapshot; then
        refresh_session_rows
        print_session_rows
        exit 0
    fi
    snapshot_built="$(date +%s)"
    start_snapshot
    session_entries=()
    session_lines=()
    session_paths=()
    # The directory of a codex session and the title of one are columns of its
    # state database, so one query stands in for opening every file. The open
    # sessions are named by the agents and are few, which is cheaper to read
    # one by one than the whole database, and an open session is listed
    # however long ago it was last written to.
    if [ "${open_only}" -eq 1 ]; then
        cutoff_epoch=0
    else
        [[ " ${agents} " == *" codex "* ]] && load_codex_state
    fi
    load_metadata_cache
    while IFS=$'\t' read -r mtime agent datetime size filepath; do
        [ -n "${filepath}" ] || continue
        mtime_epoch="${mtime%%.*}"
        [ "${cutoff_epoch}" -gt 0 ] && [ "${mtime_epoch}" -lt "${cutoff_epoch}" ] && continue
        session_lines+=("${agent}"$'\t'"${mtime}"$'\t'"${datetime}"$'\t'"${size}"$'\t'"${filepath}")
        session_paths+=("${filepath}")
    done < <(if [ "${open_only}" -eq 1 ]; then live_session_files; else session_files; fi)

    # Grepping the raw files is a cheap pre-filter over all sessions; its
    # matches are confirmed against the decoded messages below, so that hits in
    # tool calls, tool output or file contents are dropped.
    declare -A prefilter_hits=()
    if [ -n "${filter_pattern}" ] && [ "${#session_paths[@]}" -gt 0 ]; then
        verbose "Pre-filtering ${#session_paths[@]} session files..."
        while IFS= read -r filepath; do
            prefilter_hits["${filepath}"]=1
        done < <(printf '%s\0' "${session_paths[@]}" \
            | xargs -0 -r grep "${prefilter_args[@]}" -- "${prefilter_pattern}" 2>/dev/null)
        prefilter_done=1
        verbose "${#prefilter_hits[@]} session files to confirm..."
    fi

    # Walk from the newest session backwards. Count mode stops at its limit;
    # age mode was already restricted while collecting session files.
    for (( index=${#session_lines[@]} - 1; index >= 0; index-- )); do
        IFS=$'\t' read -r agent mtime datetime size filepath <<< "${session_lines[index]}"
        session_is_listed "${agent}" "${filepath}" || continue
        session_entries+=("${agent}"$'\t'"${mtime}"$'\t'"${datetime}"$'\t'"${size}"$'\t'"${filepath}")
        [ -n "${list_limit}" ] && [ "${#session_entries[@]}" -ge "${list_limit}" ] && break
    done

    collect_session_rows
    if [ -n "${folders_file}" ]; then
        write_folders "${folders_file}"
        print_folder_rows "${folders_file}"
        exit 0
    fi
    write_snapshot "${snapshot_built}"
    print_session_rows
fi

exit 0

#!/bin/bash

APP_PATH="${0}"
APP_NAME="$(basename "${APP_PATH}")"
DEFAULT_CLI="claude"
CLI_CHOICES="codex claude opencode"
RM_CMD="$(command -v trash 2>/dev/null || command -v rm 2>/dev/null)"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] COMMAND

Edit or create a file or command using ai (sudo if needed).

Symlinks are resolved. If the resulting file lives inside a git
repository, the coding agent is started in that repository and edits
the file in place. Otherwise the file is copied into a temporary git
repository and copied back after the changes have been confirmed.

    COMMAND     The command or file to edit.
                Commands are found via which or
                are searched for in /usr/local/bin

Options:
    -h, --help  Show this message
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    local message="${1}"
    [ -z "${message}" ] && message="Abort."
    echo "${message}" 1>&2
    exit 1
}

completion() {
    # The COMMAND positional is any command in PATH.
    echo "-h --help $(compgen -c | sort -u | tr '\n' ' ')"
    exit 0
}

syntax-check() {
    local file="${1}"
    local shebang
    local syntax_ok=1

    shebang="$(head -n 1 "${file}")"
    case "${shebang}" in
        "#!/bin/bash"|"#!/usr/bin/bash"|"#!/usr/bin/env bash")
            LC_ALL=C bash -n "${file}" || syntax_ok=0
            ;;
        "#!/usr/bin/python3"|"#!/usr/bin/env python3")
            LC_ALL=C python3 -m py_compile "${file}" || syntax_ok=0
            ;;
    esac

    if [ "${syntax_ok}" -eq 0 ]; then
        error "Syntax check failed"
        prompt-yes-no "Edit again?" && exec "${APP_PATH}" "${original_args[@]}"
    fi
}

original_args=("${@}")
file_or_cmd=""

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --bash-completion)
            completion
            ;;
        -h|--help)
            usage
            ;;
        *)
            if [ -z "${file_or_cmd}" ]; then
                file_or_cmd="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

[ -z "${file_or_cmd}" ] && usage
file=""

if [ "${file_or_cmd:0:1}" = "/" ] || [ "${file_or_cmd:0:2}" = "./" ]; then
    file="${file_or_cmd}"
else
    file="$(which ${file_or_cmd})"
    if [ -z "${file}" ]; then
        file="/usr/local/bin/${file_or_cmd}"
    fi
fi

# check if text based file
[ -f "${file}" ] && [ "$(file -b -i "${file}" | grep -c "^text/")" -lt 0 ] && fail "${file} is not a text based file"

# follow symlinks to the file that actually has to be edited
real_file="${file}"
[ -e "${file}" ] && real_file="$(realpath "${file}")"

# if the real file is tracked inside a git repo, edit it in place instead of a temp repo
repo_root=""
[ -f "${real_file}" ] && repo_root="$(git -C "$(dirname "${real_file}")" rev-parse --show-toplevel 2>/dev/null)"

echo "Editing ${file}"
[ "${real_file}" != "${file}" ] && echo "Symlink resolved to ${real_file}"

if [ -n "${repo_root}" ]; then
    in_repo=1
    edit_file="${real_file}"
    echo "File is inside git repo ${repo_root}, editing in place"
    [ ! -w "${real_file}" ] && error "${real_file} is not writable, the coding agent may not be able to change it"
    cd "${repo_root}"
    head_before="$(git rev-parse HEAD 2>/dev/null)"
    status_before="$(git status --porcelain)"
else
    in_repo=0

    # check if parent folder is writable by user
    if [ -w "$(dirname ${file})" ]; then
        sudo=""
    else
        sudo="sudo "
    fi

    local_file="$(basename "${file}")"
    tmp_repo="$(mktemp -d "${TMPDIR:-/tmp}/${local_file}-git-$(date +%s)-XXXX")"
    edit_file="${tmp_repo}/${local_file}"
    trap "${RM_CMD} -rf ${tmp_repo}" EXIT

    cd "${tmp_repo}"
    git init

    [ -f "${file}" ] && cp "${file}" "${edit_file}" || touch "${edit_file}"
    chmod +x "${edit_file}"
    cp "${HOME}/Dokumente/instructions/bash-cli-instructions.md" "${tmp_repo}"/.
    git add .
    git commit -m "Initial commit of ${local_file}"
fi

echo
cli=$(prompt-complete -p "Choose CLI to use:" -d "${DEFAULT_CLI}" ${CLI_CHOICES})

# run cli tool
${cli}

# check if changes have been made, either uncommitted, staged, or committed
if [ "${in_repo}" -eq 1 ]; then
    # the repo may have been dirty before, so compare against the state from before the run
    head_after="$(git rev-parse HEAD 2>/dev/null)"
    status_after="$(git status --porcelain)"
    [ "${head_before}" = "${head_after}" ] && [ "${status_before}" = "${status_after}" ] && echo && abort "No changes have been made."
else
    untracked="$(git ls-files --others --exclude-standard)"
    unstaged="$(git diff --name-only)"
    staged="$(git --no-pager diff --cached --name-only)"
    [ -z "${untracked}" ] && [ -z "${unstaged}" ] && [ -z "${staged}" ] && echo && abort "No changes have been made."
fi

git-diff
echo

syntax-check "${edit_file}"

echo

prompt-no-yes "Keep editing?"; exit_code=$?
case "${exit_code}" in
    130) abort ;;
    0) exec "${APP_PATH}" "${original_args[@]}" ;;
esac

# changes inside an existing repo are already in place, nothing to copy back
if [ "${in_repo}" -eq 1 ]; then
    echo "Changes are already applied to ${real_file} in ${repo_root}"
    echo

    branch="$(git branch --show-current)"
    echo "Repository: ${repo_root}"
    [ -n "${branch}" ] && echo "Branch: ${branch}"
    echo
    git -c color.status=always status --short --branch
    echo

    choice="$(prompt-select -p "What should happen with the repository?" -d n \
        "n=Nothing" \
        "p=Push changes" \
        "b=Branch changes")"; exit_code=$?
    [ "${exit_code}" -eq 130 ] && exit 0
    case "${choice}" in
        p) git-push ;;
        b) git-change ;;
    esac
    exit 0
fi

prompt-yes-no "Apply changes to ${file}?"; exit_code=$?
case "${exit_code}" in
    0) ;;
    *) abort "Changes not applied." ;;
esac

${sudo}cp "${edit_file}" "${file}"
echo "Copied ${local_file} to ${file}"

if [ ! -x "${file}" ]; then
    ${sudo}chmod +x "${file}"
    echo "Made ${file} executable"
fi

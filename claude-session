#!/bin/bash

APP_NAME="$(basename "${0}")"

session_folder="${HOME}/.claude/projects"
session_ext="jsonl"
directory_max_length=35

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [SESSION]

Prints sessions of claude CLI

SESSION   the ID of the session to print; omit to list sessions

Options:
    -h, --help          Show this message
    -l, --last          Print the latest session
    -n, --limit LIMIT   Limit number of sessions to list (default: 50)
    -r, --raw           Raw output
    --verbose           Verbose output
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

verbose() {
    local message

    [ "${verbose}" -eq 0 ] && return
    message="${1//$'\n'/$'\n+ '}"
    printf '+ %s\n' "${message}" 1>&2
}

truncate_middle() {
    local value="${1}"
    local max_length="${2}"
    local marker="..."
    local start_length
    local end_length

    [ "${#value}" -le "${max_length}" ] && echo "${value}" && return

    start_length=$(( (max_length - ${#marker}) / 2 ))
    end_length=$(( max_length - ${#marker} - start_length ))
    echo "${value:0:${start_length}}${marker}${value: -${end_length}}"
}

shorten_path() {
    local path="${1}"
    local max_length="${2}"
    local parts
    local part_count
    local prefix
    local collapse_start
    local collapse_end
    local shortened
    local index

    [ "${#path}" -le "${max_length}" ] && echo "${path}" && return

    IFS='/' read -r -a parts <<< "${path}"
    part_count="${#parts[@]}"

    if [[ "${path}" == /* ]]; then
        [ "${part_count}" -le 3 ] && truncate_middle "${path}" "${max_length}" && return
        prefix="/${parts[1]}"
        collapse_start=2
    else
        [ "${part_count}" -le 3 ] && truncate_middle "${path}" "${max_length}" && return
        prefix="${parts[0]}/${parts[1]}"
        collapse_start=2
    fi

    for (( collapse_end=collapse_start; collapse_end<part_count-1; collapse_end++ )); do
        shortened="${prefix}/..."
        for (( index=collapse_end+1; index<part_count; index++ )); do
            shortened+="/${parts[index]}"
        done
        [ "${#shortened}" -le "${max_length}" ] && echo "${shortened}" && return
    done

    truncate_middle "${shortened}" "${max_length}"
}

shorten_text() {
    local text="${1}"
    local max_length="${2}"

    [ "${#text}" -le "${max_length}" ] && echo "${text}" && return
    echo "${text:0:$((max_length - 3))}..."
}

format_cwd() {
    local cwd="${1}"
    local home_display="~"

    [ "${cwd}" = "${HOME}" ] && cwd="${home_display}"
    [[ "${cwd}" == "${HOME}/"* ]] && cwd="${home_display}/${cwd#"${HOME}/"}"
    shorten_path "${cwd}" "${directory_max_length}"
}

fail() {
    error "${1}"
    exit 1
}

print_session_file() {
    local filepath="${1}"
    local jq_args
    local session_content

    jq_args=(
        '-rsr'
        '
            def text_content:
                if type == "string" then .
                elif type == "array" then [.[]? | select(.type == "text") | .text] | join("\n")
                else "" end;
            def role_label:
                if .type == "assistant" then "Assistant"
                elif .type == "user" then "User"
                else empty end;
            [
                .[]
                | select((.type == "assistant" or .type == "user") and ((.isMeta // false) | not))
                | select(.message.content? != null)
                | {role: role_label, text: (.message.content | text_content)}
                | select(.role != null and (.text | length > 0))
                | "### \(.role)\n\n\(.text)"
            ] | join("\n\n---\n\n")
        '
    )
    verbose "Extracting session messages from ${filepath}..."
    verbose "jq ${jq_args[*]} ${filepath}"
    session_content="$(jq "${jq_args[@]}" "${filepath}")"
    [ "${raw}" -eq 0 ] && echo "${session_content}" | glow || echo "${session_content}"
}

session_id=""
last=0
limit=50
raw=0
verbose=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h | --help)
            usage
            ;;
        -r | --raw)
            raw=1
            ;;
        -l | --last)
            last=1
            ;;
        -n | --limit)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --limit"
            limit="${1}"
            [[ "${limit}" =~ ^[0-9]+$ ]] || fail "Invalid limit: ${limit}"
            [ "${limit}" -gt 0 ] || fail "Invalid limit: ${limit}"
            ;;
        --verbose)
            verbose=1
            ;;
        -*)
            fail "Unknown option: ${1}"
            ;;
        *)
            if [ -z "${session_id}" ]; then
                session_id="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

[ -d "${session_folder}" ] || fail "No Claude session folder: ${session_folder}"

if [ "${last}" -eq 1 ] && [ -n "${session_id}" ]; then
    fail "--last cannot be used with SESSION"
fi

if [ "${last}" -eq 1 ]; then
    verbose "Finding latest session..."
    filepath="$(find "${session_folder}" -mindepth 2 -maxdepth 2 -name "*.${session_ext}" -printf '%T@ %p\n' | sort -n | tail -n 1 | sed 's/^[^ ]* //')"
    verbose "${filepath}"
    [ -z "${filepath}" ] && fail "No sessions found"
    print_session_file "${filepath}"
elif [ -n "${session_id}" ]; then
    verbose "Finding session with session_id=${session_id}..."
    filepath="$(find "${session_folder}" -mindepth 2 -maxdepth 2 -name "*${session_id}*.${session_ext}")"
    verbose "${filepath}"
    [ -z "${filepath}" ] && fail "No such session: ${session_id}"
    [ "$(echo "${filepath}" | wc -l)" -gt 1 ] && fail "Multiple matches for session: ${session_id}"
    print_session_file "${filepath}"
else
    verbose "Listing sessions..."
    rows=""
    while IFS= read -r filepath; do
        [ -n "${filepath}" ] || continue
        filename="$(basename "${filepath}")"
        session_id="${filename%."${session_ext}"}"
        datetime="$(jq -r -s 'map(select(.timestamp))[0].timestamp // "" | sub("\\.[0-9]+Z$"; "Z") | sub("Z$"; "")' "${filepath}")"
        cwd="$(jq -r -s 'map(select(.cwd))[0].cwd // ""' "${filepath}")"
        cwd="$(format_cwd "${cwd}")"
        summary="$(jq -rsr '
            def text_content:
                if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join(" ")) end;
            def command_message:
                (capture("<command-message>(?<message>.*?)</command-message>"; "n").message? // .);
            map(select(.type == "user" and ((.isMeta // false) | not) and (.message.content? != null)))
            | map(.message.content | text_content | gsub("^[[:space:]]+"; ""))
            | map(select(test("^<command-name>|^<local-command-|^<tool_result>"; "n") | not))
            | map(command_message | gsub("<[^>]+>"; "") | gsub("^[[:space:]]+|[[:space:]]+$"; ""))
            | map(select(length > 0))
            | .[0] // ""
        ' "${filepath}" | head -1 | tr -s ' \t\n' ' ')"
        summary="$(shorten_text "${summary}" 60)"
        rows+="${session_id}  ${datetime}  ${cwd}  ${summary}\n"
    done < <(find "${session_folder}" -mindepth 2 -maxdepth 2 -name "*.${session_ext}" -printf '%T@ %p\n' | sort -n | tail -n "${limit}" | sed 's/^[^ ]* //')
    verbose "echo -e 'SESSION  DATETIME  DIRECTORY  SUMMARY\n\${rows}' | k-format"
    echo -e "SESSION  DATETIME  DIRECTORY  SUMMARY\n${rows}" | k-format
fi

exit 0

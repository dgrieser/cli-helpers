#!/bin/bash

APP_NAME="$(basename "${0}")"

# Commands OpenCode ships itself, they have no file below a command directory.
BUILTIN_COMMANDS="init review"

# The started OpenCode server is unauthenticated and is only used by the TUI
# this script starts, so it stays on the loopback interface.
HOST="127.0.0.1"

# Seconds to wait for the OpenCode server to accept requests.
DEFAULT_TIMEOUT="60"


function usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [COMMAND [ARGUMENTS...]]

Runs a slash command or a prompt in a new OpenCode session.

    COMMAND
        Slash command to run, with or without a leading '/'

    ARGUMENTS
        Arguments handed to the slash command as \$ARGUMENTS

    Options:
        -h, --help          Display this help and exit

        -c, --command       Slash command to run, same as COMMAND

        -p, --prompt        Prompt to submit instead of a slash command

        -C, --dir           Directory to start OpenCode in
                            Default: git root of the working directory,
                            the working directory otherwise

        -t, --timeout       Seconds to wait for the OpenCode server to start
                            Default: ${DEFAULT_TIMEOUT}

        -l, --list-commands List the available slash commands and exit

        -v, --verbose       Print the OpenCode command lines

        --bash-completion   Print completion candidates and exit
EOF
    exit 1
}

function error() {
    echo "ERROR: ${1}" 1>&2
}

function warning() {
    echo "WARNING: ${1}" 1>&2
}

function fail() {
    error "${1}"
    exit 1
}

function verbose() {
    [ "${verbose}" -eq 1 ] && echo "+ ${1}" 1>&2
    return 0
}

function require_command() {
    command -v "${1}" >/dev/null 2>&1 || fail "Command not found: ${1}"
}

# Directories OpenCode reads slash commands from, in the order it looks them up.
# Both the singular and the plural spelling are used, and every .opencode of a
# parent directory contributes its commands as well.
function command_directories() {
    local directory="${1}"
    local config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
    local candidate=""

    for candidate in "${config_home}/opencode/command" "${config_home}/opencode/commands"; do
        [ -d "${candidate}" ] && echo "${candidate}"
    done

    while [ -n "${directory}" ]; do
        for candidate in "${directory}/.opencode/command" "${directory}/.opencode/commands"; do
            [ -d "${candidate}" ] && echo "${candidate}"
        done
        [ "${directory}" = "/" ] && break
        directory="$(dirname "${directory}")"
    done
}

# A command is named after its file below a command directory, so a command in
# a subdirectory is called with that path as a prefix. Commands of a plugin or a
# skill are not found this way, the running server knows about those.
function list_commands() {
    local directory="${1}"
    local command_directory=""

    {
        printf '%s\n' ${BUILTIN_COMMANDS}
        while IFS= read -r command_directory; do
            find "${command_directory}" -type f -name '*.md' -printf '%P\n' 2>/dev/null \
                | sed 's/\.md$//'
        done < <(command_directories "${directory}")
    } | sort -u
}

function completion() {
    local previous="${1}"
    local directory=""
    local argument=""
    local next_is_directory=0

    case "${previous}" in
        -C|--dir|-p|--prompt|-t|--timeout)
            # Directories are left to the default filename completion,
            # prompts and timeouts are free text.
            return
            ;;
    esac
    shift

    for argument in "${@}"; do
        if [ "${next_is_directory}" -eq 1 ]; then
            directory="${argument}"
            next_is_directory=0
            continue
        fi
        case "${argument}" in
            -C|--dir)
                next_is_directory=1
                ;;
        esac
    done

    [ -z "${directory}" ] && directory="$(git rev-parse --show-toplevel 2>/dev/null)"
    [ -z "${directory}" ] && directory="${PWD}"

    echo "-h --help -c --command -p --prompt -C --dir -t --timeout -l --list-commands -v --verbose --bash-completion"
    [ -d "${directory}" ] && list_commands "${directory}"
}

# OpenCode can pick a free port itself, but it does not report which one it
# took, so the port has to be known before the server is started.
function find_free_port() {
    local candidate=""
    local attempt=0

    while [ "${attempt}" -lt 50 ]; do
        candidate=$(( (RANDOM % 16384) + 49152 ))
        if ! (exec 3<>"/dev/tcp/${HOST}/${candidate}") 2>/dev/null; then
            echo "${candidate}"
            return 0
        fi
        attempt=$(( attempt + 1 ))
    done

    return 1
}

function wait_for_server() {
    local deadline=$(( SECONDS + timeout ))

    while [ "${SECONDS}" -lt "${deadline}" ]; do
        kill -0 "${server_pid}" 2>/dev/null || return 1
        curl --fail --silent --max-time 2 "${base_url}/global/health" >/dev/null 2>&1 \
            && return 0
        sleep 0.25
    done

    return 1
}

function server_knows_command() {
    curl --fail --silent --max-time 5 "${base_url}/command" 2>/dev/null \
        | jq --exit-status --arg name "${command_name}" \
            'any(.[]; .name == $name)' >/dev/null 2>&1
}

function create_session() {
    local payload=""

    payload="$(jq --compact-output --null-input --arg directory "${directory}" \
        '{location: {directory: $directory}}')" || return 1

    curl --fail --silent --max-time 10 \
        -X POST "${base_url}/api/session" \
        -H "content-type: application/json" \
        --data-binary "${payload}" 2>/dev/null \
        | jq --raw-output --exit-status '.data.id // .id' 2>/dev/null
}

# Running the command through the server expands its template with the given
# arguments, exactly like typing the slash command in the TUI does. The request
# only returns once the assistant is done, so it runs next to the TUI.
function run_command() {
    local payload=""

    payload="$(jq --compact-output --null-input \
        --arg command "${command_name}" \
        --arg arguments "${arguments[*]}" \
        '{command: $command, arguments: $arguments}')" || return 1

    curl --silent --output /dev/null \
        -X POST "${base_url}/session/${session_id}/command" \
        -H "content-type: application/json" \
        --data-binary "${payload}" &
    request_pid="${!}"
}

function run_prompt() {
    local payload=""

    payload="$(jq --compact-output --null-input --arg text "${prompt}" \
        '{parts: [{type: "text", text: $text}]}')" || return 1

    curl --fail --silent --show-error --max-time 30 --output /dev/null \
        -X POST "${base_url}/session/${session_id}/prompt_async" \
        -H "content-type: application/json" \
        --data-binary "${payload}"
}

function cleanup() {
    local status="${?}"

    trap - EXIT INT TERM
    if [ -n "${request_pid}" ] && kill -0 "${request_pid}" 2>/dev/null; then
        kill "${request_pid}" 2>/dev/null
    fi
    if [ -n "${server_pid}" ] && kill -0 "${server_pid}" 2>/dev/null; then
        kill "${server_pid}" 2>/dev/null
    fi
    [ -n "${server_log}" ] && rm -f "${server_log}"

    exit "${status}"
}

mode=""
command_name=""
prompt=""
directory=""
timeout="${DEFAULT_TIMEOUT}"
list=0
verbose=0
arguments=()
base_url=""
session_id=""
text=""
server_pid=""
server_log=""
request_pid=""

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --bash-completion)
            shift
            completion "${@}"
            exit 0
            ;;
        -h|--help)
            usage
            ;;
        -v|--verbose)
            verbose=1
            ;;
        -l|--list-commands)
            list=1
            ;;
        -C|--dir)
            shift
            [ -z "${1}" ] && usage
            directory="${1}"
            ;;
        -t|--timeout)
            shift
            [ -z "${1}" ] && usage
            case "${1}" in
                *[!0-9]*) fail "Timeout must be a positive number of seconds: ${1}" ;;
            esac
            [ "${1}" -gt 0 ] || fail "Timeout must be a positive number of seconds: ${1}"
            timeout="${1}"
            ;;
        -p|--prompt)
            shift
            [ -z "${1}" ] && usage
            [ -n "${mode}" ] && fail "Only one command or prompt can be run."
            mode="prompt"
            prompt="${1}"
            ;;
        -c|--command)
            shift
            [ -z "${1}" ] && usage
            [ -n "${mode}" ] && fail "Only one command or prompt can be run."
            mode="command"
            command_name="${1}"
            # The rest belongs to the command, so it may contain options.
            shift
            arguments+=("${@}")
            break
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            [ -n "${mode}" ] && fail "Only one command or prompt can be run."
            mode="command"
            command_name="${1}"
            shift
            arguments+=("${@}")
            break
            ;;
    esac
    shift
done

if [ -z "${directory}" ]; then
    directory="$(git rev-parse --show-toplevel 2>/dev/null)"
    [ -z "${directory}" ] && directory="${PWD}"
fi
[ ! -d "${directory}" ] && fail "Directory does not exist: ${directory}"
directory="$(cd "${directory}" && pwd -P)" || fail "Cannot change to directory: ${directory}"

if [ "${list}" -eq 1 ]; then
    list_commands "${directory}"
    exit 0
fi

[ -z "${mode}" ] && usage

text=""
if [ "${mode}" = "command" ]; then
    command_name="${command_name#/}"
    [ -z "${command_name}" ] && fail "Empty command name."
    text="/${command_name}"
    [ "${#arguments[@]}" -gt 0 ] && text="${text} ${arguments[*]}"
fi

require_command opencode
require_command curl
require_command jq

cd "${directory}" || fail "Cannot change to directory: ${directory}"

port="$(find_free_port)" || fail "Could not find a free port on ${HOST}."
base_url="http://${HOST}:${port}"
server_log="$(mktemp)" || fail "Could not create a temporary file."

trap cleanup EXIT INT TERM

verbose "opencode serve --hostname ${HOST} --port ${port}"
opencode serve --hostname "${HOST}" --port "${port}" > "${server_log}" 2>&1 &
server_pid="${!}"

if ! wait_for_server; then
    error "OpenCode server did not start on ${base_url}."
    sed 's/^/    /' "${server_log}" 1>&2
    exit 1
fi

# The server knows about commands of a plugin or a skill as well, so this is
# checked before a session is created for an unknown name.
if [ "${mode}" = "command" ]; then
    server_knows_command || fail "Unknown slash command: ${command_name}"
fi

session_id="$(create_session)" || fail "Could not create an OpenCode session."
verbose "session ${session_id}"

case "${mode}" in
    command)
        verbose "run ${text}"
        run_command || fail "Could not run the slash command."
        ;;
    prompt)
        verbose "submit prompt"
        run_prompt || fail "Could not submit the prompt."
        ;;
esac

verbose "opencode attach ${base_url} --session ${session_id}"
opencode attach "${base_url}" --session "${session_id}" --dir "${directory}"

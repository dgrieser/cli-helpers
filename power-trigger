#!/usr/bin/python3 -u
import pydbus
from pydbus import SystemBus
from gi.repository import Gio, GLib
import os
import subprocess
import threading
import time
from pathlib import Path

# On battery with the lid closed: power saver after 10 minutes. Suspend only when the
# battery is low: under 30 % once the lid is closed for 30 minutes, under 10 % once it
# is closed for 5 minutes. At 30 % or more the laptop keeps running.
SECONDS_UNTIL_POWER_SAVER=600
BATTERY_PERCENT_LOW=30
SECONDS_LID_CLOSED_BEFORE_SUSPEND_LOW=1800
BATTERY_PERCENT_CRITICAL=10
SECONDS_LID_CLOSED_BEFORE_SUSPEND_CRITICAL=300
POWER_PROFILE_POWER_SAVER='power-saver'
SECONDS_DELAY_BETWEEN_SUSPENDS=60
# give logind time to send PrepareForSleep(false) itself before NetworkManager is checked
SECONDS_DELAY_NETWORK_WAKE_CHECK=15
NM_STATE_ASLEEP=10
# let the lock screen draw before the screens go off, so turning them on shows no desktop
SECONDS_DELAY_SCREEN_OFF_AFTER_LOCK=2
# Mutter 50.1 aborted twice when PowerSaveMode was set ~3 s after an undock
# (meta_kms_impl_device_unhold_fd assertion, 2026-11-20 and 2026-11-24).
# Wait until the monitor configuration did not change for this long.
SECONDS_MONITORS_SETTLE=10
SECONDS_DELAY_SESSION_BUS_RECONNECT=5
MUTTER_POWER_SAVE_ON=0
MUTTER_POWER_SAVE_OFF=3

def get_cifs_mountpoints():
    mounts = []
    with open("/proc/self/mounts", encoding="utf-8") as f:  # like /proc/mounts
        for line in f:
            parts = line.split()
            if len(parts) >= 3 and parts[2] == "cifs":  # fs type
                mounts.append(Path(parts[1]))
    # sort reverse so deeper mountpoints are unmounted first
    mounts.sort(key=lambda p: len(p.as_posix()), reverse=True)
    return mounts  # list[Path]

def umount_cifs(force=False, lazy=False):
    opts = []
    if force:
        opts.append("-f")
    if lazy:
        opts.append("-l")

    for mp in get_cifs_mountpoints():
        cmd = ["umount", *opts, str(mp)]
        subprocess.run(cmd, check=False)

def on_lid_opened_event(on_battery):
    global is_lid_open
    is_lid_open=True
    print(f'Detected lid open')
    set_screens_on(True)
    schedule_network_wake_check()

def on_lid_closed_event(on_battery):
    global is_lid_open
    is_lid_open=False
    print(f'Detected lid close')
    lock_screen()
    schedule_screens_off(SECONDS_DELAY_SCREEN_OFF_AFTER_LOCK)

def on_lid_closed_power_saver_event(on_battery):
    print(f'Detected lid closed for {SECONDS_UNTIL_POWER_SAVER} seconds while on {"battery" if on_battery else "AC"}')
    if on_battery:
        set_power_saver()

def on_battery_event(on_battery):
    print(f'Detected change to {"battery" if on_battery else "AC"} power')
    if not on_battery:
        restore_power_profile()
    if on_battery and not is_lid_open:
        print('Now on battery and lid closed, starting lid closed timers')
        start_lid_closed_timer()

def on_prepare_for_sleep(suspending):
    if suspending:
        on_suspend()
    else:
        on_resume()

def on_suspend():
    print(f'Detected system suspend')

def on_resume():
    print(f'Detected system resume with lid {"open" if is_lid_open else "closed"}')
    schedule_network_wake_check()
    if not is_lid_open and is_on_battery:
        print('Lid still closed and on battery, checking the battery')
        # the power saver timer does not count the time asleep
        reschedule_power_saver()
        check_suspend()

# A resume can kill systemd-logind (systemd watchdog, 2026-11-15) before it sends
# PrepareForSleep(false). NetworkManager then stays asleep and the wifi stays off.
# Wake it when logind is not preparing for sleep. NM_STATE_ASLEEP also means that
# networking is disabled by hand, so NetworkingEnabled must still be true.
# Calling Sleep needs org.freedesktop.NetworkManager.sleep-wake, see
# lib/cli-helpers/etc/polkit-1/rules.d/50-cli-helpers-nm-sleep-wake.rules
def wake_network_if_stuck_asleep():
    try:
        nm = bus.get('org.freedesktop.NetworkManager', '/org/freedesktop/NetworkManager')
        if nm.State != NM_STATE_ASLEEP or not nm.NetworkingEnabled:
            return False
        logind = bus.get('org.freedesktop.login1', '/org/freedesktop/login1')
        if logind.PreparingForSleep:
            return False
        print('NetworkManager is asleep but the system is not suspending, waking it up')
        nm.Sleep(False)
        notify('Network woken up', 'NetworkManager was still asleep after a resume.')
    except Exception as e:
        print(f'Could not check or wake NetworkManager: {e}')
    return False  # a GLib timeout callback, do not repeat

def schedule_network_wake_check(delay=SECONDS_DELAY_NETWORK_WAKE_CHECK):
    GLib.timeout_add_seconds(delay, wake_network_if_stuck_asleep)

def on_logind_owner_changed(name, old_owner, new_owner):
    if not new_owner:
        print('systemd-logind left the bus')
        return
    # logind is up before this user service starts, so a new owner is a restart
    print('systemd-logind restarted, sessions lost their devices and NetworkManager may still be asleep')
    schedule_network_wake_check()
    notify('systemd-logind restarted',
           'If keyboard or mouse do not respond anymore, log out and in again.', urgency='critical')

def notify(summary, body, urgency='normal'):
    try:
        subprocess.run(['notify-send', f'--urgency={urgency}', '--app-name=power-trigger', summary, body], check=False)
    except OSError as e:
        print(f'Could not send notification: {e}')

# The shared session bus of GLib (pydbus.SessionBus) raises SIGTERM when it closes.
# A GNOME Shell crash restarts the session bus (gnome-session-restart-dbus.service),
# and that stopped this service for good (2026-11-24). A private connection does not
# exit on close; connect again when it was closed.
session_bus = None
session_bus_reconnect_pending = False

def get_session_bus():
    global session_bus
    if session_bus is None or session_bus.con.is_closed():
        address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
        session_bus = pydbus.connect(address)
        session_bus.con.connect('closed', on_session_bus_closed)
        session_bus.subscribe(
            iface='org.gnome.Mutter.DisplayConfig',
            signal='MonitorsChanged',
            object='/org/gnome/Mutter/DisplayConfig',
            signal_fired=lambda *args: on_monitors_changed()
        )
        # a new session bus means a new GNOME Shell, its monitors are not settled yet
        on_monitors_changed()
    return session_bus

def on_session_bus_closed(*args):
    print('Session bus closed, connecting again')
    schedule_session_bus_reconnect()

def schedule_session_bus_reconnect():
    global session_bus_reconnect_pending
    if not session_bus_reconnect_pending:
        session_bus_reconnect_pending = True
        GLib.timeout_add_seconds(SECONDS_DELAY_SESSION_BUS_RECONNECT, reconnect_session_bus)

# keep the MonitorsChanged subscription alive across session bus restarts
def reconnect_session_bus():
    global session_bus_reconnect_pending
    session_bus_reconnect_pending = False
    try:
        get_session_bus()
    except Exception as e:
        print(f'Could not connect to the session bus: {e}')
        schedule_session_bus_reconnect()
    return False  # a GLib timeout callback, do not repeat

def on_monitors_changed():
    global last_monitors_change
    last_monitors_change = time.monotonic()

def schedule_screens_off(delay):
    global screens_off_source
    if screens_off_source is not None:
        GLib.source_remove(screens_off_source)
    screens_off_source = GLib.timeout_add(max(1, int(delay * 1000)), turn_screens_off_if_lid_closed)

# all screens through Mutter, the external ones too; any input turns them on again
def set_screens_on(on):
    try:
        display = get_session_bus().get('org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig')
        mode = MUTTER_POWER_SAVE_ON if on else MUTTER_POWER_SAVE_OFF
        if display.PowerSaveMode != mode:
            print(f'Turning screens {"on" if on else "off"}')
            display.PowerSaveMode = mode
    except Exception as e:
        print(f'Could not turn screens {"on" if on else "off"}: {e}')

def turn_screens_off_if_lid_closed():
    global screens_off_source
    screens_off_source = None
    if is_lid_open:
        return False
    # connect first: a new connection resets the settle time for a restarted GNOME Shell
    try:
        get_session_bus()
    except Exception as e:
        print(f'Could not turn screens off: {e}')
        return False
    since_change = time.monotonic() - last_monitors_change
    if since_change < SECONDS_MONITORS_SETTLE:
        wait = SECONDS_MONITORS_SETTLE - since_change
        print(f'Monitors changed {since_change:.1f} seconds ago, turning screens off in {wait:.1f} seconds')
        schedule_screens_off(wait)
        return False
    set_screens_on(False)
    return False  # a GLib timeout callback, do not repeat

# power-profiles-daemon, the legacy name before version 0.20 as a fallback
def get_power_profiles():
    try:
        return bus.get('org.freedesktop.UPower.PowerProfiles', '/org/freedesktop/UPower/PowerProfiles')
    except Exception:
        return bus.get('net.hadess.PowerProfiles', '/net/hadess/PowerProfiles')

# remembers the profile before, restore_power_profile switches back to it
def set_power_saver():
    global power_profile_before
    try:
        power_profiles = get_power_profiles()
        current = power_profiles.ActiveProfile
        if current == POWER_PROFILE_POWER_SAVER:
            return
        print(f'Switching power profile from {current} to {POWER_PROFILE_POWER_SAVER}')
        power_profiles.ActiveProfile = POWER_PROFILE_POWER_SAVER
        power_profile_before = current
    except Exception as e:
        print(f'Could not switch to power profile {POWER_PROFILE_POWER_SAVER}: {e}')

# any other profile in between, even power-saver chosen again later, belongs to the user
def on_power_profiles_properties_changed(params):
    global power_profile_before
    changed = params[1]
    if power_profile_before is None or 'ActiveProfile' not in changed:
        return
    if changed['ActiveProfile'] != POWER_PROFILE_POWER_SAVER:
        print(f'Power profile changed to {changed["ActiveProfile"]}, not restoring {power_profile_before} anymore')
        power_profile_before = None

# leaves a profile alone that was changed after set_power_saver
def restore_power_profile():
    global power_profile_before
    if power_profile_before is None:
        return
    previous = power_profile_before
    try:
        power_profiles = get_power_profiles()
        current = power_profiles.ActiveProfile
        if current != POWER_PROFILE_POWER_SAVER:
            print(f'Power profile changed to {current} meanwhile, not restoring {previous}')
        else:
            print(f'Restoring power profile {previous}')
            power_profiles.ActiveProfile = previous
        power_profile_before = None
    except Exception as e:
        # keep it, the next lid open or AC plug-in tries again
        print(f'Could not restore power profile {previous}: {e}')

def lock_screen():
    print('Locking screen')
    subprocess.run(['loginctl', 'lock-session'])

def suspend_laptop():
    global last_suspend_timestamp, suspend_pending
    now = time.time()
    if suspend_pending:
        # the pending one may be dropped for a lid or power change, so check again
        print(f'Suspend already pending, checking again in {SECONDS_DELAY_BETWEEN_SUSPENDS} seconds')
        schedule_suspend_check(SECONDS_DELAY_BETWEEN_SUSPENDS)
        return
    if now - last_suspend_timestamp < SECONDS_DELAY_BETWEEN_SUSPENDS:
        print(f'Last suspend call was less than {SECONDS_DELAY_BETWEEN_SUSPENDS} seconds ago, checking again later')
        schedule_suspend_check(SECONDS_DELAY_BETWEEN_SUSPENDS)
        return
    last_suspend_timestamp = now
    suspend_pending = True
    # a stalled CIFS unmount must not block the main loop and its lid and power events
    threading.Thread(target=unmount_and_suspend, args=(power_state_generation,), daemon=True).start()

def unmount_and_suspend(generation):
    global suspend_pending
    try:
        print('Unmounting cifs')
        umount_cifs(force=True)
        # the lid or the power source may change while the unmount runs, even back again
        if generation != power_state_generation:
            print('Lid or power source changed while unmounting, not suspending')
            return
        print('Suspending laptop')
        subprocess.run(['systemctl', 'suspend'])
    finally:
        suspend_pending = False

# the time the lid is closed for, suspends included; None while the lid is open or on AC
def seconds_lid_closed():
    if lid_closed_since is None:
        return None
    return time.clock_gettime(time.CLOCK_BOOTTIME) - lid_closed_since

def get_battery_percent():
    try:
        return float(battery.Percentage)
    except Exception as e:
        print(f'Could not read the battery level: {e}')
        return None

# how long the lid must be closed before a suspend at this battery level, None for never
def seconds_lid_closed_before_suspend(percent):
    if percent is None:
        # unknown level: suspend like a low battery rather than let it run empty
        return SECONDS_LID_CLOSED_BEFORE_SUSPEND_LOW
    if percent < BATTERY_PERCENT_CRITICAL:
        return SECONDS_LID_CLOSED_BEFORE_SUSPEND_CRITICAL
    if percent < BATTERY_PERCENT_LOW:
        return SECONDS_LID_CLOSED_BEFORE_SUSPEND_LOW
    return None

# called by the lid closed timers, on battery level changes and on resume
def check_suspend():
    if is_lid_open or not is_on_battery:
        return
    closed = seconds_lid_closed()
    if closed is None:
        return
    percent = get_battery_percent()
    required = seconds_lid_closed_before_suspend(percent)
    if required is None:
        return
    level = 'unknown' if percent is None else f'{percent:.0f} %'
    if closed < required:
        print(f'Battery at {level}, suspending once the lid is closed for {required} seconds')
        schedule_suspend_check(required - closed)
        return
    print(f'Battery at {level} and lid closed for {closed:.0f} seconds, suspending')
    suspend_laptop()

def schedule_suspend_check(delay):
    global suspend_check_timer
    if suspend_check_timer is not None:
        GLib.source_remove(suspend_check_timer)
    suspend_check_timer = GLib.timeout_add(max(1, int(delay * 1000) + 1), on_suspend_check_timer_trigger)

def on_suspend_check_timer_trigger():
    global suspend_check_timer
    suspend_check_timer = None
    check_suspend()
    return False  # a GLib timeout callback, do not repeat

def schedule_power_saver(delay):
    global power_saver_timer
    if power_saver_timer is not None:
        GLib.source_remove(power_saver_timer)
    power_saver_timer = GLib.timeout_add(max(1, int(delay * 1000) + 1), on_power_saver_timer_trigger)

# GLib timers do not count the time asleep, the lid closed time does
def reschedule_power_saver():
    closed = seconds_lid_closed()
    if power_saver_timer is not None and closed is not None:
        schedule_power_saver(SECONDS_UNTIL_POWER_SAVER - closed)

def on_power_saver_timer_trigger():
    global power_saver_timer
    power_saver_timer = None
    on_lid_closed_power_saver_event(is_on_battery)
    return False  # a GLib timeout callback, do not repeat

# GLib timers: the callbacks run in the main loop, like the D-Bus signal handlers.
# The suspend check runs first at the shortest time a suspend can happen at.
def start_lid_closed_timer():
    cancel_lid_closed_timer()
    global lid_closed_since, power_saver_timer
    lid_closed_since = time.clock_gettime(time.CLOCK_BOOTTIME)
    if SECONDS_UNTIL_POWER_SAVER > 0:
        schedule_power_saver(SECONDS_UNTIL_POWER_SAVER)
    schedule_suspend_check(min(SECONDS_LID_CLOSED_BEFORE_SUSPEND_CRITICAL, SECONDS_LID_CLOSED_BEFORE_SUSPEND_LOW))

def cancel_lid_closed_timer():
    global lid_closed_since, power_saver_timer, suspend_check_timer
    lid_closed_since = None
    if power_saver_timer is not None:
        GLib.source_remove(power_saver_timer)
        power_saver_timer = None
    if suspend_check_timer is not None:
        GLib.source_remove(suspend_check_timer)
        suspend_check_timer = None

def on_battery_properties_changed(*args):
    if 'Percentage' in args[1] and not is_lid_open and is_on_battery:
        check_suspend()

def on_battery(on_battery):
    global is_on_battery
    is_on_battery = on_battery
    on_battery_event(is_on_battery)

def on_upower_properties_changed(*args):
    properties = args[1]
    global power_state_generation
    if 'LidIsClosed' in properties or 'OnBattery' in properties:
        power_state_generation += 1

    if 'LidIsClosed' in properties:
        if properties['LidIsClosed']:
            on_lid_closed_event(is_on_battery)
            start_lid_closed_timer()
        else:
            on_lid_opened_event(is_on_battery)
            cancel_lid_closed_timer()
            restore_power_profile()
    
    if 'OnBattery' in properties:
        if not properties['OnBattery']:
            cancel_lid_closed_timer()
        on_battery(properties['OnBattery'])

def get_on_battery():
    power_supply_dir = "/sys/class/power_supply"
    for supply in os.listdir(power_supply_dir):
        path = os.path.join(power_supply_dir, supply)
        if os.path.exists(os.path.join(path, "type")):
            with open(os.path.join(path, "type")) as f:
                if f.read().strip() == "Mains":
                    with open(os.path.join(path, "online")) as f:
                        if f.read().strip() == "1":
                            return False
    return True

is_lid_open = True
is_on_battery = get_on_battery()
last_suspend_timestamp = 0
lid_closed_since = None
suspend_check_timer = None
suspend_pending = False
power_saver_timer = None
power_profile_before = None
# counts lid and power source changes, a pending suspend is dropped when it changed
power_state_generation = 0
screens_off_source = None
last_monitors_change = 0.0
bus = SystemBus()

upower = bus.get('org.freedesktop.UPower', '/org/freedesktop/UPower')
upower.PropertiesChanged.connect(on_upower_properties_changed)
# the combined level of all batteries, as GNOME shows it
battery = bus.get('org.freedesktop.UPower', '/org/freedesktop/UPower/devices/DisplayDevice')
battery.PropertiesChanged.connect(on_battery_properties_changed)
bus.subscribe(
    iface='org.freedesktop.login1.Manager',
    signal='PrepareForSleep',
    object='/org/freedesktop/login1',
    signal_fired=lambda sender, object, iface, signal, params: on_prepare_for_sleep(params[0])
)
bus.subscribe(
    sender='org.freedesktop.DBus',
    iface='org.freedesktop.DBus',
    signal='NameOwnerChanged',
    object='/org/freedesktop/DBus',
    arg0='org.freedesktop.login1',
    signal_fired=lambda sender, object, iface, signal, params: on_logind_owner_changed(*params)
)

for power_profiles_object in ('/org/freedesktop/UPower/PowerProfiles', '/net/hadess/PowerProfiles'):
    bus.subscribe(
        iface='org.freedesktop.DBus.Properties',
        signal='PropertiesChanged',
        object=power_profiles_object,
        signal_fired=lambda sender, object, iface, signal, params: on_power_profiles_properties_changed(params)
    )

print('Starting power trigger...')
print(f'Currently running on {"battery" if is_on_battery else "AC"} power, battery at {get_battery_percent()} %')
reconnect_session_bus()
loop = GLib.MainLoop()
loop.run()

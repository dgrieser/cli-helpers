#!/bin/bash

APP_NAME="$(basename "${0}")"
PLATFORM="$(dpkg --print-architecture)"
UPDATE_MESSAGE="Running %PKGNAME% upgrade"
FLATHUB_REPO_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
# shellcheck disable=SC1090
[ -f /etc/os-release ] && source <(sed -E 's/^([A-Z0-9_]+)=/OS_RELEASE_\1=/' /etc/os-release)

possible_install_types=()
possible_groups=()
software_install_types=()
declare -A software_handlers=()
declare -A software_disabled=()
declare -A group_members=()
# the software a step needed and that was run for it, so it is not run twice
declare -A software_needed=()
# the hosts install-git-release was checked to be logged in to
declare -A release_host_checked=()
selected=""

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

verbose() {
    [ "${verbose}" -eq 1 ] && echo "+ ${1}" 1>&2
}

require_cmd() {
    local cmd
    local missing=()
    for cmd in "${@}"; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done
    [ "${#missing[@]}" -eq 0 ] && return 0
    error "${selected:-${APP_NAME}} requires missing command(s): ${missing[*]}"
    return 1
}

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] SOFTWARE ...

Run ${APP_NAME} to update software.

SOFTWARE         Software or group to update, all if omitted.
                 Software: $(echo "${possible_install_types[@]}" | tr ' ' ',')
                 Groups: $([ "${#possible_groups[@]}" -gt 0 ] && echo "${possible_groups[@]}" | tr ' ' ',' || echo "none")

Options:
  -h, --help          display this help and exit
  -d, --dry-run       dry-run mode
  -t, --types TYPES   comma separated list of install types (deprecated)
  -l, --list          list the groups with their software and exit
  --verbose           verbose mode
  --bash-completion   print shell completion candidates and exit
EOF
    exit 1
}

is_interactive() {
    if [ -t 0 ] && [ -t 1 ]; then
        return 0
    fi
    return 1
}

is_install_type() {
    local item
    for item in "${possible_install_types[@]}"; do
        [ "${item}" = "${1}" ] && return 0
    done
    return 1
}

is_install_type_selected() {
    local item
    for item in "${selected_install_types[@]}"; do
        [ "${item}" = "${1}" ] && return 0
    done
    return 1
}

is_group() {
    local item
    for item in "${possible_groups[@]}"; do
        [ "${item}" = "${1}" ] && return 0
    done
    return 1
}

is_group_member() {
    local item
    for item in ${group_members[${1}]}; do
        [ "${item}" = "${2}" ] && return 0
    done
    return 1
}

select_install_type() {
    local arg="${1,,}"
    local member

    if [ "${arg}" = "all" ]; then
        selected_install_types=("${possible_install_types[@]}")
        return 0
    fi
    # groups first: a name shared by a group and a software always covers that software
    if is_group "${arg}"; then
        for member in ${group_members[${arg}]}; do
            is_install_type_selected "${member}" || selected_install_types+=("${member}")
        done
        return 0
    fi
    if is_install_type "${arg}"; then
        is_install_type_selected "${arg}" || selected_install_types+=("${arg}")
        return 0
    fi
    return 1
}

discover_software() {
    local declaration
    local disabled
    local group
    local groups
    local handler
    local name
    local order
    local -a entries=()
    local -A seen_orders=()

    while read -r declaration _ handler; do
        [ "${declaration}" = "declare" ] || continue
        disabled=0
        if [[ "${handler}" =~ ^software-disabled-([0-9]+)-([a-z0-9][a-z0-9_-]*)((@[a-z0-9][a-z0-9_-]*)*)$ ]]; then
            disabled=1
        elif [[ "${handler}" =~ ^software-([0-9]+)-([a-z0-9][a-z0-9_-]*)((@[a-z0-9][a-z0-9_-]*)*)$ ]]; then
            :
        else
            # catch typos like software-500-Foo or software-abc-bar instead of skipping silently
            [[ "${handler}" == software-* ]] && warning "Ignoring malformed software handler: ${handler}"
            continue
        fi

        order="$((10#${BASH_REMATCH[1]}))"
        name="${BASH_REMATCH[2]}"
        groups="${BASH_REMATCH[3]//@/ }"
        entries+=("${order}"$'\t'"${name}"$'\t'"${handler}"$'\t'"${disabled}"$'\t'"${groups}")
    done < <(declare -F)

    [ "${#entries[@]}" -gt 0 ] || fail "No software handlers found"

    while IFS=$'\t' read -r order name handler disabled groups; do
        if [ -n "${software_handlers[${name}]+registered}" ]; then
            fail "Duplicate software name: ${name}"
        fi
        if [ -n "${seen_orders[${order}]+registered}" ]; then
            fail "Duplicate software order: ${order}"
        fi
        seen_orders["${order}"]="${name}"
        software_handlers["${name}"]="${handler}"
        software_disabled["${name}"]="${disabled}"
        # every software belongs to a group, so selecting all groups (e.g. by setup.sh)
        # leaves nothing out
        [ "${disabled}" -eq 0 ] && [ -z "${groups}" ] && warning "Software ${name} is in no group"
        software_install_types+=("${name}")

        for group in ${groups}; do
            if [ -n "${group_members[${group}]+registered}" ]; then
                group_members["${group}"]+=" ${name}"
            else
                group_members["${group}"]="${name}"
            fi
        done
    done < <(printf '%s\n' "${entries[@]}" | sort -n -k1,1)

    if [ "${#group_members[@]}" -gt 0 ]; then
        mapfile -t possible_groups < <(printf '%s\n' "${!group_members[@]}" | sort)
    fi
    for group in "${possible_groups[@]}"; do
        [ "${group}" = "all" ] && fail "Reserved group name: all"
        # a group may share its name with a software, but only if that software is a
        # member of the group, so selecting the name is a superset and stays unambiguous
        if [ -n "${software_handlers[${group}]+registered}" ] && ! is_group_member "${group}" "${group}"; then
            fail "Group name conflicts with software name: ${group}"
        fi
    done

    mapfile -t possible_install_types < <(printf '%s\n' "${software_install_types[@]}" | sort)
}

# needs SOFTWARE [COMMAND|PATH]: a step that depends on another software runs it
# first when the command (default: the software name) or the path it provides is
# missing, e.g. glab for a release from GitLab. Each software runs once per run.
# Returns 3 in dry-run mode when the software is missing, as the step cannot be
# checked without it; callers use: needs ... || return $(( $? == 3 ? 0 : 1 ))
needs() {
    local software="${1}"
    local check="${2:-${1}}"
    local outer="${selected}"
    local status

    if [[ "${check}" == /* ]]; then
        [ -e "${check}" ] && return 0
    else
        command -v "${check}" >/dev/null 2>&1 && return 0
    fi
    if [ -n "${software_needed[${software}]+ran}" ]; then
        [ "${dry_run}" -eq 1 ] && return 3
        error "${check} is still missing after ${software}"
        return 1
    fi
    if [ -z "${software_handlers[${software}]+registered}" ]; then
        error "${outer} needs ${check}, but there is no software ${software}"
        return 1
    fi
    software_needed["${software}"]=1

    local message="${UPDATE_MESSAGE//%PKGNAME%/${software}}"
    echo "${APP_NAME}: ${outer} needs ${check}, ${message,} first" 1>&2
    selected="${software}"
    "${software_handlers[${software}]}"; status=$?
    selected="${outer}"
    if [ "${status}" -ne 0 ]; then
        error "Failed to update ${software}, which ${outer} needs"
        return 1
    fi
    if [ "${dry_run}" -eq 1 ]; then
        echo "${APP_NAME}: ${outer} is checked once ${software} is installed" 1>&2
        return 3
    fi
    hash -r
    if [[ "${check}" == /* ]]; then
        [ -e "${check}" ] && return 0
    else
        command -v "${check}" >/dev/null 2>&1 && return 0
    fi
    error "${check} is still missing after ${software}"
    return 1
}

# the members of a group that only works on some systems are skipped elsewhere,
# e.g. the gnome group without GNOME Shell
group_unavailable_reason() {
    case "${1}" in
        gnome)
            command -v gnome-shell >/dev/null 2>&1 || echo "GNOME Shell is not installed"
            ;;
    esac
}

run_selected_software() {
    local handler
    local item
    local group
    local reason
    local -A unavailable=()

    for group in gnome; do
        reason="$(group_unavailable_reason "${group}")"
        [ -n "${reason}" ] && unavailable["${group}"]="${reason}"
    done

    for item in "${software_install_types[@]}"; do
        is_install_type_selected "${item}" || continue
        if [ "${software_disabled[${item}]}" -eq 1 ]; then
            warning "${item} is disabled"
            continue
        fi
        if [ -n "${software_needed[${item}]+ran}" ]; then
            echo "${APP_NAME}: ${item} was already updated for another software" 1>&2
            continue
        fi
        reason=""
        for group in "${!unavailable[@]}"; do
            is_group_member "${group}" "${item}" && reason="${unavailable[${group}]}"
        done
        if [ -n "${reason}" ]; then
            echo "${APP_NAME}: Skipping ${item}: ${reason}" 1>&2
            continue
        fi

        echo 1>&2
        echo "${APP_NAME}: ${UPDATE_MESSAGE//%PKGNAME%/${item}}" 1>&2
        selected="${item}"
        export selected
        handler="${software_handlers[${item}]}"
        if ! "${handler}"; then
            error "Failed to update ${item}"
            update_failed=1
        fi
    done
}

apt_add_with_list_file() {
    require_cmd curl gpg apt-get || return 1
    local name="${1}"; shift
    local list_url="${1}"; shift
    local repo_key_url="${1}"; shift
    local repo_list_path="/etc/apt/sources.list.d/${name}.list"
    local repo_gpg_path="/etc/apt/keyrings/${name}-repo-key.gpg"

    local repo_key_ext
    repo_key_ext="$(echo "${repo_key_url}" | grep -oE "\.[a-z]{3}$")"
    [ -z "${repo_key_ext}" ] && repo_key_ext=".gpg"

    local file_args=()
    [ "${verbose}" -eq 1 ] && file_args+=("-v")

    [ "${verbose}" -eq 1 ] && echo "+ mktemp --suffix \".list\"" 1>&2
    local tmp_list_file
    local tmp_key_file=""
    tmp_list_file="$(mktemp --suffix ".list")"
    trap 'rm -f "${tmp_list_file}" "${tmp_key_file}"; trap - RETURN' RETURN
    [ "${verbose}" -eq 1 ] && echo "+ tmp_list_file=${tmp_list_file}" 1>&2


    [ "${verbose}" -eq 1 ] && echo "+ curl -fsSL ${list_url} > ${tmp_list_file}" 1>&2
    curl -fsSL "${list_url}" > "${tmp_list_file}" || return 1

    if [ "${dry_run}" -eq 0 ]; then
        [ "${verbose}" -eq 1 ] && echo "+ mktemp --suffix \".${repo_key_ext}\"" 1>&2
        tmp_key_file="$(mktemp --suffix "${repo_key_ext}")"
        [ "${verbose}" -eq 1 ] && echo "+ tmp_key_file=${tmp_key_file}" 1>&2

        [ "${verbose}" -eq 1 ] && echo "+ curl -fsSL ${repo_key_url} > ${tmp_key_file}" 1>&2
        curl -fsSL "${repo_key_url}" > "${tmp_key_file}" || return 1

        [ "${verbose}" -eq 1 ] && echo "+ gpg --with-colons --import-options show-only --import ${tmp_key_file} | awk -F: '\$1 == \"pub\" { print \$7; exit }" 1>&2
        expiry_timestamp="$(gpg --with-colons --import-options show-only --import "${tmp_key_file}" 2>/dev/null | awk -F: '$1 == "pub" { print $7; exit }')"
        [ -z "${expiry_timestamp}" ] && expiry_timestamp="0" && echo "WARNING: Failed to get expiry timestamp of ${repo_key_url}" 1>&2
        expiry_date="$([ "${expiry_timestamp}" -gt "0" ] && date --date=@"${expiry_timestamp}" +%Y-%m-%d || echo "No expiry date" )"
        now_timestamp="$(date +%s)"
        if (( expiry_timestamp > 0 )) && (( expiry_timestamp < now_timestamp )); then
            echo "ERROR: ${repo_key_url} has expired at ${expiry_date}" 1>&2
            return 1
        elif [ "${verbose}" -eq 1 ]; then
            echo "+ expiry_date=${expiry_date}" 1>&2
        fi

        # parse keypath from list file
        [ "${verbose}" -eq 1 ] && echo "+ grep -Eo -m 1 'signed-by=[^] ,]+' | ${tmp_list_file} | cut -d= -f2" 1>&2
        key_path="$(grep -Eo -m 1 'signed-by=[^] ,]+' "${tmp_list_file}" | cut -d= -f2)"
        [ "${verbose}" -eq 1 ] && echo "+ key_path='${key_path}'"
        [ -n "${key_path}" ] && repo_gpg_path="${key_path}"

        [ "${verbose}" -eq 1 ] && echo "+ mv ${file_args[*]} ${tmp_list_file} ${repo_list_path}" 1>&2
        ${SUDO} LC_ALL=C mv "${file_args[@]}" "${tmp_list_file}" "${repo_list_path}" 2>&1 | sed 's/^/+ /' 1>&2

        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} mkdir -p ${file_args[*]} $(dirname "${repo_gpg_path}")" 1>&2
        ${SUDO} LC_ALL=C mkdir -p "${file_args[@]}" "$(dirname "${repo_gpg_path}")" 2>&1 | sed 's/^/+ /' 1>&2

        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} gpg --dearmor --yes -o ${repo_gpg_path} < ${tmp_key_file}" 1>&2
        ${SUDO} LC_ALL=C gpg --dearmor --yes -o "${repo_gpg_path}" < "${tmp_key_file}" || return 1

        if [ "${verbose}" -eq 1 ]; then
            echo "+ gpg --no-options --show-keys --with-fingerprint ${repo_gpg_path}"
            LC_ALL=C ${SUDO_USER} gpg --no-options --show-keys --with-fingerprint "${repo_gpg_path}" 2>&1 | sed 's/^/+ /' 1>&2
        fi
    else
        echo "Changes from ${list_url}:"
        diff --color=always -u "${repo_list_path}" "${tmp_list_file}" 1>&2
    fi

    apt_upgrade "${name}"
}

apt_add_with_repo() {
    needs packages curl || return $(( $? == 3 ? 0 : 1 ))
    require_cmd curl gpg apt-get || return 1
    local name="${1}"; shift
    local repo_url="${1%/}"; shift

    local repo_suite="${1}"; shift
    [ -z "${repo_suite}" ] && repo_suite="/"

    local repo_components="${1}"; shift

    local repo_key_url="${1}"; shift
    [ -z "${repo_key_url}" ] && repo_key_url="${repo_url}/Release.key"

    local expected_repo_key_fingerprint="${1}"

    local repo_key_ext
    repo_key_ext="$(echo "${repo_key_url}" | grep -oE "\.[a-z]{3}$")"
    [ -z "${repo_key_ext}" ] && repo_key_ext=".gpg"

    local repo_list_path="/etc/apt/sources.list.d/${name}.list"
    local repo_gpg_path="/etc/apt/keyrings/${name}-repo-key.gpg"
    local repo_line="deb [signed-by=${repo_gpg_path}] ${repo_url}/ ${repo_suite}"
    [ -n "${repo_components}" ] && repo_line="${repo_line} ${repo_components}"

    if [ "${dry_run}" -eq 0 ]; then
        ${SUDO} mkdir -p /etc/apt/keyrings
        local tmp_key_file
        tmp_key_file="$(mktemp --suffix "${repo_key_ext}")"
        [ "${verbose}" -eq 1 ] && echo "+ curl -fsSL ${repo_key_url} > ${tmp_key_file}" 1>&2
        if ! curl -fsSL "${repo_key_url}" > "${tmp_key_file}"; then
            rm -f "${tmp_key_file}"
            return 1
        fi

        local repo_key_fingerprint
        repo_key_fingerprint="$(gpg --show-keys --with-colons "${tmp_key_file}" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')"
        if [ -z "${repo_key_fingerprint}" ]; then
            error "No valid OpenPGP key found at ${repo_key_url}"
            rm -f "${tmp_key_file}"
            return 1
        fi
        if [ -n "${expected_repo_key_fingerprint}" ] && [ "${repo_key_fingerprint}" != "${expected_repo_key_fingerprint}" ]; then
            error "Unexpected key fingerprint from ${repo_key_url}: ${repo_key_fingerprint}"
            rm -f "${tmp_key_file}"
            return 1
        fi

        [ "${verbose}" -eq 1 ] && echo "+ gpg --with-colons --import-options show-only --import ${tmp_key_file} | awk -F: '\$1 == \"pub\" { print \$7; exit }" 1>&2
        expiry_timestamp="$(gpg --with-colons --import-options show-only --import "${tmp_key_file}" 2>/dev/null | awk -F: '$1 == "pub" { print $7; exit }')"
        [ -z "${expiry_timestamp}" ] && expiry_timestamp="0"
        expiry_date="$([ "${expiry_timestamp}" -gt "0" ] && date --date=@"${expiry_timestamp}" +%Y-%m-%d || echo "No expiry date" )"
        now_timestamp="$(date +%s)"
        if (( expiry_timestamp > 0 )) && (( expiry_timestamp < now_timestamp )); then
            echo "ERROR: ${repo_key_url} has expired at ${expiry_date}" 1>&2
            return 1
        elif [ "${verbose}" -eq 1 ]; then
            echo "+ expiry_date=${expiry_date}" 1>&2
        fi
        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} gpg --dearmor --yes -o ${repo_gpg_path} < ${tmp_key_file}" 1>&2
        LC_ALL=C ${SUDO} gpg --dearmor --yes -o "${repo_gpg_path}" < "${tmp_key_file}" || return 1
        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} chmod 644 ${repo_gpg_path}" 1>&2
        LC_ALL=C ${SUDO} chmod 644 "${repo_gpg_path}" || return 1

        if [ "${verbose}" -eq 1 ]; then
            echo "+ gpg --no-options --show-keys --with-fingerprint ${repo_gpg_path}"
            LC_ALL=C ${SUDO_USER} gpg --no-options --show-keys --with-fingerprint "${repo_gpg_path}" 2>&1 | grep -v "^$" | sed 's/^/+ /' 1>&2
        fi

        rm_args=( "${tmp_key_file}" )
        [ "${verbose}" -eq 1 ] && rm_args+=( "-v" ) && echo "+ rm ${rm_args[*]}" 1>&2
        LC_ALL=C rm "${rm_args[@]}" 2>&1 | sed 's/^/+ /' 1>&2
        [ "${verbose}" -eq 1 ] && echo "+ echo ${repo_line} | ${SUDO} tee ${repo_list_path} > /dev/null" 1>&2
        echo "${repo_line}" | ${SUDO} tee "${repo_list_path}" > /dev/null
    else
        current_repo_line="$(cat "${repo_list_path}" 2>/dev/null)"
        if [ -z "${current_repo_line}" ]; then
            echo "Would write ${repo_line} to ${repo_list_path}" 1>&2
        elif [ "${current_repo_line}" != "${repo_line}" ]; then
            echo "Would update to ${repo_line} from ${current_repo_line}" 1>&2
        fi
    fi
    apt_upgrade "${name}"
}

apt_upgrade() {
    require_cmd apt-get || return 1
    # no packages: upgrade everything installed; otherwise install/upgrade just these
    local -a pkgs=("${@}")
    echo "${APP_NAME}: Updating sources..." 1>&2
    local apt_exit_code=-1
    if [ "${verbose}" -eq 1 ]; then
        LC_ALL=C ${SUDO} apt-get update
        apt_exit_code=$?
    else
        local apt_update_output
        apt_update_output="$(LC_ALL=C ${SUDO} apt-get update 2>&1)"
        apt_exit_code=$?
        [ ${apt_exit_code} -ne 0 ] && echo "${apt_update_output}" 1>&2
    fi
    [ ${apt_exit_code} -ne 0 ] && return 1

    if [ "${dry_run}" -eq 0 ]; then
        if [ "${#pkgs[@]}" -gt 0 ]; then
            LC_ALL=C ${SUDO} DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkgs[@]}" 1>&2
        else
            LC_ALL=C ${SUDO} DEBIAN_FRONTEND=noninteractive apt-get upgrade -y 1>&2 \
                && LC_ALL=C ${SUDO} DEBIAN_FRONTEND=noninteractive apt-get autoremove -y 1>&2
        fi
    else
        apt_list_output="$(LC_ALL=C ${SUDO} apt list "${pkgs[@]}" --upgradable 2>/dev/null)"
        apt_list_output="$(echo "${apt_list_output}" | awk -F'[][]' '
  /^Listing/ { next }
  /upgradable from:/ {
    pkg = $1
    sub(/\/.*/, "", pkg)       # remove /repo and everything after

    new = $1
    sub(/^[^ ]+ /, "", new)
    sub(/ .*/, "", new)

    old = $2
    sub(/^upgradable from: /, "", old)

    printf "%s\t%s\t%s\n", pkg, old, new
  }
')"
        if [ -n "${apt_list_output}" ]; then
            echo -e "NAME\tCURRENT\tUPDATE\n${apt_list_output}" | column -t -s $'\t'
        else
            echo "${pkgs[*]:-apt} is up to date" 1>&2
        fi
    fi
}

helm_plugin_update() {
    require_cmd helm || return 1
    local name="${1}"; shift
    local url="${1}"; shift

    if [ "${dry_run}" -eq 1 ]; then
        if ${SUDO_USER} helm plugin list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qFx "${name}"; then
            echo "Would update Helm plugin ${name}" 1>&2
        else
            echo "Would install Helm plugin ${name} from ${url}" 1>&2
        fi
        return 0
    fi

    if ${SUDO_USER} helm plugin list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qFx "${name}"; then
        verbose "${SUDO_USER} helm plugin update ${name}"
        ${SUDO_USER} helm plugin update "${name}"
    else
        verbose "${SUDO_USER} helm plugin install --verify=false ${url}"
        ${SUDO_USER} helm plugin install --verify=false "${url}"
    fi
}

go_install_update() {
    # go comes from the go step, the tools land in ~/go/bin of the user
    local go_cmd="${CURRENT_USER_HOME}/.local/go/bin/go"
    needs go "${go_cmd}" || return $(( $? == 3 ? 0 : 1 ))
    local go_env=("env" "GOPRIVATE=gitlab.mittwald.it")
    local updates=""
    local pkg
    local path
    local name
    local bin
    local mod
    local installed_version
    local version

    for pkg in "${@}"; do
        path="${pkg%@*}"
        # github.com/goreleaser/goreleaser/v2 installs as goreleaser
        name="$(basename "$(echo "${path}" | sed -E 's#/v[0-9]+$##')")"
        bin="${CURRENT_USER_HOME}/go/bin/${name}"
        installed_version="<none>"
        version="latest"
        if [ -x "${bin}" ]; then
            read -r mod installed_version < <(${SUDO_USER} "${go_cmd}" version -m "${bin}" 2>/dev/null | awk '$1 == "mod" { print $2, $3; exit }')
            if [ -n "${mod}" ]; then
                version="$(${SUDO_USER} "${go_env[@]}" "${go_cmd}" list -m -f '{{.Version}}' "${mod}@latest" 2>/dev/null)"
                [ -z "${version}" ] && version="latest"
            fi
            [ "${version}" = "${installed_version}" ] && continue
        fi
        updates+="${name}\t${installed_version:-<unknown>}\t${version}\n"
        [ "${dry_run}" -eq 1 ] && continue
        verbose "${SUDO_USER} ${go_env[*]} ${go_cmd} install ${path}@latest"
        ${SUDO_USER} "${go_env[@]}" "${go_cmd}" install "${path}@latest" || return 1
    done
    if [ -n "${updates}" ]; then
        echo -e "NAME\tCURRENT\tUPDATE\n${updates%\\n}" | column -t -s $'\t'
    else
        echo "${APP_NAME}: go tools are up to date" 1>&2
    fi
}

cargo_install_update() {
    local cargo_cmd="${CURRENT_USER_HOME}/.cargo/bin/cargo"
    needs rustup "${cargo_cmd}" || return $(( $? == 3 ? 0 : 1 ))
    local crate
    for crate in "${@}"; do
        if [ "${dry_run}" -eq 1 ]; then
            if ${SUDO_USER} "${cargo_cmd}" install --list | grep -q "^${crate} "; then
                echo "Would update ${crate} if outdated" 1>&2
            else
                echo "Would install ${crate}" 1>&2
            fi
            continue
        fi
        # cargo install skips a crate that is already up to date
        verbose "${SUDO_USER} ${cargo_cmd} install --locked ${crate}"
        ${SUDO_USER} "${cargo_cmd}" install --locked "${crate}" || return 1
    done
}

pip_update() {
    needs packages pip3 || return $(( $? == 3 ? 0 : 1 ))
    # the packages apt has no python3-* package for; they go into one folder that
    # is on sys.path after the apt packages, see lib/cli-helpers/pip-packages
    local name="${1}"; shift
    # rewritten by make install to $(LIBDIR)
    local pip_packages="/usr/local/lib/cli-helpers/pip-packages"
    local pip_args=()
    [ "${dry_run}" -eq 1 ] && pip_args+=("--dry-run")
    verbose "${SUDO} ${pip_packages} ${pip_args[*]} ${name} ${*}"
    ${SUDO} "${pip_packages}" "${pip_args[@]}" "${name}" "${@}"
}

gnome_extension_update() {
    needs packages jq || return $(( $? == 3 ? 0 : 1 ))
    require_cmd curl jq gnome-shell gnome-extensions gsettings || return 1
    local uuid="${1}"
    local ego_url="https://extensions.gnome.org"
    local ext_dir="${CURRENT_USER_HOME}/.local/share/gnome-shell/extensions/${uuid}"
    local shell_version
    local info
    local version
    local download_url
    local installed_version
    local tmp_zip

    shell_version="$(gnome-shell --version | grep -oE '[0-9]+' | head -n 1)"
    if ! info="$(curl -fsS "${ego_url}/extension-info/?uuid=${uuid}&shell_version=${shell_version}")"; then
        error "No version of ${uuid} for GNOME Shell ${shell_version} on ${ego_url}"
        return 1
    fi
    version="$(echo "${info}" | jq -r '.version')"
    download_url="$(echo "${info}" | jq -r '.download_url')"
    installed_version="$(jq -r '.version // empty' "${ext_dir}/metadata.json" 2>/dev/null)"
    [ -z "${installed_version}" ] && installed_version="<none>"

    if [ "${version}" != "${installed_version}" ]; then
        if [ "${dry_run}" -eq 1 ]; then
            echo -e "NAME\tCURRENT\tUPDATE\n${uuid}\t${installed_version}\t${version}" | column -t -s $'\t'
        else
            tmp_zip="$(mktemp --suffix .zip)" || return 1
            trap 'rm -f "${tmp_zip}"; trap - RETURN' RETURN
            verbose "curl -fsSL ${ego_url}${download_url} -o ${tmp_zip}"
            curl -fsSL "${ego_url}${download_url}" -o "${tmp_zip}" || return 1
            chmod 644 "${tmp_zip}"
            verbose "${SUDO_USER} gnome-extensions install --force ${tmp_zip}"
            ${SUDO_USER} gnome-extensions install --force "${tmp_zip}" || return 1
        fi
    else
        echo "${APP_NAME}: ${uuid} ${installed_version} is up to date" 1>&2
    fi

    gnome_extension_enable "${uuid}"
}

gnome_extension_enable() {
    require_cmd gsettings || return 1
    local uuid="${1}"
    # gsettings talks to the user's session
    local session_env=("env" "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CURRENT_USER_ID}/bus")
    local enabled

    # a new extension is only loaded by GNOME Shell after logging in again, so it
    # is enabled in the settings rather than with gnome-extensions enable
    enabled="$(${SUDO_USER} "${session_env[@]}" gsettings get org.gnome.shell enabled-extensions)"
    [[ "${enabled}" == *"'${uuid}'"* ]] && return 0
    if [ "${dry_run}" -eq 1 ]; then
        echo "Would enable ${uuid}" 1>&2
        return 0
    fi
    if [ "${enabled}" = "@as []" ] || [ "${enabled}" = "[]" ]; then
        enabled="['${uuid}']"
    else
        enabled="${enabled%]}, '${uuid}']"
    fi
    verbose "${SUDO_USER} gsettings set org.gnome.shell enabled-extensions ${enabled}"
    ${SUDO_USER} "${session_env[@]}" gsettings set org.gnome.shell enabled-extensions "${enabled}"
}

gnome_extension_from_git() {
    # an extension that is not on extensions.gnome.org, installed by the make
    # install of its repo into the user's extensions
    needs packages git || return $(( $? == 3 ? 0 : 1 ))
    needs packages make || return $(( $? == 3 ? 0 : 1 ))
    require_cmd git make || return 1
    local url="${1}"
    local uuid="${2}"
    local ext_dir="${CURRENT_USER_HOME}/.local/share/gnome-shell/extensions/${uuid}"
    # make install replaces the extension directory, so the commit is written after it
    local commit_file="${ext_dir}/.git-commit"
    local commit
    local installed_commit
    local tmp_dir

    commit="$(git ls-remote "${url}" HEAD | cut -f 1)"
    if [ -z "${commit}" ]; then
        error "Failed to get the latest commit of ${url}"
        return 1
    fi
    installed_commit="$(cat "${commit_file}" 2>/dev/null)"
    [ -z "${installed_commit}" ] && installed_commit="<unknown>"

    if [ "${commit}" = "${installed_commit}" ]; then
        echo "${APP_NAME}: ${uuid} ${installed_commit:0:7} is up to date" 1>&2
    elif [ "${dry_run}" -eq 1 ]; then
        echo -e "NAME\tCURRENT\tUPDATE\n${uuid}\t${installed_commit:0:9}\t${commit:0:7}" | column -t -s $'\t'
    else
        tmp_dir="$(${SUDO_USER} mktemp -d)" || return 1
        trap '${SUDO_USER} rm -rf "${tmp_dir}"; trap - RETURN' RETURN
        verbose "${SUDO_USER} git clone --depth 1 ${url} ${tmp_dir}"
        ${SUDO_USER} git clone --quiet --depth 1 "${url}" "${tmp_dir}" || return 1
        verbose "${SUDO_USER} make -s -C ${tmp_dir} install"
        ${SUDO_USER} make -s -C "${tmp_dir}" install || return 1
        commit="$(${SUDO_USER} git -C "${tmp_dir}" rev-parse HEAD)"
        echo "${commit}" | ${SUDO_USER} tee "${commit_file}" > /dev/null
    fi
    gnome_extension_enable "${uuid}"
}

# user_link TARGET LINK: makes LINK in the user's home a symlink to TARGET, but
# never replaces something that is not a symlink
user_link() {
    local target="${1}"
    local link="${2}"
    if [ -L "${link}" ] && [ "$(readlink "${link}")" = "${target}" ]; then
        return 0
    fi
    if [ -e "${link}" ] && [ ! -L "${link}" ]; then
        warning "${link} exists and is no symlink, not linking it to ${target}"
        return 0
    fi
    if [ "${dry_run}" -eq 1 ]; then
        echo "Would link ${link} -> ${target}" 1>&2
        return 0
    fi
    verbose "${SUDO_USER} ln -sfn ${target} ${link}"
    ${SUDO_USER} ln -sfn "${target}" "${link}"
}

# git_repo_update REPO DIR: clones the repo into DIR or pulls it, unless it has
# local changes; OWNER/NAME is a GitHub repo cloned with gh, HOST/OWNER/NAME a
# GitLab one cloned with glab, as both may be private
git_repo_update() {
    local repo="${1}"
    local dir="${2}"
    local behind

    if [ ! -d "${dir}/.git" ]; then
        case "${repo}" in
            */*/*) needs glab || return $(( $? == 3 ? 0 : 1 )) ;;
            *) needs gh || return $(( $? == 3 ? 0 : 1 )) ;;
        esac
        if [ "${dry_run}" -eq 1 ]; then
            echo "Would clone ${repo} into ${dir}" 1>&2
            return 0
        fi
        ${SUDO_USER} mkdir -p "$(dirname "${dir}")" || return 1
        case "${repo}" in
            */*/*)
                verbose "${SUDO_USER} glab repo clone https://${repo} ${dir}"
                ${SUDO_USER} glab repo clone "https://${repo}" "${dir}" -- --quiet
                ;;
            *)
                verbose "${SUDO_USER} gh repo clone ${repo} ${dir}"
                ${SUDO_USER} gh repo clone "${repo}" "${dir}" -- --quiet
                ;;
        esac
        return
    fi
    # untracked files, e.g. of an editor or agent, do not stop the pull
    if [ -n "$(${SUDO_USER} git -C "${dir}" status --porcelain --untracked-files=no)" ]; then
        echo "${APP_NAME}: ${dir} has local changes, not pulling" 1>&2
        return 0
    fi
    ${SUDO_USER} git -C "${dir}" fetch --quiet || return 1
    behind="$(${SUDO_USER} git -C "${dir}" rev-list --count HEAD..@{upstream} 2>/dev/null)"
    if [ -z "${behind}" ] || [ "${behind}" -eq 0 ]; then
        echo "${APP_NAME}: ${dir} is up to date" 1>&2
        return 0
    fi
    if [ "${dry_run}" -eq 1 ]; then
        echo "Would pull ${behind} commit(s) into ${dir}" 1>&2
        return 0
    fi
    verbose "${SUDO_USER} git -C ${dir} pull --ff-only"
    ${SUDO_USER} git -C "${dir}" pull --ff-only --quiet
}

# user_service_enable UNIT [FILE]: installs the systemd user unit FILE (if given,
# e.g. from $(LIBDIR)/systemd-user) and enables and starts UNIT for the user
user_service_enable() {
    local unit="${1}"
    local src="${2}"
    local unit_dir="${CURRENT_USER_HOME}/.config/systemd/user"
    # systemctl --user talks to the user's session
    local session_env=("env" "XDG_RUNTIME_DIR=/run/user/${CURRENT_USER_ID}" "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CURRENT_USER_ID}/bus")
    local changed=0

    if [ -n "${src}" ] && ! cmp -s "${src}" "${unit_dir}/${unit}"; then
        if [ "${dry_run}" -eq 1 ]; then
            echo "Would install ${unit_dir}/${unit}" 1>&2
        else
            verbose "${SUDO_USER} install -D -m 0644 ${src} ${unit_dir}/${unit}"
            ${SUDO_USER} install -D -m 0644 "${src}" "${unit_dir}/${unit}" || return 1
            ${SUDO_USER} "${session_env[@]}" systemctl --user daemon-reload || return 1
            changed=1
        fi
    fi
    if ${SUDO_USER} "${session_env[@]}" systemctl --user is-enabled --quiet "${unit}" 2>/dev/null; then
        if [ "${changed}" -eq 1 ]; then
            verbose "${SUDO_USER} systemctl --user try-restart ${unit}"
            ${SUDO_USER} "${session_env[@]}" systemctl --user try-restart "${unit}"
        fi
        return 0
    fi
    if [ "${dry_run}" -eq 1 ]; then
        echo "Would enable and start the user service ${unit}" 1>&2
        return 0
    fi
    verbose "${SUDO_USER} systemctl --user enable --now ${unit}"
    ${SUDO_USER} "${session_env[@]}" systemctl --user enable --now "${unit}"
}

# claude_plugins_update SETTINGS: adds the GitHub marketplaces and installs the
# plugins that the Claude Code settings file enables but are missing
claude_plugins_update() {
    local settings="${1}"
    local claude_cmd="${CURRENT_USER_HOME}/.local/bin/claude"
    local installed_file="${CURRENT_USER_HOME}/.claude/plugins/installed_plugins.json"
    local marketplaces
    local installed
    local name
    local repo
    local plugin

    needs claude "${claude_cmd}" || return $(( $? == 3 ? 0 : 1 ))
    needs packages jq || return $(( $? == 3 ? 0 : 1 ))
    marketplaces="$(${SUDO_USER} "${claude_cmd}" plugin marketplace list --json 2>/dev/null | jq -r '.[].name')"
    while IFS=$'\t' read -r name repo; do
        [ -z "${name}" ] && continue
        grep -qFx "${name}" <<< "${marketplaces}" && continue
        if [ "${dry_run}" -eq 1 ]; then
            echo "Would add the Claude Code marketplace ${name} (${repo})" 1>&2
            continue
        fi
        verbose "${SUDO_USER} ${claude_cmd} plugin marketplace add ${repo}"
        ${SUDO_USER} "${claude_cmd}" plugin marketplace add "${repo}" < /dev/null || return 1
    done < <(jq -r '.extraKnownMarketplaces // {} | to_entries[] | select(.value.source.source == "github") | [.key, .value.source.repo] | @tsv' "${settings}")

    installed="$(jq -r '.plugins // {} | keys[]' "${installed_file}" 2>/dev/null)"
    while read -r plugin; do
        [ -z "${plugin}" ] && continue
        grep -qFx "${plugin}" <<< "${installed}" && continue
        if [ "${dry_run}" -eq 1 ]; then
            echo "Would install the Claude Code plugin ${plugin}" 1>&2
            continue
        fi
        verbose "${SUDO_USER} ${claude_cmd} plugin install ${plugin}"
        ${SUDO_USER} "${claude_cmd}" plugin install "${plugin}" < /dev/null || return 1
    done < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' "${settings}")
}

# tool_ready COMMAND|PATH: after the install of a step, whether the rest of it (the
# config) can go on; in dry-run mode the tool may not be installed yet, then
# that is only checked once it is (returns 1), a real run fails (returns 2).
# Callers use: tool_ready ... || return $(( $? == 1 ? 0 : 1 ))
tool_ready() {
    local check="${1}"
    hash -r
    if [[ "${check}" == /* ]]; then
        [ -e "${check}" ] && return 0
    else
        command -v "${check}" >/dev/null 2>&1 && return 0
    fi
    if [ "${dry_run}" -eq 1 ]; then
        echo "${APP_NAME}: the config of ${selected} is checked once it is installed" 1>&2
        return 1
    fi
    error "${check} is missing after installing ${selected}"
    return 2
}

# helper_repo_update REPO [TARGET]: one of the own repos, cloned or pulled into
# ~/workspace/dgrieser and installed by its make TARGET, by default
# install-links (for the repos of commands, linked into /usr/local/bin)
helper_repo_update() {
    local repo="${1}"
    local target="${2:-install-links}"
    local dir="${CURRENT_USER_HOME}/workspace/dgrieser/${repo##*/}"
    needs packages make || return $(( $? == 3 ? 0 : 1 ))
    git_repo_update "${repo}" "${dir}" || return 1
    if [ "${dry_run}" -eq 1 ]; then
        echo "Would install ${dir} (make ${target})" 1>&2
        return 0
    fi
    verbose "${SUDO_USER} make -s -C ${dir} ${target}"
    ${SUDO_USER} make -s -C "${dir}" "${target}" > /dev/null
}

yazi_plugin_update() {
    needs yazi ya || return $(( $? == 3 ? 0 : 1 ))
    require_cmd ya || return 1
    local pkg_toml="${CURRENT_USER_HOME}/.config/yazi/package.toml"
    local missing=()
    local pkg

    for pkg in "${@}"; do
        if ! ${SUDO_USER} grep -qF "use = \"${pkg}\"" "${pkg_toml}" 2>/dev/null; then
            missing+=("${pkg}")
        fi
    done

    if [ "${dry_run}" -eq 1 ]; then
        [ "${#missing[@]}" -gt 0 ] && echo "Would install yazi plugins ${missing[*]}" 1>&2
        echo "Would upgrade installed yazi plugins" 1>&2
        return 0
    fi

    for pkg in "${missing[@]}"; do
        verbose "${SUDO_USER} ya pkg add ${pkg}"
        ${SUDO_USER} ya pkg add "${pkg}" || return 1
    done
    verbose "${SUDO_USER} ya pkg upgrade"
    ${SUDO_USER} ya pkg upgrade
}

config_update() {
    # the shipped config in $(LIBDIR)/NAME into the user's config directory
    local name="${1}"
    local dst_dir="${2}"
    # rewritten by make install to $(LIBDIR)
    local lib_dir="/usr/local/lib/cli-helpers"
    local merge_args=()
    [ "${dry_run}" -eq 1 ] && merge_args+=("--dry-run")
    # a missing config file is copied, an existing one only gets the shipped
    # settings, entries, functions and variables merged in
    verbose "${SUDO_USER} ${lib_dir}/config-merge ${merge_args[*]} ${lib_dir}/${name} ${dst_dir}"
    ${SUDO_USER} "${lib_dir}/config-merge" "${merge_args[@]}" "${lib_dir}/${name}" "${dst_dir}"
}

flatpak_list_updates() {
    local pkg="${1}"
    # by application id, which is what the handlers pass; plugins are runtimes, not apps
    local -a kind=("--app")
    [ -n "${pkg}" ] && kind=()
    all_updates="$(join -t $'\t' -j 1 <(flatpak list "${kind[@]}" --columns=application,version | sort) <(flatpak remote-ls --updates "${kind[@]}" --columns=application,version | sort))"
    if [ -n "${pkg}" ]; then
        updates="$(echo "${all_updates}" | grep -F -w "${pkg%%//*}")"
    else
        updates="${all_updates}"
    fi
    # now remove all rows without version changes
    updates="$(echo "${updates}" | awk -F $'\t' '{if ($2 != $3) print $0}')"
    if [ -n "${updates}" ]; then
        echo -e "NAME\tCURRENT\tUPDATE\n${updates}" | column -t -s $'\t'
    else
        echo "${pkg:-flatpak} is up to date" 1>&2
    fi
}

# installs flatpak itself (apt) and the flathub remote when missing; in a dry-run
# without flatpak it only says so and sets flatpak_missing, as there is nothing to query
flatpak_setup() {
    flatpak_missing=0
    if ! command -v flatpak >/dev/null 2>&1; then
        if [ "${dry_run}" -eq 1 ]; then
            # once per run, not for every app and plugin
            [ -z "${flatpak_missing_reported}" ] && echo "flatpak is not installed, would install it and add the flathub remote" 1>&2
            flatpak_missing_reported=1
            flatpak_missing=1
            return 0
        fi
        apt_upgrade flatpak || return 1
    fi
    if ! flatpak remotes --system --columns=name 2>/dev/null | grep -qFx "flathub"; then
        if [ "${dry_run}" -eq 1 ]; then
            echo "Would add flatpak remote flathub (${FLATHUB_REPO_URL})" 1>&2
        else
            verbose "${SUDO} flatpak remote-add --system --if-not-exists flathub ${FLATHUB_REPO_URL}"
            ${SUDO} flatpak remote-add --system --if-not-exists flathub "${FLATHUB_REPO_URL}" || return 1
        fi
    fi
}

# flatpak_update [REF [REMOTE | --from FLATPAKREF_URL]]: without an app, update all
# of them; an app that is not installed yet comes from REMOTE (default flathub), or
# from a .flatpakref, which also adds the remote it names (for apps outside flathub)
flatpak_update() {
    flatpak_setup || return 1
    [ "${flatpak_missing}" -eq 1 ] && return 0
    require_cmd flatpak || return 1
    local pkg="${1}"
    local remote="${2:-flathub}"
    local ref_url=""
    if [ "${2}" = "--from" ]; then
        ref_url="${3}"
        remote=""
    fi
    if [ "${dry_run}" -eq 0 ]; then
        if [ -n "${pkg}" ]; then
            if [ -n "${ref_url}" ]; then
                if ${SUDO_USER} flatpak list --app --columns=application 2>/dev/null | grep -qFx "${pkg}"; then
                    ${SUDO_USER} flatpak update -y "${pkg}"
                else
                    ${SUDO_USER} flatpak install -y --from "${ref_url}"
                fi
            else
                # --or-update: installs or updates, apps and runtimes (plugins) alike;
                # PKG may carry a branch, e.g. org.gimp.GIMP.Plugin.GMic//3
                ${SUDO_USER} flatpak install -y --or-update "${remote}" "${pkg}"
            fi
        else
            ${SUDO_USER} flatpak update -y
        fi
    else
        flatpak_list_updates "${pkg}"
    fi
}

curl_update() {
    local pkg="${1}"; shift   
    local url="${1}"; shift
    [ -z "${url}" ] && echo "ERROR: curl_update requires a URL" 1>&2 && return 1
    [ -z "${pkg}" ] && echo "ERROR: curl_update requires a package name" 1>&2 && return 1
    needs packages curl || return $(( $? == 3 ? 0 : 1 ))
    require_cmd curl || return 1
    curl_args=( "--fail" "--location" )
    [ "${verbose}" -eq 0 ] && curl_args+=( "--silent" "--show-error" )
    curl_args+=( "${url}" )
    if [ "${dry_run}" -eq 0 ]; then
        [ "${verbose}" -eq 1 ] && echo "+ curl ${curl_args[*]} | ${SUDO_USER} bash" 1>&2
        curl "${curl_args[@]}" | ${SUDO_USER} bash
    else
        echo "+ curl ${curl_args[*]} | ${SUDO_USER} bash"
    fi
}

nvm_load() {
    export NVM_DIR="${CURRENT_USER_HOME}/.nvm"
    [ -s "${NVM_DIR}/nvm.sh" ] || return 1
    # shellcheck disable=SC1091
    \. "${NVM_DIR}/nvm.sh" --no-use || return 1
    nvm ls default >/dev/null 2>&1 || return 0
    # puts the default node and its npm on PATH for this process
    if ! nvm use --silent default >/dev/null 2>&1; then
        warning "nvm cannot activate node, a prefix or globalconfig in ${CURRENT_USER_HOME}/.npmrc is incompatible with nvm (remove it or run: nvm use --delete-prefix default)"
    fi
    return 0
}

nvm_run() {
    # run as the user, so nothing in ~/.nvm ends up owned by root
    verbose "${SUDO_USER} bash -c '. ${NVM_DIR}/nvm.sh && nvm ${*}'"
    ${SUDO_USER} bash -c '\. "${1}/nvm.sh" --no-use && shift && nvm "${@}"' bash "${NVM_DIR}" "${@}"
}

install_nodejs() {
    needs packages curl || return $(( $? == 3 ? 0 : 1 ))
    require_cmd curl || return 1
    local nvm_repo_url="https://github.com/nvm-sh/nvm"
    local node_version="lts/*"
    local latest_url
    local nvm_version
    local installed_nvm_version
    local node_latest
    local node_installed

    latest_url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "${nvm_repo_url}/releases/latest")" || return 1
    nvm_version="${latest_url##*/}"
    if [[ ! "${nvm_version}" =~ ^v[0-9.]+$ ]]; then
        error "Failed to get latest version of nvm from ${latest_url}"
        return 1
    fi

    installed_nvm_version="<none>"
    nvm_load && installed_nvm_version="v$(nvm --version)"

    if [ "${dry_run}" -eq 1 ]; then
        node_installed="<none>"
        node_latest="<unknown>"
        if [ "${installed_nvm_version}" != "<none>" ]; then
            node_installed="$(nvm version "${node_version}")"
            node_latest="$(nvm version-remote "${node_version}")"
        fi
        local updates=""
        [ "${installed_nvm_version}" != "${nvm_version}" ] && updates+="nvm\t${installed_nvm_version}\t${nvm_version}\n"
        [ "${node_installed}" != "${node_latest}" ] && updates+="node\t${node_installed}\t${node_latest}\n"
        if [ -n "${updates}" ]; then
            echo -e "NAME\tCURRENT\tUPDATE\n${updates%\\n}" | column -t -s $'\t'
        else
            echo "nodejs is up to date" 1>&2
        fi
        return 0
    fi

    # the install script also upgrades an existing nvm in place
    if [ "${installed_nvm_version}" != "${nvm_version}" ]; then
        echo "${APP_NAME}: Installing nvm ${installed_nvm_version} -> ${nvm_version}..." 1>&2
        verbose "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/${nvm_version}/install.sh | ${SUDO_USER} bash"
        curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${nvm_version}/install.sh" | ${SUDO_USER} bash || return 1
        nvm_load || { error "nvm not found in ${NVM_DIR} after install"; return 1; }
    fi

    local -a nvm_install_args=("install" "${node_version}")
    local node_current
    local node_target
    node_current="$(nvm current 2>/dev/null)"
    node_target="$(nvm version-remote "${node_version}" 2>/dev/null)"
    # carry global npm packages over to a new node version; nvm refuses to reinstall
    # them from the version it is installing ("Can not reinstall packages from the
    # current version of node"), which is the case whenever node is already up to date
    if [ -n "${node_current}" ] && [ "${node_current}" != "none" ] && [ "${node_current}" != "system" ] \
        && [ "${node_current}" != "${node_target}" ]; then
        nvm_install_args+=("--reinstall-packages-from=current")
    fi
    nvm_run "${nvm_install_args[@]}" || return 1
    nvm_run alias default "${node_version}" || return 1
    # reload so the following handlers see the new node and npm
    nvm_load || return 1
    require_cmd node npm || return 1
    echo "${APP_NAME}: node $(node -v), npm $(npm -v)" 1>&2
}

npm_update() {
    needs nodejs npm || return $(( $? == 3 ? 0 : 1 ))
    require_cmd npm npm-pkg-dir || return 1
    local pkg="${1}"; shift
    local force=0
    local npm_args=("install" "-g" "${pkg}")
    while [ $# -gt 0 ]; do
        case "${1}" in
            -f|--force)
                force=1
                ;;
            *)
                npm_args+=("${1}")
                ;;
        esac
        shift
    done
    
    [ -z "${pkg}" ] && echo "ERROR: npm_update requires a package name" 1>&2 && return 1

    # a package that is not installed yet has no directory (npm-pkg-dir exits 2), any
    # other failure is real; without a target there is nothing to back up either, so a
    # backup_dir of ".old" never points at the current directory
    local target_dir=""
    local backup_dir=""
    local rc=0
    target_dir="$(npm-pkg-dir "${pkg}" 2>/dev/null)" || rc=$?
    if [ "${rc}" -ne 0 ] && [ "${rc}" -ne 2 ]; then
        error "Failed to resolve the global npm directory of ${pkg}"
        return 1
    fi
    [ -n "${target_dir}" ] && backup_dir="${target_dir}.old"
    local npm_json
    local npm_table

    local sudo=""
    if [ -n "${SUDO_USER}" ] && [[ "$(npm root -g)" == "${CURRENT_USER_HOME}/"* ]]; then
        # nvm keeps global packages in the user's home, never install those as root
        sudo="sudo -n -u ${CURRENT_USER_NAME} env PATH=${PATH}"
    elif [ -d "${target_dir}" ] && [ ! -w "${target_dir}" ]; then
        sudo="${SUDO}"
    fi

    if [ "${dry_run}" -eq 0 ]; then
        if [ "${force}" -eq 1 ]; then
            if [ -d "${backup_dir}" ]; then
                [ "${verbose}" -eq 1 ] && echo "+ ${sudo} rm -rf ${backup_dir}" 1>&2
                ${sudo} rm -rf "${backup_dir}"
            fi
            if [ -d "${target_dir}" ]; then
                [ "${verbose}" -eq 1 ] && echo "+ ${sudo} mv ${target_dir} ${backup_dir}" 1>&2
                ${sudo} mv "${target_dir}" "${backup_dir}"
            fi
        fi
        [ "${verbose}" -eq 1 ] && npm_args+=("--verbose")
        [ "${verbose}" -eq 1 ] && echo "+ ${sudo} npm ${npm_args[*]}" 1>&2
        ${sudo} npm "${npm_args[@]}"
    else
        require_cmd jq || return 1
        # npm outdated lists only installed packages, so a missing one looked up to date
        if [ -z "${target_dir}" ] || [ ! -d "${target_dir}" ]; then
            local latest_version
            latest_version="$(npm view "${pkg}" version 2>/dev/null)"
            echo -e "NAME\tCURRENT\tUPDATE\n${pkg}\t<none>\t${latest_version:-<unknown>}" | column -t -s $'\t'
        elif ! npm_json="$(NODE_PATH="/usr/lib/node_modules" npm outdated -g "${pkg}" --json)"; then
            npm_table="$(echo "${npm_json}" | \
                         jq -r 'to_entries[] | [.key, (.value.current // "<unknown>"), .value.wanted] | @tsv')"
            echo -e "NAME\tCURRENT\tUPDATE\n${npm_table}" | column -t -s $'\t'

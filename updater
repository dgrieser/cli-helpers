selected_install_types=()
dry_run=0
verbose=0
update_failed=0

LOGFILE_PATH="/var/log/${APP_NAME}.log"

discover_software

while [ $# -gt 0 ]; do
    case "${1}" in
        --bash-completion)
            echo "-h --help -d --dry-run -l --list -t --types --verbose all ${possible_groups[*]} ${possible_install_types[*]}"
            exit 0
            ;;
        -h|--help)
            usage
            ;;
        -l|--list)
            for group in "${possible_groups[@]}"; do
                printf '%s\t%s\n' "${group}" "${group_members[${group}]}"
            done
            exit 0
            ;;
        -d|--dry-run)
            dry_run=1
            ;;
        -t|--types)
            shift
            [ -z "${1}" ] && usage
            selected_install_types=()
            for t in ${1//,/ }; do
                if ! select_install_type "${t}"; then
                    error "Unknown type: ${t}"
                    usage
                fi
            done
            ;;
        --verbose)
            verbose=1
            ;;
        *)
            if ! select_install_type "${1}"; then
                error "Unknown argument: ${1}"
                usage
            fi
            ;;
    esac
    shift
done

loggedin_id_name="$(loggedin --id-name)" || fail "Failed to run loggedin --id-name"
CURRENT_USER_ID="$(echo "${loggedin_id_name}" | cut -d: -f1)"
CURRENT_USER_NAME="$(echo "${loggedin_id_name}" | cut -d: -f2)"
unset loggedin_id_name
CURRENT_USER_HOME="$(getent passwd "${CURRENT_USER_NAME}" | cut -d: -f6)"

if [ "${#selected_install_types[@]}" -eq 0 ]; then
    selected_install_types=("${possible_install_types[@]}")
fi

SUDO=""
if [ "${EUID}" -ne 0 ]; then
    SUDO="sudo"
fi

[ -z "${CURRENT_USER_NAME}" ] && fail "Failed to determine CURRENT_USER_NAME"
[ -z "${CURRENT_USER_ID}" ] && fail "Failed to determine CURRENT_USER_ID"
[ -z "${CURRENT_USER_HOME}" ] && fail "Failed to determine CURRENT_USER_HOME"

SUDO_USER=""
if [ "${EUID}" -ne "${CURRENT_USER_ID}" ]; then
    SUDO_USER="sudo -n -i -u ${CURRENT_USER_NAME}"
fi

if [ "${dry_run}" -eq 0 ]; then
    echo "Running ${APP_NAME} (see ${LOGFILE_PATH})..." | logger -t "${APP_NAME}"
    if ! ${SUDO_USER} test -w "${LOGFILE_PATH}"; then
        ${SUDO} touch "${LOGFILE_PATH}"
        ${SUDO} chown "${CURRENT_USER_NAME}":"${CURRENT_USER_NAME}" "${LOGFILE_PATH}"
    fi
    if is_interactive; then
        exec 1> >(${SUDO_USER} tee -a "${LOGFILE_PATH}")
        exec 2> >(${SUDO_USER} tee -a "${LOGFILE_PATH}" 1>&2)
        echo "Running ${APP_NAME} in interactive mode..." 1>&2
    else
        exec 1> >(${SUDO_USER} tee -a "${LOGFILE_PATH}" &>/dev/null)
        exec 2>&1
    fi
else
    UPDATE_MESSAGE="Checking %PKGNAME% upgrade"
    echo "Running ${APP_NAME} in dry-run mode..." 1>&2
fi

# node and npm may only be available through nvm
nvm_load

run_selected_software

if [ "${update_failed}" -ne 0 ]; then
    fail "One or more updates failed"
fi

echo "${APP_NAME}: Done" 1>&2

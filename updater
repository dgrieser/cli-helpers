# chrome_first_start: Chrome started once for the user and waited for until it
# is closed again, so it creates its profile (chrome-profile only changes an
# existing one); only with a terminal to say so and a graphical session to
# show it in, otherwise the user is told to do it
chrome_first_start() {
    local session_env=("env" "XDG_RUNTIME_DIR=/run/user/${CURRENT_USER_ID}" "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${CURRENT_USER_ID}/bus")
    [ -n "${DISPLAY}" ] && session_env+=("DISPLAY=${DISPLAY}")
    [ -n "${WAYLAND_DISPLAY}" ] && session_env+=("WAYLAND_DISPLAY=${WAYLAND_DISPLAY}")
    if [ ! -t 0 ] || { [ -z "${DISPLAY}" ] && [ -z "${WAYLAND_DISPLAY}" ]; }; then
        echo "${APP_NAME}: Chrome has no profile yet: start it once, close it and run: ${APP_NAME} chrome" 1>&2
        return 1
    fi
    echo "${APP_NAME}: Starting Chrome once, so it creates its profile: set it up and close it to continue..." 1>&2
    verbose "${SUDO_USER} ${session_env[*]} google-chrome"
    ${SUDO_USER} "${session_env[@]}" google-chrome > /dev/null 2>&1
    # the launcher returns with the browser, which may still be writing its profile
    while pgrep -u "${CURRENT_USER_ID}" -x chrome > /dev/null 2>&1; do
        sleep 1
    done
}


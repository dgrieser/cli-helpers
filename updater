# slack_repo_remove: the packagecloud repo of Slack, both the list updater wrote
# before and the one the cron job of the package writes, and keep the cron job
# from adding it again
slack_repo_remove() {
    local -a files=()
    local file
    for file in /etc/apt/sources.list.d/slack-desktop.list /etc/apt/keyrings/slack-desktop-repo-key.gpg \
        /etc/apt/sources.list.d/slack.list; do
        [ -e "${file}" ] && files+=("${file}")
    done
    local defaults_file="/etc/default/slack"
    local defaults=$'repo_add_once="false"\nrepo_reenable_on_distupgrade="false"'
    local defaults_current=""
    [ -r "${defaults_file}" ] && defaults_current="$(cat "${defaults_file}")"
    if [ "${dry_run}" -eq 1 ]; then
        [ "${#files[@]}" -gt 0 ] && echo "Would remove ${files[*]}" 1>&2
        [ "${defaults_current}" != "${defaults}" ] && echo "Would write ${defaults_file} to keep Slack from adding its repo" 1>&2
        return 0
    fi
    if [ "${#files[@]}" -gt 0 ]; then
        echo "${APP_NAME}: removing the Slack apt repo, its key fails with apt 3" 1>&2

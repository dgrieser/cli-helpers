    stable="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" || return 1
    if [[ ! "${stable}" =~ ^(v[0-9]+\.[0-9]+)\.[0-9]+$ ]]; then
        error "Unexpected kubernetes stable version: ${stable}"
        return 1

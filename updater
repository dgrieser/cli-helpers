    local zoom_package_name="zoom"
    local zoom_deb_file_name="${zoom_package_name}_${PLATFORM}.deb"
    local zoom_deb_file_path="/tmp/${zoom_deb_file_name}"
    local zoom_base_url="https://zoom.us"
    local zoom_rest_url="${zoom_base_url}/rest/download?os=linux"
    local zoom_client_url="${zoom_base_url}/client"
    local zoom_rest_response
    local version
    local installed_version

    zoom_rest_response="$(curl -sS "${zoom_rest_url}")" || return 1
    version="$(echo "${zoom_rest_response}" | jq -r '.result.downloadVO.zoom.version')"
    if [ -z "${version}" ] || [[ ! "${version}" =~ ^[0-9\.]+$ ]]; then
        error "Failed to get latest version of Zoom"
        echo "${zoom_rest_url} returned:" 1>&2
        echo "${zoom_rest_response}" 1>&2
        return 1
    fi

    installed_version="$(dpkg -s "${zoom_package_name}" 2>/dev/null | grep -m 1 '^Version:' | awk '{print $2}')"
    [ -z "${installed_version}" ] && installed_version="<unknown>"
    if [ "${version}" = "${installed_version}" ]; then
        echo "${APP_NAME}: Zoom ${installed_version} is up to date" 1>&2
    elif [ "${dry_run}" -eq 1 ]; then
        echo "${APP_NAME}: Update available for Zoom ${installed_version} -> ${version}" 1>&2
        echo -e "NAME\tCURRENT\tUPDATE\nZoom\t${installed_version}\t${version}" | column -t -s $'\t'
    else
        echo "${APP_NAME}: Update available for Zoom ${installed_version} -> ${version}" 1>&2
        trap 'rm -f "${zoom_deb_file_path}"; trap - RETURN' RETURN
        if ! curl -L "${zoom_client_url}/${version}/${zoom_deb_file_name}" -o "${zoom_deb_file_path}"; then
            error "Failed to download latest version of Zoom from ${zoom_client_url}"
            return 1
        fi
        apt_get_noninteractive install "${zoom_deb_file_path}" || return 1
    fi

            ${SUDO} rm -f /etc/apt/sources.list.d/kubernetes.list /etc/apt/keyrings/kubernetes-apt-keyring.gpg || return 1
        fi
    fi
    apt_add_with_repo "kubectl" "https://pkgs.k8s.io/core:/stable:/${minor}/deb/"
}


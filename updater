#!/bin/bash

APP_NAME="$(basename "${0}")"
PLATFORM="$(dpkg --print-architecture)"
UPDATE_MESSAGE="Running %PKGNAME% upgrade"
# shellcheck disable=SC1090
[ -f /etc/os-release ] && source <(sed -E 's/^([A-Z0-9_]+)=/OS_RELEASE_\1=/' /etc/os-release)

possible_install_types=()
software_install_types=()
declare -A software_handlers=()
declare -A software_disabled=()
selected=""

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

verbose() {
    [ "${verbose}" -eq 1 ] && echo "+ ${1}" 1>&2
}

require_cmd() {
    local cmd
    local missing=()
    for cmd in "${@}"; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done
    [ "${#missing[@]}" -eq 0 ] && return 0
    error "${selected:-${APP_NAME}} requires missing command(s): ${missing[*]}"
    return 1
}

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] SOFTWARE ...

Run ${APP_NAME} to update software.

SOFTWARE         Software to update, all if omitted.
                 Can be one of: $(echo "${possible_install_types[@]}" | tr ' ' ',')

Options:
  -h, --help          display this help and exit
  -d, --dry-run       dry-run mode
  -t, --types TYPES   comma separated list of install types (deprecated)
  --verbose           verbose mode
  --bash-completion   print shell completion candidates and exit
EOF
    exit 1
}

is_interactive() {
    if [ -t 0 ] && [ -t 1 ]; then
        return 0
    fi
    return 1
}

is_install_type() {
    local item
    for item in "${possible_install_types[@]}"; do
        [ "${item}" = "${1}" ] && return 0
    done
    return 1
}

is_install_type_selected() {
    local item
    for item in "${selected_install_types[@]}"; do
        [ "${item}" = "${1}" ] && return 0
    done
    return 1
}

discover_software() {
    local declaration
    local disabled
    local handler
    local name
    local order
    local -a entries=()
    local -A seen_orders=()

    while read -r declaration _ handler; do
        [ "${declaration}" = "declare" ] || continue
        disabled=0
        if [[ "${handler}" =~ ^software-disabled-([0-9]+)-([a-z0-9][a-z0-9_-]*)$ ]]; then
            disabled=1
        elif [[ "${handler}" =~ ^software-([0-9]+)-([a-z0-9][a-z0-9_-]*)$ ]]; then
            :
        else
            # catch typos like software-500-Foo or software-abc-bar instead of skipping silently
            [[ "${handler}" == software-* ]] && warning "Ignoring malformed software handler: ${handler}"
            continue
        fi

        order="$((10#${BASH_REMATCH[1]}))"
        name="${BASH_REMATCH[2]}"
        entries+=("${order}"$'\t'"${name}"$'\t'"${handler}"$'\t'"${disabled}")
    done < <(declare -F)

    [ "${#entries[@]}" -gt 0 ] || fail "No software handlers found"

    while IFS=$'\t' read -r order name handler disabled; do
        if [ -n "${software_handlers[${name}]+registered}" ]; then
            fail "Duplicate software name: ${name}"
        fi
        if [ -n "${seen_orders[${order}]+registered}" ]; then
            fail "Duplicate software order: ${order}"
        fi
        seen_orders["${order}"]="${name}"
        software_handlers["${name}"]="${handler}"
        software_disabled["${name}"]="${disabled}"
        software_install_types+=("${name}")
    done < <(printf '%s\n' "${entries[@]}" | sort -n -k1,1)

    mapfile -t possible_install_types < <(printf '%s\n' "${software_install_types[@]}" | sort)
}

run_selected_software() {
    local handler
    local item

    for item in "${software_install_types[@]}"; do
        is_install_type_selected "${item}" || continue
        if [ "${software_disabled[${item}]}" -eq 1 ]; then
            warning "${item} is disabled"
            continue
        fi

        echo 1>&2
        echo "${APP_NAME}: ${UPDATE_MESSAGE//%PKGNAME%/${item}}" 1>&2
        selected="${item}"
        export selected
        handler="${software_handlers[${item}]}"
        if ! "${handler}"; then
            error "Failed to update ${item}"
            update_failed=1
        fi
    done
}

apt_add_with_list_file() {
    require_cmd curl gpg apt-get || return 1
    local name="${1}"; shift
    local list_url="${1}"; shift
    local repo_key_url="${1}"; shift
    local repo_list_path="/etc/apt/sources.list.d/${name}.list"
    local repo_gpg_path="/etc/apt/keyrings/${name}-repo-key.gpg"

    local repo_key_ext
    repo_key_ext="$(echo "${repo_key_url}" | grep -oE "\.[a-z]{3}$")"
    [ -z "${repo_key_ext}" ] && repo_key_ext=".gpg"

    local file_args=()
    [ "${verbose}" -eq 1 ] && file_args+=("-v")

    [ "${verbose}" -eq 1 ] && echo "+ mktemp --suffix \".list\"" 1>&2
    local tmp_list_file
    local tmp_key_file=""
    tmp_list_file="$(mktemp --suffix ".list")"
    trap 'rm -f "${tmp_list_file}" "${tmp_key_file}"; trap - RETURN' RETURN
    [ "${verbose}" -eq 1 ] && echo "+ tmp_list_file=${tmp_list_file}" 1>&2


    [ "${verbose}" -eq 1 ] && echo "+ curl -fsSL ${list_url} > ${tmp_list_file}" 1>&2
    curl -fsSL "${list_url}" > "${tmp_list_file}" || return 1

    if [ "${dry_run}" -eq 0 ]; then
        [ "${verbose}" -eq 1 ] && echo "+ mktemp --suffix \".${repo_key_ext}\"" 1>&2
        tmp_key_file="$(mktemp --suffix "${repo_key_ext}")"
        [ "${verbose}" -eq 1 ] && echo "+ tmp_key_file=${tmp_key_file}" 1>&2

        [ "${verbose}" -eq 1 ] && echo "+ curl -fsSL ${repo_key_url} > ${tmp_key_file}" 1>&2
        curl -fsSL "${repo_key_url}" > "${tmp_key_file}" || return 1

        [ "${verbose}" -eq 1 ] && echo "+ gpg --with-colons --import-options show-only --import ${tmp_key_file} | awk -F: '\$1 == \"pub\" { print \$7; exit }" 1>&2
        expiry_timestamp="$(gpg --with-colons --import-options show-only --import "${tmp_key_file}" 2>/dev/null | awk -F: '$1 == "pub" { print $7; exit }')"
        [ -z "${expiry_timestamp}" ] && expiry_timestamp="0" && echo "WARNING: Failed to get expiry timestamp of ${repo_key_url}" 1>&2
        expiry_date="$([ "${expiry_timestamp}" -gt "0" ] && date --date=@"${expiry_timestamp}" +%Y-%m-%d || echo "No expiry date" )"
        now_timestamp="$(date +%s)"
        if (( expiry_timestamp > 0 )) && (( expiry_timestamp < now_timestamp )); then
            echo "ERROR: ${repo_key_url} has expired at ${expiry_date}" 1>&2
            return 1
        elif [ "${verbose}" -eq 1 ]; then
            echo "+ expiry_date=${expiry_date}" 1>&2
        fi

        # parse keypath from list file
        [ "${verbose}" -eq 1 ] && echo "+ grep -Eo -m 1 'signed-by=[^] ,]+' | ${tmp_list_file} | cut -d= -f2" 1>&2
        key_path="$(grep -Eo -m 1 'signed-by=[^] ,]+' "${tmp_list_file}" | cut -d= -f2)"
        [ "${verbose}" -eq 1 ] && echo "+ key_path='${key_path}'"
        [ -n "${key_path}" ] && repo_gpg_path="${key_path}"

        [ "${verbose}" -eq 1 ] && echo "+ mv ${file_args[*]} ${tmp_list_file} ${repo_list_path}" 1>&2
        ${SUDO} LC_ALL=C mv "${file_args[@]}" "${tmp_list_file}" "${repo_list_path}" 2>&1 | sed 's/^/+ /' 1>&2

        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} mkdir -p ${file_args[*]} $(dirname "${repo_gpg_path}")" 1>&2
        ${SUDO} LC_ALL=C mkdir -p "${file_args[@]}" "$(dirname "${repo_gpg_path}")" 2>&1 | sed 's/^/+ /' 1>&2

        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} gpg --dearmor --yes -o ${repo_gpg_path} < ${tmp_key_file}" 1>&2
        ${SUDO} LC_ALL=C gpg --dearmor --yes -o "${repo_gpg_path}" < "${tmp_key_file}" || return 1

        if [ "${verbose}" -eq 1 ]; then
            echo "+ gpg --no-options --show-keys --with-fingerprint ${repo_gpg_path}"
            LC_ALL=C ${SUDO_USER} gpg --no-options --show-keys --with-fingerprint "${repo_gpg_path}" 2>&1 | sed 's/^/+ /' 1>&2
        fi
    else
        echo "Changes from ${list_url}:"
        diff --color=always -u "${repo_list_path}" "${tmp_list_file}" 1>&2
    fi

    apt_upgrade "${name}"
}

apt_add_with_repo() {
    require_cmd curl gpg apt-get || return 1
    local name="${1}"; shift
    local repo_url="${1%/}"; shift

    local repo_suite="${1}"; shift
    [ -z "${repo_suite}" ] && repo_suite="/"

    local repo_components="${1}"; shift

    local repo_key_url="${1}"; shift
    [ -z "${repo_key_url}" ] && repo_key_url="${repo_url}/Release.key"

    local expected_repo_key_fingerprint="${1}"

    local repo_key_ext
    repo_key_ext="$(echo "${repo_key_url}" | grep -oE "\.[a-z]{3}$")"
    [ -z "${repo_key_ext}" ] && repo_key_ext=".gpg"

    local repo_list_path="/etc/apt/sources.list.d/${name}.list"
    local repo_gpg_path="/etc/apt/keyrings/${name}-repo-key.gpg"
    local repo_line="deb [signed-by=${repo_gpg_path}] ${repo_url}/ ${repo_suite}"
    [ -n "${repo_components}" ] && repo_line="${repo_line} ${repo_components}"

    if [ "${dry_run}" -eq 0 ]; then
        ${SUDO} mkdir -p /etc/apt/keyrings
        local tmp_key_file
        tmp_key_file="$(mktemp --suffix "${repo_key_ext}")"
        [ "${verbose}" -eq 1 ] && echo "+ curl -fsSL ${repo_key_url} > ${tmp_key_file}" 1>&2
        if ! curl -fsSL "${repo_key_url}" > "${tmp_key_file}"; then
            rm -f "${tmp_key_file}"
            return 1
        fi

        local repo_key_fingerprint
        repo_key_fingerprint="$(gpg --show-keys --with-colons "${tmp_key_file}" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')"
        if [ -z "${repo_key_fingerprint}" ]; then
            error "No valid OpenPGP key found at ${repo_key_url}"
            rm -f "${tmp_key_file}"
            return 1
        fi
        if [ -n "${expected_repo_key_fingerprint}" ] && [ "${repo_key_fingerprint}" != "${expected_repo_key_fingerprint}" ]; then
            error "Unexpected key fingerprint from ${repo_key_url}: ${repo_key_fingerprint}"
            rm -f "${tmp_key_file}"
            return 1
        fi

        [ "${verbose}" -eq 1 ] && echo "+ gpg --with-colons --import-options show-only --import ${tmp_key_file} | awk -F: '\$1 == \"pub\" { print \$7; exit }" 1>&2
        expiry_timestamp="$(gpg --with-colons --import-options show-only --import "${tmp_key_file}" 2>/dev/null | awk -F: '$1 == "pub" { print $7; exit }')"
        [ -z "${expiry_timestamp}" ] && expiry_timestamp="0"
        expiry_date="$([ "${expiry_timestamp}" -gt "0" ] && date --date=@"${expiry_timestamp}" +%Y-%m-%d || echo "No expiry date" )"
        now_timestamp="$(date +%s)"
        if (( expiry_timestamp > 0 )) && (( expiry_timestamp < now_timestamp )); then
            echo "ERROR: ${repo_key_url} has expired at ${expiry_date}" 1>&2
            return 1
        elif [ "${verbose}" -eq 1 ]; then
            echo "+ expiry_date=${expiry_date}" 1>&2
        fi
        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} gpg --dearmor --yes -o ${repo_gpg_path} < ${tmp_key_file}" 1>&2
        LC_ALL=C ${SUDO} gpg --dearmor --yes -o "${repo_gpg_path}" < "${tmp_key_file}" || return 1
        [ "${verbose}" -eq 1 ] && echo "+ ${SUDO} chmod 644 ${repo_gpg_path}" 1>&2
        LC_ALL=C ${SUDO} chmod 644 "${repo_gpg_path}" || return 1

        if [ "${verbose}" -eq 1 ]; then
            echo "+ gpg --no-options --show-keys --with-fingerprint ${repo_gpg_path}"
            LC_ALL=C ${SUDO_USER} gpg --no-options --show-keys --with-fingerprint "${repo_gpg_path}" 2>&1 | grep -v "^$" | sed 's/^/+ /' 1>&2
        fi

        rm_args=( "${tmp_key_file}" )
        [ "${verbose}" -eq 1 ] && rm_args+=( "-v" ) && echo "+ rm ${rm_args[*]}" 1>&2
        LC_ALL=C rm "${rm_args[@]}" 2>&1 | sed 's/^/+ /' 1>&2
        [ "${verbose}" -eq 1 ] && echo "+ echo ${repo_line} | ${SUDO} tee ${repo_list_path} > /dev/null" 1>&2
        echo "${repo_line}" | ${SUDO} tee "${repo_list_path}" > /dev/null
    else
        current_repo_line="$(cat "${repo_list_path}" 2>/dev/null)"
        if [ -z "${current_repo_line}" ]; then
            echo "Would write ${repo_line} to ${repo_list_path}" 1>&2
        elif [ "${current_repo_line}" != "${repo_line}" ]; then
            echo "Would update to ${repo_line} from ${current_repo_line}" 1>&2
        fi
    fi
    apt_upgrade "${name}"
}

apt_upgrade() {
    require_cmd apt-get || return 1
    local pkg="${1}"
    echo "${APP_NAME}: Updating sources..." 1>&2
    local apt_exit_code=-1
    if [ "${verbose}" -eq 1 ]; then
        LC_ALL=C ${SUDO} apt-get update
        apt_exit_code=$?
    else
        local apt_update_output
        apt_update_output="$(LC_ALL=C ${SUDO} apt-get update 2>&1)"
        apt_exit_code=$?
        [ ${apt_exit_code} -ne 0 ] && echo "${apt_update_output}" 1>&2
    fi
    [ ${apt_exit_code} -ne 0 ] && return 1

    if [ "${dry_run}" -eq 0 ]; then
        if [ -n "${pkg}" ]; then
            LC_ALL=C ${SUDO} DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkg}" 1>&2
        else
            LC_ALL=C ${SUDO} DEBIAN_FRONTEND=noninteractive apt-get upgrade -y 1>&2 \
                && LC_ALL=C ${SUDO} DEBIAN_FRONTEND=noninteractive apt-get autoremove -y 1>&2
        fi
    else
        apt_list_output="$(LC_ALL=C ${SUDO} apt list "${pkg}" --upgradable 2>/dev/null)"
        apt_list_output="$(echo "${apt_list_output}" | awk -F'[][]' '
  /^Listing/ { next }
  /upgradable from:/ {
    pkg = $1
    sub(/\/.*/, "", pkg)       # remove /repo and everything after

    new = $1
    sub(/^[^ ]+ /, "", new)
    sub(/ .*/, "", new)

    old = $2
    sub(/^upgradable from: /, "", old)

    printf "%s\t%s\t%s\n", pkg, old, new
  }
')"
        if [ -n "${apt_list_output}" ]; then
            echo -e "NAME\tCURRENT\tUPDATE\n${apt_list_output}" | column -t -s $'\t'
        else
            echo "${pkg:-apt} is up to date" 1>&2
        fi
    fi
}

helm_plugin_update() {
    require_cmd helm || return 1
    local name="${1}"; shift
    local url="${1}"; shift

    if [ "${dry_run}" -eq 1 ]; then
        if ${SUDO_USER} helm plugin list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qFx "${name}"; then
            echo "Would update Helm plugin ${name}" 1>&2
        else
            echo "Would install Helm plugin ${name} from ${url}" 1>&2
        fi
        return 0
    fi

    if ${SUDO_USER} helm plugin list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qFx "${name}"; then
        verbose "${SUDO_USER} helm plugin update ${name}"
        ${SUDO_USER} helm plugin update "${name}"
    else
        verbose "${SUDO_USER} helm plugin install --verify=false ${url}"
        ${SUDO_USER} helm plugin install --verify=false "${url}"
    fi
}

flatpak_list_updates() {
    local pkg="${1}"
    all_updates="$(join -t $'\t' -j 1 <(flatpak list --app --columns=name,version | tail -n +2 | sort) <(flatpak remote-ls --updates --app --columns=name,version | tail -n +2 | sort))"
    if [ -n "${pkg}" ]; then
        updates="$(echo "${all_updates}" | grep -w "${pkg}")"
    else
        updates="${all_updates}"
    fi
    # now remove all rows without version changes
    updates="$(echo "${updates}" | awk -F $'\t' '{if ($2 != $3) print $0}')"
    if [ -n "${updates}" ]; then
        echo -e "NAME\tCURRENT\tUPDATE\n${updates}" | column -t -s $'\t'
    else
        echo "${pkg:-flatpak} is up to date" 1>&2
    fi
}

flatpak_update() {
    require_cmd flatpak || return 1
    local pkg="${1}"
    if [ "${dry_run}" -eq 0 ]; then
        if [ -n "${pkg}" ]; then
            # check if installed
            if ${SUDO_USER} flatpak list --app --columns=application 2>/dev/null | tail -n +1 | grep -qFx "${pkg}"; then
                ${SUDO_USER} flatpak update -y "${pkg}"
            else
                ${SUDO_USER} flatpak install -y "${pkg}"
            fi
        else
            ${SUDO_USER} flatpak update -y
        fi
    else
        flatpak_list_updates "${pkg}" 
    fi
}

curl_update() {
    local pkg="${1}"; shift   
    local url="${1}"; shift
    [ -z "${url}" ] && echo "ERROR: curl_update requires a URL" 1>&2 && return 1
    [ -z "${pkg}" ] && echo "ERROR: curl_update requires a package name" 1>&2 && return 1
    require_cmd curl || return 1
    curl_args=( "--fail" "--location" )
    [ "${verbose}" -eq 0 ] && curl_args+=( "--silent" "--show-error" )
    curl_args+=( "${url}" )
    if [ "${dry_run}" -eq 0 ]; then
        [ "${verbose}" -eq 1 ] && echo "+ curl ${curl_args[*]} | ${SUDO_USER} bash" 1>&2
        curl "${curl_args[@]}" | ${SUDO_USER} bash
    else
        echo "+ curl ${curl_args[*]} | ${SUDO_USER} bash"
    fi
}

npm_update() {
    require_cmd npm npm-pkg-dir || return 1
    local pkg="${1}"; shift
    local force=0
    while [ $# -gt 0 ]; do
        case "${1}" in
            -f|--force)
                force=1
                ;;
            *)
                echo "ERROR: Unrecognized option: ${1}" 1>&2
                return 1
                ;;
        esac
        shift
    done
    
    local target_dir
    target_dir="$(npm-pkg-dir "${pkg}")"
    local backup_dir="${target_dir}.old"
    local npm_json
    local npm_table
    [ -z "${pkg}" ] && echo "ERROR: npm_update requires a package name" 1>&2 && return 1

    local sudo=""
    if [ -d "${target_dir}" ] && [ ! -w "${target_dir}" ]; then
        sudo="${SUDO}"
    fi

    if [ "${dry_run}" -eq 0 ]; then
        if [ "${force}" -eq 1 ]; then
            if [ -d "${backup_dir}" ]; then
                [ "${verbose}" -eq 1 ] && echo "+ ${sudo} rm -rf ${backup_dir}" 1>&2
                ${sudo} rm -rf "${backup_dir}"
            fi
            if [ -d "${target_dir}" ]; then
                [ "${verbose}" -eq 1 ] && echo "+ ${sudo} mv ${target_dir} ${backup_dir}" 1>&2
                ${sudo} mv "${target_dir}" "${backup_dir}"
            fi
        fi
        npm_args=("install" "-g" "${pkg}")
        [ "${verbose}" -eq 1 ] && npm_args+=("--verbose")
        [ "${verbose}" -eq 1 ] && echo "+ ${sudo} npm ${npm_args[*]}" 1>&2
        ${sudo} npm install "${npm_args[@]}"
    else
        require_cmd jq || return 1
        if ! npm_json="$(NODE_PATH="/usr/lib/node_modules" npm outdated -g "${pkg}" --json)"; then
            npm_table="$(echo "${npm_json}" | \
                         jq -r 'to_entries[] | [.key, (.value.current // "<unknown>"), .value.wanted] | @tsv')"
            echo -e "NAME\tCURRENT\tUPDATE\n${npm_table}" | column -t -s $'\t'
        else
            echo "${pkg} is up to date" 1>&2
        fi
    fi 
}

install_git_release() {
    require_cmd install-git-release || return 1
    local url="${1}"; shift
    local install_git_args=()
    while [ $# -gt 0 ]; do
        install_git_args+=("${1}")
        shift
    done
    [ "${dry_run}" -eq 1 ] && install_git_args+=("--dry-run")
    [ "${dry_run}" -eq 0 ] && install_git_args+=("--yes")
    install-git-release "${url}" "${install_git_args[@]}"
}

install_from_git() {
    local url=""
    local branch=""
    local script=""
    local script_args=()
    while [ $# -gt 0 ]; do
        case "${1}" in
            -b|--branch)
                if [ -z "${branch}" ]; then
                    shift
                    branch="${1}"
                else
                    script_args+=("${1}")
                fi
                ;;
            *)
                if [ -z "${url}" ]; then
                    url="${1}"
                elif [ -z "${script}" ]; then
                    script="${1}"
                else
                    script_args+=("${1}")
                fi
                ;;
        esac
        shift
    done
    [ -z "${url}" ] && echo "ERROR: install_from_git requires a URL" 1>&2 && return 1
    [ -z "${script}" ] && echo "ERROR: install_from_git requires a script to run" 1>&2 && return 1
    require_cmd git || return 1

    local tmp_dir
    verbose "mktemp -d"
    tmp_dir="$(mktemp -d)"
    local file_args=()
    [ "${verbose}" -eq 1 ] && file_args+=("-v")
    trap 'rm -rf "${tmp_dir}"; trap - RETURN' RETURN
    verbose "git clone ${url} ${tmp_dir}"
    LC_ALL=C git clone "${url}" "${tmp_dir}"; exit_code=$?
    [ "${exit_code}" -ne 0 ] && error "Failed to clone ${url}" && return 1
    (
        verbose "cd ${tmp_dir}"
        cd "${tmp_dir}" || exit 1
        if [ -n "${branch}" ]; then
            verbose "git checkout ${branch}"
            LC_ALL=C git checkout "${branch}"; exit_code=$?
            [ "${exit_code}" -ne 0 ] && error "Failed to checkout ${branch}" && exit 1
        else
            verbose "git describe --abbrev=0 --tags"
            latest_tag="$(LC_ALL=C git describe --abbrev=0 --tags)"; exit_code=$?
            [ "${exit_code}" -ne 0 ] && error "Failed to get latest tag" && exit 1
            verbose "latest_tag=${latest_tag}"
            verbose "git checkout ${latest_tag}"
            result="$(LC_ALL=C git checkout "${latest_tag}" 2>&1)"; exit_code=$?
            verbose "${result}"
            [ "${exit_code}" -ne 0 ] && error "Failed to checkout ${latest_tag}" && exit 1
        fi

        local cmd=()
        [[ "${script}" != *"/bash" ]] && [[ "${script}" != "bash" ]] && cmd+=("bash")
        cmd+=("${script}")

        if [ "${dry_run}" -eq 0 ]; then
            verbose "${cmd[*]} ${script_args[*]}"
            "${cmd[@]}" "${script_args[@]}"; exit_code=$?
            [ "${exit_code}" -ne 0 ] && error "Failed to run ${script}" && exit 1
        else
            echo "Would run: ${cmd[*]} ${script_args[*]}"
        fi
    ) || return 1
}

install_adb() {
    require_cmd git gpasswd udevadm systemd-sysusers systemctl || return 1
    apt_upgrade "adb" || return 1
    local tmp_dir
    verbose "mktemp -d"
	tmp_dir="$(mktemp -d)"
	local file_args=()
	[ "${verbose}" -eq 1 ] && file_args+=("-v")
    trap 'rm -rf "${tmp_dir}"; trap - RETURN' RETURN
	local git_dir="${tmp_dir}/android-udev-rules"

    verbose "mkdir ${file_args[*]} -p ${git_dir}"
	LC_ALL=C mkdir "${file_args[@]}" -p "${git_dir}"
    verbose "git clone https://github.com/M0Rf30/android-udev-rules.git ${tmp_dir}/android-udev-rules"
    LC_ALL=C git clone "https://github.com/M0Rf30/android-udev-rules.git" "${tmp_dir}/android-udev-rules"; exit_code=$?
	[ "${exit_code}" -ne 0 ] && error "Failed to clone https://github.com/M0Rf30/android-udev-rules.git" && return 1
    (
        verbose "cd ${tmp_dir}/android-udev-rules"
        cd "${tmp_dir}/android-udev-rules" || return 1

        verbose "ls -1 [0-9][0-9]-android.rules"
    	rules_file="$(ls -1 [0-9][0-9]-android.rules 2>/dev/null || true)"
        verbose "rules_file=${rules_file}"

        verbose "ls -1 android-udev.conf"
        conf_file="$(ls -1 android-udev.conf 2>/dev/null || true)"
        verbose "conf_file=${conf_file}"

    	[ -z "${rules_file}" ] && error "No **-android.rules files found" && return 1
    	[ "$(echo "${rules_file}" | wc -l)" -gt 1 ] && error "Multiple **-android.rules files found" && return 1
        [ -z "${conf_file}" ] && error "No android-udev.conf file found" && return 1

        verbose "rm -f ${file_args[*]} /etc/udev/rules.d/[0-9][0-9]-android.rules"
    	${SUDO} LC_ALL=C rm -f "${file_args[@]}" "/etc/udev/rules.d/"[0-9][0-9]"-android.rules"
        verbose "cp ${file_args[*]} ${rules_file} /etc/udev/rules.d/${rules_file}" || return 1
        ${SUDO} LC_ALL=C cp "${file_args[@]}" "${rules_file}" "/etc/udev/rules.d/${rules_file}"
        verbose "chmod ${file_args[*]} a+r /etc/udev/rules.d/${rules_file}" || return 1
    	${SUDO} LC_ALL=C chmod "${file_args[@]}" a+r "/etc/udev/rules.d/${rules_file}"
        verbose "rm -f ${file_args[*]} /usr/lib/sysusers.d/android-udev.conf" || true
        ${SUDO} LC_ALL=C rm -f "${file_args[@]}" /usr/lib/sysusers.d/android-udev.conf
        verbose "cp ${file_args[*]} ${conf_file} /usr/lib/sysusers.d/" || return 1
    	${SUDO} LC_ALL=C cp "${file_args[@]}" "${conf_file}" /usr/lib/sysusers.d/
    ) || return 1

    verbose "systemd-sysusers"
	${SUDO} LC_ALL=C systemd-sysusers
    verbose "gpasswd -a ${CURRENT_USER_NAME} adbusers"
	${SUDO} LC_ALL=C gpasswd -a "${CURRENT_USER_NAME}" adbusers
    verbose "udevadm control --reload-rules"
	${SUDO} LC_ALL=C udevadm control --reload-rules
    verbose "systemctl restart systemd-udevd.service"
	${SUDO} LC_ALL=C systemctl restart systemd-udevd.service

    verbose "adb kill-server"
	${SUDO_USER} adb kill-server
    verbose "adb devices"
	${SUDO_USER} adb devices &>/dev/null; exit_code=$?
    [ "${exit_code}" -ne 0 ] && error "Failed to run adb devices" && return 1
    echo "ADB installed successfully" 1>&2
}


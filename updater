    local latest_url
    local version
    local installed_version

    latest_url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/ollama/ollama/releases/latest")" || return 1
    version="${latest_url##*/v}"
    if [[ ! "${version}" =~ ^[0-9.]+$ ]]; then
        error "Failed to get latest version of Ollama from ${latest_url}"
        return 1
    fi
    # without a running server the version comes as a warning on stderr
    installed_version="$(ollama --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1)"
    [ -z "${installed_version}" ] && installed_version="<none>"
    if [ "${version}" = "${installed_version}" ]; then
        echo "${APP_NAME}: ollama ${installed_version} is up to date" 1>&2
        return 0
    fi
    if [ "${dry_run}" -eq 1 ]; then
        echo -e "NAME\tCURRENT\tUPDATE\nollama\t${installed_version}\t${version}" | column -t -s $'\t'
        return 0
    fi
    # the install script also resets /usr/local/bin to root:root 755
    # ("install -o0 -g0 -m755 -d"), which undoes setup-dirs, so its owner and
    # mode are restored afterwards, also when the script fails
    local bin_dir="/usr/local/bin"
    local bin_dir_owner
    local bin_dir_mode
    local rc=0
    bin_dir_owner="$(stat -c '%u:%g' "${bin_dir}")" || return 1
    bin_dir_mode="$(stat -c '%a' "${bin_dir}")" || return 1
    # the install script sets up /usr/local and the ollama systemd service, so it runs as root
    verbose "curl -fsSL https://ollama.com/install.sh | ${SUDO} sh"
    curl -fsSL "https://ollama.com/install.sh" | ${SUDO} sh || rc=1
    verbose "chown ${bin_dir_owner} ${bin_dir}"
    ${SUDO} chown "${bin_dir_owner}" "${bin_dir}" || rc=1
    verbose "chmod ${bin_dir_mode} ${bin_dir}"
    ${SUDO} chmod "${bin_dir_mode}" "${bin_dir}" || rc=1
    return ${rc}
}


#!/bin/bash
full_command="ssh ${@}"
config="${XDG_CONFIG_HOME:-${HOME}/.config}/cli-helpers/ssh.conf"
skip_host=""
[ ! -r "${config}" ] || skip_host="$(sed -n 's/^skip_history_host=//p' "${config}" | head -n 1)"
if [[ "${@}" != *"git@"* ]] \
&& { [ -z "${skip_host}" ] || [[ "${@}" != *"${skip_host}"* ]]; } \
&& [[ "${full_command}" != *" -G "* ]]; then
    echo "${full_command}" | history_append
fi
exec /usr/bin/ssh "${@}"

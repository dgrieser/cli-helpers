[Desktop Entry]
Type=Application
Version=1.0
Name=Browser Router
GenericName=Web Browser
Comment=Open URLs in the regular browser, except 2FA logins
Exec=/usr/local/bin/browser-router %U
Icon=google-chrome
Terminal=false
StartupNotify=true
NoDisplay=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;

#!/bin/bash

APP_NAME="$(basename "${0}")"
REMINDER_DIR="${HOME}/.cache/reminder"
# Persisted display order for active reminders: one basename per line. Read on
# every print; rewritten whenever an edit/add is actually applied. Not matched
# by the *.md / *.md_* globs, so it never shows up as a reminder.
ORDER_FILE="${REMINDER_DIR}/.order"

C_TITLE=$'\033[38;5;228;48;5;63;1m'
C_HELP=$'\033[90m'      # grey help text
C_KEY=$'\033[38;5;250m' # lighter grey for help keys
C_SEP=$'\033[90m'       # grey vertical rule
C_BOX_OFF=$'\033[36m'   # cyan unchecked checkbox
C_BOX_ON=$'\033[32m'    # green checked checkbox
C_OPEN=$'\033[92m'      # bright green "OPEN" view label
C_DONE=$'\033[38;5;250m' # light grey "DONE" view label
C_BOLD=$'\033[1m'       # bold reminder titles
C_NOBOLD=$'\033[22m'    # bold off only (keeps reverse video / other attrs)
C_ITALIC=$'\033[3m'     # italic title: unsaved (new/edited) reminder
C_MOVE=$'\033[38;5;232;48;5;214m' # selected row while reordering (dark on amber)
C_RESET=$'\033[0m'

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS]

Manage and write Markdown reminders in ${REMINDER_DIR}.

Active reminders are *.md files. Marking one as done renames it to
<name>.md_<timestamp> so it drops out of every listing without being lost.

The display order of active reminders is kept in ${ORDER_FILE} and applied to
every listing (--print included). Reminders missing from that file (e.g. added
from outside this tool) sort on top, newest-modified first. The order file is
rewritten whenever a change is actually applied.

With no options, runs interactive edit mode: navigate the reminder titles,
toggle a done checkbox, edit and add reminders, then save. Every change is
staged and nothing in ${REMINDER_DIR} is touched until you save with enter;
esc or Ctrl+C exit with the real reminders untouched. Tab switches between the
open (active) and done (completed) views; both list newest-modified first.

Options:
  --print               Render all reminders with glow and exit
  --add                 Open an editor to write a new reminder and exit
  -h, --help            Show this help message and exit

Edit-mode keys:
  up / down (or k / j)  Move between reminders
  tab                   Switch between the open and done (completed) views
  shift+up / shift+down Scroll the preview pane (for reminders taller than it)
  space                 Toggle the checkbox (open: mark done; done: reopen)
  o                     Reorder: grab the selected reminder (open view only),
                        then up/down move it; enter keeps the new order, esc
                        cancels. All other keys are disabled while reordering.
  e                     Edit the selected reminder in vim (staged until save)
  n                     Add a new reminder, then return to edit mode
  enter                 Save: apply all staged changes and exit
  esc                   Done view: back to open view; open view: abort
                        (prompts to discard if anything is staged)
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

# Emit reminder files for a view, newest-modified first, one path per line.
# $1 = "open" (active *.md) | "done" (completed *.md_<timestamp>).
list_files_by_mtime() {
    local view="${1}" f
    {
        if [ "${view}" = "done" ]; then
            for f in "${REMINDER_DIR}"/*.md_*; do
                [ -f "${f}" ] && printf '%s\t%s\n' "$(stat -c %Y "${f}")" "${f}"
            done
        else
            for f in "${REMINDER_DIR}"/*.md; do
                [ -f "${f}" ] && printf '%s\t%s\n' "$(stat -c %Y "${f}")" "${f}"
            done
        fi
    } | sort -rn -k1,1 | cut -f2-
}

# Emit active reminder paths (*.md) in display order, one per line:
#   1. files NOT listed in ORDER_FILE first, newest-modified first
#   2. then files listed in ORDER_FILE, in that order, skipping any that no
#      longer exist.
# This is the single source of truth for ordering used by --print and edit mode.
list_files_ordered() {
    local f base line
    declare -A in_order=()
    if [ -f "${ORDER_FILE}" ]; then
        while IFS= read -r line; do
            [ -n "${line}" ] && in_order["${line}"]=1
        done < "${ORDER_FILE}"
    fi
    # Untracked active reminders, newest first.
    while IFS= read -r f; do
        [ -n "${f}" ] || continue
        base="${f##*/}"
        [ -n "${in_order[${base}]:-}" ] || printf '%s\n' "${f}"
    done < <(list_files_by_mtime open)
    # Tracked reminders, in the stored order (existing ones only).
    if [ -f "${ORDER_FILE}" ]; then
        while IFS= read -r line; do
            [ -n "${line}" ] || continue
            [ -f "${REMINDER_DIR}/${line}" ] && printf '%s\n' "${REMINDER_DIR}/${line}"
        done < "${ORDER_FILE}"
    fi
}

# Write ORDER_FILE from the given reminder paths (basenames, one per line). With
# no paths the file is truncated, which is the correct state for "no reminders".
persist_order() {
    local p out=""
    for p in "$@"; do
        out+="${p##*/}"$'\n'
    done
    printf '%s' "${out}" > "${ORDER_FILE}"
}

# First non-empty line of a file, with any leading Markdown heading marks stripped.
get_title() {
    local t
    t="$(grep -m1 -E '\S' "${1}" 2>/dev/null | sed -E 's/^#+[[:space:]]*//')"
    [ -z "${t}" ] && t="$(basename "${1}")"
    printf '%s' "${t}"
}

# Render every active reminder with glow, newest first.
print_reminders() {
    local reminders=() f
    while IFS= read -r f; do
        [ -n "${f}" ] && reminders+=("${f}")
    done < <(list_files_ordered)
    if [ "${#reminders[@]}" -eq 0 ]; then
        echo "No reminders." 1>&2
        return 0
    fi
    {
        echo "# YOUR REMINDERS"
        echo
        for f in "${reminders[@]}"; do
            cat "${f}"
            echo
        done
    } | glow
}


# Open an editor on a new reminder *template* and stage it in a tmp file WITHOUT
# touching REMINDER_DIR. On success (editor exit 0 and the template was actually
# changed) print the tmp path to stdout; otherwise print nothing and return
# non-zero. The caller decides when (if ever) to persist it via save_reminder.
compose_reminder() {
    local dir template tmp content header
    dir="$(basename "$(pwd)")"
    template="### ${dir}"

    tmp="$(mktemp --suffix=.md)" || return 1
    printf '%s\n' "${template}" > "${tmp}"

    if ! vim "${tmp}" </dev/tty >/dev/tty 2>&1; then
        rm -f "${tmp}"
        return 1
    fi

    content="$(cat "${tmp}")"
    header="$(grep -m1 -E '\S' "${tmp}" | sed -E 's/^#+[[:space:]]*//')"
    if [ "${content}" = "${template}" ] || [ -z "${header}" ]; then
        # Unchanged from the template, or empty: nothing worth keeping.
        rm -f "${tmp}"
        return 1
    fi

    printf '%s\n' "${tmp}"
}

# Persist a composed reminder (the tmp from compose_reminder) into REMINDER_DIR
# under a slug derived from its first heading. The tmp is copied, not moved, so
# the caller still owns its cleanup. Prints the saved path.
save_reminder() {
    local tmp="${1}" header slug target ts
    header="$(grep -m1 -E '\S' "${tmp}" | sed -E 's/^#+[[:space:]]*//')"
    slug="$(printf '%s' "${header}" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    [ -z "${slug}" ] && slug="reminder"

    target="${REMINDER_DIR}/${slug}.md"
    if [ -e "${target}" ]; then
        ts="$(date +%Y-%m-%dT%H-%M-%S)"
        target="${REMINDER_DIR}/${slug}-${ts}.md"
    fi

    cp "${tmp}" "${target}"
    printf '%s\n' "${target}"
}

# --- interactive edit mode --------------------------------------------------

# State shared across the edit-mode helpers.
files=()
titles=()
done_flags=()
done_epoch=()                # parallel to files: completion epoch (done view) or 0
# Nothing below touches REMINDER_DIR until save (enter). Every edit-mode action
# is staged here and only applied on save; esc/Ctrl+C discard it all, leaving the
# real reminders untouched.
created=()                    # tmp paths of new reminders composed but not saved
declare -A edited_work=()     # real file -> tmp holding its EDITED (new) content
declare -A new_done=()        # created-tmp -> 1 if a staged new reminder is flagged done
sel=0
saved_stty=""                 # original tty settings, restored on exit
view="open"                   # "open" (active) | "done" (completed)
declare -A pending=()         # real file -> 1 if flagged for its view's action on save
change_log=()                 # coloured, one-per-line summary of changes applied on save
term_cols=80                  # cached terminal size; recomputed only on SIGWINCH
term_lines=24
need_winch=1                  # 1 => refresh term size on next render
smso_cap=""                   # standout on/off escapes, queried once (static)
rmso_cap=""
declare -A preview_cache=()   # "file::width" -> glow output, newline-joined
open_seq=()                   # canonical open-view order (created tmps + real paths)
reorder=0                     # 1 while in reorder sub-mode (m); disables other keys
reorder_backup=()             # open_seq snapshot, restored if reorder is cancelled
order_changed=""              # non-empty once a reorder is kept (counts as a change)

# Parse the completion epoch out of a "<name>.md_<YYYY-MM-DDTHH-MM-SS>" path.
# Done once per item at load time (not per frame), so the one date(1) fork here
# stays off render's hot path. Prints the epoch, or 0 if it can't be parsed.
done_path_epoch() {
    local raw d t
    raw="${1##*.md_}"
    d="${raw%%T*}"
    t="${raw#*T}"
    t="${t//-/:}"
    date -d "${d} ${t}" +%s 2>/dev/null || echo 0
}

# Build open_seq, the canonical open-view order: staged new reminders first
# (newest staged on top), then the active reminders in their stored order.
# Called once at edit-mode start; thereafter open_seq is mutated in place (new
# items prepended on "n", rows swapped while reordering) so a manual reorder and
# the staged-new positions survive view switches.
build_open_seq() {
    open_seq=()
    local n f
    for n in "${created[@]}"; do open_seq+=("${n}"); done
    while IFS= read -r f; do
        [ -n "${f}" ] && open_seq+=("${f}")
    done < <(list_files_ordered)
}

load_list() {
    files=()
    titles=()
    done_flags=()
    done_epoch=()
    local f
    if [ "${view}" = "open" ]; then
        # Open view follows open_seq exactly (created tmps + real paths).
        for f in "${open_seq[@]}"; do
            files+=("${f}")
            # Title reflects the staged edit when there is one.
            titles+=("$(get_title "${edited_work[${f}]:-${f}}")")
            done_epoch+=(0)
            if is_created "${f}"; then
                if [ -n "${new_done[${f}]:-}" ]; then done_flags+=(1); else done_flags+=(0); fi
            else
                if [ -n "${pending[${f}]:-}" ]; then done_flags+=(1); else done_flags+=(0); fi
            fi
        done
        return
    fi
    # Done view: completed reminders, newest-completed first (not reorderable).
    while IFS= read -r f; do
        [ -n "${f}" ] || continue
        files+=("${f}")
        titles+=("$(get_title "${edited_work[${f}]:-${f}}")")
        done_epoch+=("$(done_path_epoch "${f}")")
        if [ -n "${pending[${f}]:-}" ]; then
            done_flags+=(1)
        else
            done_flags+=(0)
        fi
    done < <(list_files_by_mtime "${view}")
}

# True if a keystroke is already waiting, without consuming it. Used to coalesce
# rapid scrolling: render skips the costly preview build while input is queued.
input_pending() {
    IFS= read -rsn1 -t 0 _ </dev/tty
}

# Read one logical key into the global KEY. Setting a variable rather than
# echoing avoids a $()-subshell fork on every single keystroke.
read_key() {
    local char rest c rc
    IFS= read -rsn1 char </dev/tty
    rc=$?
    if [ "${rc}" -gt 128 ]; then
        # A trapped signal (e.g. SIGWINCH) interrupted read: just repaint.
        KEY='redraw'
        return
    fi
    if [ -z "${char}" ]; then
        KEY='enter'
        return
    fi
    if [ "${char}" = $'\e' ]; then
        rest=""
        while IFS= read -rsn1 -t 0.001 c </dev/tty; do
            rest="${rest}${c}"
        done
        case "${rest}" in
            "[A") KEY='up' ;;
            "[B") KEY='down' ;;
            "[C") KEY='right' ;;
            "[D") KEY='left' ;;
            "[1;2A") KEY='shift-up' ;;
            "[1;2B") KEY='shift-down' ;;
            "") KEY='esc' ;;
            *) KEY='other' ;;
        esac
        return
    fi
    case "${char}" in
        " ") KEY='space' ;;
        $'\t') KEY='tab' ;;
        $'\n'|$'\r') KEY='enter' ;;
        *) KEY="${char}" ;;
    esac
}

# Resolve the glow style to render previews with into the global GLOW_STYLE.
# Honors $REMINDER_GLOW_STYLE, then the "style" key in glow.yml, else "dark".
# (--print's glow writes to a tty so it already picks up glow.yml on its own;
# the preview pipes glow into a substitution, which strips style + colour, so it
# must pass the style explicitly.)
resolve_glow_style() {
    if [ -n "${REMINDER_GLOW_STYLE:-}" ]; then
        GLOW_STYLE="${REMINDER_GLOW_STYLE}"
        return
    fi
    local cfg style
    cfg="${GLOW_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/glow/glow.yml}"
    if [ -f "${cfg}" ]; then
        style="$(sed -nE 's/^[[:space:]]*style:[[:space:]]*"?([^"#]+)"?[[:space:]]*$/\1/p' "${cfg}" | head -1)"
        style="${style%"${style##*[![:space:]]}"}"
    fi
    GLOW_STYLE="${style:-dark}"
    [ "${GLOW_STYLE}" = "auto" ] && GLOW_STYLE="dark"
}

# Render the selected reminder with glow into the global right_lines, wrapped to
# the given width. Cached on (file, width) via preview_key so that toggling done
# (which leaves the selection unchanged) does not re-run glow.
build_right_lines() {
    local w="${1}" f key line
    if [ "${#files[@]}" -eq 0 ]; then
        right_lines=()
         preview_key=""
        return
    fi
    f="${files[${sel}]}"
    key="${f}::${w}"
    [ "${key}" = "${preview_key:-}" ] && return
    preview_key="${key}"
    right_scroll=0          # new preview starts at the top
    if [ -n "${preview_cache[${key}]+x}" ]; then
        # Already rendered this (file, width): split the stored lines back out
        # (builtin, no glow fork) so revisiting an item is instant.
        mapfile -t right_lines <<< "${preview_cache[${key}]}"
        return
    fi
    # Preview the staged content: a new reminder's tmp, or an edited file's
    # working copy, falls back to the real file when neither applies.
    local src="${edited_work[${f}]:-${f}}"
    right_lines=()
    # glow writes to a pipe here, so it would normally drop colour ("not a
    # terminal"); CLICOLOR_FORCE keeps the ANSI, and an explicit style is needed
    # because background auto-detection also needs a tty. Feed the file on stdin
    # rather than as a path: done reminders are named "<name>.md_<timestamp>", and
    # glow only treats a path as Markdown by its extension (it hangs on .md_*),
    # whereas stdin is always rendered as Markdown.
    while IFS= read -r line; do
        right_lines+=("${line}")
    done < <(COLORTERM=truecolor CLICOLOR_FORCE=1 glow -s "${GLOW_STYLE}" -w "$((w - 1))" 2>/dev/null < "${src}")
    # glow prepends a blank top-margin line; drop it.
    if [ "${#right_lines[@]}" -gt 0 ]; then
        local first
        first="$(printf '%s' "${right_lines[0]}" | sed -E $'s/\033\\[[0-9;?]*[A-Za-z]//g')"
        [ -z "${first//[[:space:]]/}" ] && right_lines=("${right_lines[@]:1}")
    fi
    # Memoise the finished frame so later visits skip glow entirely.
    local joined
    printf -v joined '%s\n' "${right_lines[@]}"
    preview_cache[${key}]="${joined%$'\n'}"
}

# The whole frame is composed into a single string and written in one shot, and
# the screen is repainted from the home position (rather than cleared) with each
# line erased to its end — this avoids the blank-screen flash between frames.
render() {
    local cols lines avail sep left_w right_w tw pad tpad now today yest
    # Clock for the done view's relative-time labels. printf's %()T is a builtin
    # (no fork); computed once per frame, reused for every row.
    printf -v now '%(%s)T' -1
    printf -v today '%(%Y-%m-%d)T' "${now}"
    printf -v yest '%(%Y-%m-%d)T' "$((now - 86400))"
    # Terminal size is forked from tput only when it actually changes (initial
    # frame + SIGWINCH), not on every keystroke.
    if [ "${need_winch}" -eq 1 ]; then
        term_cols="$(tput cols 2>/dev/null || echo 80)"
        term_lines="$(tput lines 2>/dev/null || echo 24)"
        need_winch=0
    fi
    cols="${term_cols}"
    lines="${term_lines}"
    avail=$((lines - 3))
    [ "${avail}" -lt 1 ] && avail=1
    left_w=$((cols / 3))
    [ "${left_w}" -lt 24 ] && left_w=24
    [ "${left_w}" -gt 44 ] && left_w=44
    right_w=$((cols - left_w - 3))
    # Width left for the title after "> " (arrow + space, 2), the ☐ box (1) and
    # a two-space gap (2).
    tw=$((left_w - 5))
    [ "${tw}" -lt 1 ] && tw=1
    # Grey vertical rule (3 visible columns: space, bar, space).
    sep=" ${C_SEP}│${C_RESET} "

    # eol = reset attributes, then erase to end of line (clears stale glyphs and
    # any background colour glow may have left active).
    local home=$'\033[H' eol=$'\033[0m\033[K' clrbelow=$'\033[J'
    # Standout caps are static; queried once in edit_mode, not per frame.
    local smso="${smso_cap}" rmso="${rmso_cap}"

    # Scroll the list so the selection stays visible.
    local count="${#files[@]}" start=0
    if [ "${count}" -gt "${avail}" ] && [ "${sel}" -ge "${avail}" ]; then
        start=$((sel - avail + 1))
    fi

    local vlabel="OPEN" vcol="${C_OPEN}"
    if [ "${view}" = "done" ]; then vlabel="DONE"; vcol="${C_DONE}"; fi

    local out="${home}"
    # View label styled like glow's H1; the label word is tinted by view (green
    # OPEN / white DONE), then C_TITLE restores the bar's fg for the trailing pad.
    if [ "${reorder}" -eq 1 ]; then
        # Reorder sub-mode: only the keys that do something here are advertised.
        out+="${C_TITLE} REMINDERS · ${vcol}${vlabel}${C_TITLE} ${C_RESET}  ${C_MOVE} REORDER ${C_RESET}${C_HELP}  ${C_KEY}up/down${C_HELP} move · ${C_KEY}o/enter${C_HELP} save order · ${C_KEY}esc${C_HELP} cancel${eol}"$'\n'
    else
        out+="${C_TITLE} REMINDERS · ${vcol}${vlabel}${C_TITLE} ${C_RESET}${C_HELP}  ${C_KEY}up/down${C_HELP} move · ${C_KEY}tab${C_HELP} open/done · ${C_KEY}space${C_HELP} toggle · ${C_KEY}shift+up/down${C_HELP} scroll · ${C_KEY}e${C_HELP} edit · ${C_KEY}n${C_HELP} new · ${C_KEY}o${C_HELP} reorder · ${C_KEY}enter${C_HELP} save · ${C_KEY}esc${C_HELP} abort${eol}"$'\n'
    fi
    out+="${eol}"$'\n'

    local preview=1 max_scroll=0
    [ "${right_w}" -lt 16 ] && preview=0
    if [ "${preview}" -eq 1 ]; then
        # While more keystrokes are already queued (fast scrolling), reuse the
        # last frame's preview instead of (re)building it; the preview settles
        # the moment the user stops, keeping the list itself responsive.
        input_pending || build_right_lines "${right_w}"
        # Clamp the preview scroll so it can't run past the last screenful.
        max_scroll=$(( ${#right_lines[@]} - avail ))
        [ "${max_scroll}" -lt 0 ] && max_scroll=0
        [ "${right_scroll}" -gt "${max_scroll}" ] && right_scroll="${max_scroll}"
        [ "${right_scroll}" -lt 0 ] && right_scroll=0
    fi

    local r li lcell box boxcol title plain rtext titalic checked datestr ttw
    for ((r = 0; r < avail; r++)); do
        li=$((start + r))
        if [ "${count}" -eq 0 ] && [ "${r}" -eq 0 ]; then
            plain="(no reminders — n to add, esc to quit)"
            printf -v pad '%-*s' "${left_w}" "${plain:0:${left_w}}"
            lcell="${C_HELP}${pad}${C_RESET}"
        elif [ "${li}" -lt "${count}" ]; then
            # A flag means "mark done" in the open view, "reopen" in the done
            # view. A ticked box shows the done-state either way: flagged when
            # open, unflagged when done.
            if [ "${view}" = "done" ]; then
                checked=$(( done_flags[li] == 1 ? 0 : 1 ))
            else
                checked="${done_flags[li]}"
            fi
            if [ "${checked}" -eq 1 ]; then
                box="☑"; boxcol="${C_BOX_ON}"
            else
                box="☐"; boxcol="${C_BOX_OFF}"
            fi
            # Italicise unsaved titles only: created this session, or edited
            # (staged). The italic spans just the title, not the box or ">".
            if is_created "${files[${li}]}" || [ -n "${edited_work[${files[${li}]}]:-}" ]; then
                titalic="${C_ITALIC}"
            else
                titalic=""
            fi
            # In the done view, show when it was completed, right-aligned in
            # light grey and not bold. Under 5h: relative ("4h 10m ago", or
            # "just now" under a minute). Else today/yesterday by name, else the
            # full date — all with the time. The title shrinks to make room.
            datestr=""; ttw="${tw}"
            if [ "${view}" = "done" ]; then
                local dts ddate dtime ep diff dh dm
                dts="${files[${li}]##*.md_}"   # YYYY-MM-DDTHH-MM-SS
                ddate="${dts%%T*}"            # YYYY-MM-DD
                dtime="${dts#*T}"; dtime="${dtime%-*}"; dtime="${dtime//-/:}"  # HH:MM
                ep="${done_epoch[li]:-0}"
                diff=$(( now - ep ))
                if [ "${ep}" -gt 0 ] && [ "${diff}" -ge 0 ] && [ "${diff}" -lt 18000 ]; then
                    if [ "${diff}" -lt 60 ]; then
                        datestr="just now"
                    else
                        dh=$(( diff / 3600 )); dm=$(( (diff % 3600) / 60 ))
                        datestr=""
                        [ "${dh}" -gt 0 ] && datestr="${dh}h"
                        [ "${dm}" -gt 0 ] && datestr="${datestr:+${datestr} }${dm}m"
                        datestr="${datestr} ago"
                    fi
                elif [ "${ep}" -gt 0 ] && [ "${ddate}" = "${today}" ]; then
                    datestr="Today ${dtime}"
                elif [ "${ep}" -gt 0 ] && [ "${ddate}" = "${yest}" ]; then
                    datestr="Yesterday ${dtime}"
                else
                    datestr="${ddate} ${dtime}"
                fi
                ttw=$(( tw - ${#datestr} - 1 ))
                [ "${ttw}" -lt 1 ] && ttw=1
            fi
            title="${titles[${li}]:0:${ttw}}"
            printf -v tpad '%-*s' "${ttw}" "${title}"
            if [ "${li}" -eq "${sel}" ] && [ "${reorder}" -eq 1 ]; then
                # Grabbed for reordering: amber background bar with a ↕ marker so
                # it reads as "this row moves with up/down".
                lcell="${C_MOVE}${C_BOLD}↕ ${box}  ${titalic}${tpad}"
                [ -n "${datestr}" ] && lcell+="${C_NOBOLD} ${datestr}"
                lcell+="${C_RESET}"
            elif [ "${li}" -eq "${sel}" ]; then
                # Selected: reverse-video bold bar; italic on the title only. The
                # date rides inside the bar (C_NOBOLD drops bold but keeps the
                # reverse video, so it isn't bold like the title).
                lcell="${smso}${C_BOLD}> ${box}  ${titalic}${tpad}"
                [ -n "${datestr}" ] && lcell+="${C_NOBOLD} ${datestr}"
                lcell+="${C_RESET}${rmso}"
            else
                # Arrow gap, coloured checkbox, two spaces, bold (italic if unsaved) title.
                lcell="  ${boxcol}${box}${C_RESET}  ${C_BOLD}${titalic}${tpad}${C_RESET}"
                [ -n "${datestr}" ] && lcell+=" ${C_HELP}${datestr}${C_RESET}"
            fi
        else
            printf -v lcell '%-*s' "${left_w}" ""
        fi
        if [ "${preview}" -eq 1 ]; then
            # glow output carries its own ANSI; pass it through untruncated.
            # right_scroll offsets which preview line maps to this screen row.
            rtext="${right_lines[$((r + right_scroll))]:-}"
            out+="${lcell}${sep}${rtext}${eol}"$'\n'
        else
            out+="${lcell}${eol}"$'\n'
        fi
    done

    # Drop the final newline so the cursor never lands past the last row (which
    # would scroll the screen), then clear anything left below.
    out="${out%$'\n'}"
    out+="${clrbelow}"
    printf '%s' "${out}"
}

# True if the given path was created this session (via the "n" key).
is_created() {
    local p
    for p in "${created[@]}"; do
        [ "${p}" = "${1}" ] && return 0
    done
    return 1
}

has_changes() {
    [ "${#created[@]}" -gt 0 ] && return 0
    [ "${#edited_work[@]}" -gt 0 ] && return 0
    [ "${#pending[@]}" -gt 0 ] && return 0
    [ -n "${order_changed}" ] && return 0
    return 1
}

# Remove every staging tmp (composed new reminders + edit working copies). Safe
# to call repeatedly and on any exit path; it never touches REMINDER_DIR.
cleanup_staging() {
    local p
    for p in "${created[@]}"; do rm -f "${p}"; done
    for p in "${edited_work[@]}"; do rm -f "${p}"; done
}

confirm_discard() {
    tput cnorm
    stty echo </dev/tty 2>/dev/null   # show the y/N keystroke
    printf '\nDiscard changes'
    [ "${#created[@]}" -gt 0 ] && printf ', drop %d new reminder(s)' "${#created[@]}"
    [ "${#edited_work[@]}" -gt 0 ] && printf ', discard %d edit(s)' "${#edited_work[@]}"
    [ "${#pending[@]}" -gt 0 ] && printf ', drop %d pending toggle(s)' "${#pending[@]}"
    [ -n "${order_changed}" ] && printf ', discard reordering'
    printf '? [y/N] '
    local ans
    IFS= read -rn1 ans </dev/tty
    printf '\n'
    stty -echo </dev/tty 2>/dev/null  # back to the session's no-echo mode
    tput civis
    case "${ans}" in
        y|Y) return 0 ;;
        *) return 1 ;;
    esac
}

# Apply pending toggles across both views: an open reminder flagged done gets a
# _<timestamp> suffix; a done reminder flagged for reopen gets that suffix
# stripped (back to <name>.md). Keyed by path, so the current view is irrelevant.
# Each applied move appends a coloured line to change_log (title read before mv).
commit_pending() {
    local p ts target title
    for p in "${!pending[@]}"; do
        [ "${pending[${p}]}" = "1" ] || continue
        [ -f "${p}" ] || continue
        title="$(get_title "${p}")"
        case "${p}" in
            *.md_*)
                target="${p%%.md_*}.md"
                [ -e "${target}" ] && target="${p%%.md_*}-$(date +%Y-%m-%dT%H-%M-%S).md"
                mv "${p}" "${target}" && change_log+=("${C_DONE}↺ reopened ${C_RESET}${title}")
                ;;
            *.md)
                ts="$(date +%Y-%m-%dT%H-%M-%S)"
                mv "${p}" "${p}_${ts}" && change_log+=("${C_BOX_ON}✓ done     ${C_RESET}${title}")
                ;;
        esac
    done
    return 0
}

edit_mode() {
    [ -t 1 ] || fail "Edit mode requires a terminal."

    view="open"
    pending=()
    created=()
    edited_work=()
    new_done=()
    change_log=()
    preview_cache=()
    reorder=0
    reorder_backup=()
    order_changed=""
    build_open_seq
    load_list
    sel=0
    preview_key=""
    right_scroll=0
    resolve_glow_style

    # Query the static standout caps once (used every frame by render).
    smso_cap="$(tput smso 2>/dev/null)"
    rmso_cap="$(tput rmso 2>/dev/null)"

    # Disable echo for the whole session. render() runs between keystrokes, and a
    # held-down arrow streams escape sequences during that window; with echo on
    # the terminal would print and act on them, flashing stray glyphs at the edges.
    saved_stty="$(stty -g </dev/tty 2>/dev/null)"
    stty -echo </dev/tty 2>/dev/null
    # On any exit (including death by signal) restore the terminal and drop the
    # staging tmps. Nothing in REMINDER_DIR is touched here, so an interrupted
    # session — Ctrl+C included — leaves the real reminders exactly as they were.
    trap 'tput cnorm 2>/dev/null; [ -n "${saved_stty:-}" ] && stty "${saved_stty}" </dev/tty 2>/dev/null; cleanup_staging' EXIT
    # Ctrl+C / kill: exit, which fires the EXIT trap above (discard, no apply).
    # Print a newline first so the shell prompt resumes on its own line.
    trap 'printf "\n"; exit 130' INT
    trap 'exit 143' TERM
    # On resize, just flag a size refresh; render recomputes on the next frame.
    trap 'need_winch=1' WINCH
    need_winch=1
    tput civis
    tput clear

    local key newpath
    while true; do
        render
        read_key
        key="${KEY}"
        # Reorder sub-mode owns the keyboard: up/down drag the grabbed row, enter
        # keeps the new order, esc reverts to the pre-grab order, and every other
        # key is ignored. (Ctrl+C still fires the global INT trap: exit, no save.)
        if [ "${reorder}" -eq 1 ]; then
            case "${key}" in
                up|k)
                    # No wrap: at the top, up does nothing. Otherwise swap with
                    # the row above and follow the grabbed item up.
                    if [ "${sel}" -gt 0 ]; then
                        local tmp_seq="${open_seq[$((sel - 1))]}"
                        open_seq[$((sel - 1))]="${open_seq[${sel}]}"
                        open_seq[${sel}]="${tmp_seq}"
                        sel=$((sel - 1))
                        load_list
                    fi
                    ;;
                down|j)
                    # No wrap: at the bottom, down does nothing.
                    if [ "${sel}" -lt $(( ${#open_seq[@]} - 1 )) ]; then
                        local tmp_seq="${open_seq[$((sel + 1))]}"
                        open_seq[$((sel + 1))]="${open_seq[${sel}]}"
                        open_seq[${sel}]="${tmp_seq}"
                        sel=$((sel + 1))
                        load_list
                    fi
                    ;;
                o|enter)
                    # Keep the new order (staged; written to ORDER_FILE on save).
                    order_changed=1
                    reorder=0
                    ;;
                esc)
                    # Abort: restore the order captured when reordering began.
                    open_seq=("${reorder_backup[@]}")
                    load_list
                    [ "${sel}" -ge "${#files[@]}" ] && sel=$(( ${#files[@]} - 1 ))
                    [ "${sel}" -lt 0 ] && sel=0
                    reorder=0
                    ;;
                redraw|*)
                    # All other keys are disabled while reordering.
                    ;;
            esac
            continue
        fi
        case "${key}" in
            up|k)
                # Wrap to the bottom when stepping off the top.
                [ "${#files[@]}" -gt 0 ] && sel=$(( (sel - 1 + ${#files[@]}) % ${#files[@]} ))
                ;;
            down|j)
                # Wrap to the top when stepping off the bottom.
                [ "${#files[@]}" -gt 0 ] && sel=$(( (sel + 1) % ${#files[@]} ))
                ;;
            shift-up)
                # Scroll the preview pane up; render clamps the lower bound.
                [ "${right_scroll}" -gt 0 ] && right_scroll=$((right_scroll - 1))
                ;;
            shift-down)
                # Scroll the preview pane down; render clamps to the last screenful.
                right_scroll=$((right_scroll + 1))
                ;;
            tab)
                # Switch open <-> done view. Pending toggles are keyed by path, so
                # they persist across the switch.
                if [ "${view}" = "open" ]; then view="done"; else view="open"; fi
                load_list
                sel=0
                preview_key=""
                right_scroll=0
                ;;
            space)
                [ "${#files[@]}" -gt 0 ] || continue
                local kf="${files[${sel}]}"
                # Staged new items carry their done flag in new_done; existing
                # files in pending (which commit_pending applies on save).
                if [ "${done_flags[${sel}]}" -eq 0 ]; then
                    done_flags[${sel}]=1
                    if is_created "${kf}"; then new_done["${kf}"]=1; else pending["${kf}"]=1; fi
                else
                    done_flags[${sel}]=0
                    if is_created "${kf}"; then unset 'new_done['"${kf}"']'; else unset 'pending['"${kf}"']'; fi
                fi
                ;;
            o)
                # Grab the selected reminder for reordering. Open view only
                # (the done view's order is fixed), and only with rows present.
                [ "${view}" = "open" ] || continue
                [ "${#files[@]}" -gt 0 ] || continue
                reorder=1
                reorder_backup=("${open_seq[@]}")
                ;;
            e)
                [ "${#files[@]}" -gt 0 ] || continue
                tput cnorm
                local f work
                f="${files[${sel}]}"
                if is_created "${f}"; then
                    # Staged new reminder: its content already lives in a tmp
                    # (f itself), so edit it in place — still nothing on disk.
                    vim "${f}" </dev/tty >/dev/tty 2>&1
                else
                    # Existing reminder: edit a working copy and stage it; the
                    # real file stays untouched until save.
                    work="${edited_work[${f}]:-}"
                    if [ -z "${work}" ]; then
                        work="$(mktemp --suffix=.md)"
                        cp "${f}" "${work}"
                    fi
                    vim "${work}" </dev/tty >/dev/tty 2>&1
                    if cmp -s "${work}" "${f}"; then
                        # Edited back to the original: drop the staged copy.
                        rm -f "${work}"
                        unset 'edited_work['"${f}"']'
                    else
                        edited_work[${f}]="${work}"
                    fi
                fi
                tput civis
                titles[${sel}]="$(get_title "${edited_work[${f}]:-${f}}")"
                # Content changed: drop this file's memoised previews (all widths).
                local ck
                for ck in "${!preview_cache[@]}"; do
                    case "${ck}" in "${f}::"*) unset 'preview_cache['"${ck}"']' ;; esac
                done
                preview_key=""
                tput clear
                ;;
            n)
                tput cnorm
                newpath="$(compose_reminder)"
                tput civis
                if [ -n "${newpath}" ] && [ -f "${newpath}" ]; then
                    # Stage only — written to REMINDER_DIR on save, not now.
                    created+=("${newpath}")
                    # New reminders are active and newest: put them on top of the
                    # open view, ahead of any existing manual order.
                    open_seq=("${newpath}" "${open_seq[@]}")
                    view="open"
                    load_list
                    sel=0
                fi
                preview_key=""
                tput clear
                ;;
            enter)
                # Save: this is the ONLY place REMINDER_DIR is mutated. Order:
                # persist new reminders, apply edits, then done/reopen toggles.
                local p saved ts title applied=0
                has_changes && applied=1
                declare -A saved_map=()
                for p in "${created[@]}"; do
                    title="$(get_title "${p}")"
                    saved="$(save_reminder "${p}")"
                    saved_map["${p}"]="${saved}"
                    change_log+=("${C_OPEN}+ added    ${C_RESET}${title}")
                    # A new reminder flagged done is saved, then marked done.
                    if [ -n "${new_done[${p}]:-}" ] && [ -f "${saved}" ]; then
                        ts="$(date +%Y-%m-%dT%H-%M-%S)"
                        mv "${saved}" "${saved}_${ts}" \
                            && change_log+=("${C_BOX_ON}✓ done     ${C_RESET}${title}")
                    fi
                done
                for p in "${!edited_work[@]}"; do
                    cp "${edited_work[${p}]}" "${p}" \
                        && change_log+=("${C_BOX_OFF}~ edited   ${C_RESET}$(get_title "${p}")")
                done
                commit_pending
                # Rewrite ORDER_FILE only when something was actually applied,
                # capturing the open view's current order. Created items map to
                # their saved paths; anything flagged done drops out (it left the
                # open view), and resolves to its final active *.md path.
                if [ "${applied}" -eq 1 ]; then
                    local ordered=() q sp
                    for q in "${open_seq[@]}"; do
                        if is_created "${q}"; then
                            [ -n "${new_done[${q}]:-}" ] && continue
                            sp="${saved_map[${q}]:-}"
                            [ -n "${sp}" ] && [ -f "${sp}" ] && ordered+=("${sp}")
                        else
                            [ -n "${pending[${q}]:-}" ] && continue
                            [ -f "${q}" ] && ordered+=("${q}")
                        fi
                    done
                    persist_order "${ordered[@]}"
                fi
                break
                ;;
            esc)
                # From the done view, esc backs out to the open view first;
                # only a second esc (from the open view) exits.
                if [ "${view}" = "done" ]; then
                    view="open"
                    load_list
                    sel=0
                    preview_key=""
                    right_scroll=0
                    continue
                fi
                if has_changes; then
                    if confirm_discard; then
                        # Nothing was applied; the end-of-function cleanup drops
                        # the staging tmps and the real reminders stay as-is.
                        break
                    fi
                    # Declined: prompt text dirtied the screen, repaint clean.
                    tput clear
                else
                    break
                fi
                ;;
            redraw)
                # Signal-interrupted read (e.g. SIGWINCH): loop repaints.
                ;;
        esac
    done

    cleanup_staging          # drop staging tmps (already applied on save, or discarded)
    tput cnorm
    [ -n "${saved_stty:-}" ] && stty "${saved_stty}" </dev/tty 2>/dev/null
    tput clear
    trap - EXIT INT TERM WINCH

    # Report what the save applied, one coloured change per line. Printed after
    # the clear so it survives onto the cleared screen.
    [ "${#change_log[@]}" -gt 0 ] && printf '%s\n' "${change_log[@]}" 1>&2
}

# --- argument parsing -------------------------------------------------------

mode="edit"
while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        --print)
            [ "${mode}" != "edit" ] && fail "Only one of --print or --add may be given"
            mode="print"
            ;;
        --add)
            [ "${mode}" != "edit" ] && fail "Only one of --print or --add may be given"
            mode="add"
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            error "Unexpected argument: ${1}"
            usage
            ;;
    esac
    shift
done

mkdir -p "${REMINDER_DIR}"

case "${mode}" in
    print)
        print_reminders
        ;;
    add)
        tmp="$(compose_reminder)"
        if [ -n "${tmp}" ]; then
            path="$(save_reminder "${tmp}")"
            rm -f "${tmp}"
            echo "Saved: ${path}" 1>&2
            # A new item was applied: rewrite the order file. The new reminder is
            # untracked (newest), so it lands on top; existing order is preserved.
            order_paths=()
            while IFS= read -r f; do
                [ -n "${f}" ] && order_paths+=("${f}")
            done < <(list_files_ordered)
            persist_order "${order_paths[@]}"
        else
            echo "No reminder added." 1>&2
        fi
        ;;
    edit)
        edit_mode
        ;;
esac

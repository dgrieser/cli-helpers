#!/bin/bash

APP_NAME="$(basename "${0}")"
REMINDER_DIR="${HOME}/.cache/reminder"

C_TITLE=$'\033[38;5;228;48;5;63;1m'
C_HELP=$'\033[90m'      # grey help text
C_SEP=$'\033[90m'       # grey vertical rule
C_BOX_OFF=$'\033[36m'   # cyan unchecked checkbox
C_BOX_ON=$'\033[32m'    # green checked checkbox
C_RESET=$'\033[0m'

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS]

Manage and write Markdown reminders in ${REMINDER_DIR}.

Active reminders are *.md files. Marking one "Done" renames it to
<name>.md_<timestamp> so it drops out of every listing without being lost.

With no options, runs interactive edit mode: navigate the reminder titles,
toggle a Done checkbox, add new reminders, then save.

Options:
  --print               Render all reminders with glow and exit
  --add                 Open an editor to write a new reminder and exit
  -h, --help            Show this help message and exit

Edit-mode keys:
  up / down (or k / j)  Move between reminders
  space                 Toggle the Done checkbox on the selected reminder
  e                     Edit the selected reminder in vim, then return
  n                     Add a new reminder, then return to edit mode
  enter                 Save: mark checked reminders Done and exit
  esc                   Abort (prompts to discard if anything changed)
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

# Collect active reminder files (*.md) into the named array variable.
collect_reminders() {
    local -n _out="${1}"
    local f
    _out=()
    for f in "${REMINDER_DIR}"/*.md; do
        [ -f "${f}" ] && _out+=("${f}")
    done
}

# First non-empty line of a file, with any leading Markdown heading marks stripped.
get_title() {
    local t
    t="$(grep -m1 -E '\S' "${1}" 2>/dev/null | sed -E 's/^#+[[:space:]]*//')"
    [ -z "${t}" ] && t="$(basename "${1}")"
    printf '%s' "${t}"
}

# Render every reminder with glow.
print_reminders() {
    local reminders=()
    collect_reminders reminders
    if [ "${#reminders[@]}" -eq 0 ]; then
        echo "No reminders." 1>&2
        return 0
    fi
    {
        echo "# YOUR REMINDERS"
        echo
        local f
        for f in "${reminders[@]}"; do
            cat "${f}"
            echo
        done
    } | glow
}


# Open an editor on a new reminder. On success (editor exit 0 and the template
# was actually changed) save it and print the saved path to stdout. Otherwise
# print nothing and return non-zero.
add_reminder() {
    local dir template tmp content header slug target ts
    dir="$(basename "$(pwd)")"
    template="### ${dir}"

    tmp="$(mktemp --suffix=.md)" || return 1
    printf '%s\n' "${template}" > "${tmp}"

    if ! vim "${tmp}" </dev/tty >/dev/tty 2>&1; then
        rm -f "${tmp}"
        return 1
    fi

    content="$(cat "${tmp}")"
    header="$(grep -m1 -E '\S' "${tmp}" | sed -E 's/^#+[[:space:]]*//')"
    if [ "${content}" = "${template}" ] || [ -z "${header}" ]; then
        # Unchanged from the template, or empty: nothing worth saving.
        rm -f "${tmp}"
        return 1
    fi

    slug="$(printf '%s' "${header}" \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    [ -z "${slug}" ] && slug="reminder"

    target="${REMINDER_DIR}/${slug}.md"
    if [ -e "${target}" ]; then
        ts="$(date +%Y-%m-%dT%H-%M-%S)"
        target="${REMINDER_DIR}/${slug}-${ts}.md"
    fi

    mv "${tmp}" "${target}"
    printf '%s\n' "${target}"
}

# --- interactive edit mode --------------------------------------------------

# State shared across the edit-mode helpers.
files=()
titles=()
done_flags=()
created=()
sel=0

load_list() {
    files=()
    titles=()
    done_flags=()
    collect_reminders files
    local f
    for f in "${files[@]}"; do
        titles+=("$(get_title "${f}")")
        done_flags+=(0)
    done
}

read_key() {
    local char rest c
    IFS= read -rsn1 char </dev/tty
    if [ -z "${char}" ]; then
        printf 'enter\n'
        return
    fi
    if [ "${char}" = $'\e' ]; then
        rest=""
        while IFS= read -rsn1 -t 0.001 c </dev/tty; do
            rest="${rest}${c}"
        done
        case "${rest}" in
            "[A") printf 'up\n' ;;
            "[B") printf 'down\n' ;;
            "[C") printf 'right\n' ;;
            "[D") printf 'left\n' ;;
            "") printf 'esc\n' ;;
            *) printf 'other\n' ;;
        esac
        return
    fi
    case "${char}" in
        " ") printf 'space\n' ;;
        $'\n'|$'\r') printf 'enter\n' ;;
        *) printf '%s\n' "${char}" ;;
    esac
}

# Resolve the glow style to render previews with into the global GLOW_STYLE.
# Honors $REMINDER_GLOW_STYLE, then the "style" key in glow.yml, else "dark".
# (--print's glow writes to a tty so it already picks up glow.yml on its own;
# the preview pipes glow into a substitution, which strips style + colour, so it
# must pass the style explicitly.)
resolve_glow_style() {
    if [ -n "${REMINDER_GLOW_STYLE:-}" ]; then
        GLOW_STYLE="${REMINDER_GLOW_STYLE}"
        return
    fi
    local cfg style
    cfg="${GLOW_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/glow/glow.yml}"
    if [ -f "${cfg}" ]; then
        style="$(sed -nE 's/^[[:space:]]*style:[[:space:]]*"?([^"#]+)"?[[:space:]]*$/\1/p' "${cfg}" | head -1)"
        style="${style%"${style##*[![:space:]]}"}"
    fi
    GLOW_STYLE="${style:-dark}"
    [ "${GLOW_STYLE}" = "auto" ] && GLOW_STYLE="dark"
}

# Render the selected reminder with glow into the global right_lines, wrapped to
# the given width. Cached on (file, width) via preview_key so that toggling Done
# (which leaves the selection unchanged) does not re-run glow.
build_right_lines() {
    local w="${1}" f key line
    if [ "${#files[@]}" -eq 0 ]; then
        right_lines=()
         preview_key=""
        return
    fi
    f="${files[${sel}]}"
    key="${f}::${w}"
    [ "${key}" = "${preview_key:-}" ] && return
    preview_key="${key}"
    right_lines=()
    # glow writes to a pipe here, so it would normally drop colour ("not a
    # terminal"); CLICOLOR_FORCE keeps the ANSI, and an explicit style is needed
    # because background auto-detection also needs a tty.
    while IFS= read -r line; do
        right_lines+=("${line}")
    done < <(COLORTERM=truecolor CLICOLOR_FORCE=1 glow -s "${GLOW_STYLE}" -w "$((w - 1))" "${f}" 2>/dev/null)
    # glow prepends a blank top-margin line; drop it.
    if [ "${#right_lines[@]}" -gt 0 ]; then
        local first
        first="$(printf '%s' "${right_lines[0]}" | sed -E $'s/\033\\[[0-9;?]*[A-Za-z]//g')"
        [ -z "${first//[[:space:]]/}" ] && right_lines=("${right_lines[@]:1}")
    fi
}

# The whole frame is composed into a single string and written in one shot, and
# the screen is repainted from the home position (rather than cleared) with each
# line erased to its end — this avoids the blank-screen flash between frames.
render() {
    local cols lines avail sep left_w right_w tw
    cols="$(tput cols 2>/dev/null || echo 80)"
    lines="$(tput lines 2>/dev/null || echo 24)"
    avail=$((lines - 3))
    [ "${avail}" -lt 1 ] && avail=1
    left_w=$((cols / 3))
    [ "${left_w}" -lt 24 ] && left_w=24
    [ "${left_w}" -gt 44 ] && left_w=44
    right_w=$((cols - left_w - 3))
    # Width left for the title after the "  " marker, the "[ ]" box and a space.
    tw=$((left_w - 6))
    [ "${tw}" -lt 1 ] && tw=1
    # Grey vertical rule (3 visible columns: space, bar, space).
    sep=" ${C_SEP}│${C_RESET} "

    # eol = reset attributes, then erase to end of line (clears stale glyphs and
    # any background colour glow may have left active).
    local home=$'\033[H' eol=$'\033[0m\033[K' clrbelow=$'\033[J'
    local smso rmso
    smso="$(tput smso)"
    rmso="$(tput rmso)"

    # Scroll the list so the selection stays visible.
    local count="${#files[@]}" start=0
    if [ "${count}" -gt "${avail}" ] && [ "${sel}" -ge "${avail}" ]; then
        start=$((sel - avail + 1))
    fi

    local out="${home}"
    # "YOUR REMINDERS" styled like glow's H1, then grey help text.
    out+="${C_TITLE} YOUR REMINDERS ${C_RESET}${C_HELP}  up/down move · space Done · e edit · n new · enter save · esc abort${eol}"$'\n'
    out+="${eol}"$'\n'

    local preview=1
    [ "${right_w}" -lt 16 ] && preview=0
    [ "${preview}" -eq 1 ] && build_right_lines "${right_w}"

    local r li lcell box boxcol title plain rtext
    for ((r = 0; r < avail; r++)); do
        li=$((start + r))
        if [ "${count}" -eq 0 ] && [ "${r}" -eq 0 ]; then
            plain="(no reminders — n to add, esc to quit)"
            lcell="${C_HELP}$(printf '%-*s' "${left_w}" "${plain:0:${left_w}}")${C_RESET}"
        elif [ "${li}" -lt "${count}" ]; then
            if [ "${done_flags[${li}]}" -eq 1 ]; then
                box="[x]"; boxcol="${C_BOX_ON}"
            else
                box="[ ]"; boxcol="${C_BOX_OFF}"
            fi
            title="${titles[${li}]:0:${tw}}"
            if [ "${li}" -eq "${sel}" ]; then
                # Selected: reverse-video bar across the whole cell, plain text.
                plain="$(printf '> %s %-*s' "${box}" "${tw}" "${title}")"
                lcell="${smso}$(printf '%-*s' "${left_w}" "${plain:0:${left_w}}")${rmso}"
            else
                # Coloured checkbox, default-coloured title.
                lcell="  ${boxcol}${box}${C_RESET} $(printf '%-*s' "${tw}" "${title}")"
            fi
        else
            lcell="$(printf '%-*s' "${left_w}" "")"
        fi
        if [ "${preview}" -eq 1 ]; then
            # glow output carries its own ANSI; pass it through untruncated.
            rtext="${right_lines[${r}]:-}"
            out+="${lcell}${sep}${rtext}${eol}"$'\n'
        else
            out+="${lcell}${eol}"$'\n'
        fi
    done

    # Drop the final newline so the cursor never lands past the last row (which
    # would scroll the screen), then clear anything left below.
    out="${out%$'\n'}"
    out+="${clrbelow}"
    printf '%s' "${out}"
}

has_changes() {
    [ "${#created[@]}" -gt 0 ] && return 0
    local i
    for i in "${!done_flags[@]}"; do
        [ "${done_flags[${i}]}" -eq 1 ] && return 0
    done
    return 1
}

confirm_discard() {
    tput cnorm
    printf '\nDiscard changes'
    [ "${#created[@]}" -gt 0 ] && printf ' and delete %d new reminder(s)' "${#created[@]}"
    printf '? [y/N] '
    local ans
    IFS= read -rn1 ans </dev/tty
    printf '\n'
    tput civis
    case "${ans}" in
        y|Y) return 0 ;;
        *) return 1 ;;
    esac
}

commit_done() {
    local i ts count=0
    for i in "${!files[@]}"; do
        if [ "${done_flags[${i}]}" -eq 1 ]; then
            ts="$(date +%Y-%m-%dT%H-%M-%S)"
            mv "${files[${i}]}" "${files[${i}]}_${ts}"
            count=$((count + 1))
        fi
    done
    [ "${count}" -gt 0 ] && echo "Marked ${count} reminder(s) done." 1>&2
    return 0
}

edit_mode() {
    [ -t 1 ] || fail "Edit mode requires a terminal."

    load_list
    sel=0
    created=()
    preview_key=""
    resolve_glow_style

    trap 'tput cnorm 2>/dev/null' EXIT
    tput civis
    tput clear

    local key newpath
    while true; do
        render
        key="$(read_key)"
        case "${key}" in
            up|k)
                [ "${sel}" -gt 0 ] && sel=$((sel - 1))
                ;;
            down|j)
                [ $((sel + 1)) -lt "${#files[@]}" ] && sel=$((sel + 1))
                ;;
            space)
                [ "${#files[@]}" -gt 0 ] || continue
                if [ "${done_flags[${sel}]}" -eq 0 ]; then
                    done_flags[${sel}]=1
                else
                    done_flags[${sel}]=0
                fi
                ;;
            e)
                [ "${#files[@]}" -gt 0 ] || continue
                tput cnorm
                vim "${files[${sel}]}" </dev/tty >/dev/tty 2>&1
                tput civis
                titles[${sel}]="$(get_title "${files[${sel}]}")"
                preview_key=""
                tput clear
                ;;
            n)
                tput cnorm
                newpath="$(add_reminder)"
                tput civis
                if [ -n "${newpath}" ] && [ -f "${newpath}" ]; then
                    files+=("${newpath}")
                    titles+=("$(get_title "${newpath}")")
                    done_flags+=(0)
                    created+=("${newpath}")
                    sel=$(( ${#files[@]} - 1 ))
                fi
                preview_key=""
                tput clear
                ;;
            enter)
                commit_done
                break
                ;;
            esc)
                if has_changes; then
                    if confirm_discard; then
                        local p
                        for p in "${created[@]}"; do
                            rm -f "${p}"
                        done
                        break
                    fi
                    # Declined: prompt text dirtied the screen, repaint clean.
                    tput clear
                else
                    break
                fi
                ;;
        esac
    done

    tput cnorm
    tput clear
    trap - EXIT
}

# --- argument parsing -------------------------------------------------------

mode="edit"
while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        --print)
            [ "${mode}" != "edit" ] && fail "Only one of --print or --add may be given"
            mode="print"
            ;;
        --add)
            [ "${mode}" != "edit" ] && fail "Only one of --print or --add may be given"
            mode="add"
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            error "Unexpected argument: ${1}"
            usage
            ;;
    esac
    shift
done

mkdir -p "${REMINDER_DIR}"

case "${mode}" in
    print)
        print_reminders
        ;;
    add)
        path="$(add_reminder)"
        if [ -n "${path}" ]; then
            echo "Saved: ${path}" 1>&2
        else
            echo "No reminder added." 1>&2
        fi
        ;;
    edit)
        edit_mode
        ;;
esac

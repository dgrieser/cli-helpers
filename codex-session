#!/bin/bash

APP_NAME="$(basename "${0}")"

session_folder="${HOME}/.codex/sessions"
session_prefix="rollout-"
session_ext="jsonl"
directory_max_length=35

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [SESSION]

Prints sessions of codex CLI

SESSION   the ID of the session to print; omit to list sessions

Options:
    -h, --help          Show this message
    -l, --last          Print the latest session
    -n, --limit LIMIT   Limit number of sessions to list (default: 50)
    -g, --grep GREP     Filter listed sessions by a regex match in session contents
    -i, --igrep GREP    Filter listed sessions by a case-insensitive regex match
    -r, --raw           Raw output
    --verbose           Verbose output
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

verbose() {
    local message

    [ "${verbose}" -eq 0 ] && return
    message="${1//$'\n'/$'\n+ '}"
    printf '+ %s\n' "${message}" 1>&2
}

truncate_middle() {
    local value="${1}"
    local max_length="${2}"
    local marker="..."
    local start_length
    local end_length

    [ "${#value}" -le "${max_length}" ] && echo "${value}" && return

    start_length=$(( (max_length - ${#marker}) / 2 ))
    end_length=$(( max_length - ${#marker} - start_length ))
    echo "${value:0:${start_length}}${marker}${value: -${end_length}}"
}

shorten_path() {
    local path="${1}"
    local max_length="${2}"
    local parts
    local part_count
    local prefix
    local collapse_start
    local collapse_end
    local shortened
    local index

    [ "${#path}" -le "${max_length}" ] && echo "${path}" && return

    IFS='/' read -r -a parts <<< "${path}"
    part_count="${#parts[@]}"

    if [[ "${path}" == /* ]]; then
        [ "${part_count}" -le 3 ] && truncate_middle "${path}" "${max_length}" && return
        prefix="/${parts[1]}"
        collapse_start=2
    else
        [ "${part_count}" -le 3 ] && truncate_middle "${path}" "${max_length}" && return
        prefix="${parts[0]}/${parts[1]}"
        collapse_start=2
    fi

    for (( collapse_end=collapse_start; collapse_end<part_count-1; collapse_end++ )); do
        shortened="${prefix}/..."
        for (( index=collapse_end+1; index<part_count; index++ )); do
            shortened+="/${parts[index]}"
        done
        [ "${#shortened}" -le "${max_length}" ] && echo "${shortened}" && return
    done

    truncate_middle "${shortened}" "${max_length}"
}

shorten_text() {
    local text="${1}"
    local max_length="${2}"

    [ "${#text}" -le "${max_length}" ] && echo "${text}" && return
    echo "${text:0:$((max_length - 3))}..."
}

format_cwd() {
    local cwd="${1}"
    local home_display="~"

    [ "${cwd}" = "${HOME}" ] && cwd="${home_display}"
    [[ "${cwd}" == "${HOME}/"* ]] && cwd="${home_display}/${cwd#"${HOME}/"}"
    shorten_path "${cwd}" "${directory_max_length}"
}

fail() {
    error "${1}"
    exit 1
}

print_session_file() {
    local filepath="${1}"
    local jq_args
    local session_content

    jq_args=( '-rs' '[.[] | .payload | select(.role == "assistant") | .content[]?.text] | join("\n\n---\n\n")' )
    verbose "Extracting session messages from ${filepath}..."
    verbose "jq ${jq_args[*]} ${filepath}"
    session_content="$(jq "${jq_args[@]}" "${filepath}")"
    [ "${raw}" -eq 0 ] && echo "${session_content}" | glow || echo "${session_content}"
}

session_id=""
grep_pattern=""
igrep_pattern=""
last=0
limit=50
raw=0
verbose=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h | --help)
            usage
            ;;
        -r | --raw)
            raw=1
            ;;
        -l | --last)
            last=1
            ;;
        -n | --limit)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --limit"
            limit="${1}"
            [[ "${limit}" =~ ^[0-9]+$ ]] || fail "Invalid limit: ${limit}"
            [ "${limit}" -gt 0 ] || fail "Invalid limit: ${limit}"
            ;;
        -g | --grep)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --grep"
            grep_pattern="${1}"
            [ -n "${grep_pattern}" ] || fail "Missing argument for --grep"
            ;;
        -i | --igrep)
            shift
            [ "${#}" -gt 0 ] || fail "Missing argument for --igrep"
            igrep_pattern="${1}"
            [ -n "${igrep_pattern}" ] || fail "Missing argument for --igrep"
            ;;
        --verbose)
            verbose=1
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            if [ -z "${session_id}" ]; then
                session_id="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

if [ "${last}" -eq 1 ] && [ -n "${session_id}" ]; then
    fail "--last cannot be used with SESSION"
fi

if [ -n "${grep_pattern}" ] && [ -n "${session_id}" ]; then
    fail "--grep cannot be used with SESSION"
fi

if [ -n "${igrep_pattern}" ] && [ -n "${session_id}" ]; then
    fail "--igrep cannot be used with SESSION"
fi

if [ -n "${grep_pattern}" ] && [ "${last}" -eq 1 ]; then
    fail "--grep cannot be used with --last"
fi

if [ -n "${igrep_pattern}" ] && [ "${last}" -eq 1 ]; then
    fail "--igrep cannot be used with --last"
fi

if [ -n "${grep_pattern}" ] && [ -n "${igrep_pattern}" ]; then
    fail "--grep and --igrep cannot be used together"
fi

if [ -n "${grep_pattern}" ]; then
    grep -q -- "${grep_pattern}" /dev/null 2>/dev/null
    grep_status="${?}"
    [ "${grep_status}" -eq 1 ] || [ "${grep_status}" -eq 0 ] || fail "Invalid --grep pattern: ${grep_pattern}"
fi

if [ -n "${igrep_pattern}" ]; then
    grep -qi -- "${igrep_pattern}" /dev/null 2>/dev/null
    grep_status="${?}"
    [ "${grep_status}" -eq 1 ] || [ "${grep_status}" -eq 0 ] || fail "Invalid --igrep pattern: ${igrep_pattern}"
fi

if [ "${last}" -eq 1 ]; then
    verbose "Finding latest session..."
    filepath="$(find "${session_folder}" -name "${session_prefix}*.${session_ext}" | sort | tail -n 1)"
    verbose "${filepath}"
    [ -z "${filepath}" ] && fail "No sessions found"
    print_session_file "${filepath}"
elif [ -n "${session_id}" ]; then
    verbose "Finding session with session_id=${session_id}..."
    find_args=( "${session_folder}" '-name' "${session_prefix}*${session_id}.${session_ext}" )
    filepath="$(find "${find_args[@]}")"
    verbose "${filepath}"
    [ -z "${filepath}" ] && fail "No such session: ${session_id}"
    [ "$(echo "${filepath}" | wc -l)" -gt 1 ] && fail "Multiple matches for session: ${session_id}"
    print_session_file "${filepath}"
else
    verbose "Listing sessions..."
    rows=""
    session_files=()
    while IFS= read -r filepath; do
        if [ -n "${grep_pattern}" ]; then
            grep -q -- "${grep_pattern}" "${filepath}" || continue
        fi
        if [ -n "${igrep_pattern}" ]; then
            grep -qi -- "${igrep_pattern}" "${filepath}" || continue
        fi
        session_files+=("${filepath}")
    done < <(find "${session_folder}" -name "${session_prefix}*.${session_ext}" | sort)

    session_count="${#session_files[@]}"
    start_index=$(( session_count - limit ))
    [ "${start_index}" -lt 0 ] && start_index=0

    for filepath in "${session_files[@]:${start_index}}"; do
        filename="$(basename "${filepath}")"
        session_id="$(echo "${filename}" | sed -E 's/^'"${session_prefix}"'([^.]+)\.'"${session_ext}"'/\1/')"
        uuid="$(echo "${session_id}" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-(.+)$/\1/')"
        datetime="$(echo "${session_id}" | sed -E 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2})-([0-9]{2})-([0-9]{2})-.+$/\1T\2:\3:\4/')"
        cwd="$(jq -r -s 'map(select(.type == "session_meta"))[0].payload.cwd // ""' "${filepath}")"
        cwd="$(format_cwd "${cwd}")"
        summary="$(jq -rs 'map(select(.type == "event_msg" and .payload.type == "user_message"))[0].payload.message // ""' "${filepath}" | head -1 | tr -s ' \t\n' ' ')"
        summary="$(shorten_text "${summary}" 60)"
        rows+="${uuid}  ${datetime}  ${cwd}  ${summary}\n"
    done
    verbose "echo -e 'SESSION  DATETIME  DIRECTORY  SUMMARY\n\${rows}' | k-format"
    echo -e "SESSION  DATETIME  DIRECTORY  SUMMARY\n${rows}" | k-format
fi

exit 0
